quest collect_quest_lv80  begin
	state start begin
	end
	state run begin
		when login or levelup with pc.level >= 80  begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20084)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;402]")
			end
			send_letter("[LC;415]")
		end

		when button or info begin
			say_title("[LC;427]")
			say("[LC;429]")
		end

		when __TARGET__.target.click or	20084.chat."[LC;364]" begin
			target.delete("__TARGET__")
			say_title("[LC;365]")
			say("[LC;430]")
			wait()
			say_title("[LC;365]")
			say("[LC;431]")
			wait()
			say_title("[LC;365]")
			say("[LC;432]")
			set_state(go_to_disciple)
			pc.setqf("duration",0)  -- Die Versuchszeit
			pc.setqf("collect_count",0)--die gesammelte Artikrl
			pc.setqf("drink_drug",0) --Wenn man das Verwirrungswasse trinkt 1
		end
	end

	state go_to_disciple begin
		when letter begin

			send_letter("[LC;346]")
		end
		when button or info begin
			say_title("[LC;433]")
			say("[LC;434]")
			say_item_vnum(30166)
			say_reward(string.format("[LC;401;%s]", pc.getqf("collect_count")))
					end

		when 71035.use begin --Das Wunderwasser der Verwirrung
			if get_time() < pc.getqf("duration") then
				say("[LC;403]")
				return
			end
			if pc.getqf("drink_drug")==1 then
				say("[LC;404]")
				return
			end
			if pc.count_item(30166)==0 then
				say_title("[LC;365]")
				say("[LC;405]")
				return
			end

			pc.remove_item(71035, 1)
			pc.setqf("drink_drug",1)
		end

		when 1401.kill or 1402.kill or 1403.kill or 1601.kill or  1602.kill or 1603.kill  begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item(30166)==0 then
				pc.give_item2(30166, 1)
				--send_letter(string.format("[LC;428]", item_name(30166)))
				send_letter("[LC;428]")
			end	
		end


		when 20084.chat."[LC;407]" with pc.count_item(30166) >0   begin
			if get_time() > pc.getqf("duration") then
				if  pc.count_item(30166) >0 then
					say_title("[LC;365]")
					say("[LC;408]")
					pc.remove_item(30166, 1)
					pc.setqf("duration",get_time()+60*60*22)--------------22 Stunden
					wait()

					local pass_percent
					if pc.getqf("drink_drug")==0 then
						pass_percent=60
					else
						pass_percent=90
					end

					local s= number(1,100)
					if s<= pass_percent  then
						if pc.getqf("collect_count")< 29 then     
							local index =pc.getqf("collect_count")+1
							pc.setqf("collect_count",index)     
							say_title("[LC;365]")
							say(string.format("[LC;409;%s]", 30-pc.getqf("collect_count")))
							pc.setqf("drink_drug",0)	 
							return
						end
						say_title("[LC;365]")
						say("[LC;410]")
						pc.setqf("collect_count",0)
						pc.setqf("drink_drug",0)
						pc.setqf("duration",0)
						set_state(key_item)
						return
					else
						say_title("[LC;365]")
						say("[LC;411]")
						pc.setqf("drink_drug",0)	
						return
					end
				else
					say_title("[LC;365]")
					--say(string.format("[LC;231]", item_name(30116)))
					say("[LC;412]", item_name(30116))
					return
				end
			else
				say_title("[LC;365]")
				say("[LC;379]")
				return
			end

		end
	end


	state key_item begin
		when letter begin

			send_letter("[LC;346]")
			if pc.count_item(30225)>0 then
				local v = find_npc_by_vnum(20084)
				if v != 0 then
					target.vid("__TARGET__", v, "[LC;272]")
				end
			end

		end
		when button or info begin
			if pc.count_item(30225) >0 then
				say_title("[LC;413]")
				say("[LC;414]")
				return
			end

			say_title("[LC;416]")
			say("[LC;417]")
			say_item_vnum(30225)
			say("[LC;418]")
		end


		when 1401.kill or 1402.kill or 1403.kill or 1601.kill or 1602.kill or 1603.kill  begin
			local s = number(1, 200)
			if s == 1 and pc.count_item(30225)==0 then
				pc.give_item2(30225, 1)
				send_letter("[LC;419]")
			end
		end




		when __TARGET__.target.click  or	20084.chat."[LC;420]" with pc.count_item(30225) > 0  begin
		    target.delete("__TARGET__")
			if pc.count_item(30225) > 0 then 
				say_title("[LC;365]")
				say("[LC;421]")
				pc.remove_item(30225,1)
				set_state(__reward)
			else
				say_title("[LC;365]")
				--say(string.format("[LC;242]", item_name(30225)))
				say("[LC;422]")
				return
			end
		end

	end

	state __reward begin
		when letter begin

			send_letter("[LC;282]")
			local v = find_npc_by_vnum(20018)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;245]")
			end

		end
		when button or info begin
			say_title("[LC;282]")
			say("[LC;423]")
		end

		when __TARGET__.target.click  or	20018.chat."[LC;247]"  begin
		    target.delete("__TARGET__")
			say_title("[LC;248]")
			say("[LC;424]")
			wait()
			say_title("[LC;248]")
			say("[LC;425]")
			say_reward("[LC;426]")
	    	affect.add_collect(apply.ATT_SPEED,6,60*60*24*365*60) 
	        affect.add_collect_point(POINT_ATT_BONUS,10,60*60*24*365*60) 

			pc.give_item2(50114)
			clear_letter()
			set_quest_state("collect_quest_lv85", "run")
			set_state(__complete)
		end

	end


	state __complete begin
	end
end



