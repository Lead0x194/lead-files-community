

quest main_quest_lv55 begin
	state start begin
	end
	state run begin
		when login or levelup with  pc.get_level() >= 55 begin
			set_state ( survey8 )
		end
	end

state survey8 begin
		when letter begin
			send_letter("[LC;4459]")

			if main_quest_lv55.is_other_vil()==1  then
				local v=find_npc_by_vnum(20357)
				if 0==v then
				else
					target.vid("__TARGET1__", v, "[LC;4459]")
				end
			end
		end
		when button or info begin
			local empire = pc.get_empire()
			if empire ==1 then --Shinsoo
				say_title("[LC;4459]")
				say("[LC;4471]")

			elseif empire ==2 then --Chunjo
				say_title("[LC;4459]")
				say("[LC;4482]")

			elseif empire ==3 then  --Jinno
				say_title("[LC;4459]")
				say("[LC;4494]")
			end

		end

		function is_other_vil()
			local empire = pc.get_empire()
			local map_num= pc.get_map_index()

			local is_village = 0

			if empire == 1 and map_num == 21 then is_village = 1 end
			if empire == 2 and map_num == 41 then is_village = 1 end
			if empire == 3 and map_num ==  1 then is_village = 1 end
			return is_village
		end

		when __TARGET1__.target.click or 20357.chat."[LC;4495]" with main_quest_lv55.is_other_vil()==1 begin
			say_pc_name()
			say("[LC;4496]")
			pc.give_item2(30150)
			set_state ( gototeacher8)
		end
	end

	state gototeacher8 begin
		when letter begin
			send_letter("[LC;4497]")
			if main_quest_lv55.is_my_vil()==1 then
				local v=find_npc_by_vnum(20011)
				if 0==v then
				else
					target.vid("__TARGET__", v, "[LC;4498]")
				end
			end
		end
		when button or info begin
			local empire = pc.get_empire()
			if empire ==2 then --Chonjo
				say_title("[LC;4497]")
				say("[LC;4499]")

			elseif empire ==1 then --Shinsu
				say_title("[LC;4497]")
				say("[LC;4458]")

			elseif empire ==3 then --Jinno
				say_title("[LC;4497]")
				say("[LC;4460]")
			end

		end

		function is_my_vil()
			local empire = pc.get_empire()
			local map_num= pc.get_map_index()

			local is_village = 0

			if empire == 1 and map_num == 1 then is_village = 1 end
			if empire == 2 and map_num == 21 then is_village = 1 end
			if empire == 3 and map_num == 41 then is_village = 1 end
			return is_village
		end

		when __TARGET__.target.click or	20011.chat."[LC;4497]" with main_quest_lv55.is_my_vil()==1 begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4461]")
			wait()
			say_title("[LC;4462]")
			say_reward("[LC;4463]")
			wait()
			say_title("[LC;4464]")
			say_reward("[LC;4465]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4466]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4467]")
			say_reward("[LC;4468]")
			pc.give_exp2(6500000)
			say_reward("[LC;4469]")
			pc.change_money(162500)
			pc.remove_item(30150)
			set_state (last_shot)
		end
	end

	state last_shot begin
		when letter begin
			send_letter("[LC;4470]")

		end
		when button or info begin
			say_title("[LC;4472]")
			say("[LC;4473]")
		end

		when 1303.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30150")==0 then
				say("[LC;4474]")
				set_state (takepaper)
			end
		end
	end

	state takepaper begin
		when letter begin
			send_letter("[LC;4475]")

			local v=find_npc_by_vnum(20363)
			if 0==v then
			else
				target.vid("__TARGET1__", v, "[LC;4475]")
			end

		end
		when button or info begin
			say_title("[LC;4476]")
			say("[LC;4477]")
			wait()
			say_title("[LC;4476]")
			say("[LC;4478]")
		end
		when __TARGET1__.target.click or 20363.chat."[LC;4479]" begin
			target.delete("__TARGET1__")
			say_title("[LC;4479]")
			say("[LC;4480]")
			pc.give_item2(30150)
			set_state ( gototeacher)
		end
	end
	state gototeacher begin
		when letter begin
			send_letter("[LC;4470]")

			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4385]")
			end
		end
		when button or info begin
			say_title("[LC;4470]")
			say("[LC;4481]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4470]" begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4483]")
			wait()
			say_title("[LC;4484]")
			say_reward("[LC;4485]")
			wait()
			say_title("[LC;4486]")
			say_reward("[LC;4487]")
			wait()
			say_title("[LC;4486]")
			say_reward("[LC;4488]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4489]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4490]")
			say_reward("[LC;4491]")
			pc.give_exp2(7000000)

			say_reward("[LC;4492]")
			pc.change_money(175000)

			say_reward("[LC;4493]")
			pc.give_item2(71012)

			pc.remove_item(30150)

			clear_letter()
			set_quest_state("main_quest_lv60", "run")
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv60", "run")
		end
	end
	state __COMPLETE__ begin
	end
end

