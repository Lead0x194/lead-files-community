quest subquest_11 begin
	state start begin
		when login or  levelup with pc.level >= 19 and pc.level <= 24 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20006)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7273]")
			end
		end


		when __TARGET__.target.click or	20006.chat."[LC;7282]" with pc.level >= 19 begin
			target.delete("__TARGET__")

                        say_title("[LC;944]")
                        say("[LC;7283]")
			wait()
                        say_title("[LC;944]")
			say("[LC;7284]")

			local s= select("[LC;7285]", "[LC;7200]")
			if 2==s then
				say("[LC;7286]")
				local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;944]")
						say("[LC;7287]")
						return
					end
					say_title("[LC;944]")
					say("[LC;7288]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;944]")
				say("[LC;7289]")
				set_state(find_brother)

		end
	end

	state find_brother begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7273]")
			q.set_title("[LC;7273]")
			q.start()

			local v= find_npc_by_vnum(20017)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7272]")
			end

		end

		when info or button begin
			say_title("[LC;7273]")
						say_reward("[LC;7272]")
					end

		when __TARGET__.target.click or	20017.chat."[LC;7274]" begin
			target.delete("__TARGET__")
			say_title("[LC;14]")
			say("[LC;7275]")

			set_state(ask_to_hunter)
		end
	end

	state ask_to_hunter begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7273]")
			q.set_title("[LC;7273]")
			q.start()

			local v= find_npc_by_vnum(20019)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7276]")
			end

		end

		when info or button begin
			say_title("[LC;7273]")
						say_reward("[LC;7276]")
					end

		when  __TARGET__.target.click or	20019.chat."[LC;7274]" begin
			target.delete("__TARGET__")
			say_title("[LC;4275]")
			say("[LC;7277]")

			set_state(back_to)
		end
	end

	state back_to begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7273]")
			q.set_title("[LC;7273]")
			q.start()

			local v= find_npc_by_vnum(20006)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7278]")
			end

		end

		when info or button begin
			say_title("[LC;7273]")
                        			say_reward("[LC;7278]")
					end

		when __TARGET__.target.click or	20006.chat."[LC;7279]" begin
			target.delete("__TARGET__")
			say_title("[LC;944]")
			say("[LC;7280]")

			pc.give_exp2(122000)
			pc.change_money(5000)

                        say_title("[LC;192]")
                        			say_reward("[LC;7281]")
			
			clear_letter()
			set_state(__COMPLETE__)
		end
	end

	state __GIVEUP__ begin
	end

	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
