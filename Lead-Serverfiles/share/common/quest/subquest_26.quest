quest subquest_26 begin
	state start begin
		when login or levelup with pc.level >= 57  and pc.level <= 59 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(9005)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7702]")
			end
		end

		when __TARGET__.target.click or	9005.chat."[LC;7713]" begin
			target.delete("__TARGET__")
			say_title("[LC;7724]")
			say("[LC;7735]")
			wait()
			say_title("[LC;7724]")
			say("[LC;7737]")

			local s= select("[LC;7738]", "[LC;7739]")
			if 2==s then
				say("[LC;7740]")
					local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;7724]")
						say("[LC;7741]")
						return
					end	
					say_title("[LC;7724]")
					say("[LC;7701]")
					set_state(__GIVEUP__)
					return
			end					
			say_title("[LC;7724]")
			say("[LC;7703]")
			set_state(ask_okgu)

		end
	

		end
	state ask_okgu begin
		when letter begin

			send_letter("[LC;7704]")
			
			local v=find_npc_by_vnum(20008)
			if 0==v then
			else
				target.vid("__TARGET1__", v, "[LC;7705]")
			end

		end

		when info or button begin

			say_title("[LC;7706]")
			say("[LC;7707]")
		end


		when __TARGET1__.target.click or	20008.chat."[LC;7708]" begin
			target.delete("__TARGET1__")
			say_title("[LC;7137]")
			say("[LC;7709]")
			wait("")
			say_title("[LC;7137]")
			say("[LC;7710]")
			local s= select("[LC;7711]", "[LC;7712]")
			if 2==s then
				say("[LC;7714]")
					local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;7137]")
						say("[LC;7715]")
						return
					end	
					say_title("[LC;7137]")
					say("[LC;7716]")
					set_state(__GIVEUP__)
			return
			end					
			say_title("[LC;7137]")
			say("[LC;7717]")
			set_state(accept)

		end


		end

	state accept begin

		when letter begin
			if pc.count_item(30116)>0 then
				send_letter("[LC;7718]")
				
				local v=find_npc_by_vnum(20008)
				if 0==v then
				else
					target.vid("__TARGET__", v, "[LC;7719]")
				end

			return
		  end 
		  send_letter("[LC;7720]")

		end

		when info or button begin
			if pc.count_item(30116)>0 then

				say_title("[LC;7718]")
				say("[LC;7721]")
				return
			end
			say_title("[LC;7722]")
			say("[LC;7723]")
		end


		when 20008.chat."[LC;7725]" with pc.getqf("frog_done")==1 begin


			say_title("[LC;7137]")
			say("[LC;7726]")

			local s= select("[LC;7727]", "[LC;939]")
			if 2==s then
				say("[LC;7740]")
					local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;7137]")
						say("[LC;7728]")
						return
					end	
					say_title("[LC;7137]")
					say("[LC;7729]")
					set_state(__GIVEUP__)
			return
			end					
			say_title("[LC;7137]")
			say("[LC;7730]")

		end
		
		when 1302.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30116")==0 then
				pc.give_item2(30116, 1)
				
				if pc.count_item("30116")>=1 then
					local v=find_npc_by_vnum(20008)
					if 0 != v then
						target.vid("__TARGET__",v, "[LC;7731]")
					end
				end 
			end
		end


			
		when __TARGET__.target.click or	20008.chat."[LC;7718]" with pc.count_item(30116)>=1  begin
			target.delete("__TARGET__")

			say_title("[LC;7137]")
			say("[LC;7732]")
			wait()
			say_title("[LC;7137]")
			say("[LC;7733]")
			pc.remove_item(30116,1)
		
			say_reward("[LC;7734]")
			pc.change_money(50000)

			say_reward("[LC;7736]")
			pc.give_exp2(5000000)
			

			clear_letter()
			set_state(COMPLETE)

		end
	
	end
	
	state __GIVEUP__ begin
	end
	state COMPLETE begin
		when enter begin
			q.done()
		end
	end

end

	


