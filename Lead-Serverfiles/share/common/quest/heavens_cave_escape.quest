quest heavens_cave_escape begin
	state start begin
		when login or levelup with pc.level >=75 begin
			set_state(heavens_cave_escape)
		end
	end
		
	state heavens_cave_escape begin
		when 20090.chat."[LC;1501]" with pc.get_map_index() == 72 begin
			say_title("[LC;1502]")

			say("[LC;1503]")
			local a= select("[LC;2059]", "[LC;2035]")
			if 1==a then
				say_title("[LC;1502]")

				say("[LC;1504]")
				wait()
				
				pc.warp(284460, 810495)
				return
			end

			say_title("[LC;1502]")
			say("[LC;1505]")
		end
	end
end