quest main_quest_lv14 begin
	state start begin
	end
	state run begin
		when login or levelup or enter with pc.get_level() >= 14 begin
		set_state ( gotoboss )
		end
	end

	state gotoboss begin
		when letter begin
			send_letter("[LC;4070]")
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4070]")
			end
		end
		when button or info begin
			say_title("[LC;4070]")
			say("[LC;4109]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;4082]")
			say("[LC;4114]")
			wait()

                        say_title("[LC;4082]")
                                                ---                                                   l
			say("[LC;4115]")
			wait()
			say_title("[LC;192]")
                        			say_reward("[LC;4116]")
			set_state ( killmetinstone )
		end
	end

	state killmetinstone begin
		when letter begin
			send_letter("[LC;4117]")
		end
		when button or info begin
			say_title("[LC;4117]")
			say("[LC;4118]")
		end
		when 8003.kill begin
			say_title("[LC;4119]")
			say("[LC;4120]")
			set_state (gotoboss2)
		end
	end
	state gotoboss2 begin
		when letter begin
			send_letter("[LC;4121]")
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4078]")
			end
		end
		when button or info begin
			say_title("[LC;4108]")
			say("[LC;4110]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			
			local stones = { 28030,28130,28230 }
			local i = stones[number( 1, 3 )];
			local stone =  (i+number(1,14)-1)
			say_title("[LC;4082]")
			say("[LC;4111]")
			say_title("[LC;192]")
                        			say_reward("[LC;4112]")
say_reward(string.format("[LC;4113;%s]", item_name(stone)))
			
			pc.give_exp2( stone )
			pc.change_money( 10000 )
			pc.give_item2( stone,1 )
			
			clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv15", "run")
			
		end
	end
	state __COMPLETE__ begin
	end
end