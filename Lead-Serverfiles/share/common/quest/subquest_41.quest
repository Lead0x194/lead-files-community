
quest subquest_41 begin
	state start begin
		when login or levelup with pc.level >= 49 and pc.level <= 51 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
					
			local v = find_npc_by_vnum(20008)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;8138]")
			end
		end

		
		when __TARGET__.target.click or	20008.chat.nil with pc.level >= 49 begin
			target.delete("__TARGET__")

			say_title("[LC;7137]")
			say("[LC;8149]")
			wait()
			say_title("[LC;7137]")
			say("[LC;8151]")
			wait()
			say_title("[LC;7137]")
			say("[LC;8152]")
			say_item_vnum("30162")
						local s= select("[LC;6997]", "[LC;7811]")
			if 2==s then
				say("[LC;8153]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7137]")
					say("[LC;8154]")
					return
				end
				say_title("[LC;7137]")
				say("[LC;8155]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7137]")
			say("[LC;8156]")
			set_state(hunt_for_oku)
		end
	end

	state hunt_for_oku begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8138]")
			q.set_title("[LC;8138]")
			q.start()

			if pc.count_item("30162") >= 100 then  
				local v = find_npc_by_vnum(20008)

				if v != 0 then
					target.vid("__TARGET__", v, "[LC;8138]")
				end
				return
			end
		end

		when info or button begin

			if pc.count_item("30162") >= 100 then  
				say_title("[LC;8157]")
				say("[LC;8137]")
				return
			end
				
			say_title("[LC;8139]")
			say("[LC;8140]")
			say_item_vnum("30162")
					end
		when 2001.kill or 2002.kill or 2003.kill or 2004.kill or  2005.kill begin
			local s = number(1, 100)
			if s <= 7 and pc.count_item("30162")<100  then 
				pc.give_item2("30162", 3) 
				if pc.count_item("30162")>=100 then
					local v=find_npc_by_vnum(20008)
					if 0==v then
					else
						target.vid("__TARGET__",v, "[LC;8141]")
					end
				end	
			end	
		end
			
		when __TARGET__.target.click or	20008.chat."[LC;8142]" begin
			target.delete("__TARGET__")
			if pc.count_item("30162") >= 100 then
				say_title("[LC;8143]")
				say("[LC;8144]")
				wait()
				say_title("[LC;8143]")
				say("[LC;8145]")
				pc.remove_item("30162",100)

				say_reward("[LC;8146]")
				pc.give_exp2(2100000)
				set_quest_state("levelup","run")

				say_reward("[LC;7806]")
				pc.change_money(20000)
				clear_letter()	
				set_state(COMPLETE)
				return
				
			else
				say_title("[LC;8143]")
				say("[LC;8147]")
				local s= select("[LC;7727]", "[LC;939]")
				if 2==s then
					say_title("[LC;8143]")
					say("[LC;8148]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;8143]")
				say("[LC;8150]")
			end
		end
	end
	state __GIVEUP__ begin
	end
	
	state COMPLETE begin
		when enter begin
			q.done()
		end
	end
end
