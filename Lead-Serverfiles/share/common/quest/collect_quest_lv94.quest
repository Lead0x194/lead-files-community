----------------------------------------------------
--COLLECT QUEST_lv94
----------------------------------------------------
quest collect_quest_lv94  begin
	state start begin
	end

	state run begin
		when login or levelup with pc.level >= 94 begin
			set_state(information)
		end	
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20091)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;569]")
			end
			send_letter("[LC;570]")
		end

		when button or info begin
			say_title("[LC;570]")
			say("[LC;571]")
			say("")
		end
		
		when __TARGET__.target.click or	20091.chat."[LC;572]" begin
			target.delete("__TARGET__")
			---                                                   l
			say_title("[LC;573]")
			say("[LC;574]")
			say("")
			wait()
			say_title("[LC;573]")
			say("[LC;575]")
			say("")
			set_state(go_to_disciple)
			pc.setqf("duration", 0)
			pc.setqf("collect_count", 0)
			pc.setqf("drink_drug", 0)
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter("[LC;576]")
		end

		when button or info begin
			say_title("[LC;576]")
			---                                                   l
			say("[LC;577]")
			say_item_vnum(30252) 
			say_reward(string.format("[LC;578;%s]", pc.getqf("collect_count")))
			say("")
		end
		
		when 71035.use begin
			if get_time() < pc.getqf("duration") then
				say("[LC;579]")
				return
			end

			if pc.getqf("drink_drug") == 1 then
				say("[LC;580]")
				return
			end

			if pc.count_item(30252) == 0 then
				---                                                   l
				say("[LC;581]")
				say("")
				return
			end

			pc.remove_item(71035, 1)
			pc.setqf("drink_drug", 1)
		end

		when 2414.kill or 2412.kill begin
			local s = number(1, 400)
			if s <= 1 then
				pc.give_item2(30252, 1)
				send_letter("[LC;582]")
			end	
		end
		
    	when 20091.chat."[LC;583]" with pc.count_item(30252) > 0 begin
			if get_time() < pc.getqf("duration") then
				say_title("[LC;573]")
				say("[LC;584]")
				return
			end

			if pc.count_item(30252) <= 0 then
				say_title("[LC;573]")
				say("[LC;585]")
				return
			end

			say_title("[LC;573]")
			say("[LC;586]")
			pc.remove_item(30252, 1)

			if is_test_server() then 
				pc.setqf("duration", get_time() + 2) 
			else
				pc.setqf("duration", get_time()+60*60*24) -----------------------------------24 stunden nun
			end

			wait()
		
			local pass_percent

			if pc.getqf("drink_drug") == 0 then
				pass_percent = 10
			else		
				pass_percent = 60
			end
		
			local s = number(1, 100)
			if s <= pass_percent then
				if pc.getqf("collect_count") < 19 then
					local index = pc.getqf("collect_count") + 1
					pc.setqf("collect_count", index)
					say_title("[LC;573]")
					say("[LC;587]")
					say(string.format("[LC;588;%s]", 20-pc.getqf("collect_count")))
					say("[LC;589]")
					pc.setqf("drink_drug", 0)
					return
				end
				say_title("[LC;573]")
				say("[LC;594]")
				pc.setqf("collect_count",0)
				set_state(key_item)
			else
				pc.setqf("drink_drug", 0)
				say_title("[LC;573]")
				say("[LC;593]")
				return
			end
		end -- end of when
	end -- end of state

	state key_item begin
		
		when letter begin
			send_letter("[LC;595]")
			
			if pc.count_item(30228)>0 then	
				local v = find_npc_by_vnum(20091)
				if v != 0 then
					target.vid("__TARGET__", v, "")
				end
			end
		end

		when button or info begin
			if pc.count_item(30228) >0 then
				say_title("[LC;596]")
				say("[LC;597]")
				return
			end
			say_title("[LC;598]")
			say("[LC;599]")
			say_item_vnum(30228)
			say("[LC;600]")
		end
		
	
		when  2493.kill begin
			if pc.count_item(30228)==0 then
				pc.give_item2(30228, 1)
				send_letter("[LC;601]")		
			end	
		end
		
		when 2495.kill begin
			local s = number(1, 20)
				if s == 1  then
					if pc.count_item(30228)==0 then
						pc.give_item2(30228, 1)
						send_letter("[LC;601]")
					end
				end	
		end
	
		when __TARGET__.target.click  or 20091.chat."[LC;602]" with pc.count_item(30228) > 0  begin
		    target.delete("__TARGET__")
			if pc.count_item(30228) > 0 then 
				say_title("[LC;573]")
				say("[LC;603]")
				
				local s = select("[LC;590]", "[LC;591]", "[LC;592]")
				if 1 == s then
					affect.add_collect(1, 1100, 60*60*24*365*60) -- hp apply index == 1
					pc.setqf("reward", 1)
				elseif 2 == s then
					affect.add_collect(apply.DEF_GRADE_BONUS, 140, 60*60*24*365*60) 
					pc.setqf("reward", 2)
				elseif 3 == s then 
					affect.add_collect(apply.ATT_GRADE_BONUS, 60, 60*60*24*365*60) 
					pc.setqf("reward", 3)
				end
			    pc.remove_item(30228, 1)
				pc.setqf("collect_count", 0)
				pc.setqf("drink_drug", 0)
				pc.setqf("duration", 0) 
				clear_letter()
				set_quest_state("collect_quest_lv96", "run")
				set_state(__complete)
				return
			else
				say_title("[LC;573]")
				say("[LC;604]")
				return
			end
		end -- end of when
	end -- end of state

	state __complete begin
	end
end
