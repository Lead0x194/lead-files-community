quest horse_ride begin
    state start begin
	when 20349.chat."[LC;1654]" with pc.level>=10 and not pc.is_mount() begin
	    if get_global_time() - pc.getqf("Reitzeit") < 3600 then
		say("[LC;1655]")	
	    else
		local msg =
		    say_title("[LC;1558]")
		    say("[LC;1656]")
		local horse_ticket_vnum = 50083
		say(msg)
		local s= select("[LC;3457]", "[LC;1657]")
		if s==1 then
		    if pc.countitem(horse_ticket_vnum)>0 then
				if true == horse.is_summon() then
					horse.unsummon()
				end

			pc.removeitem(horse_ticket_vnum, 1)
			pc.mount(20030, 600)
			pc.setqf("Reitzeit", get_global_time())
		    else
			say("[LC;1658]")
		    end
		end
	    end
	end
    end
end


