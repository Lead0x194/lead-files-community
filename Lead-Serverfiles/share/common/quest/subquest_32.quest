
quest subquest_32 begin
	state start begin
		when login  or levelup with pc.level >= 41 and pc.level <= 43 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			
			local v = find_npc_by_vnum(20010)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7846]")
			end
		end

				
		when __TARGET__.target.click or	20010.chat."[LC;7857]" with pc.level >= 41 begin
			target.delete("__TARGET__")

			say_title("[LC;4232]")
			say("[LC;7868]")
			wait()
			say_title("[LC;4232]")
			say("[LC;7879]")
			wait()
			say_title("[LC;4232]")
			say("[LC;7890]")
		
			
			local s= select("[LC;6997]", "[LC;6998]")
			if 2==s then
				say("[LC;7893]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;4232]")
					say("[LC;7894]")
					return
				end
				say_title("[LC;4232]")
				say("[LC;7895]")
				set_state(__GIVEUP__)
				return
			end	
			say_title("[LC;4232]")

			say("[LC;7896]")
			set_state(gogogo)
		end
	end
	state gogogo begin
		
		when letter begin
			send_letter("[LC;7845]")
			if pc.getqf("sil_done") == 0 or pc.getqf("sil_done") ==2  then
				local v=find_npc_by_vnum(20021)
				if 0!=v then
					target.vid("__TARGET1__",v, "[LC;7424]")
				end
			end
			
				
			if pc.getqf("sil_done")== 1  then

				local v=find_npc_by_vnum(20003)
				if 0!=v then
					target.vid("__TARGET3__",v, "[LC;7847]")
				end
			end

		
			if pc.count_item(30144) >=100 and pc.count_item(30143)>0  then	
				
				local v=find_npc_by_vnum(9003)
				if 0==v then
					target.vid("__TARGET2__",v, "[LC;7848]")
				end

			end 
		
				if  pc.count_item(30139)>=100 and pc.count_item(30140)>0 and   pc.count_item(30141)>0  then
					set_state(all_item_done)
			end

			
		end
		
		when info or button begin
			say_title("[LC;7849]")
			say("[LC;7850]")
		end
		
		when 20021.chat."[LC;7851]" with pc.getf("subquest_32","sil_done")==0 begin
			target.delete("__TARGET1__")

				say_title("[LC;1406]")
				say("[LC;7852]")
				wait()
				say_title("[LC;1406]")
				say("[LC;7853]")
						
  			local s= select("[LC;6997]", "[LC;6998]")
  			if 2==s then
				say_title("[LC;1406]")
				say("[LC;7854]")
  				local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;1406]")
						say("[LC;7855]")
						return
					end
					say_title("[LC;1406]")
					say("[LC;7856]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;1406]")
				say("[LC;7858]")
				pc.give_item2(30159)
				pc.setqf("sil_done",1)

		end
		when 20021.chat."[LC;7851]" with  pc.getf("subquest_32","sil_done") == 1 begin	
				say_title("[LC;7859]")
				say("[LC;7860]")
				return
		end	
		when 20021.chat."[LC;7851]" with  pc.getqf("subquest_32","sil_done") == 2 begin	
				target.delete("__TARGET1__")
				say_title("[LC;7859]")
				say("[LC;7861]")
				pc.give_item2(30140)
				pc.setqf("sil_done",3)
				if  pc.count_item(30141)>0 and  pc.count_item(30139)>=100 then
					set_state(all_item_done)
				return
				end
		end
		when 20021.chat."[LC;7851]" with  pc.getqf("subquest_32","sil_done") == 3 begin	
				say_title("[LC;7859]")
				say("[LC;7862]")
				
     		end

		when 20003.chat."[LC;7863]" with pc.count_item(30159)>0 begin
			target.delete("__TARGET3__")
			say_title("[LC;7864]")
			say("[LC;7865]")
			pc.remove_item(30159)
			pc.setqf("sil_done",2)
		end


		when 9003.chat."[LC;7866]" with pc.getf("subquest_32","jewel_done")==0  begin
			target.delete("__TARGET2__")
			say_title("[LC;1004]")
			say("[LC;7867]")
			wait()
			say_title("[LC;7749]")
			say("[LC;7869]")
			say_item_vnum(30143)
			say_item_vnum(30144)
			say("[LC;7870]")
			wait()
			say_title("[LC;7749]")
			say("[LC;7871]")
  			local s= select("[LC;6997]", "[LC;6998]")
  			if 2==s then
  				say("[LC;7893]")
  				local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;7749]")
						say("[LC;7872]")
						return
					end
					say_title("[LC;7749]")
					say("[LC;7873]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;7749]")
				say("[LC;7874]")
				pc.setqf("jewel_done",1)
		end
	
		when 9003.chat."[LC;7875]" with pc.getqf("subquest_32","jewel_done")==1 and  pc.count_item(30143)>=1 and pc.count_item(30144)>=100 begin
				target.delete("__TARGET2__")				
				say_title("[LC;7749]")
				say("[LC;7876]")
				
				pc.give_item2(30141)
				
				pc.remove_item(30143 ,1) 
				pc.remove_item(30144 ,100) 
				pc.setqf("jewel_done",2)
				
				
				if pc.count_item(30140)>0  and  pc.count_item(30139)>=100 then
					set_state(all_item_done)
					return
				end
		end			
	
	
	when 114.kill or 115.kill  begin 
				local s = number(1, 100)
				if s <= 7 and pc.count_item(30144)<100  then 
					pc.give_item2(30144, 2)
				end

				local a = number(1, 100)
				if a <= 5 and pc.count_item(30143)== 0  then 
					pc.give_item2(30143, 1)
				end	

					end


	 when 634.kill  begin		
			
			local s = number(1, 100)
			if s <= 7 and pc.count_item(30139)<100  then 
				pc.give_item2(30139, 2)
			
				if pc.count_item(30139)>=100 and pc.count_item(30140)>0 and   pc.count_item(30141)>0 then
					set_state(all_item_done)
					return
				end
			end 
		end

	end	
	state all_item_done begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7849]")
			q.set_title("[LC;7877]")
			q.start()
			
			local v=find_npc_by_vnum(20010)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7878]")
			end
		end
		when info or button begin
			say("[LC;7880]")
			say("[LC;7881]")
		end
		
		when __TARGET__.target.click or	20010.chat."[LC;7882]" begin 
			if pc.count_item(30140)>=1 and pc.count_item(30141)>=1 and  pc.count_item(30139) >= 100 then
			    target.delete("__TARGET__")
				say_title("[LC;7883]")
				say("[LC;7884]")
				
				pc.remove_item(30140,1)
				pc.remove_item(30141,1)
				pc.remove_item(30139,100)
				
				pc.setqf("jewel_done",0)
				pc.setqf("sil_done",0)
				
				say_reward("[LC;7885]")
				pc.give_exp2(1100000)
				set_quest_state("levelup","run")
				
				say_reward("[LC;7886]")
				pc.give_item2(14060)
				pc.give_item2(16060)
				pc.give_item2(17060)

				set_state(THEEND)
				clear_letter()
				return
			end
			    target.delete("__TARGET__")
				say_title("[LC;7883]")
				say("[LC;7887]")
				local s= select("[LC;6997]", "[LC;6998]")
				if 2==s then
  				say("[LC;7888]")
  				local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;7883]")
						say("[LC;7889]")
						set_state(gogogo)
						return
					end
					say_title("[LC;7883]")
					say("[LC;7891]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;7883]")
				say("[LC;7892]")
				set_state(gogogo)

		end
	end
	
	
	
	state __GIVEUP__ begin
	end
    state THEEND begin
		when enter begin
			q.done()
		end
	end
end
			
