quest subquest_8 begin
	state start begin
		when login or levelup with pc.level >= 15 and pc.level <= 20 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin

			local v = find_npc_by_vnum(20003)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7193]")
			end
		end


		when __TARGET__.target.click or	20003.chat."[LC;7193]" with pc.level >= 15 begin
			target.delete("__TARGET__")

			say_title("[LC;6396]")
			say("[LC;7204]")

			local s= select("[LC;7215]", "[LC;931]")
			if 2==s then
				say("[LC;7225]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;6396]")
					say("[LC;7226]")
					return
				end
                                say_title("[LC;6396]")
				say("[LC;7227]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;6396]")
			say("[LC;7228]")
			set_state(ask_for_ricecake)

		end
	end

	state ask_for_ricecake begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7229]")
			q.set_title("[LC;7229]")
			q.start()

			local v=find_npc_by_vnum(9001)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7230]")
			end

		end

		when info or button begin
			say_title("[LC;7229]")
						say_reward("[LC;7192]")
					end

		when __TARGET__.target.click or	9001.chat."[LC;7194]" begin
			target.delete("__TARGET__")
			say_title("[LC;7195]")
			say("[LC;7196]")

			set_state(ask_for_ricecake2)
		end
	end

	state ask_for_ricecake2 begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7197]")
			q.set_title("[LC;7197]")
			q.start()

			local v= find_npc_by_vnum(20008)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7197]")
			end

		end

		when info or button begin
			say_title("[LC;7197]")
						say_reward("[LC;7198]")
					end

		when __TARGET__.target.click or	20008.chat."[LC;7194]" begin
			target.delete("__TARGET__")
			say_title("[LC;7137]")
			say("[LC;7199]")
			local s= select("[LC;7102]", "[LC;7200]")
			if 2==s then
				say("[LC;6993]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7137]")
					say("[LC;7201]")
					return
				end
				say_title("[LC;7137]")
				say("[LC;7202]")
				set_state(__GIVEUP__)
				return
			end

			say_title("[LC;7137]")
			say("[LC;7203]")
			set_state(ask_for_ricecake3)
		end
	end

	state ask_for_ricecake3 begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7205]")
			q.set_title("[LC;7205]")
			q.start()

			local v=find_npc_by_vnum(20012)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7206]")
			end

		end

		when info or button begin
			say_title("[LC;7205]")
						say("[LC;7207]")
					end

		when __TARGET__.target.click or	20012.chat."[LC;7194]" begin
			target.delete("__TARGET__")
			say_title("[LC;7208]")
			say("[LC;7209]")

			set_state(ask_for_ricecake4)
		end
	end

	state ask_for_ricecake4 begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7210]")
			q.set_title("[LC;7210]")
			q.start()

			local v=find_npc_by_vnum(20014)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7210]")
			end

		end

		when info or button begin
			say_title("[LC;7210]")
            say("[LC;7211]")
		end


		when __TARGET__.target.click or	20014.chat."[LC;7212]" begin
			target.delete("__TARGET__")
			say_title("[LC;6407]")
			say("[LC;7213]")

			set_state(report_to_girl)
		end
	end

	state report_to_girl begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7214]")
			q.set_title("[LC;7214]")
			q.start()

			local v=find_npc_by_vnum(20012)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7216]")
			end

		end

		when info or button begin
			say_title("[LC;7214]")
            say("[LC;7217]")
		end


		when __TARGET__.target.click or	20012.chat."[LC;7194]" begin
			target.delete("__TARGET__")
			say_title("[LC;7208]")
			say("[LC;7218]")

			set_state(reward_go)
		end
	end

	state reward_go begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7219]")
			q.set_title("[LC;7219]")
			q.start()

			local v=find_npc_by_vnum(20003)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7220]")
			end

		end

		when info or button begin
			say_title("[LC;7219]")
            say("[LC;7221]")
		end

		when __TARGET__target.click or	20003.chat."[LC;7222]" begin
			target.delete("__TARGET__")
			say_title("[LC;6396]")
			say("[LC;7223]")

			pc.give_exp2(26000)
			set_quest_state("levelup","run")
			pc.change_money(10000)

                        say_title("[LC;192]")
                        			say_reward("[LC;7224]")
			
			clear_letter()
			set_state(__COMPLETE__)
		end
	end
	state __GIVEUP__ begin
	end

	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
