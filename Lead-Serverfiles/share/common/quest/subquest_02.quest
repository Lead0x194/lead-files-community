quest subquest_2 begin
	state start begin
		when login or levelup with pc.level >= 7 and pc.level <= 12 begin
			set_state(information)
		end	
	end
	state information begin
		when letter begin
			local v = find_npc_by_vnum(9003)

			if v!= 0 then
				target.vid("__TARGET__", v, "[LC;7003]")
			end
		end	
		
	
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;1004]")

			say("[LC;7014]")
			set_state(ask_dinner)
		end
	end

	state ask_dinner begin
		when letter begin
			local v=find_npc_by_vnum(9002)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4197]")
			end
		end
		when letter begin
			send_letter("[LC;4197]")
		end
		when button or info begin
            say_title("[LC;44]")
						say_reward("[LC;7015]")
						say_reward("[LC;7016]")
					end

		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;4200]")
			say("[LC;7017]")
			wait()
			say_title("[LC;4200]")

			say("[LC;7018]")
			set_state(report)
		end
	end

	state report begin
		when letter begin
			local v = find_npc_by_vnum(9003)
			if v!= 0 then
				target.vid("__TARGET__", v, "[LC;7019]")
			end
		end	

		when letter begin
			send_letter("[LC;7003]")
		end

		when button or info begin
			say_title("[LC;7003]")
						say_reward("[LC;7020]")
						say_reward("[LC;7021]")
					end

		when 9002.chat."[LC;7019]" begin
			
			say_title("[LC;7002]")
			say("[LC;7004]")
		end


		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;1004]")

			say("[LC;7005]")
			local s = select( 
				"[LC;7006]",
				"[LC;7007]",
				"[LC;7008]",
				"[LC;7009]"
				)

			if s == 3 then
				say_title("[LC;1004]")

				say("[LC;7010]")
				say_title("[LC;192]")
								say_reward("[LC;7011]")

								pc.give_exp2(1000)
				set_quest_state("levelup","run")
				pc.change_money( 1500 )

				clear_letter()
				set_state(__COMPLETE__)
			elseif s == 4 then

				say("[LC;7012]")
				set_state(ask_dinner)

			else

				say("[LC;7013]")
				set_state(ask_dinner)
			end
		end
	end

	state __COMPLETE__ begin
	end
end

	
