
quest subquest_38 begin
	state start begin
		when login or levelup with pc.level >= 45 and pc.level <= 47 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
					
			local v = find_npc_by_vnum(20019)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;8034]")
			end
		end

		
		when __TARGET__.target.click or 20019.chat."[LC;8034]" with pc.level >= 16 begin
			target.delete("__TARGET__")

			say_title("[LC;4275]")
			say("[LC;8046]")
			wait()
			say_title("[LC;4275]")
			say("[LC;8048]")
			wait()
			say_title("[LC;4275]")

			say("[LC;8049]")
			local s= select("[LC;971]", "[LC;6998]")
			if 2==s then
				say("[LC;7826]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;8050]")
					say("[LC;8051]")
					return
				end
				say_title("[LC;4275]")
				say("[LC;8052]")
				set_state(__GIVEUP__)
				return
			end
			
			say_title("[LC;4275]")
			say("[LC;8053]")
			set_state(hunt_monkey)
		
		end
	end

	state hunt_monkey begin
		when enter or login or letter begin
			if pc.count_item("30136") == 0then
				send_letter("[LC;8034]")
			else
				send_letter("[LC;8035]")
			end
		end
		when info or button begin
			if pc.count_item("30136") == 0then
				say_title("[LC;8054]")
				say("[LC;8033]")
			else
				say_title("[LC;8036]")
				say("[LC;8037]")
			end
		end

		when 5121.kill or 5122.kill or 5123.kill or 5124.kill or 5125.kill begin
			local s = number(1, 100) 
			if s <= 5 and pc.count_item("30136")== 0  then
				pc.give_item2("30136", 1)
				send_letter("[LC;8035]")
				local v=find_npc_by_vnum(20019)
				if 0== v then
				else
					target.vid("__TARGET__",v, "[LC;8036]")
				end
			end

		end	

		when 20019.chat."[LC;8038]" begin
			target.delete("__TARGET__")
		
			if pc.count_item("30136") >= 1 then
				say_title("[LC;4275]")
				say("[LC;8039]")
				pc.remove_item("30136", 1)
				
				say_reward("[LC;8040]")
				pc.give_exp2(1500000)
				
				say_reward("[LC;8041]")
				pc.give_item2(70038)
				
				say_reward("[LC;8042]")
				pc.change_money(35000)
				set_state(COMPLETE)
				clear_letter()
				return
			else
				say_title("[LC;4275]")
				say("[LC;8043]")
				local s= select("[LC;8044]", "[LC;7632]")
				if 2==s then
					say("[LC;8028]")
					local a= select("[LC;2059]", "[LC;2035]")
					if  1==a then
						say_title("[LC;4275]")
						say("[LC;8045]")
						set_state(__GIVEUP__)
						return
					end
					say_title("[LC;4275]")
					say("[LC;8047]")
				end	
			end
		end
	end

	state __GIVEUP__ begin
	end
		
	state COMPLETE begin
		when enter begin
			q.done()
		end
	end
end
