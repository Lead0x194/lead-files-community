quest arena_manager begin
	state start begin
		when 20017.chat."[LC;2]" begin
			if game.get_event_flag("arena_close") > 0 then
				say_title("[LC;14]")
				say("[LC;17]")
				return
			end

			if not npc.lock() then
				say_title("[LC;14]")
				say("[LC;18]")
				return
			end

			local useMinLevel = game.get_event_flag("arena_use_min_level")

			if useMinLevel == 0 then
				useMinLevel = 25 ;
			end

			if pc.get_level() < useMinLevel then
				say_title("[LC;14]")
				say(string.format("[LC;19;%s]", useMinLevel))
				npc.unlock()
				return
			else
				say_title("[LC;14]")
				say("[LC;20]")

				local sname = input()

				if sname == "" then
				say_title("[LC;14]")
				say("[LC;21]")
					npc.unlock()
					return
				else
				say_title("[LC;14]")
				say(string.format("[LC;22;%s;%s]", pc.name, sname))
				wait("")

					local opp_vid = find_pc_by_name(sname)

					if opp_vid == 0 then
				say_title("[LC;14]")
				say(string.format("[LC;25;%s]", sname))
						npc.unlock()
						return
					elseif opp_vid == pc.get_vid() then
				say_title("[LC;14]")
				say("[LC;1]")
						npc.unlock()
						return
					end

					local old = pc. select(opp_vid , opp_vid )
					local opp_level = pc.get_level()
					pc. select(old , old )

					if opp_level < useMinLevel then
				say_title("[LC;14]")
				say(string.format("[LC;3;%s]", useMinLevel))
						npc.unlock()
						return
					end
					if not npc.is_near_vid(opp_vid, 10) then
				say_title("[LC;14]")
				say(string.format("[LC;4;%s]", sname))
						npc.unlock()
						return ;
					end

					local a = arena.is_in_arena(opp_vid)
					if a == 0 then
				say_title("[LC;14]")
				say(string.format("[LC;5;%s]", sname))
						npc.unlock()
						return ;
					end
				say_title("[LC;6]")
				say(string.format("[LC;23;%s;%s]", pc.name, sname))
					local agree = confirm(opp_vid, string.format("[LC;24;%s;%s]", sname, pc.name), 30)
					if agree!= CONFIRM_OK then
				say_title("[LC;14]")
				say(string.format("[LC;7;%s]", sname))
						npc.unlock()
						return
					end

					s = arena.start_duel(sname, 3)
			
					if s == 0 then
				say_title("[LC;14]")
				say("[LC;8]")
					elseif s == 2 then
				say_title("[LC;14]")
				say("[LC;9]")
					elseif s == 3 then
				say_title("[LC;14]")
				say("[LC;10]")
					end
				end
			end
			npc.unlock()
		end

		when 20017.chat."[LC;11]" begin
			local g = arena.get_duel_list()
			local arena_name = {}
			local arena_observer = {}

			table.foreachi(g,
				function(n, p)
					arena_name[n] = string.format("[LC;12;%s;%s]", p[1], p[2])
					arena_observer[n] = { p[3], p[4], p[5] }
				end
			)

			table.insert(arena_name, "[LC;13]")
			table.insert(arena_observer, 0)

			local count = table.getn(g)
			if count == 0 then
			say_title("[LC;14]")
			say("[LC;15]")
			return ;
			else
			say_title("[LC;14]")
			say(string.format("[LC;16;%s]", count))
			wait()
			end

			if table.getn(g)!= 0 then
				local s = select_table(arena_name)

				if table.getn(arena_observer) == s then
					return ;
				end

				if table.getn(arena_observer) >= s then
					arena.add_observer(arena_observer[s][1], arena_observer[s][2], arena_observer[s][3])
				end
			end
		end
	end
end


