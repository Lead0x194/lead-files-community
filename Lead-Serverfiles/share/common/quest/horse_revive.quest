quest horse_revive begin
	state start begin
		when 20349.chat."[LC;1641]" with horse.get_grade()==3 and horse.is_dead() and pc.countitem("50059")<1 begin
			say_title("[LC;1558]")
			say("[LC;1646]")
			if pc.countitem("50058")>=1 then
				say_title("[LC;1558]")
				say("[LC;1647]")
			elseif pc.countitem("50057")>=1 then
				say_title("[LC;1558]")
				say("[LC;1648]")
			end
		end
		when 20349.chat."[LC;1641]" with horse.get_grade()==3 and horse.is_dead() and pc.countitem("50059")>=1 begin
			say_title("[LC;1558]")
			say("[LC;1649]")
			wait()
			say_title("[LC;1558]")
			say("[LC;1650]")
			horse.summon()
						wait()
			say_title("[LC;1558]")
			say("[LC;1651]")
			if pc.countitem("50059")>=1 then
				pc.removeitem("50059", 1)
				horse.revive()
			end
		end
		when 20349.chat."[LC;1641]" with horse.get_grade()==2 and horse.is_dead() and pc.countitem("50058")<1 begin
			say_title("[LC;1558]")
			say("[LC;1652]")
			if pc.countitem("50059")>=1 then
				say_title("[LC;1558]")
				say("[LC;1653]")
			elseif pc.countitem("50057")>=1 then
				say_title("[LC;1558]")
				say("[LC;1648]")
			end
		end

		when 20349.chat."[LC;1640]" with horse.get_grade()==2 and horse.is_dead() and pc.countitem("50058")>=1 begin
			say_title("[LC;1558]")
			say("[LC;1642]")
			wait()
			say_title("[LC;1558]")
			say("[LC;1650]")
			horse.summon()
						wait()
			say_title("[LC;1558]")
			say("[LC;1651]")
			if pc.countitem("50058")>=1 then
				pc.removeitem("50058", 1)
				horse.revive()
			end
		end

		when 20349.chat."[LC;1640]" with horse.get_grade()==1 and horse.is_dead() and pc.countitem("50057")<1 begin
			say_title("[LC;1558]")
			say("[LC;1643]")
			if pc.countitem("50059")>=1 then
				say_title("[LC;1558]")
				say("[LC;1653]")
			elseif pc.countitem("50058")>=1 then
				say_title("[LC;1558]")
				say("[LC;1644]")
			end
		end
		when 20349.chat."[LC;1641]" with horse.get_grade()==1 and horse.is_dead() and pc.countitem("50057")>=1 begin
			say_title("[LC;1558]")
			say("[LC;1645]")
			wait()
			say_title("[LC;1558]")
			say("[LC;1650]")
			horse.summon()
						wait()
			say_title("[LC;1558]")
			say("[LC;1651]")
			if pc.countitem("50057")>=1 then
				pc.removeitem("50057", 1)
				horse.revive()
			end
		end	
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end

