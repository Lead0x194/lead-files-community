quest new_quest_lv28 begin

	state start begin
		when login or levelup with pc.get_level() >= 28 begin
			set_state(information)
		end
	end
	-- yu-hwan is worried about ah-yu, want player to help her -----------------------------------------
	state information begin
		when login or enter begin
			local v=find_npc_by_vnum(20017) -- Yu-Hwan
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;5759]")
			end
			send_letter("[LC;5770]") 
			q.start()
			q.set_title("[LC;5770]")
		end
		
		when button or info begin
			say_title("[LC;5770]")
			say("[LC;5760]")
		end
		
		when 20017.chat."[LC;5761]" begin
			target.delete("__TARGET__")
			say_title("[LC;5766]") -- yellow text headline
			say("[LC;5767]") -- white font text
			q.done()
			local doquest = select("[LC;5764]", "[LC;7304]", "[LC;6200]")
			if doquest ==1 then 
				set_state(ask_ahyu)
			elseif doquest == 3 then
				say("[LC;7170]")
				local abortquest = select("[LC;7173]", "[LC;7174]")
				if abortquest == 1 then
					set_state(__GIVEUP__)
				else
					say_title("[LC;5766]") -- yellow text headline
					say("[LC;7288]")
					return
				end
			else
				say_title("[LC;5766]") -- yellow text headline
				say("[LC;7288]")
				return
			end
		end
		
	end
	-- ah-yu tells player, that she is blackmailed by yang-shin -----------------------------------------
	state ask_ahyu begin
		when enter or login begin
			send_letter("[LC;5761]") -- EDIT added by Arne 22sept09, Reason: no quest, no letter
			q.start() -- EDIT added by Arne 22sept09, Reason: no quest, no letter
			q.set_title("[LC;5761]") -- EDIT added by Arne 22sept09, Reason: no quest, no letter
			local v=find_npc_by_vnum(20003) -- Ah-Yu
			if 0==v then
			else
				target.vid("__TARGET2__", v, "[LC;5761]")
			end
			new_quest_lv28_neededAmountDrop1 = 1
			new_quest_lv28_dropProb1 = 100
			new_quest_lv28_mob1 = 193 -- bera
			new_quest_lv28_drop1 = 30174 -- Bärentatze
		end
		
		-- BEGIN EDIT added by Arne 22sept09, Reason: no quest, no letter
		when button or info begin
			say_title("[LC;5761]")
			say("[LC;5762]")
			say("")
			say(string.format("[LC;5763;%s]", get_map_name_by_number(1)))		
		end
		-- END EDIT
		
		when 20003.chat."[LC;5761]" begin
			target.delete("__TARGET2__")
			say_title("[LC;5765]")
			say("[LC;5768]")
		wait()
			say_title("[LC;5765]")
			say("[LC;5769]")
		wait()
			say_title("[LC;5765]")
			say(nil)
			say_reward(string.format("%s x", new_quest_lv28_neededAmountDrop1))
			say_item_vnum(new_quest_lv28_drop1) -- icon of item
			say_reward("[LC;5776]")
			say(mob_name(new_quest_lv28_mob1))
			set_state(hunting)
			q.done()--EDIT added by Arne 22Sept09, Reason: see above
		end
	end
	-- player has to hunt for bearfootskin+ because yang-shin wants it from ah-yu ----------------------
	state hunting begin
		when enter or login begin
			new_quest_lv28_neededAmountDrop1 = 1
			new_quest_lv28_dropProb1 = 100
			new_quest_lv28_mob1 = 193 -- bera
			new_quest_lv28_drop1 = 30174 -- Bärentatze
			send_letter("[LC;5783]") -- EDIT added by Arne 22sept09, Reason: no letter
			q.start()
			q.set_title("[LC;5783]")			
			notice_multiline("[LC;5771]", notice)
		end
		---------------- bärenfusshaut+ ------------------------------------------------------
		-- kill a 193#Bera
		when 193.kill begin
			if pc.count_item(new_quest_lv28_drop1) < new_quest_lv28_neededAmountDrop1 then
				if math.random(1,100) <= new_quest_lv28_dropProb1 then -- probability if s.th. drops
					
					pc.give_item2(new_quest_lv28_drop1) -- bärenfusshaut+
					notice("[LC;5772]")
					if new_quest_lv28_neededAmountDrop1 == pc.count_item(new_quest_lv28_drop1) then
						q.done()
						notice_multiline("[LC;5773]", notice)
						set_state(goto_yangshin)
					end		
				else
					notice("[LC;5774]")
				end
			end
		end
		-- BEGIN EDIT added by Arne 22sept09, Reason: no quest, no letter
		when info or button begin
			say_title("[LC;5783]")
			say("[LC;5777]")
			if new_quest_lv28_neededAmountDrop1 >  pc.count_item(new_quest_lv28_drop1) then
				say_reward(string.format("[LC;5778;%s]", new_quest_lv28_neededAmountDrop1-pc.count_item(new_quest_lv28_drop1), item_name(new_quest_lv28_drop1), mob_name(new_quest_lv28_mob1)))
			end
		end
		--END EDIT
		
	end
	------  bring bearfootskin+ to yangshin ------------------------------------------------------------------------------------------------------
	state goto_yangshin begin
		when enter or login begin
			new_quest_lv28_neededAmountDrop1 = 1
			new_quest_lv28_dropProb1 = 100
			new_quest_lv28_mob1 = 193 -- bera
			new_quest_lv28_drop1 = 30174 -- Bärentatze
		-- BEGIN EDIT added by Arne 22sept09, Reason: no quest, no letter
			send_letter("[LC;5783]")
			q.start()
			q.set_title("[LC;5783]")	
			local v=find_npc_by_vnum(20019) -- Yang-Shin
			if 0==v then
			else
				target.vid("__TARGET5__", v, "[LC;5779]")
			end
		end

		when info or button begin
		
			say_title("[LC;5783]")
			say("[LC;5780]")
			say("")
			say(string.format("[LC;5781;%s]", get_map_name_by_number(3)))
		end
		--END EDIT
		
		when 20019.chat."[LC;5783]" begin
			target.delete("__TARGET5__")
			say_title("[LC;5782]")
			if pc.count_item(new_quest_lv28_drop1) >= new_quest_lv28_neededAmountDrop1 then 
				say("[LC;5785]")
				say("[LC;5786]")
				pc.remove_item(new_quest_lv28_drop1, pc.count_item(new_quest_lv28_drop1))
				set_state(back_to_ahyu)
				return
			else
				-- this happens, if the player sold or dropped needed items:
				say("[LC;5787]")
				say("[LC;5788]" )
				set_state(hunting)
			end
		end
	end
	-- tell ah-yu that yang-shin will stop to blackmail her---------------------------------------------
	state back_to_ahyu begin
			when login or enter begin
			new_quest_lv28_neededAmountDrop1 = 1
			new_quest_lv28_dropProb1 = 100
			new_quest_lv28_mob1 = 193 -- bera
			new_quest_lv28_drop1 = 30174 -- Bärentatze
			-- BEGIN EDIT added by Arne 22sept09, Reason: no quest, no letter
			send_letter("[LC;5783]")
			q.start()
			q.set_title("[LC;5783]")			
			new_quest_lv28_RewardXP=500000
			new_quest_lv28_RewardXP2=850000
			new_quest_lv28_RewardCash=40000		
			-- END EDIT
			local v=find_npc_by_vnum(20003) -- Ah-Yu
			if 0==v then
			else
				target.vid("__TARGET4__", v, "[LC;5761]")
			end
		end
		
		-- BEGIN EDIT added by Arne 22sept09, Reason: no quest, no letter
		when info or button begin
			say_title("[LC;5783]")
			say("[LC;5789]")
			say("")
			say(string.format("[LC;5763;%s]", get_map_name_by_number(1)))		
		end
		
		when 20003.chat."[LC;5783]" begin
			target.delete("__TARGET4__")
			say_title("[LC;5765]") -- yellow text headline
			say("[LC;5790]") -- white font text
			-- select to options buttons:
			local b= select("[LC;5791]", "[LC;5792]")
			-- option 1: the player takes the money (not much) and gets some xp
			if b==1 then
                say_title("[LC;5765]")
				say("[LC;5793]")
				say_reward(string.format("[LC;5796;%s]", new_quest_lv28_RewardXP))
				say_reward(string.format("[LC;5795;%s]", new_quest_lv28_RewardCash))
				q.done() -- EDIT added by Arne 22Sept09, Reason: see above
				pc.give_exp2( new_quest_lv28_RewardXP )-- EDIT added by Arne 22Sept09, Reason: keep balance values in variables
				pc.change_money( new_quest_lv28_RewardCash )-- EDIT added by Arne 22Sept09, Reason: keep balance values in variables
				set_state(__COMPLETE__)
			end	
			-- option 2: the player refuses to take the money, gets more EXP and ah-yus gratitude
			if b==2 then
                say_title("[LC;5765]")
				say("[LC;5794]")
				pc.give_exp2(new_quest_lv28_RewardXP2)-- EDIT added by Arne 22Sept09, Reason: keep balance values in variables
				say_reward(string.format("[LC;5796;%s]", new_quest_lv28_RewardXP2))
				q.done() -- EDIT added by Arne 22Sept09, Reason: see above
				set_state(__COMPLETE__)
			end
		end
	end
	------  give up ------------------------------------------------------------------------------------------------------
	state __GIVEUP__ begin
	end
	------  complete ------------------------------------------------------------------------------------------------------
	state __COMPLETE__ begin
	end
end 
