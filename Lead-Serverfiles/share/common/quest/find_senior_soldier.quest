quest find_senior_soldier begin
    state start begin
		when 20300.chat."[LC;973]" or 20301.chat."[LC;973]" or 20302.chat."[LC;973]" or 20303.chat."[LC;973]" or 20304.chat."[LC;973]" or 20305.chat."[LC;973]" or 20306.chat."[LC;973]" or 20307.chat."[LC;973]" or 20320.chat."[LC;973]" or 20321.chat."[LC;973]" or 20322.chat."[LC;973]" or 20323.chat."[LC;973]" or 20324.chat."[LC;973]" or 20325.chat."[LC;973]" or 20326.chat."[LC;973]" or 20327.chat."[LC;973]" or 20340.chat."[LC;973]" or 20341.chat."[LC;973]" or 20342.chat."[LC;973]" or 20343.chat."[LC;973]" or 20344.chat."[LC;973]" or 20345.chat."[LC;973]" or 20346.chat."[LC;973]" or 20347.chat."[LC;973]" with pc_is_novice() and npc_is_same_empire() and npc_is_same_job() and pc.get_level()<=10 begin
			if not next_time_is_now() then
				say_title("[LC;991]")
				say("[LC;993]")
				else
				say("[LC;994]")
				wait()
				say_title("[LC;991]")
				say("[LC;995]")
				find_senior_soldier.save_target_cond()
				next_time_set(time_hour_to_sec(1), 10)
				set_state(find)
			end
		end
    end
    state failure begin
		when letter begin
			send_letter("[LC;996]")
		end
		when button or info begin
			----"12345678901234567890123456789012345678901234567890"|
			say_title("[LC;44]")
			say("[LC;997]")
			say_reward("[LC;998]")
			restart_quest()
		end
    end
    state find begin
		when letter begin
			local v=find_senior_soldier.find_target()
			test_chat(string.format("[LC;999;%s]", v))
			if v==0 then 
			set_state(failure)
			else
			target.vid("__TARGET__", v, "[LC;972]") 
			send_letter("[LC;972]")
			end
		end
		when button or info begin
			-----------"12345678901234567890123456789012345678901234567890"|
			say_title("[LC;974]")
					say_reward("[LC;975]")
				end
		when __TARGET__.target.die begin
			----------"12345678901234567890123456789012345678901234567890"|
			say_title("[LC;44]")
					say_reward("[LC;976]")
					say_reward("[LC;998]")
					restart_quest()
		end
		when __TARGET__.target.click begin
			----------"12345678901234567890123456789012345678901234567890"|
			say_title("[LC;977]")
					say_reward("[LC;978]")
			say("[LC;979]")
			target.delete("__TARGET__")
			find_senior_soldier.clear_target_cond()
			set_state(reward)
		end
    end
    state reward begin
		when letter begin
			send_letter("[LC;980]")
		end
		when button begin
			----------"12345678901234567890123456789012345678901234567890"|
			say_title("[LC;981]")
			say("[LC;982]")

			local funcList={
			function() find_senior_soldier.apply_affect("[LC;983]", apply.MAX_HP, 100) end,
			function() find_senior_soldier.apply_affect("[LC;984]", apply.HP_REGEN, 50) end,
			function() find_senior_soldier.apply_affect("[LC;985]", apply.STR, 5) end,
			function() find_senior_soldier.apply_affect("[LC;986]", apply.CON, 5) end,
			function() find_senior_soldier.apply_affect("[LC;987]", apply.CRITICAL_PCT, 10) end,
			function() find_senior_soldier.apply_affect("[LC;988]", apply.ATT_SPEED, 10) end,
			function() find_senior_soldier.apply_affect("[LC;989]", apply.ATTBONUS_ANIMAL, 10) end,
			}	
			table_get_random_item(funcList)()
			restart_quest()
		end
    end
    state __FUNC__ begin
		function clear_target_cond()
			pc.setqf("Ziel_Beding", 0)
		end
		function save_target_cond()
			test_chat(string.format("[LC;990;%s]", npc_get_job()))
			pc.setqf("Ziel_Beding", npc_get_job())
		end
		function find_target()
			return find_pc_cond(5, 100, pc.getqf("Ziel_Beding"))
		end
		function apply_affect(name, type, value)
			say_title("[LC;29]")
					say_reward(name)
			say_reward("[LC;992]")
					affect.add(type, value, 5*60)
		end
    end
end

