quest find_brother_article begin
    state start begin
	when 20006.chat."[LC;932]" with pc.get_level()>=23 and pc.get_level()<=26 begin
	    	say_title("[LC;944]")
		say("[LC;955]")
		wait()
		say_pc_name()
		say("[LC;966]")
		wait()
		say_title("[LC;944]")
		say("[LC;967]")
		wait()
		say_title("[LC;968]")
		say("[LC;969]")
		say_reward("[LC;970]")
				local s= select("[LC;971]", "[LC;931]")
		if 1==s then
			say_pc_name()
		    say("[LC;933]")
		    set_state(accept)
		elseif 2==s then
			say_pc_name()
		    say("[LC;934]")
		end
	end
    end
    state accept begin
	when letter begin
	    send_letter("[LC;935]")
	end
	when button or info begin
		say_title("[LC;935]")
		say("[LC;936]")
	end
	when 20006.chat."[LC;937]" with pc.count_item(30032)==0 begin
	    say_title("[LC;968]")
	    say("[LC;938]")
	    local s= select("[LC;2105]", "[LC;939]")
	    if 1==s then
			say_title("[LC;29]")
			say_reward("[LC;940]")
		else
			say_pc_name()
			say("[LC;941]")
			wait()
			say_title("[LC;968]")
			say("[LC;942]")
			say_reward("[LC;943]")
			local s= select("[LC;945]", "[LC;939]")
			if 1==s then
				say_pc_name()
				say("[LC;946]")
			elseif 2==s then
				say_title("[LC;968]")
				say("[LC;947]")
				set_state(__FAILURE__)
			end
	    end
	end
	when 20006.chat."[LC;948]" with pc.count_item(30032)>=1 begin
	    say_title("[LC;968]")
	    say("[LC;949]")
	    say_reward("[LC;950]")

	    pc.remove_item(30032)
	    set_state(reward)
	end
    end
    state reward begin
	when letter begin
	    send_letter("[LC;951]")
	end
	when button begin
	    say_title("[LC;951]")
	    say("[LC;952]")
	    wait()
	    say("[LC;953]")
	    say_reward("[LC;954]")
	    	    set_state(repair)
	end
    end
    state repair begin
	when letter begin
	    send_letter("[LC;956]")

	end
	when button or info begin
	    say_title("[LC;956]")
	    say("[LC;957]")
	end
	when letter begin
	    local v=find_npc_by_vnum(20016)
	    if v!=0 then
		target.vid("__TARGET__", v, "[LC;958]")
	    end
	end
	when __TARGET__.target.click or 20016.chat."[LC;959]" begin
	    target.delete("__TARGET__")

	    say_title("[LC;27]")
	    say("[LC;960]")
	    wait()
	    say_title("[LC;27]")
	    say("[LC;961]")
		
	    local r=number(1, 4)
	    if 1==r then
		say_reward("[LC;962]")
		pc.give_item2(00062)
	    elseif 2==r then
		say_reward("[LC;963]")
		pc.give_item2(00072)
	    elseif 3==r then
		say_reward("[LC;964]")
		pc.give_item2(00082)
	    elseif 4==r then
		say_reward("[LC;965]")
		pc.give_item2(00092)
	    end
	    clear_letter()
	    set_state(__COMPLETE__)
	    q.done()
	end
    end
    state __COMPLETE__ begin
    end
    state __FAILURE__ begin
    end
end


