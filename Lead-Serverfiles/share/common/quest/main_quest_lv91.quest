		when SCHOLAR.chat."[LC;4915]" with pc.count_item(ITEM5_1) >= ITEM5_1_NEEDED begin
			target.delete("__TARGET__")
			pc.remove_item(ITEM5_1, pc.count_item(ITEM5_1))
			
			say_title(mob_name(SCHOLAR))
			say("[LC;4924]")
			wait()
			
			say_title(pc.getname())
			say("[LC;4925]")
			wait()
			
			say_title(mob_name(SCHOLAR))
			say("[LC;4926]")
			wait()
			
			say_title(locale.reward)
			say_reward(string.format ("[LC;4537;%d]", REWARD5_EXP))
			--say_reward(string.format ("[LC;4538;%d]", REWARD5_GOLD))
			say_reward(string.format ("[LC;4540;%s]", item_name(REWARD5_ITEM1),REWARD5_ITEM1_COUNT,locale.count_postfix))
			say("")
			say_title("[LC;4930]")
			
			pc.give_exp2(REWARD5_EXP)
			--pc.change_money(REWARD5_GOLD)
			pc.give_item2(REWARD5_ITEM1, REWARD5_ITEM1_COUNT)
			
			clear_letter()
			set_quest_state ("main_quest_lv92", "state0")
			set_state (__COMPLETE__)
		end
	end
	state state5_3 begin
	
		when letter begin
			send_letter("[LC;4915]")
			
			local v = find_npc_by_vnum(SCHOLAR)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(SCHOLAR))
			end
		end
		
		when button or info begin
			say_title("[LC;4915]")
			say("[LC;4927]")
			
		end
		
		when MOB5_1.click begin
			if pc.count_item(ITEM5_1) < ITEM5_1_NEEDED then
				pc.give_item2(ITEM5_1, 1)
				notice_multiline("[LC;4923]",notice)
			end
		end
		
		when SCHOLAR.chat."[LC;4915]" with pc.count_item(ITEM5_1) >= ITEM5_1_NEEDED begin
			target.delete("__TARGET__")
			pc.remove_item(ITEM5_1, pc.count_item(ITEM5_1))
			
			say_title(mob_name(SCHOLAR))
			say("[LC;4924]")
			wait()
			
			say_title(pc.getname())
			say("[LC;4925]")
			wait()
			
			say_title(mob_name(SCHOLAR))
			say("[LC;4926]")
			wait()
			
			say_title(locale.reward)
			say_reward(string.format ("[LC;4537;%d]", REWARD5_EXP))
			--say_reward(string.format ("[LC;4538;%d]", REWARD5_GOLD))
			say_reward(string.format ("[LC;4540;%s]", item_name(REWARD5_ITEM1),REWARD5_ITEM1_COUNT,locale.count_postfix))
			say("")
			say_title("[LC;4930]")
			
			pc.give_exp2(REWARD5_EXP)
			--pc.change_money(REWARD5_GOLD)
			pc.give_item2(REWARD5_ITEM1, REWARD5_ITEM1_COUNT)
			
			clear_letter()
			set_quest_state ("main_quest_lv92", "state0")
			set_state (__COMPLETE__)
		end
	end
	
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
