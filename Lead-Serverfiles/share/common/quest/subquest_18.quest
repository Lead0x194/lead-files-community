quest subquest_18 begin
	state start begin
		when login or levelup with pc.level >= 10 and pc.level <=12  begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20002)
			if 0!=v then
			target.vid("__TARGET__", v, "[LC;7440]")
			end
		end
		when __TARGET__.target.click or	20002.chat."[LC;7440]"  begin
			target.delete("__TARGET__")
			say_title("[LC;7453]")
			say("[LC;7464]")

			local s=select(
				"[LC;7467]",
				"[LC;7468]"
				)

			if 2==s then
				say("[LC;7469]")
				local a=  select("[LC;2059]", "[LC;2035]")
				if 2==a then
					
					say_title("[LC;7453]")
					say("[LC;7470]")
					return
				end
					say_title("[LC;7453]")
					say("[LC;7471]")
				set_state(__GIVEUP__)
				return
			end
				say_title("[LC;7453]")
				say("[LC;7472]")
			set_state(find_soonyougil)

		end
	end
	state find_soonyougil begin
		when letter begin
			send_letter("[LC;7473]")
			
			local v=find_npc_by_vnum(20023)
			if 0!=v then
				target.vid("__TARGET2_", v, "[LC;7473]")
			end

		end
		when button or info begin
			say_title("[LC;7474]")
			say("[LC;7439]")
		end
		when 20002.chat."[LC;7441]"  begin
			say_title("[LC;7453]")
			say("[LC;7442]")
		end
		when  __TARGET2__target.click or	20023.chat."[LC;7443]"  begin
			target.delete("__TARGET2_")
			say_title("[LC;44]")
			say("[LC;7444]")
			wait()
			say_title("[LC;7093]")
			say("[LC;7445]")
			local s=select(
				"[LC;7446]",
				"[LC;7447]"
				)
			
			if 1==s then
				say_title("[LC;7093]")
				say("[LC;7448]")
				set_state(report_true)
			elseif 2==s then
				say_title("[LC;7093]")
				say("[LC;7449]")
				set_state(report_false)
			end
		end
	end
	state report_false begin
		when letter begin
			send_letter("[LC;7450]")
			local v=find_npc_by_vnum(20002)
			if v!=0 then
				target.npc("__TARGET__", v, "[LC;7450]")
			end
		end
		when button or info begin
			say_title("[LC;7450]")
			say("[LC;7451]")
		end

		when __TARGET__.target.click or	20002.chat."[LC;7452]" begin
			target.delete("__TARGET__")
			say_title("[LC;7453]")
			say("[LC;7454]")
			set_state(come_back)	
		end
	end
	state come_back begin
		when letter begin
			send_letter("[LC;7455]")
			local v=find_npc_by_vnum(20023)
			if v!=0 then
				target.npc("__TARGET__", v, "[LC;7455]")
			end
		end
		when button or info begin
			say_title("[LC;7455]")
			say("[LC;7456]")
		end
		when __TARGET__.target.click or	20023.chat."[LC;7457]" begin
		   	target.delete("__TARGET__")
			say_title("[LC;7093]")
			say("[LC;7458]")
			say_title("[LC;3558]")
						say_reward("[LC;7459]")
			pc.give_exp2(7000)
			say_reward("[LC;7460]")
			pc.change_money(10000)

			clear_letter()
			set_state(__COMPLETE__)
		end
	end

	state report_true begin
		when letter begin
			send_letter("[LC;7450]")
			local v=find_npc_by_vnum(20002)
			if v!=0 then
				target.npc("__TARGET__", v, "[LC;7450]")
			end
		end
		
		when button or info begin
			say_title("[LC;7450]")
			say("[LC;7461]")
		end
		when 20023.chat."[LC;7462]" begin 
			say_title("[LC;7093]")
			say("[LC;7463]")
		end
		when __TARGET__.target.click or	20002.chat."[LC;7465]" begin
			target.delete("__TARGET__")
			say_title("[LC;6402]")
			say("[LC;7466]")
			say_title("[LC;3558]")
						say_reward("[LC;7459]")
			pc.give_exp2(7000)
			say_reward("[LC;7460]")
			pc.change_money(10000)
		
			clear_letter()
			set_state(__COMPLETE__)
		end
	end
				
	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end

end
