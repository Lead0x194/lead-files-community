quest reset_scroll begin
    state start begin
		when 71002.use or 76001.use  begin
			say_title("[LC;6772]")

			say("[LC;6779]")
			local s =  select("[LC;2059]", "[LC;2035]")
			if 2 == s then
				return
			end

			say_title("[LC;6780]")

			say("[LC;6781]")
			local c =  select("[LC;2059]", "[LC;2035]")
			if 2 == c then
				return
			end

			char_log(0, "RESET_ALL", "USE_ITEM(71002 or 76001)")
            
			item.remove()

			char_log(0, "RESET_ALL", "RESET_STAT_POINTS")
			pc.reset_point()
			char_log(0, "RESET_ALL", "RESET_SKILL_POINTS")
			pc.clear_skill()
			pc.set_skill_group(0)
			char_log(0, "RESET_ALL", "RESET_END")
		end

		when 71003.use begin
			say_title("[LC;6782]")
            say("[LC;6783]")
            wait()

			local result = BuildSkillList(pc.get_job(), pc.get_skill_group())

			local vnum_list = result[1]
			local name_list = result[2]

			if table.getn(vnum_list) < 2 then
				say_title("[LC;6782]")
				say("[LC;6784]")
				return
			end
	
			say_title("[LC;6782]")
			say("[LC;6785]")
			local i = select_table(name_list)

			if table.getn(name_list) == i then
			return
			end

			local name = name_list[i]
			local vnum = vnum_list[i]

			say_title("[LC;6782]")
			
			say("[LC;6786]")
			say_reward(string.format("[LC;6771;%s]", name))

			local s =  select("[LC;2059]", "[LC;2035]")
			if 2 == s then
				return
			end

			say_title("[LC;6773]")

			say("[LC;6774]")
			local c =  select("[LC;2059]", "[LC;2035]")

			if 2 == c then
				return
			end

			char_log(0, "RESET_ONE_SKILL", "USE_ITEM(71003)")
			pc.remove_item(71003)

			char_log(0, "RESET_ONE_SKILL", "RESET_SKILL["..name.."]")
			pc.clear_one_skill(vnum)

			char_log(0, "RESET_ONE_SKILL", "APPLY_17MASTER_BONUS")
			pc.setqf("force_to_master_skill", 1)

			say_title("[LC;6776]")
			say_reward(string.format("[LC;6777;%s]", name))
			end
	end
end
