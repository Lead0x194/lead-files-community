			pc.change_money(REWARD1_GOLD)
			pc.give_item2(REWARD1_ITEM1, REWARD1_ITEM1_COUNT)
			pc.give_item2(REWARD1_ITEM2, REWARD1_ITEM2_COUNT)
				
