			say_reward(string.format ("[LC;4540;%s]", item_name(REWARD1_ITEM1),REWARD1_ITEM1_COUNT,locale.count_postfix))
			say_reward(string.format ("[LC;4540;%s]", item_name(REWARD1_ITEM2),REWARD1_ITEM2_COUNT,locale.count_postfix))
