quest couple_ring begin
    state start begin
	when 9006.chat."[LC;606]" with pc.get_level()>=25 begin

	    say_title("[LC;617]")

	    say("[LC;624]")
	    local s= select("[LC;625]", "[LC;626]")

	    if s==1 then
		say_title("[LC;617]")
		say("[LC;627]")
		set_state(kill)
	    elseif s==2 then
		say_title("[LC;617]")
		say("[LC;628]")
	    end
	end
    end
    state kill begin
	when enter begin
	    pc.setqf("kill_count", 0)
	end
	when leave begin
	    pc.setqf("kill_count", 0)
	    q.done()
	end
	when letter begin
	    q.set_counter("[LC;629]", couple_ring.get_rest_count());
	end
	when 394.kill begin
	    local kill_count=pc.getqf("kill_count")+1
	    pc.setqf("kill_count", kill_count)	
	    q.set_counter("[LC;629]", couple_ring.get_rest_count());

	    if couple_ring.is_completed() then
		say_title("[LC;630]")
		say("[LC;631]")
		set_state(report)
	    end
	end
	function get_rest_count()
	    return 30-pc.getqf("kill_count")
	end
	function is_completed()
		return pc.getqf("kill_count")>=30 
	end

	when letter begin
	    send_letter("[LC;605]")
	end
	when button or info begin
	    say_title("[LC;44]")
		say("[LC;607]")
	    say_reward(string.format("[LC;608;%s]", couple_ring.get_rest_count()))
	end
	when 9006.chat."[LC;606]" begin
	    say_title("[LC;617]")
	    say("[LC;609]")
	    local s= select("[LC;2105]", "[LC;1891]")
	    if s==1 then
		say_title("[LC;617]")
		say("[LC;610]")
	    else
		say_title("[LC;617]")
		say("[LC;611]")
		wait()
		say_title("[LC;44]")
		say("[LC;612]")
		local s =  select("[LC;613]", "[LC;1891]")
		if s==1 then
		say_title("[LC;617]")
		say("[LC;614]")
		elseif s==2 then
		say_title("[LC;617]")
		say("[LC;615]")
		set_state(start)
		    q.done()
		end
	    end
	end
    end
    state report begin
	when letter begin
	    send_letter("[LC;616]")
	end
	when button or info begin
	    say_title("[LC;44]")
	    say("[LC;618]")
	end
	when 9006.chat."[LC;619]" begin
	    say_title("[LC;617]")
	    say("[LC;620]")
	    say_reward("[LC;621]")
	    say_item("[LC;622]", 70301, "[LC;623]")
	    pc.give_item2(70301)
	    set_state(__COMPLETE__ )
	    q.done()
	end
    end
    state __COMPLETE__ begin
    end
    state failure begin
    end
end

