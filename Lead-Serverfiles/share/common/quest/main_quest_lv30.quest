quest main_quest_lv30 begin
	state start begin
	end
	state run begin
		when login or levelup or enter begin
			if pc.get_level() >= 30 then 				
				setstate( gotoeUriel )		
			end
		end
	end
	state gotoeUriel begin
		when letter begin
			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4214]")
			end
		end
		when letter begin
			send_letter("[LC;4221]")
		end
		when info or  button begin
			say_title("[LC;4221]")
			say("[LC;4222]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4224]")
   			wait()
			say_title("[LC;4223]")
			say("[LC;4225]")
			
			setstate( clickstone )
			q.done()
		end
	end
	state clickstone begin
		when letter begin
			local v=find_npc_by_vnum(20352)
			if 0==v then
			else
				target.vid("__TARGET1__", v, "[LC;4227]")
			end
		end
		when letter begin
			send_letter("[LC;4221]")
		end
		when info or  button begin
			say_title("[LC;4221]")
			say("[LC;4228]")
		end
		when __TARGET1__.target.click begin
			target.delete("__TARGET1__")
			say_title("[LC;4221]")
			say("[LC;4213]")
			setstate(gotoeUriel2)
		end
	end
	state gotoeUriel2 begin
		when letter begin
			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4214]")
			end
		end
		when letter begin
			send_letter("[LC;4221]")
		end
		when info or button begin
			say_title("[LC;4221]")
			say("[LC;4215]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
		   	say("[LC;4216]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4217]")

			set_state (clickplace)
		end
	end
	state clickplace begin
		when letter begin
			local v=find_npc_by_vnum(20353)
			if 0==v then
			else
				target.vid("__TARGET2__", v, "[LC;4218]")
			end
		end
		when letter begin
           		send_letter("[LC;4221]")
		end
		when info or  button begin
			say_title("[LC;4221]")
			say("[LC;4219]")
		end
		when __TARGET2__.target.click begin
			target.delete("__TARGET2__")
			say_title("[LC;4221]")
			say("[LC;4213]")
			setstate(gotoeUriel3)
			q.done()
		end
	end
	state gotoeUriel3 begin
		when letter begin
			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4214]")
			end
		end
		when letter begin
			send_letter("[LC;4221]")
		end
		when info or  button begin
			say_title("[LC;4221]")
			say("[LC;4215]")
		end
		when __TARGET__.target.click begin
			pc.give_exp2( 420000 )
			pc.change_money( 20000 )
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4220]")
			say_title("[LC;3558]")
			say_reward("[LC;4226]")
			clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv32","run")
			q.done()
		end
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end


