quest main_quest_lv32 begin
	state start begin
	end
	state run begin
		when login or levelup or enter with pc.get_level() >= 32 begin
			set_state ( gototeacher )
		end
	end

	state gototeacher begin
		when letter begin
			send_letter("[LC;4230]")

			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4241]")
			end
		end
		when button or info begin
			say_title("[LC;4230]")
			say("[LC;4252]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4230]" begin
			target.delete("__TARGET__")

			say_title("[LC;4223]")
			say("[LC;4263]")
   			wait()
			say_title("[LC;4223]")
   			say("[LC;4274]")
   			wait()
			say_title("[LC;4223]")
			say("[LC;4285]")
			set_state ( gomerchant )

		end
	end

	state gomerchant begin
		when letter begin
			send_letter("[LC;4230]")

			local v=find_npc_by_vnum(20010)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4295]")
			end
		end
		when button or info begin
			say_title("[LC;4296]")
			say("[LC;4297]")
			say_reward("[LC;4229]")
		end
		when __TARGET__.target.click or	20010.chat."[LC;4231]" begin
			target.delete("__TARGET__")
			say_title("[LC;4232]")
			say("[LC;4233]")
   			wait()
			say_title("[LC;4232]")
			say("[LC;4234]")
			set_state ( gotorequest )

		end
	end
	state gotorequest begin
		when letter begin
			send_letter("[LC;4231]")

				if pc.count_item(60)>=20 then
					local v=find_npc_by_vnum(20010)
					if 0==v then
					else
						target.vid("__TARGET__", v, "[LC;4235]")
					end
				end

		end
		when button or info begin
			if pc.count_item(60)>=20 then
				say_title("[LC;4236]")
				say("[LC;4237]")
				return
			end
			say_title("[LC;4238]")
			say("[LC;4239]")
		end


		when __TARGET__.target.click or	20010.chat."[LC;4240]" begin
			target.delete("__TARGET__")

			if pc.count_item(60)>=20 then
				say_title("[LC;4232]")
				say("[LC;4242]")
				wait()
				say_title("[LC;4232]")
				say("[LC;4243]")
				pc.remove_item(60,20)
				set_state ( gotodoc )
			else
				say_title("[LC;4244]")
				say("[LC;4245]")
			end
		end
	end

	state gotodoc begin
		when letter begin
			send_letter("[LC;4246]")

			local v=find_npc_by_vnum(20357)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4247]")
			end
		end

		when button or info begin
			say_title("[LC;4246]")
			say("[LC;4248]")
		end

		when __TARGET__.target.click or	20357.chat."[LC;4249]" begin
			target.delete("__TARGET__")
			say_pc_name()
			say("[LC;4250]")
			pc.give_item2(30150)
			set_state ( gototeacher2 )

		end
	end

	state gototeacher2 begin
		when letter begin
			send_letter("[LC;4251]")

			local v=find_npc_by_vnum(20011)
	if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4253]")
			end
		end
		when button or info begin
			say_title("[LC;4254]")
			say("[LC;4255]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4251]" begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4256]")
			wait()
			say_title("[LC;4257]")
						say_reward("[LC;4258]")
			wait()
			say_title("[LC;4259]")
						say_reward("[LC;4260]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4261]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4262]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4264]")
			say_reward("[LC;4265]")
			pc.give_exp2(1000000)

			say_reward("[LC;4266]")
			pc.change_money(50000)

			say_reward("[LC;4267]")
			pc.give_item2(70012)

			pc.remove_item(30150)
			set_state ( gotohunter )

		end
	end

	state gotohunter begin
		when letter begin
			send_letter("[LC;4268]")

			local v=find_npc_by_vnum(20019)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4269]")
			end
		end
		when button or info begin
			say_title("[LC;4270]")
			say("[LC;4271]")
			say_reward("[LC;4272]")
		end

		when __TARGET__.target.click or	20019.chat."[LC;4273]" begin
			target.delete("__TARGET__")
			say_title("[LC;4275]")
			say("[LC;4276]")
			wait()
			say_title("[LC;4275]")
			say("[LC;4277]")
			set_state ( godoc2 )

		end
	end

	state godoc2 begin
		when letter begin
			send_letter("[LC;4278]")
		end
		when button or info begin
			say_title("[LC;4278]")
			say("[LC;4279]")
		end
		when 634.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30150")==0 then
				pc.give_item2(30150, 1)
				set_state ( goteacher3 )
			end
		end
	end
	state goteacher3 begin
		when letter begin
			send_letter("[LC;4280]")
			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4253]")
			end
		end
		when button or info begin
			say_title("[LC;4281]")
			say("[LC;4282]")
		end

		when __TARGET__.target.click or	20011.chat."[LC;4280]"	begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4283]")
			wait()
			say_title("[LC;4284]")
						say_reward("[LC;4286]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4287]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4288]")
			say_reward("[LC;4289]")
			pc.give_exp2(1000000)

			say_reward("[LC;4290]")
			pc.change_money(50000)

			say_reward("[LC;4291]")
			pc.give_item2(70008)

			pc.remove_item(30150)
			set_state (godoc3)

		end
	end

	state godoc3 begin

		when letter begin
			send_letter("[LC;4292]")
		end

		when button or info begin
			say_title("[LC;4292]")
			say("[LC;4293]")
			say_reward("[LC;4294]")
			
			clear_letter()
			set_quest_state("main_quest_lv40", "run")
			set_state (__COMPLETE__)

		end

	end
	state __COMPLETE__ begin
	end

end

