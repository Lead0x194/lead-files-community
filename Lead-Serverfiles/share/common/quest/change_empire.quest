quest change_empire begin
       state start begin
               when 20090.chat."[LC;56]"  with game.get_event_flag("c_e") >0  begin

                       local count = pc.get_change_empire_count() ;
                       if count >= 1 then
                               say("[LC;68]")
                               return
                       end
                       say_title("[LC;56]")

                       say("[LC;76]")
                       local s =  select("[LC;2059]", "[LC;1891]")

                       if s == 1 then
                               change_empire.move_pc()
                       end
               end

               when 71054.use begin
                       say_title("[LC;56]")

                       say("[LC;77]")
                       if get_time() < pc.getqf("next_use_time") then
                                say_title("[LC;78]")
                                say_reward("[LC;79]")

                                if pc.is_gm() then
                                    say("[LC;80]")
                                    local s =  select("[LC;2059]", "[LC;2035]")
                                    if s == 1 then
                                        say("[LC;81]")
                                        pc.setqf("next_use_time", 0)
                                    end
                               end

                               return
                       end

                       if change_empire.move_pc() == true then
                               pc.setqf("next_use_time", get_time() + 86400 * 7)
                       end
               end



               function move_pc()
                       if pc.is_engaged() then
                            say_title("[LC;78]")
                            say_reward("[LC;82]")
                            say("[LC;55]")
                            return false
                       end

                       if pc.is_married() then
                           say_title("[LC;78]")
                           say_reward("[LC;82]")
                           say("[LC;57]")
                           return false
                       end

                       if pc.is_polymorphed() then
                           say_title("[LC;78]")
                           say_reward("[LC;58]")
                           say("[LC;59]")
                           return false
                       end

                       if pc.has_guild() then
                           say_title("[LC;78]")
                           say_reward("[LC;60]")
                           say("[LC;61]")
                           return false
                       end

                       if pc.money < 500000 then
                           say_title("[LC;78]")
                           say_reward("[LC;62]")
                           say("[LC;63]")
                           return false
                       end


                       say("[LC;64]")
                       local s =  select ( "[LC;65]", "[LC;66]", "[LC;67]", "[LC;1891]")

                       if 4 == s then
                               return false
                       end

                        say_reward("[LC;69]")

                       local a =  select("[LC;2059]", "[LC;1891]")

                       if 2 == a then
                               return false
                       end

                       local ret = pc.change_empire(s)
                       local oldempire = pc.get_empire()

                       if ret == 999 then
                        say_title("[LC;70]")
                        say_reward("[LC;71]")
                        pc.change_gold(-500000)
                        pc.remove_item(71054) ;

                        char_log(0, "CHANGE_EMPIRE",string.format("[LC;72;%s;%s]", oldempire, s))

                        return true
                       else
                           if ret == 1 then
                                say("[LC;73]")
                           elseif ret == 2 then
                                say("[LC;74]")
                           elseif ret == 3 then
                                say("[LC;75]")
                           end
                       end

                       return false
               end


       end
end

