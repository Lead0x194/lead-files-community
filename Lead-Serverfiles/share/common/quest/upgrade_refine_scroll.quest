quest upgrade_refine_scroll begin
    state start begin
	when 20016.chat."[LC;8468]" begin
		say_title("[LC;27]")
		say("[LC;8479]")
		wait()

	    if pc.count_item(70035)==0 then
			say_title("[LC;27]")
			say("[LC;8487]")
			say_item("[LC;8488]", 70035, "")
			wait()
	    end

	    if pc.count_item(25040)==0 then
			say_title("[LC;27]")
			say("[LC;8489]")
			say_item("[LC;8490]", 25040, "")
			wait()
	    end

	    say_title("[LC;27]")
	    say("[LC;8491]")
	    local s= select("[LC;2059]", "[LC;2035]")
	    if 1==s then
		if pc.get_gold() < 200000 then
		    say_title("[LC;29]")
		    say_reward("[LC;1687]")
		elseif pc.count_item(70035)>0 and pc.count_item(25040)>0 then
		    pc.remove_item(70035)
		    pc.remove_item(25040)
		    pc.changegold(-200000)
		    pc.give_item2(71021)
		    say_title("[LC;27]")
		    say("[LC;8492]")
		    say_item("[LC;8493]", 71021, "")
		else
		    say_title("[LC;27]")
		    say("[LC;8467]")
		    
		end
	    end
	end
	when 20016.chat."[LC;8469]" begin
	    say_title("[LC;27]")
	    say("[LC;8470]")
	    wait()

	    if pc.count_item(71026)==0 then
			say_title("[LC;27]")
			say("[LC;8471]")
			say_item("[LC;8472]", 71026, "")
			wait()
	    end

	    if pc.count_item(25040)==0 then
			say_title("[LC;27]")
			say("[LC;8473]")
			say_item("[LC;8490]", 25040,"")
			wait()
	    end
		
	    say_title("[LC;27]")
	    say("[LC;8474]")
	    local s= select("[LC;2059]", "[LC;2035]")
	    if 1==s then
		if pc.count_item(71026)>0 and pc.count_item(25040)>0 then
		    pc.remove_item(71026)
		    pc.remove_item(25040)
		    pc.give_item2(71032)
		    say_title("[LC;7789]")
		    say("[LC;8475]")
		    say_item("[LC;8469]", 71032, "")
		else
		    say_title("[LC;27]")
		    say("[LC;8476]")
		end
	    end
	end

	when 20016.chat."[LC;8477]" begin
		say_title("[LC;27]")
		say("[LC;8478]")
		wait()

		if pc.count_item(71025) == 0 then
			say_title("[LC;27]")
			say("[LC;8480]")
			say_item("[LC;8481]", 71025, "")
						wait()
		end

		if pc.count_item(25040) == 0 then
			say_title("[LC;27]")
			say("[LC;8482]")
			say_item("[LC;8490]", 25040, "")
						wait()
		end


		say_title("[LC;27]")
		say("[LC;8483]")

		local s =  select("[LC;2059]", "[LC;2035]")
		if 1 == s then
			if pc.count_item(71025) > 0 and pc.count_item(25040) > 0 then
				pc.remove_item(71025)
				pc.remove_item(25040)
				pc.give_item2(70039)
				say_title("[LC;27]")
				say("[LC;8484]")
				say_item("[LC;8485]", 70039, "")
			else
				say_title("[LC;27]")
				say("[LC;8486]")
			end
		end
	end

    end
end


