
quest subquest_19  begin
	state start begin
		when login or levelup with pc.level >= 13  and pc.level <=15 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(9006)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;1118]")
			end
		end

		when __TARGET__.target.click or	9006.chat."[LC;7476]"  begin
			target.delete("__TARGET__")
			say_title("[LC;1118]")
			say("[LC;7487]")
			local b= select("[LC;7498]", "[LC;7434]")
			if 2==b then
				say_title("[LC;617]")
				say("[LC;7499]")
			else	
				say_title("[LC;1118]")
				say("[LC;7500]")
			end
			local r= select("[LC;971]", "[LC;931]")
			if 2==r then
				say("[LC;7501]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;617]")
					say("[LC;7502]")
					return
				end
				say_pc_name()
					say("[LC;7503]")
				set_state(__GIVEUP__)
				return
			end
			say_pc_name()
			say("[LC;7504]")
			set_state(find)
				
		end
	end
	state find begin
		when letter begin
			send_letter("[LC;7475]")
		end
		when info or button begin
			say_title("[LC;7477]")
			say("[LC;7478]")
		end

		when 106.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30151")==0  then 
				pc.give_item2("30151", 1)
				local v=find_npc_by_vnum(9006)
				if 0==v then
				else
					target.vid("__TARGET__",v, "[LC;7479]")
				end
			end	
		end
		
		when 9006.chat."[LC;7480]" with pc.count_item("30151") == 0 begin
			say("[LC;7481]")
			say_item_vnum(30151)
			say("[LC;7482]")

			local s= select("[LC;7483]", "[LC;7484]")
			if 2==s then
				say("[LC;7485]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say("[LC;7486]")
					return
				end	
				say_title("[LC;617]")
				say("[LC;7488]")
				set_state(__GIVEUP__)
				return
			end
				
			say_title("[LC;617]")
			say("[LC;7489]")
			
		 end


		when __TARGET__.target.click or 9006.chat."[LC;7480]" with pc.countitem("30151")>=1 begin 
			target.delete("__TARGET__")
			say_title("[LC;1118]")
			say("[LC;7490]")
			wait()
			say_title("[LC;617]")
			say("[LC;7491]")
			pc.removeitem("30151", 1) 
			setstate(reward)
		end
	end
	state reward begin
		when letter begin
			send_letter("[LC;7492]")
		end
		when info or button begin
			say_title("[LC;7492]")
			say("[LC;7493]")
	
			local s=number(1, 3)
			if 1>=s then -- 33.33% (1/3)
					say_title("[LC;44]")
				say("[LC;7494]")
				local r=number(1, 16)
				if r==1 then
					pc.give_item2("11204", 1)
				elseif r==2 then
					pc.give_item2("11214", 1)
				elseif r==3 then
					pc.give_item2("11404", 1)
				elseif r==4 then
					pc.give_item2("11414", 1)
				elseif r==5 then
					pc.give_item2("11604", 1)
				elseif r==6 then
					pc.give_item2("11614", 1)
				elseif r==7 then
					pc.give_item2("11804", 1)
				elseif r==8 then
					pc.give_item2("11814", 1)
				elseif r==9 then
					pc.give_item2("11203", 1)
				elseif r==10 then
					pc.give_item2("11213", 1)
				elseif r==11 then
					pc.give_item2("11403", 1)
				elseif r==12 then
					pc.give_item2("11413", 1)
				elseif r==13 then
					pc.give_item2("11603", 1)
				elseif r==14 then
					pc.give_item2("11613", 1)
				elseif r==15 then
					pc.give_item2("11803", 1)
				elseif r==16 then
					pc.give_item2("11813", 1)
				end
			elseif 2>=s then -- 33.33% (1/3)
					say_title("[LC;44]")
				say("[LC;7495]")
				local r=number(1, 16)
				if r==1 then
					pc.give_item2("11202", 1)
				elseif r==2 then
					pc.give_item2("11212", 1)
				elseif r==3 then
					pc.give_item2("11402", 1)
				elseif r==4 then
					pc.give_item2("11412", 1)
				elseif r==5 then
					pc.give_item2("11602", 1)
				elseif r==6 then
					pc.give_item2("11612", 1)
				elseif r==7 then
					pc.give_item2("11802", 1)
				elseif r==8 then
					pc.give_item2("11812", 1)
				elseif r==9 then
					pc.give_item2("11201", 1)
				elseif r==10 then
					pc.give_item2("11211", 1)
				elseif r==11 then
					pc.give_item2("11401", 1)
				elseif r==12 then
					pc.give_item2("11411", 1)
				elseif r==13 then
					pc.give_item2("11601", 1)
				elseif r==14 then
					pc.give_item2("11611", 1)
				elseif r==15 then
					pc.give_item2("11801", 1)
				elseif r==16 then
					pc.give_item2("11811", 1)
				end
			elseif 3>=s then -- 33.33% (1/3)
					say_title("[LC;44]")
				say("[LC;7496]")
				local r=number(1, 8)
				if r==1 then
					pc.give_item2("11200", 1)
				elseif r==2 then
					pc.give_item2("11210", 1)
				elseif r==3 then
					pc.give_item2("11400", 1)
				elseif r==4 then
					pc.give_item2("11410", 1)
				elseif r==5 then
					pc.give_item2("11600", 1)
				elseif r==6 then
					pc.give_item2("11610", 1)
				elseif r==7 then
					pc.give_item2("11800", 1)
				elseif r==8 then
					pc.give_item2("11810", 1)
				end
			end
			say_reward("[LC;7497]")
			pc.give_exp2(15000)
			clear_letter()
			set_state(__COMPLETE__)
		end
	end
	
	state __GIVEUP__ begin
	end
	
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
