quest pony_buy begin
	state start begin
		when 20349.chat."[LC;6550]" with horse.get_grade()==0 begin
			if pc.level<=24 then
				say_title("[LC;1558]")
				say("[LC;6561]")
			elseif pc.countitem("50050")<1 then
				say_title("[LC;1586]")
				say("[LC;6572]")
				setstate(need_item50050)
			elseif pc.countitem("50050")>=1 and pc.level>=25 then
				say_title("[LC;1586]")
				say("[LC;6581]")
				local b= select("[LC;971]", "[LC;931]")
				if 1==b then
					if pc.countitem("50050")>=1 then
						pc.removeitem("50050", 1)
						setstate(test)
					end
				elseif 2==b then
					say_title("[LC;1558]")
					say("[LC;6582]")
				else
					say(string.format("[LC;1020;%s]", b))
				end
			else
				say_title("[LC;1558]")
				say("[LC;6583]")
			end
		end
	end
	state need_item50050 begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1723]")
			q.set_title("[LC;1723]")
			q.start()
		end
		when button begin
			say_title("[LC;44]")
						say_reward("[LC;6584]")
			setstate(start)
			q.done()
		end
		when info begin
			say_title("[LC;44]")
						say_reward("[LC;6584]")
			setstate(start)
			q.done()
		end
	end
	state test begin
		when letter begin
			q.set_counter("[LC;6587]", 20-pc.getqf("kill_count"))
		end
		when 503.kill begin
			pc.setqf("kill_count", pc.getqf("kill_count")+1)
			q.set_counter("[LC;6587]", 20-pc.getqf("kill_count"))
			if get_time()>=pc.getqf("limit_time") then
				setstate(failure)
			end
		end
		when letter begin
			q.set_clock("[LC;1722]", pc.getqf("limit_time")-get_time())
		end
		when enter begin
			pc.setqf("limit_time", get_time()+30*60)
			pc.setqf("kill_count", 0)
		end
		when leave begin
			q.done()
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;6585]")
			q.set_title("[LC;6585]")
			q.start()
		end
		when button begin
			say_title("[LC;6585]")
						say_reward("[LC;6586]")
					end
		when info begin
			say_title("[LC;6585]")
			say("[LC;6549]")
		end
		when 503.kill with pc.getqf("kill_count") >= 20 and pc.getqf("limit_time")>=get_time() begin
			setstate(report)
		end
		when 20349.chat."[LC;6551]" with horse.get_grade()!=0 begin
			setstate(start)
			q.done()
		end
		when 20349.chat."[LC;6552]" begin
			say_title("[LC;1558]")
						say_reward("[LC;6553]")
						local b= select("[LC;2105]", "[LC;6554]")
			if 1==b then
			elseif 2==b then
				say_title("[LC;1558]")
				say("[LC;6555]")
				local b= select("[LC;2059]", "[LC;6556]")
				if 1==b then
					say_title("[LC;1558]")
					say("[LC;6557]")
					setstate(start)
					q.done()
				elseif 2==b then
					say_title("[LC;6558]")
					say("[LC;6559]")
				else
					say(string.format("[LC;1020;%s]", b))
				end
			else
				say(string.format("[LC;1020;%s]", b))
			end
		end
	end
	state report begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1738]")
			q.set_title("[LC;1738]")
			q.start()
		end
		when button begin
			say_title("[LC;1738]")
						say_reward("[LC;1739]")
					end
		when info begin
			say_title("[LC;1738]")
						say_reward("[LC;1739]")
					end
		when 20349.chat."[LC;1740]" with horse.get_grade()!=0 begin
			setstate(start)
			q.done()
		end
		when 20349.chat."[LC;1741]" with horse.get_grade()==0 begin
			say_title("[LC;1558]")
			say("[LC;6560]")
			if is_test_server() then
				pc.setqf("make_time", get_time()+10)
			else
				pc.setqf("make_time", get_time()+number(8, 16)*60*60)
			end
			setstate(wait)
		end
	end
	state wait begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;6562]")
			q.set_title("[LC;6562]")
			q.start()
		end
		when button begin
			say_title("[LC;6562]")
			say("[LC;6563]")
		end
		when info begin
			say_title("[LC;6562]")
			say("[LC;6563]")
		end
		when login with get_time()>=pc.getqf("make_time") begin
			setstate(buy)
		end
		when 20349.chat."[LC;1740]" with horse.get_grade()!=0 begin
			setstate(start)
			q.done()
		end
		when 20349.chat."[LC;6564]" with horse.get_grade()==0 begin
			say_title("[LC;1558]")
			say("[LC;6565]")
		end
	end
	state buy begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;6566]")
			q.set_title("[LC;6566]")
			q.start()
		end
		when button begin
			say_title("[LC;6566]")
			say("[LC;6567]")
		end
		when info begin
			say_title("[LC;6566]")
			say("[LC;6567]")
		end
		when 20349.chat."[LC;6568]" with horse.get_grade()==0 and get_time()>=pc.getqf("make_time") begin
			say_title("[LC;6569]")
			say("[LC;6570]")
			local b= select("[LC;49]", "[LC;6571]", "[LC;6554]")
			if 1==b then
				if pc.money>=100000 then
					char_log(0, " HORSE_BUY", "BEGIN")
					pc.changemoney(-100000)
					char_log(0, " HORSE_BUY", " DEC money 100000")
					horse.unride()
					horse.advance()
					horse.ride()
					char_log(0, " HORSE_BUY", "INC horse_advance 1")
					pc.give_item2("50051", 1)
					char_log(0, " HORSE_BUY", "INC 50051 1")
					char_log(0, " HORSE_BUY", "END")
					say_title("[LC;1558]")
					say("[LC;6573]")
					setstate(start)
					q.done()
				else
					say_title("[LC;1558]")
					say("[LC;6574]")
				end
			elseif 2==b then
				say_title("[LC;1558]")

				say("[LC;6575]")
			elseif 3==b then
				say_title("[LC;1558]")
				say("[LC;6576]")
				local b= select("[LC;2059]", "[LC;6577]")
				if 1==b then
					setstate(start)
				elseif 2==b then
				else
					say(string.format("[LC;1020;%s]", b))
				end
			else
				say(string.format("[LC;1020;%s]", b))
			end
		end
	end
	state failure begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;6578]")
			q.set_title("[LC;6578]")
			q.start()
		end
		when button begin
			say_title("[LC;6578]")
						say_reward("[LC;6579]")
						say_reward("[LC;6580]")
			setstate(start)
			q.done()
		end
		when info begin
			say_title("[LC;6578]")
						say_reward("[LC;6579]")
						say_reward("[LC;6580]")
			setstate(start)
			q.done()
		end
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end

