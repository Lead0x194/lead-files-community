quest main_quest_lv15 begin
	state start begin
	end
	state run begin
		when login or levelup or enter begin
			if pc.get_level() >= 15 then
				setstate(gotoboss)
			end
		end
	end
	state gotoboss begin
		when letter begin
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4078]")
			end
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;4093]")
			q.set_title("[LC;4123]")
			q.start()
		end
		when button or info begin
			say_title("[LC;4123]")
			say("[LC;4133]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;4082]")
			say("[LC;4134]")
			wait()
			local empire = pc.getempire()
			if empire == 1 then
				say_title("[LC;4082]")
				say("[LC;4135]")
				wait()
				say_title("[LC;4082]")
				say("[LC;4136]")
				wait()
				say_title("[LC;4082]")
				say("[LC;4137]")

			elseif empire == 2 then
				say_title("[LC;4082]")
				say("[LC;4138]")
				wait()
				say_title("[LC;4082]")
				say("[LC;4139]")
				wait()
				say_title("[LC;4082]")
				say("[LC;4140]")

			elseif empire == 3 then
				say_title("[LC;4082]")
				say("[LC;4122]")
				wait()
				say_title("[LC;4082]")
				say("[LC;4124]")
				wait()
				say_title("[LC;4082]")
				say("[LC;4125]")

			end

			set_state (gotomusition)
			q.done()
		end
	end

	state gotomusition begin
		when letter begin
			local v=find_npc_by_vnum(20017)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;3738]")
			end
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;3738]")
			q.set_title("[LC;3738]")
			q.start()
		end
		when button or info begin
			say_title("[LC;4127]")
			say("[LC;4128]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;14]")
			say("[LC;4129]")
			setstate(gotoboss2)
			q.done()
		end
	end
	state gotoboss2 begin
		when letter begin
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4078]")
			end
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;4130]")
			q.set_title("[LC;4130]")
			q.start()
		end
		when button or info begin
			say_title("[LC;4127]")
			say("[LC;4131]")
		end
		when __TARGET__.target.click begin
			pc.give_exp2( 20000 )
			pc.change_money( 10000 )
			target.delete("__TARGET__")
			say_title("[LC;4082]")
			say("[LC;4132]")
			say_title("[LC;192]")
						say_reward("[LC;4126]")

			clear_letter()
			q.done()
			setstate(__COMPLETE__)
			set_quest_state("main_quest_lv16","run")
		end
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end

