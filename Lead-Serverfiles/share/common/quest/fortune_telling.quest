quest fortune_telling begin
	state start begin
		when oldwoman.chat."[LC;1119]" begin
			if pc.level<=20 then
				say_title("[LC;617]")
				say("[LC;1128]")
				return
			end

			if get_time()-pc.getqf("time") < 8*60*60 then
				local passed_time = get_time() - pc.getqf("time")
				say_title("[LC;617]")
				say("[LC;1129]")
				
				wait()
				local idx = pc.getqf("idx")
				if idx!=0 then
					say_title("[LC;1130]")
					say("[LC;1131]")
					say(locale.fortune_words[idx][1])
					
					wait()
					
					if pc.getqf("talisman") == 0 and special.fortune_telling[idx][5] > 0 then
						local talisman_cost = special.fortune_telling[idx][5]
						say_title("[LC;1130]")
						say("[LC;1132]")
						
						local s =  select("[LC;1133]", "[LC;1134]")
						if s == 1 then
							if pc.gold < talisman_cost then
								say_title("[LC;1130]")
								say("[LC;1135]")
								
								pc.setqf("talisman", 0)
							else
								pc.give_item2(70052,1)
								pc.changegold(-talisman_cost)
								pc.setqf("talisman", 1)
								
							end
						else
							return
						end
					else
						return
					end
				end
			end

			local gold = 7777
			
			say_title("[LC;1118]")


			say("[LC;1120]")
			local s =  select("[LC;1121]", "[LC;1122]")

			if s == 2 then
				say_title("[LC;1118]")
				say("[LC;1123]")
				
				return
			end

			local n = number(1, 10000)

			local i
			local idx
			for i = 1, table.getn(special.fortune_telling) do
				if n<=special.fortune_telling[i][1] then
					idx = i
					break
				else
					n = n - special.fortune_telling[i][1]
				end
			end
			i = idx

			say_title("[LC;1118]")
			say(locale.fortune_words[i][2])
			
			local t = {}

			n = 0
			local j
			for j = 2,4 do
				if special.fortune_telling[i][j] != 0 then
					n=n+1
					t[n] = j
				end
			end

			if n > 0 then
				n = number(1, n)
				__give_char_priv(t[n]-1, special.fortune_telling[i][t[n]])
			end

			pc.setqf("time", get_time())
			pc.setqf("idx", i)

			if special.fortune_telling[i][5]>0 then
				wait()
				
				say_title("[LC;1118]")
				say(locale.fortune_words[i][3])

				local talisman_cost = special.fortune_telling[i][5]
				local s =  select("[LC;1124]", "[LC;1125]")
				if s == 1 then
					if pc.gold < talisman_cost then
						say(string.format("[LC;1126;%s]", gold))
						pc.setqf("talisman", 0)
						
					else
						pc.give_item2(70052,1)
						pc.changegold(-talisman_cost)
						pc.setqf("talisman", 1)
						
					end

				elseif s == 2 then
					say_title("[LC;1130]")
					say("[LC;1127]")
					pc.setqf("talisman", 0)
				end
			end

		end -- end_of_when
	end -- end_of_state
end -- end_of_quest
