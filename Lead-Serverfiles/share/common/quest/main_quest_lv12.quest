quest main_quest_lv12 begin
	state start begin
	end
	state run begin
		when login or levelup or enter with pc.get_level() >= 12 begin
			set_state (gotoboss)
		end
	end

	state gotoboss begin
		when letter begin
		 	send_letter("[LC;4070]")
		
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4070]")
			end
		end
		when button or info begin
			say_title("[LC;4070]")
            say("[LC;4090]")
			end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")

                        say_title("[LC;4082]")
                        	    		---                                                   l
			say("[LC;4099]")
			wait()
			say_title("[LC;44]")
                        			say_reward("[LC;4100]")
			set_state ( killgraydog )


		end
	end

	state killgraydog begin
		when letter begin
			send_letter("[LC;4101]")
		end
		when button or info begin
			say_title("[LC;4101]")
            say("[LC;4102]")
			say_reward(string.format("[LC;4103;%s]", pc.getqf("state")))
		end
		when 107.kill begin
			local count = pc.getqf("state") + 1
			
			if count <= 10 then
				pc.setqf("state", count)
				q.set_counter("[LC;4104]", 10 - count)
						
				if count == 10 then 
					say_title("[LC;44]")
					say_reward("[LC;4105]")
					set_state (gotoboss2)
				end
			end
		end
		when 20355.chat."[LC;4106]" with pc.getqf("state") < 10 begin	
			say_title("[LC;4082]")
			say("[LC;4107]")
			
			if pc.is_gm() then
				wait()
				say_title("[LC;4089]")
				say("[LC;4091]")
				local s =  select("[LC;2059]", "[LC;2035]")
				if s == 1 then
					set_state (gotoboss2)
				end
			end
		end

	when 20355.chat."[LC;4106]" with pc.getqf("state") >= 10 begin
			say_title("[LC;4082]")
			say("[LC;4092]")
			set_state (gotoboss2)
		end
	end
	
	state gotoboss2 begin
		when letter begin
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4093]")
			end
		end
		when letter begin
			send_letter("[LC;4094]")
		end
		when button or info begin
			say_title("[LC;4095]")
			say("[LC;4096]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;4082]")
                        	    		---                                                   l
                        say("[LC;4097]")
			wait()
			say_title("[LC;192]")
                        			say_reward("[LC;4098]")
			
			pc.give_exp2( 10000 )
			pc.change_money( 3500 )
			pc.setqf("state", 0)
			
			clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv14","run")

		end
	end
	state __COMPLETE__ begin
	end
end