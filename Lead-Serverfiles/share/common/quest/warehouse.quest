quest stash begin
	state start begin --Status when nothing is open
		when warehouse_keeper.chat."[LC;8495]"  begin
			say_title("[LC;8501]")
			-- changed handling, after we get a new button to open the storeage directly
			say("[LC;8502]")
			wait()

			if pc.gold < 500 then
				
				
				say_title("[LC;8501]")
				say("[LC;8503]")
			else
				local s =  select("[LC;3704]", "[LC;3703]")

				if s == 1 then
					pc.changegold(-500)
					game.set_safebox_level(1)
					set_state(use)
					say_title("[LC;7724]")
					say("[LC;8504]")
					say_reward("[LC;8505]")
					say("[LC;8506]")
				else
					say_title("[LC;8501]")
					say("[LC;8507]")
				end
			end
		end
		when warehouse_keeper.chat."[LC;8497]"  begin
			if pc.getqf("open_item_storage_count") < 3 then
				say_title("[LC;7724]")
				say("[LC;8499]")
				wait()
				say_title("[LC;7724]")
				say_show_item(90013) -- icon of item
				say("[LC;8500]")
				wait()
				pc.setqf("open_item_storage_count", pc.getqf("open_item_storage_count") + 1)
			end
			
			setskin(NOWINDOW)
			game.open_mall()
		end
	end
	state use begin
		when warehouse_keeper.chat."[LC;8508]" begin
			if pc.getqf("open_count") < 3 then
				say_title("[LC;7724]")
				say("[LC;8494]")
				wait()
				say_title("[LC;7724]")
				say("[LC;8496]")
				wait()
				pc.setqf("open_count", pc.getqf("open_count") + 1)
			end
			setskin(NOWINDOW)
			game.open_safebox()
		end
		when warehouse_keeper.chat."[LC;8497]" begin
			if pc.getqf("open_item_storage_count") < 3 then
				say_title("[LC;7724]")
				say("[LC;8499]")
			    wait()
				say_title("[LC;7724]")
				say_show_item(90013) -- icon of item
				say("[LC;8500]")
				wait()
				pc.setqf("open_item_storage_count", pc.getqf("open_item_storage_count") + 1)
			end
			
			setskin(NOWINDOW)
			game.open_mall()
			
		end
		when warehouse_keeper.chat."[LC;3647]" begin
			npc.open_shop()
			say_title("[LC;7724]")
			say("[LC;8498]")
		end 

	end -- end_of_state: use
end -- end_of_quest

