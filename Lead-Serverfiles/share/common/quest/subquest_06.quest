quest subquest_6 begin
	state start begin
		when login or levelup with pc.level >= 11 and pc.level <= 16 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(9002)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7106]")
			end
		end

		when __TARGET__.target.click or	9002.chat."[LC;7117]" with pc.level >= 11 begin
			target.delete("__TARGET__")

			say_title("[LC;4200]")
			say("[LC;7135]")
			local s= select("[LC;7148]", "[LC;7159]")
			if 2==s then
				say("[LC;7170]")
				local a= select("[LC;7173]", "[LC;7174]")
				if  2==a then
				say_title("[LC;4200]")
				say("[LC;7175]")
					return
				end
				say_title("[LC;4200]")
                                say("[LC;7105]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;4200]")
			say("[LC;7107]")
			set_state(ask_blacksmith)
		end
	end
	state ask_blacksmith begin
		when info or button begin
			say_title("[LC;7117]")
			say_reward("[LC;7108]")
		end

		when letter begin
			send_letter("[LC;7106]")
		end

		when __TARGET__.target.click or	20016.chat."[LC;7109]" begin
			target.delete("__TARGET__")
			say_title("[LC;27]")
			say("[LC;7110]")

			local s= select("[LC;7111]", "[LC;7112]")
			if 2==s then
				say("[LC;7113]")
				local a= select("[LC;2059]", "[LC;7095]")
				if  2==a then
					say_title("[LC;27]")
                                        say("[LC;7114]")
					return
				end
				say_title("[LC;27]")
                                say("[LC;7115]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;27]")
			say("[LC;7116]")
			set_state(to_get_material)
		end

	end
	state to_get_material begin
		when button or info begin
			say_title("[LC;7117]")
			say("[LC;7119]")
			if pc.getqf("asked_20011") == 1 then
				say("[LC;7132]")
			elseif pc.getqf("ironore_done") == 1 then
				say_reward("[LC;7123]")
			else 
				say("[LC;7120]")
			end
			
			if pc.getqf("asked_20008") == 1 then
				say("[LC;7140]")
			elseif pc.getqf("leather_done") == 1 then
				say_reward("[LC;7124]")
			else 
				say("[LC;7121]")
			end
			
			if pc.getqf("asked_20005") == 1 then
				say("[LC;7146]")
			elseif pc.getqf("coal_done") == 1 then
				say_reward("[LC;7125]")
			else
				say("[LC;7122]")
			end
		end

		when letter begin
			send_letter("[LC;7118]")
			if pc.getqf("leather_done")!=1 then
				local v=find_npc_by_vnum(20008)
				if 0!=v then
					target.vid("__TARGET1__",v, "[LC;7126]")
				end
			end

			if pc.getqf("ironore_done")!=1 then
				local v=find_npc_by_vnum(20011)
				if 0!=v then
					target.vid("__TARGET2__",v, "[LC;7127]")
				end
			end

			if pc.getqf("coal_done")!=1 then
				local v=find_npc_by_vnum(20005)
				if 0!=v then
					target.vid("__TARGET3__",v, "[LC;7128]")
				end
			end
		end

		when 20011.chat."[LC;7129]" with pc.getf("subquest_6","ironore_done") == 0 begin
			target.delete("__TARGET2__")
			if pc.count_item(30132) >= 1 then
				pc.setqf("ironore_done", 1)
				pc.setqf("asked_20011", 1)
				pc.remove_item("30132", 1)

				say_title("[LC;4223]")
				say("[LC;7130]")
				if  pc.getqf("ironore_done") == 1 and pc.getqf("leather_done") == 1 and pc.getqf("coal_done") == 1 then
					set_state(back_to_blacksmith)
				end
				return
			end
			say_title("[LC;4223]")
			say("[LC;7131]")
			say_item_vnum("30132")
			pc.setqf("asked_20011", 1)

		end
		when 20011.chat."[LC;7133]" with pc.getf("subquest_6","ironore_done")==1 begin
				target.delete("__TARGET2__")
				say_title("[LC;4223]")
				say("[LC;7134]")
		end
		when 20008.chat."[LC;7136]" with pc.getf("subquest_6","leather_done") == 0 begin
			target.delete("__TARGET1__")
			if pc.count_item(60001) >= 1 then
				pc.setqf("leather_done", 1)
				pc.setqf("asked_20008", 0)
				pc.remove_item("60001", 1)

				say_title("[LC;7137]")
				say("[LC;7138]")
				if pc.getqf("ironore_done") == 1 and pc.getqf("leather_done") == 1 and pc.getqf("coal_done") == 1 then

					set_state(back_to_blacksmith)
				end
				return
			end
			say_title("[LC;7137]")
			say("[LC;7139]")
			say_item_vnum("60001")
			pc.setqf("asked_20008", 1)

		end
		when 20008.chat."[LC;7141]" with pc.getqf("leather_done")==1 begin
				target.delete("__TARGET1__")
				say_title("[LC;7137]")
				say("[LC;7142]")
		end


		when 20005.chat."[LC;7143]" with pc.getf("subquest_6","coal_done") == 0 begin
			target.delete("__TARGET3__")
			if pc.count_item(30044) >= 1 then
				pc.setqf("coal_done", 1)
				pc.setqf("asked_20005", 0)
				pc.remove_item("30044", 1)

				say_title("[LC;6969]")
				say("[LC;7144]")
				if  pc.getqf("ironore_done") == 1 and pc.getqf("leather_done") == 1 and pc.getqf("coal_done") == 1 then
					set_state(back_to_blacksmith)

				end
				return
			end
			say_title("[LC;6969]")
			say("[LC;7145]")
			wait()

			say_title("[LC;6969]")
			say("[LC;7147]")
			say_item_vnum("30044")
			pc.setqf("asked_20005", 1)
		end
		when 20005.chat."[LC;7149]" with pc.getf("subquest_6","coal_done")==1 begin
				target.delete("__TARGET3__")
				say_title("[LC;6969]")
				say("[LC;7150]")
		end

		when 101.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30132")==0  then
				pc.give_item2("30132", 1)
			end
		end


		when 110.kill  begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("60001")==0  then
				pc.give_item2("60001", 1)
			end
		end

		when 109.kill  begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30044")==0  then
				pc.give_item2("30044", 1)
			end
		end

		when 20016.chat."[LC;7151]" begin
			target.delete("__TARGET__")
			if pc.getqf("ironore_done") != 1 then
				say_title("[LC;27]")
				say("[LC;7152]")
				return
			end

			if pc.getqf("leather_done") != 1 then
				say_title("[LC;27]")
				say("[LC;7153]")
				return
			end
			if pc.getqf("coal_done") != 1 then
				say_title("[LC;27]")
				say("[LC;7154]")
				return
			end
		end
	end
	state back_to_blacksmith begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7155]")
			q.set_title("[LC;7156]")
			q.start()

			local v=find_npc_by_vnum(20016)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7157]")
			end
		end
		when info or button begin
			say_title("[LC;7158]")
						say("[LC;7160]")
					end

		when __TARGET__.target.click or	20016.chat."[LC;7161]" with pc.getf("subquest_6","ironore_done") == 1 and pc.getf("subquest_6","leather_done") == 1 and pc.getf("subquest_6","coal_done") == 1 begin
				say_title("[LC;27]")
				say("[LC;7162]")
				set_state(resource_complete)
		end
	end
	state resource_complete begin
		when info or button begin
			say_title("[LC;7117]")
            say("[LC;7163]")
		end

		when letter begin
			send_letter("[LC;7106]")

		    local v=find_npc_by_vnum(9002)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7164]")
			end
		end


		when __TARGET__.target.click or	9002.chat."[LC;7165]" begin
			target.delete("__TARGET__")
			say_title("[LC;4200]")
			say("[LC;7166]")

			pc.give_exp2(26000)
			set_quest_state("levelup","run")
			pc.change_money(15000)

			pc.give_item2("30003", 1)

			say_title("[LC;192]")
						say_reward("[LC;7167]")
             clear_letter()
			set_state(__COMPLETE__)

			if pc.job == 0 then
				pc.give_item2("11223", 1)
				say_reward("[LC;7168]")
			elseif pc.job == 1 then
				pc.give_item2("11423", 1)
				say_reward("[LC;7169]")
			elseif pc.job == 2 then
				pc.give_item2("11623", 1)
				say_reward("[LC;7171]")
			elseif pc.job==3 then
				pc.give_item2("11823", 1)
				say_reward("[LC;7172]")
			end
			pc.setqf("ironore_done",0)
			pc.setqf("leather_done" ,0)
			pc.setqf("coal_done",0)
		end
	end

	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
	end
end
