quest subquest_21 begin
	state start begin
		when login or levelup with pc.level >= 48 and pc.level <= 50 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20020)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7543]")
			end
		end

		when __TARGET__.target.click or	20020.chat."[LC;7553]"  begin
			target.delete("__TARGET__")
			say_title("[LC;7554]")
			say("[LC;7555]")
			wait()
			say_title("[LC;7554]")
			say("[LC;7556]")
			local s= select("[LC;7557]", "[LC;3719]")
			if 2==s then
				say_title("[LC;7554]")
				say("[LC;7558]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;7554]")
					say("[LC;7559]")
					return
				end
				say_title("[LC;7554]")
				say("[LC;7560]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7554]")
			say("[LC;7542]")
			set_state(accept_request)


			end

		end


	state accept_request begin

		when letter begin
			send_letter("[LC;7544]")

			if pc.count_item("30152")>0 then
				local v=find_npc_by_vnum(20020)
				if 0!= v then
					target.vid("__TARGET__",v, "[LC;7545]")
				end
			end

		end


		when info or  button begin
			if pc.count_item("30152") >=1 then
				say_title("[LC;7545]")
				say("[LC;7546]")
				return
			end

			say_title("[LC;7547]")
			say("[LC;7548]")

		end



		when 903.kill with pc.getqf("kill_count")==0 begin

			local s = number(1, 100)
			if s <= 5 and  pc.count_item("30152") ==0  then
				pc.give_item2(30152, 1)
				pc.setqf("medicine_done",0)

			end
		end



		when  __TARGET__.target.click or	20020.chat."[LC;7549]" with pc.count_item("30152") >=1  begin
			target.delete("__TARGET__")
			say_title("[LC;7554]")
			say("[LC;7550]")
			pc.remove_item("30152",1)

		    say_title("[LC;7551]")
						say_reward("[LC;7552]")
						pc.change_money(30000)
			pc.give_exp2(1900000)


			clear_letter()
			set_state(COMPLETE)

		end

end

	state __GIVEUP__ begin
	end

	state COMPLETE begin
		when enter begin
			q.done()
		end
	end


end

