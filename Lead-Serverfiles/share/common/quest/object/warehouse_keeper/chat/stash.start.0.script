say_title ( "[LC;8501]" ) 
say ( "[LC;8502]" ) 
wait ( ) 
if pc . gold < 500 then 
say_title ( "[LC;8501]" ) 
say ( "[LC;8503]" ) 
else 
local s = select ( "[LC;3704]" , "[LC;3703]" ) 
if s == 1 then 
pc . changegold ( - 500 ) 
game . set_safebox_level ( 1 ) 
set_state ( "use" ) 
say_title ( "[LC;7724]" ) 
say ( "[LC;8504]" ) 
say_reward ( "[LC;8505]" ) 
say ( "[LC;8506]" ) 
else 
say_title ( "[LC;8501]" ) 
say ( "[LC;8507]" ) 
end 
end 
