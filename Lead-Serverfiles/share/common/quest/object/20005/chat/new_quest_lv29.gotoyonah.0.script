target . delete ( "__TARGET__" ) 
say_title ( "[LC;5800]" ) 
say ( "[LC;5801]" ) 
say ( "[LC;5802]" ) 
local goto_npc = 20005 
local accept = select ( "[LC;5803]" , "[LC;5804]" ) 
if accept == 1 then 
local v = find_npc_by_vnum ( 20014 ) 
if 0 ~= v then 
target . vid ( "__TARGET2__" , v , "[LC;5806]" ) 
end 
set_state ( "find_taurean" ) 
else 
say ( "[LC;5805]" ) 
say ( "[LC;7170]" ) 
local abortquest = select ( "[LC;7173]" , "[LC;7174]" ) 
if abortquest == 1 then 
pc . setqf ( "hayIndex" , 0 ) 
pc . setqf ( "hayFromHarang" , 0 ) 
pc . setqf ( "hayFromTaurean" , 0 ) 
pc . setqf ( "hayFromStablemaster" , 0 ) 
pc . setqf ( "yonahspatience" , 0 ) 
pc . setqf ( "yonahHasHay" , 0 ) 
pc . setqf ( "dropProb" , 0 ) 
set_state ( "__GIVEUP__" ) 
else 
local v = find_npc_by_vnum ( goto_npc ) 
if 0 ~= v then 
target . vid ( "__TARGET__" , v , "[LC;5798]" ) 
end 
return 
end 
end 
