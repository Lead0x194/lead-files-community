say_title ( "[LC;1272]" ) 
say ( "[LC;1274]" ) 
local s = select ( locale . yes , locale . no ) 
if s == 1 then 
if not pc . is_guild_master ( ) then 
say_title ( "[LC;1272]" ) 
say ( "[LC;1275]" ) 
elseif building . has_land ( pc . get_guild ( ) ) then 
say_title ( "[LC;1272]" ) 
say ( "[LC;1276]" ) 
else 
local land_id = building . get_land_id ( pc . get_map_index ( ) , pc . get_x ( ) * 100 , pc . get_y ( ) * 100 ) 
if land_id == 0 then 
say_title ( "[LC;1272]" ) 
say ( "[LC;1277]" ) 
else 
local price , owner , guild_level_limit = building . get_land_info ( land_id ) 
say_title ( "[LC;1272]" ) 
say ( string . format ( "[LC;1278;%s;%s]" , guild_level_limit , price .. locale . gold ) ) 
if guild . level ( pc . get_guild ( ) ) < guild_level_limit then 
say_title ( "[LC;1272]" ) 
say ( "[LC;1279]" ) 
else 
say_title ( "[LC;1272]" ) 
say ( "[LC;1280]" ) 
s = select ( locale . yes , locale . no ) 
if s == 1 then 
local price , owner , guild_level_limit = building . get_land_info ( land_id ) 
if owner ~= 0 then 
say_title ( "[LC;1272]" ) 
say ( "[LC;1281]" ) 
elseif pc . gold < price then 
say_title ( "[LC;1272]" ) 
say ( "[LC;1270]" ) 
else 
pc . changegold ( - price ) 
building . set_land_owner ( land_id , pc . get_guild ( ) ) 
notice_multiline ( string . format ( "[LC;1271;%s]" , guild . name ( pc . get_guild ( ) ) ) , notice ) 
end 
else 
say_title ( "[LC;1272]" ) 
say ( "[LC;1273]" ) 
end 
end 
end 
end 
else 
say_title ( "[LC;1272]" ) 
say ( "[LC;1273]" ) 
end 
