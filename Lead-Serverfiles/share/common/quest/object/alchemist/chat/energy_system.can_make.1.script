local setting = energy_system . setting ( ) 
local need = 30 
say_title ( mob_name ( 20001 ) ) 
say ( string . format ( "[LC;814;%d]" , need ) ) 
wait ( ) 
if pc . get_level ( ) < 35 then 
say_title ( mob_name ( 20001 ) ) 
say ( "[LC;803]" ) 
return 
end 
if pc . count_item ( setting . energy_stone ) < need then 
say_title ( mob_name ( 20001 ) ) 
say ( string . format ( "[LC;815;%d]" , need ) ) 
return 
else 
say_title ( mob_name ( 20001 ) ) 
say ( string . format ( "[LC;816;%d]" , need ) ) 
wait ( ) 
end 
local charge = 1000 
say_title ( mob_name ( 20001 ) ) 
say ( string . format ( "[LC;817;%d]" , charge ) ) 
local s = select ( "[LC;818]" , "[LC;819]" ) 
if s == 2 then 
say_title ( mob_name ( 20001 ) ) 
say ( "[LC;820]" ) 
return 
end 
if pc . get_gold ( ) < charge then 
say_title ( mob_name ( 20001 ) ) 
say ( "[LC;821]" ) 
return 
end 
if pc . count_item ( setting . energy_stone ) < need then 
return 
end 
pc . change_gold ( - charge ) 
pc . remove_item ( setting . energy_stone , need ) 
if pc . getqf ( "hasExperience" ) == 0 then 
say_title ( mob_name ( 20001 ) ) 
say ( "[LC;822]" ) 
pc . give_item2 ( setting . charging_stone , 1 ) 
pc . setqf ( "hasExperience" , 1 ) 
return 
end 
local r = number ( 1 , 100 ) 
if r > 30 then 
say_title ( mob_name ( 20001 ) ) 
say ( "[LC;823]" ) 
return 
end 
say_title ( mob_name ( 20001 ) ) 
say ( "[LC;824]" ) 
pc . give_item2 ( setting . charging_stone , 1 ) 
