local time_remaining = dragon_lair_weekly . get_time_remaining ( ) 
q . set_clock ( "[LC;738]" , time_remaining ) 
timer ( "dragon_lair_weekly_timer" , time_remaining ) 
if dragon_lair_weekly . get_amount_remaining ( ) > 0 then 
send_letter ( "[LC;739]" ) 
q . set_title ( "[LC;740]" ) 
else 
send_letter ( "[LC;741]" ) 
q . set_title ( "[LC;742]" ) 
end 
q . start ( ) 
