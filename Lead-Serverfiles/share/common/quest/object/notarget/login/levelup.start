local lev = pc . getqf ( "current" ) 
if lev ~= 0 then 
if pc . getqf ( "remain" ) <= 0 then 
setskin ( NOWINDOW ) 
pc . setqf ( "buttonstate" , 3 ) 
makequestbutton ( string . format ( "[LC;1827;%s]" , lev ) ) 
else 
setskin ( NOWINDOW ) 
pc . setqf ( "buttonstate" , 1 ) 
makequestbutton ( string . format ( "[LC;1828;%s]" , lev ) ) 
end 
end 
