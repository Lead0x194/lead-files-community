if pc . count_item ( 30131 ) >= 1 then 
target . delete ( "__TARGET__" ) 
say_title ( "[LC;7043]" ) 
say ( "[LC;7044]" ) 
wait ( ) 
say_title ( "[LC;7043]" ) 
say ( "[LC;7045]" ) 
pc . remove_item ( "30131" , 1 ) 
set_state ( "return_to" ) 
else 
say_title ( "[LC;7043]" ) 
say ( "[LC;7046]" ) 
local s = select ( "[LC;7047]" , "[LC;7048]" ) 
if 2 == s then 
say ( "[LC;7050]" ) 
local a = select ( "[LC;2059]" , "[LC;2035]" ) 
if 2 == a then 
say_title ( "[LC;5585]" ) 
say ( "[LC;7051]" ) 
return 
end 
say_title ( "[LC;5585]" ) 
say ( "[LC;7052]" ) 
clear_letter ( ) 
set_state ( "__GIVEUP__" ) 
return 
end 
say_title ( "[LC;5585]" ) 
say ( "[LC;7053]" ) 
set_state ( "information" ) 
end 
