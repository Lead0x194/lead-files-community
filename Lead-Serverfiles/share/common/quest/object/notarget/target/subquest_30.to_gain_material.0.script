target . delete ( "__TARGET__" ) 
local gold = pc . count_item ( 50606 ) 
local silver = pc . count_item ( 50605 ) 
local ebony = pc . count_item ( 50608 ) 
if gold < 100 or silver < 100 or ebony < 100 then 
say_title ( "[LC;27]" ) 
say ( "[LC;7795]" ) 
local s = select ( "[LC;7796]" , "[LC;7797]" ) 
if 2 == s then 
say_title ( "[LC;27]" ) 
say ( "[LC;7798]" ) 
local a = select ( "[LC;2059]" , "[LC;2035]" ) 
if 2 == a then 
say_title ( "[LC;7240]" ) 
say ( "[LC;7800]" ) 
return 
end 
say_title ( "[LC;27]" ) 
say ( "[LC;7801]" ) 
set_state ( "__GIVEUP__" ) 
return 
end 
say_title ( "[LC;7240]" ) 
say ( "[LC;7802]" ) 
return 
end 
if gold >= 100 and silver >= 100 and ebony >= 100 then 
say_title ( "[LC;27]" ) 
say ( "[LC;7803]" ) 
wait ( ) 
say_title ( "[LC;27]" ) 
say ( "[LC;7804]" ) 
pc . remove_item ( 50606 , 100 ) 
pc . remove_item ( 50605 , 100 ) 
pc . remove_item ( 50608 , 100 ) 
say_reward ( "[LC;7805]" ) 
pc . give_exp2 ( 200000 ) 
say_reward ( "[LC;7806]" ) 
pc . change_money ( 20000 ) 
if pc . job == 0 then 
pc . give_item2 ( 63 , 1 ) 
say_reward ( "[LC;7807]" ) 
elseif pc . job == 1 then 
pc . give_item2 ( 63 , 1 ) 
say_reward ( "[LC;7807]" ) 
elseif pc . job == 2 then 
pc . give_item2 ( 63 , 1 ) 
say_reward ( "[LC;7807]" ) 
elseif pc . job == 3 then 
pc . give_item2 ( 7053 , 1 ) 
say_reward ( "[LC;7808]" ) 
end 
clear_letter ( ) 
set_state ( "__COMPLETE__" ) 
end 
