target . delete ( "__TARGET__" ) 
if pc . count_item ( "30156" ) >= 1 then 
say_title ( "[LC;7093]" ) 
say ( "[LC;7774]" ) 
pc . remove_item ( "30156" , 1 ) 
say_reward ( "[LC;7775]" ) 
pc . change_money ( 20000 ) 
say_reward ( "[LC;7777]" ) 
pc . give_exp2 ( 850000 ) 
clear_letter ( ) 
set_state ( "__COMPLETE__" ) 
return 
else 
say_title ( "[LC;7093]" ) 
say ( "[LC;7778]" ) 
local s = select ( "[LC;7727]" , "[LC;939]" ) 
if 2 == s then 
say ( "[LC;7740]" ) 
local a = select ( "[LC;2059]" , "[LC;2035]" ) 
if 2 == a then 
say_title ( "[LC;7093]" ) 
say ( "[LC;7779]" ) 
return 
end 
say_title ( "[LC;7093]" ) 
say ( "[LC;7780]" ) 
set_state ( "__GIVEUP__" ) 
return 
end 
say_title ( "[LC;7093]" ) 
say ( "[LC;7781]" ) 
end 
