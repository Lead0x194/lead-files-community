target . delete ( "__TARGET__" ) 
if pc . count_item ( 30130 ) >= 1 then 
say_title ( "[LC;6985]" ) 
say ( "[LC;6986]" ) 
wait ( ) 
say_title ( "[LC;192]" ) 
say_reward ( "[LC;6988]" ) 
pc . remove_item ( 30130 ) 
pc . give_exp2 ( 1500 ) 
set_quest_state ( "levelup" , "run" ) 
pc . change_money ( 1000 ) 
clear_letter ( ) 
set_state ( "__COMPLETE__" ) 
else 
say_title ( "[LC;6985]" ) 
say ( "[LC;6989]" ) 
say_item_vnum ( 30130 ) 
wait ( ) 
say_title ( "[LC;1004]" ) 
say ( "[LC;6990]" ) 
local s = select ( "[LC;6991]" , "[LC;6992]" ) 
if s == 2 then 
say ( "[LC;6993]" ) 
local a = select ( "[LC;2059]" , "[LC;2035]" ) 
if 2 == a then 
say_title ( "[LC;1004]" ) 
say ( "[LC;6994]" ) 
return 
end 
say_pc_name ( ) 
say ( "[LC;6995]" ) 
clear_letter ( ) 
set_state ( "__GIVEUP__" ) 
return 
end 
set_state ( "hunt_for_peach" ) 
end 
