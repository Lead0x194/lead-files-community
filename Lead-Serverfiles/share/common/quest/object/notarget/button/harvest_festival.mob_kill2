local mob2_info = pc . getqf ( "mob2_info" ) 
if mob2_info == 10 then 
mob2_name = "[LC;1500]" elseif mob2_info == 9 then 
mob2_name = "[LC;1499]" elseif mob2_info == 8 then 
mob2_name = "[LC;1477]" elseif mob2_info == 7 then 
mob2_name = "[LC;1476]" elseif mob2_info == 6 then 
mob2_name = "[LC;1478]" elseif mob2_info == 5 then 
mob2_name = "[LC;1479]" elseif mob2_info == 4 then 
mob2_name = "[LC;1480]" elseif mob2_info == 3 then 
mob2_name = "[LC;1481]" elseif mob2_info == 2 then 
mob2_name = "[LC;1482]" elseif mob2_info == 1 then 
mob2_name = "[LC;1483]" end 
say_title ( "[LC;1468]" ) 
say ( string . format ( "[LC;1489;%s]" , mob2_name ) ) 
if party . is_party ( ) then 
say ( "[LC;1490]" ) 
else 
say ( "[LC;1491]" ) 
end 
local gogo_set = select ( "[LC;1454]" , "[LC;1470]" ) 
if gogo_set == 2 then 
clear_letter ( ) 
set_state ( "information" ) 
end 
