local remain_time = pc . getqf ( "limit_time" ) - get_time ( ) 
local left_hour = math . mod ( remain_time / ( 60 * 60 ) , 24 ) ; 
local left_minute = math . mod ( remain_time / 60 , 60 ) ; 
say ( string . format ( "[LC;3827;%d;%d]" , left_hour , left_minute ) ) 
