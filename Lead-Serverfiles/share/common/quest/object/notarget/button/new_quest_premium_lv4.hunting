if pc . getqf ( "neededAmountDrop1" ) ~= pc . getqf ( "new_quest_premium_lv4_collect_count_1" ) then 
say_title ( "[LC;6332]" ) 
say ( string . format ( "[LC;6308;%s]" , pc . getqf ( "neededAmountDrop1" ) - pc . getqf ( "new_quest_premium_lv4_collect_count_1" ) ) ) 
say_reward ( "[LC;6301]" ) 
say ( mob_name ( pc . getqf ( "mob1" ) ) ) 
else 
say_title ( "[LC;6332]" ) 
say ( "[LC;6306]" ) 
end 
