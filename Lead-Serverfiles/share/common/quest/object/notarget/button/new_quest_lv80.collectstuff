say_title ( "[LC;6235]" ) 
say ( "[LC;6236]" ) 
if pc . count_item ( new_quest_lv80_ice ) >= 10 then 
say ( string . format ( "[LC;6237]" , item_name ( new_quest_lv80_ice ) ) ) 
else 
say ( "[LC;6238]" ) 
say_reward ( string . format ( "%s x" , new_quest_lv80_amountIce - pc . count_item ( new_quest_lv80_ice ) ) ) 
say_item_vnum ( new_quest_lv80_ice ) 
say_reward ( string . format ( "[LC;6239]" , mob_name ( new_quest_lv80_mob2 ) ) ) 
wait ( ) 
end 
if pc . count_item ( new_quest_lv80_ember ) == 1 then 
say ( string . format ( "[LC;6240]" , item_name ( new_quest_lv80_figure ) , item_name ( new_quest_lv80_ember ) ) ) 
else 
say ( "[LC;6241]" ) 
say_reward ( "1 x" ) 
say_item_vnum ( new_quest_lv80_ember ) 
say_reward ( "[LC;6242]" ) 
say_item_vnum ( new_quest_lv80_figure ) 
say_reward ( string . format ( "[LC;6243]" , item_name ( new_quest_lv80_figure ) , mob_name ( new_quest_lv80_mob1 ) ) ) 
end 
