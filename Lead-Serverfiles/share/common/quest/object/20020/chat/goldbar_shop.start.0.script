if pc . get_level ( ) < 30 then 
say_title ( "[LC;1232]" ) 
say ( "[LC;1243]" ) 
wait ( ) 
say_title ( "[LC;44]" ) 
say_reward ( "[LC;1251]" ) 
return 
end 
if game . get_event_flag ( "gold_trade_enable" ) == 0 then 
say_title ( "[LC;1232]" ) 
say ( "[LC;1252]" ) 
wait ( ) 
say_title ( "[LC;44]" ) 
say_reward ( "[LC;1253]" ) 
return 
end 
say_title ( "[LC;1232]" ) 
say ( "[LC;1254]" ) 
local s = select ( "[LC;1255]" , "[LC;1256]" ) 
if s == 1 then 
say_title ( "[LC;1232]" ) 
say ( "[LC;1218]" ) 
wait ( ) 
local interval = game . get_event_flag ( "gold_trade_cycle" ) 
local unit = "" 
if interval <= 0 then interval = 360 end 
if interval >= 60 then 
interval = interval / 60 
unit = "[LC;1219]" math . ceil ( interval ) 
else 
unit = "[LC;1220]" end 
if interval < 1 then interval = 1 end 
say_title ( "[LC;1232]" ) 
say ( string . format ( "[LC;1222;%s;%s]" , interval , unit ) ) 
say ( "[LC;1223]" ) 
else 
say_title ( "[LC;1232]" ) 
say ( "[LC;1224]" ) 
end 
setstate ( "trade_goldbar" ) 
