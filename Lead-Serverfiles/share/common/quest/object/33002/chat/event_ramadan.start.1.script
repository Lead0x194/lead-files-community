local setting = event_ramadan . setting ( ) 
if pc . count_item ( setting . bread ) == 0 then 
say_title ( "[LC;887]" ) 
say ( "[LC;928]" ) 
local s = select ( "[LC;929]" , "[LC;930]" ) 
if 2 == s then 
say_title ( "[LC;887]" ) 
say ( "[LC;893]" ) 
return 
end 
say_title ( "[LC;887]" ) 
say ( "[LC;894]" ) 
wait ( ) 
say_title ( "[LC;887]" ) 
say ( "[LC;895]" ) 
local s = select ( "[LC;896]" , "[LC;897]" ) 
if 2 == s then 
say_title ( "[LC;887]" ) 
say ( "[LC;893]" ) 
return 
end 
say_title ( "[LC;887]" ) 
say ( "[LC;898]" ) 
elseif pc . count_item ( setting . bread ) > 0 and pc . count_item ( setting . bread ) < 10 then 
say_title ( "[LC;887]" ) 
say ( "[LC;899]" ) 
elseif pc . count_item ( setting . bread ) >= 10 then 
say_title ( "[LC;887]" ) 
say ( "[LC;900]" ) 
wait ( ) 
say_title ( "[LC;887]" ) 
say ( "[LC;901]" ) 
pc . give_item2 ( setting . candy , 1 ) 
pc . remove_item ( setting . bread , 10 ) 
end 
if not event_ramadan . is_running ( ) then 
npc . purge ( ) 
end 
