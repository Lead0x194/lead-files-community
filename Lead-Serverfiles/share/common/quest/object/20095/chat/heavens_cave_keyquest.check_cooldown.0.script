if pc . getqf ( "heavens_cave_keyquest_Repeat" ) == 0 then 
target . delete ( "__TARGET__" ) 
say_title ( "[LC;1507]" ) 
if pc . get_sex ( ) == 0 then 
say ( "[LC;1508]" ) 
else 
say ( "[LC;1509]" ) 
end 
wait ( ) 
say_title ( "[LC;1507]" ) 
say ( "[LC;1510]" ) 
wait ( ) 
say_title ( "[LC;1507]" ) 
say ( "[LC;1511]" ) 
wait ( ) 
say_title ( "[LC;1507]" ) 
say ( "[LC;1512]" ) 
say ( "" ) 
say ( "[LC;1513]" ) 
say_reward ( "[LC;1514]" ) 
set_state ( "initialize" ) 
else 
if get_time ( ) - pc . getqf ( "overall_cooldown_timestamp" ) >= pc . getqf ( "heavens_cave_keyquest_CooldownTime" ) then 
say_title ( "[LC;1507]" ) 
say ( "[LC;1515]" ) 
set_state ( "initialize" ) 
else 
s = pc . getqf ( "heavens_cave_keyquest_CooldownTime" ) - ( get_time ( ) - pc . getqf ( "overall_cooldown_timestamp" ) ) 
h = math . floor ( s / 3600 ) 
m = math . ceil ( ( ( s / 3600 ) - h ) * 60 ) 
say_title ( "[LC;1507]" ) 
say ( "[LC;1516]" ) 
say ( "" ) 
if s >= 7200 then 
say ( string . format ( "[LC;1517;%s]" , h ) ) 
else 
if s >= 3660 then 
say ( string . format ( "[LC;1518;%s]" , m ) ) 
else 
say ( string . format ( "[LC;1519;%s]" , m ) ) 
end 
end 
end 
end 
