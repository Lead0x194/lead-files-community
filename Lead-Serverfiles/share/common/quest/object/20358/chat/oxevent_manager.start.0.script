local stat = oxevent . get_status ( ) 
if stat == 0 then 
say ( "[LC;839]" ) 
local choice = select ( "1> min " .. oxevent_manager . enter_level ( 1 , 1 ) .. " max " .. oxevent_manager . enter_level ( 1 , 2 ) , "2> min " .. oxevent_manager . enter_level ( 2 , 1 ) .. " max " .. oxevent_manager . enter_level ( 2 , 2 ) , "3> min " .. oxevent_manager . enter_level ( 3 , 1 ) .. " max " .. oxevent_manager . enter_level ( 3 , 2 ) , "4> min " .. oxevent_manager . enter_level ( 4 , 1 ) .. " max " .. oxevent_manager . enter_level ( 4 , 2 ) , "5> min " .. oxevent_manager . enter_level ( 5 , 1 ) .. " max " .. oxevent_manager . enter_level ( 5 , 2 ) , "[LC;1891]" ) 
if choice == 6 then 
return 
end 
say ( "[LC;840]" ) 
local amount_choice = input_number ( "[LC;848]" ) 
if amount_choice > 200 or amount_choice <= 0 then 
say ( "[LC;849]" ) 
return 
end 
say ( "[LC;6486]" ) 
say ( "[LC;842]" ) 
say ( "[LC;843]" .. " " .. oxevent_manager . enter_level ( choice , 1 ) .. " - " .. oxevent_manager . enter_level ( choice , 2 ) ) 
say ( "[LC;844]" .. " " .. amount_choice ) 
local s = select ( "[LC;6487]" , "[LC;1891]" ) 
if s == 1 then 
local v = oxevent . open ( ) 
if v == 0 then 
say ( "[LC;6447]" ) 
say_reward ( "[LC;6449]" ) 
elseif v == 1 then 
say ( "[LC;6450]" ) 
notice_multiline ( "[LC;6451]" , notice_all ) 
notice_multiline ( "[LC;6452]" , notice_all ) 
game . set_event_flag ( "ox_map_level_min" , oxevent_manager . enter_level ( choice , 1 ) ) 
game . set_event_flag ( "ox_map_level_max" , oxevent_manager . enter_level ( choice , 2 ) ) 
game . set_event_flag ( "ox_map_player_max" , amount_choice ) 
else 
say ( "[LC;6447]" ) 
end 
end 
elseif stat == 1 then 
say ( string . format ( "[LC;6453;%s]" , oxevent . get_attender ( ) ) ) 
local s = select ( "[LC;6454]" , "[LC;1891]" ) 
if s == 1 then 
oxevent . close ( ) 
say ( "[LC;6455]" ) 
end 
elseif stat == 2 then 
say ( "[LC;6456]" ) 
local s = select ( 
"[LC;6457]" , 
"[LC;6458]" , 
"[LC;6459]" , 
"[LC;1891]" ) 
if s == 1 then 
local v = oxevent . quiz ( 1 , 30 ) 
if v == 0 then 
say ( "[LC;6460]" ) 
elseif v == 1 then 
say ( "[LC;6462]" ) 
else 
say ( "[LC;6463]" ) 
end 
elseif s == 2 then 
oxevent_manager . cleanup_event ( ) 
say ( "[LC;6464]" ) 
notice_multiline ( "[LC;6465]" , notice_all ) 
notice_multiline ( "[LC;6466]" , notice_all ) 
elseif s == 3 then 
oxevent_manager . cleanup_event ( ) 
say ( "[LC;6467]" ) 
notice_multiline ( "[LC;6468]" , notice_all ) 
notice_multiline ( "[LC;6469]" , notice_all ) 
end 
elseif stat == 3 then 
say ( "[LC;6470]" ) 
say_reward ( "[LC;6471]" ) 
else 
say ( "[LC;6472]" ) 
end 
