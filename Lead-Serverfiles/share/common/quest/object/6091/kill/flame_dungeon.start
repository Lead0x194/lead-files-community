if flame_dungeon . is_flamed ( d . get_map_index ( ) ) and d . getf ( "level" ) == 17 then notice_multiline ( "[LC;1089]" , d . notice ) 
notice_multiline ( "[LC;1090]" , d . notice ) 
server_timer ( "dungeon_end_timer" , 60 , d . get_map_index ( ) ) 
flame_dungeon . level_clear ( ) 
if party . is_party ( ) then 
party . setf ( "flame_dungeon_boss_kill_count" , 1 ) 
end 
 return end 