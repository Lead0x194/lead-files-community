say ( "[LC;6811]" ) 
wait ( ) 
local items = { pc . get_sig_items ( 10032 ) } 
local ticket = nil 
if table . getn ( items ) > 1 then 
for i , v in ipairs ( items ) begin 
item . select ( v ) 
say_title ( mob_name ( 20349 ) ) 
say ( "[LC;6812]" ) 
say_item_vnum ( item . vnum ) 
say ( "[LC;6813]" ) 
local s = select ( locale . yes , locale . no , locale . cancel ) 
if s == 3 then 
return 
end 
if s == 1 then 
ticket = v 
break 
end 
end 
else 
ticket = items [ 1 ] 
end 
if ticket == nil then 
say_title ( mob_name ( 20349 ) ) 
say ( "[LC;6814]" ) 
return 
end 
say_title ( mob_name ( 20349 ) ) 
say ( "[LC;6815]" ) 
item . select ( ticket ) 
local s = select ( "[LC;6816]" , "[LC;6817]" , "[LC;6818]" , "[LC;6819]" , "[LC;6820]" , "[LC;6821]" ) 
if s == 6 then 
say_title ( mob_name ( 20349 ) ) 
say ( "[LC;6822]" ) 
