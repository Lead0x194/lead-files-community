if pc . level <= 24 then 
say_title ( "[LC;1558]" ) 
say ( "[LC;6561]" ) 
elseif pc . countitem ( "50050" ) < 1 then 
say_title ( "[LC;1586]" ) 
say ( "[LC;6572]" ) 
setstate ( "need_item50050" ) 
elseif pc . countitem ( "50050" ) >= 1 and pc . level >= 25 then 
say_title ( "[LC;1586]" ) 
say ( "[LC;6581]" ) 
local b = select ( "[LC;971]" , "[LC;931]" ) 
if 1 == b then 
if pc . countitem ( "50050" ) >= 1 then 
pc . removeitem ( "50050" , 1 ) 
setstate ( "test" ) 
end 
elseif 2 == b then 
say_title ( "[LC;1558]" ) 
say ( "[LC;6582]" ) 
else 
say ( string . format ( "[LC;1020;%s]" , b ) ) 
end 
else 
say_title ( "[LC;1558]" ) 
say ( "[LC;6583]" ) 
end 
