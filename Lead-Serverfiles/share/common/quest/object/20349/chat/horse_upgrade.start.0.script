if horse . is_dead ( ) then 
say_title ( "[LC;1558]" ) 
say ( "[LC;1690]" ) 
elseif pc . level <= 34 then 
say_title ( "[LC;1558]" ) 
say ( "[LC;1701]" ) 
elseif horse . get_level ( ) <= 9 then 
say_title ( "[LC;1558]" ) 
say ( "[LC;1712]" ) 
elseif pc . countitem ( "50050" ) < 1 then 
say_title ( "[LC;1558]" ) 
say ( "[LC;1765]" ) 
setstate ( "need_item50050" ) 
elseif pc . countitem ( "50051" ) < 1 then 
say_title ( "[LC;1558]" ) 
say ( "[LC;1714]" ) 
elseif horse . get_level ( ) == 10 and not horse . is_dead ( ) and pc . countitem ( "50050" ) >= 1 and pc . level >= 35 then 
say_title ( "[LC;1558]" ) 
say ( "[LC;1715]" ) 
local b = select ( "[LC;971]" , "[LC;931]" ) 
if 1 == b then 
if pc . countitem ( "50050" ) >= 1 then 
pc . removeitem ( "50050" , 1 ) 
setstate ( "test" ) 
end 
elseif 2 == b then 
say ( "[LC;1716]" ) 
else 
say ( string . format ( "[LC;1717;%s]" , b ) ) 
end 
else 
say_title ( "[LC;1558]" ) 
say ( "[LC;1718]" ) 
end 
