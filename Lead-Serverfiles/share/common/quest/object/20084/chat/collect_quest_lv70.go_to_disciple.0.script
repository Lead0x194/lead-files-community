if get_time ( ) > pc . getqf ( "duration" ) then 
if pc . count_item ( 30165 ) > 0 then 
say_title ( "[LC;365]" ) 
say ( "[LC;374]" ) 
pc . remove_item ( 30165 , 1 ) 
pc . setqf ( "duration" , get_time ( ) + 60 * 60 * 22 ) 
wait ( ) 
local pass_percent 
if pc . getqf ( "drink_drug" ) == 0 then 
pass_percent = 60 
else 
pass_percent = 90 
end 
local s = number ( 1 , 100 ) 
if s <= pass_percent then 
if pc . getqf ( "collect_count" ) < 24 then 
local index = pc . getqf ( "collect_count" ) + 1 
pc . setqf ( "collect_count" , index ) 
say_title ( "[LC;365]" ) 
say ( string . format ( "[LC;375;%s]" , 25 - pc . getqf ( "collect_count" ) ) ) 
pc . setqf ( "drink_drug" , 0 ) 
return 
end 
say_title ( "[LC;365]" ) 
say ( "[LC;376]" ) 
pc . setqf ( "collect_count" , 0 ) 
pc . setqf ( "drink_drug" , 0 ) 
pc . setqf ( "duration" , 0 ) 
set_state ( "key_item" ) 
return 
else 
say_title ( "[LC;365]" ) 
say ( "[LC;377]" ) 
pc . setqf ( "drink_drug" , 0 ) 
return 
end 
else 
say_title ( "[LC;365]" ) 
say ( "[LC;378]" ) 
return 
end 
else 
say_title ( "[LC;365]" ) 
say ( "[LC;379]" ) 
return 
end 
