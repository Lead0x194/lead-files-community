say_title ( "[LC;138]" ) 
say ( "[LC;187]" ) 
pc . remove_item ( 50706 , 1 ) 
wait ( ) 
local pass_percent 
if pc . getqf ( "drink_drug" ) == 0 then 
pass_percent = 70 
else 
pass_percent = 100 
end 
local s = number ( 1 , 100 ) 
if s <= pass_percent then 
if pc . getqf ( "collect_count" ) < 9 then 
local index = pc . getqf ( "collect_count" ) + 1 
pc . setqf ( "collect_count" , index ) 
say_title ( "[LC;138]" ) 
say ( string . format ( "[LC;171;%s]" , 10 - pc . getqf ( "collect_count" ) ) ) 
pc . setqf ( "drink_drug" , 0 ) 
return 
end 
say_title ( "[LC;138]" ) 
say ( "[LC;173]" ) 
say_reward ( "[LC;174]" ) 
if pc . job == 0 then 
pc . give_item2 ( 12222 ) 
say_reward ( "[LC;175]" ) 
end 
if pc . job == 1 then 
pc . give_item2 ( 12362 ) 
say_reward ( "[LC;176]" ) 
end 
if pc . job == 2 then 
pc . give_item2 ( 12502 ) 
say_reward ( "[LC;177]" ) 
end 
if pc . job == 3 then 
pc . give_item2 ( 12642 ) 
say_reward ( "[LC;178]" ) 
end 
pc . setqf ( "collect_count" , 0 ) 
pc . setqf ( "drink_drug" , 0 ) 
clear_letter ( ) 
set_state ( "__complete" ) 
pc . change_money ( 20000 ) 
pc . give_exp2 ( 200000 ) 
set_quest_state ( "levelup" , "run" ) 
return 
else 
say_title ( "[LC;138]" ) 
say ( "[LC;179]" ) 
pc . setqf ( "drink_drug" , 0 ) 
return 
end 
