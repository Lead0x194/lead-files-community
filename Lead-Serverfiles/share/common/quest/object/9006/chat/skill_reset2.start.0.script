if pc . level < 5 then 
say_title ( "[LC;617]" ) 
say ( "[LC;6910]" ) 
return 
end 
if pc . level > 30 then 
say_title ( "[LC;617]" ) 
say ( string . format ( "[LC;6911;%s]" , pc . level ) ) 
return 
end 
if pc . get_skill_group ( ) == 0 then 
say_title ( "[LC;617]" ) 
say ( "[LC;6912]" ) 
return 
end 
local cost = 10000 + pc . level * 2000 
local s = 0 
if not pc . has_master_skill ( ) then 
say_title ( "[LC;617]" ) 
say ( string . format ( "[LC;6913;%s]" , cost ) ) 
s = select ( "[LC;6904]" , "[LC;6914]" ) 
else 
say_title ( "[LC;617]" ) 
say ( "[LC;6915]" ) 
wait ( ) 
say ( string . format ( "[LC;6916;%s]" , cost ) ) 
s = select ( "[LC;6917]" , "[LC;1891]" ) 
end 
if 2 == s then 
say_title ( "[LC;617]" ) 
say ( "[LC;6905]" ) 
return 
end 
if pc . money < cost then 
say_title ( "[LC;617]" ) 
say ( "[LC;6906]" ) 
return 
end 
pc . changegold ( - cost ) 
pc . clear_skill ( ) 
pc . set_skill_group ( 0 ) 
set_quest_state ( "skill_group" , "run" ) 
