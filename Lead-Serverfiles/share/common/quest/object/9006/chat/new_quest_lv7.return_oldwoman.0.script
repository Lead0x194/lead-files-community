say_reward ( string . format ( "[LC;6106;%s]" , new_quest_lv7_AmountNeed2 - pc . count_item ( new_quest_lv7_drop2 ) ) ) 
say_reward ( string . format ( "[LC;6107;%s]" , new_quest_lv7_AmountNeed3 - pc . count_item ( new_quest_lv7_drop3 ) ) ) 
say ( "[LC;6098]" ) 
set_state ( "collect_flowers" ) 
else 
pc . remove_item ( 30169 , 1 ) 
