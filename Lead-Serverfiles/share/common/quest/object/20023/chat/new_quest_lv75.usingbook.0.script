if pc . count_item ( 30182 ) < 1 then 
say ( "[LC;6201]" ) 
else 
say_title ( "[LC;6146]" ) 
say ( "[LC;6202]" ) 
say ( "[LC;6203]" ) 
wait ( ) 
say ( "[LC;6204]" ) 
local sell = select ( "[LC;6205]" , "[LC;6206]" ) 
if sell == 1 and pc . getqf ( "bargainsleft" ) > 0 then 
local letmeout = 0 
repeat 
say ( "[LC;6207]" ) 
local pcgives = tonumber ( input ( ) ) 
if pcgives < 1 or pcgives > 1e+09 or pc . getqf ( "bargainsleft" ) < 1 then 
say ( "[LC;6208]" ) 
local nobargain = select ( "[LC;6209]" , "[LC;6210]" ) 
if nobargain == 1 then 
pc . remove_item ( 30182 , 1 ) 
pc . change_money ( 500000 ) 
pc . setqf ( "bargainsleft" , 0 ) 
letmeout = 1 
set_state ( "__COMPLETE__" ) 
else 
say ( "[LC;6211]" ) 
letmeout = 1 
end 
elseif pcgives >= 1 and pcgives <= 1e+09 and pcgives > averagebargain * 2 then 
say ( "[LC;6212]" ) 
local npcmaxbargain = averagebargain + math . random ( 1 , 5 ) * 100000 
local reducebargains = pc . getqf ( "bargainsleft" ) 
reducebargains = reducebargains - 1 
pc . setqf ( "bargainsleft" , reducebargains ) 
say ( string . format ( "[LC;6213;%s]" , npcmaxbargain ) ) 
say ( "[LC;6214]" ) 
if pc . getqf ( "bargainsleft" ) == 0 then say ( "[LC;6215]" ) end 
local makebargain = select ( string . format ( "[LC;6216;%s]" , npcmaxbargain ) , "[LC;6217]" ) 
if makebargain == 1 then 
pc . remove_item ( 30182 , 1 ) 
pc . change_money ( npcmaxbargain ) 
letmeout = 1 
pc . setqf ( "bargainsleft" , 0 ) 
set_state ( "__COMPLETE__" ) 
else 
say ( "[LC;6218]" ) 
end 
else 
say ( "[LC;6219]" ) 
pc . remove_item ( 30182 , 1 ) 
pc . change_money ( pcgives ) 
pc . setqf ( "bargainsleft" , 0 ) 
letmeout = 1 
set_state ( "__COMPLETE__" ) 
end 
until letmeout == 1 
elseif sell == 1 and pc . getqf ( "bargainsleft" ) == 0 then 
say ( "[LC;6220]" ) 
say ( "[LC;6221]" ) 
local nobargain = select ( "[LC;6209]" , "[LC;6210]" ) 
if nobargain == 1 then 
pc . remove_item ( 30182 , 1 ) 
pc . change_money ( 500000 ) 
set_state ( "__COMPLETE__" ) 
else 
say ( "[LC;6222]" ) 
end 
else 
say ( "[LC;6223]" ) 
end 
end 
