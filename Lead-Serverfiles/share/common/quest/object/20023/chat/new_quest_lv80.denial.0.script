wait ( ) 
say_pc_name ( ) 
say ( "[LC;6279]" ) 
local give_blackice = select ( "[LC;6280]" , "[LC;6281]" ) 
if give_blackice == 1 then 
say_pc_name ( ) 
say ( "[LC;6282]" ) 
wait ( ) 
say_title ( "[LC;6202]" ) 
say ( "[LC;6283]" ) 
