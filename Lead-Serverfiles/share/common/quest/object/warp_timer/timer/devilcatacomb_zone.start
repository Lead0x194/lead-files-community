local level = d . getf ( "level" ) 
local level_switch = { 
[ 3 ] = "[LC;673]" , 
[ 4 ] = "[LC;674]" , 
[ 5 ] = "[LC;675]" , 
[ 6 ] = "[LC;676]" , 
} 
local t = 3600 - ( get_global_time ( ) - d . getf ( "enter_time" ) ) 
local t_r = math . mod ( t , 60 ) 
local t_m = ( t - t_r ) / 60 
d . notice ( level_switch [ level ] ) 
d . notice ( string . format ( "[LC;655;%s]" , t_m ) ) 
d . set_warp_location ( 0 , 0 , 0 ) 
