target . delete ( "__TARGET__" ) 
local empire = pc . get_empire ( ) 
say_title ( "[LC;6080]" ) 
say ( "[LC;6083]" ) 
if empire == 1 then 
say ( "[LC;6084]" ) 
end 
if empire == 2 then 
say ( "[LC;6085]" ) 
end 
if empire == 3 then 
say ( "[LC;6086]" ) 
end 
wait ( ) 
say_title ( "[LC;6080]" ) 
say ( "[LC;6087]" ) 
say ( "[LC;6088]" ) 
local doquest = select ( "[LC;7148]" , "[LC;7304]" , "[LC;6200]" ) 
if doquest == 1 then 
set_state ( "ask_oldwoman" ) 
elseif doquest == 3 then 
say ( "[LC;7170]" ) 
local abortquest = select ( "[LC;7173]" , "[LC;7174]" ) 
if abortquest == 1 then 
set_state ( "__GIVEUP__" ) 
else 
say_title ( "[LC;6080]" ) 
say ( "[LC;7288]" ) 
return 
end 
else 
say_title ( "[LC;6080]" ) 
say ( "[LC;7288]" ) 
return 
end 
