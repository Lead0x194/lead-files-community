target . delete ( "__TARGET__" ) 
if pc . count_item ( "30162" ) >= 100 then 
say_title ( "[LC;8143]" ) 
say ( "[LC;8144]" ) 
wait ( ) 
say_title ( "[LC;8143]" ) 
say ( "[LC;8145]" ) 
pc . remove_item ( "30162" , 100 ) 
say_reward ( "[LC;8146]" ) 
pc . give_exp2 ( 2.1e+06 ) 
set_quest_state ( "levelup" , "run" ) 
say_reward ( "[LC;7806]" ) 
pc . change_money ( 20000 ) 
clear_letter ( ) 
set_state ( "COMPLETE" ) 
return 
else 
say_title ( "[LC;8143]" ) 
say ( "[LC;8147]" ) 
local s = select ( "[LC;7727]" , "[LC;939]" ) 
if 2 == s then 
say_title ( "[LC;8143]" ) 
say ( "[LC;8148]" ) 
set_state ( "__GIVEUP__" ) 
return 
end 
say_title ( "[LC;8143]" ) 
say ( "[LC;8150]" ) 
end 
