if not npc . lock ( ) then 
say_title ( "[LC;5528]" ) 
say ( "[LC;5539]" ) 
return 
end 
say_title ( "[LC;5521]" ) 
say ( "[LC;5540]" ) 
local s = select ( "[LC;5542]" , "[LC;5543]" ) 
if s == 2 then 
local u_vid = marriage . find_married_vid ( ) 
if u_vid == 0 then 
say_title ( "[LC;5521]" ) 
say ( "[LC;5544]" ) 
npc . unlock ( ) 
return 
end 
say_title ( "[LC;5521]" ) 
say ( "[LC;5545]" ) 
local ok_sign = confirm ( u_vid , "[LC;5546]" , 30 ) 
if ok_sign == CONFIRM_OK then 
marriage . end_wedding ( ) 
else 
say_title ( "[LC;5528]" ) 
say ( "[LC;5547]" ) 
end 
end 
npc . unlock ( ) 
