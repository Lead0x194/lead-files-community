say_title ( "[LC;5973]" ) 
say ( "[LC;5962]" ) 
local doquest = select ( "[LC;5975]" , "[LC;7304]" , "[LC;6200]" ) 
if doquest == 1 then 
say_title ( "[LC;5973]" ) 
say ( "[LC;5976]" ) 
elseif doquest == 3 then 
say ( "[LC;7170]" ) 
local abortquest = select ( "[LC;7173]" , "[LC;7174]" ) 
if abortquest == 1 then 
pc . setqf ( "ghostsleft" , 0 ) 
target . delete ( "__TARGET__" ) 
set_state ( "__GIVEUP__" ) 
else 
say_title ( "[LC;5973]" ) 
say ( "[LC;7288]" ) 
end 
return 
else 
say_title ( "[LC;5973]" ) 
say ( "[LC;6032]" ) 
end 
