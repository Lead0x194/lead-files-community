target . delete ( "__TARGET__" ) 
if pc . count_item ( "30149" ) > 0 then 
say_title ( "[LC;6407]" ) 
say ( "[LC;8378]" ) 
pc . remove_item ( 30149 , 1 ) 
say_reward ( "[LC;8379]" ) 
pc . give_exp2 ( 6e+06 ) 
say_reward ( "[LC;8380]" ) 
pc . give_item2 ( 71021 ) 
say_reward ( "[LC;8382]" ) 
pc . change_money ( 70000 ) 
clear_letter ( ) 
set_state ( "__COMPLETE__" ) 
else 
say_title ( "[LC;6407]" ) 
say ( "[LC;8383]" ) 
say_item_vnum ( 30149 ) 
wait ( ) 
say_pc_name ( ) 
say ( "[LC;8384]" ) 
local s = select ( "[LC;8385]" , "[LC;8386]" ) 
if s == 2 then 
say_pc_name ( ) 
say ( "[LC;8387]" ) 
clear_letter ( ) 
