quest subquest_5 begin
	state start begin
		when login or levelup with pc.level >= 10 and pc.level <= 15 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20023)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7067]")
			end
		end

		when __TARGET__.target.click or	20023.chat."[LC;7078]" with pc.level >= 10 begin
			target.delete("__TARGET__")
			say_title("[LC;7093]")
			say("[LC;7099]")

		     wait()

			 say_title("[LC;7093]")
			 say("[LC;7100]")
			 wait()

			 say_title("[LC;7093]")
			 say("[LC;7101]")
			local s= select("[LC;7102]", "[LC;7103]")
			if 2==s then
				say("[LC;7104]")
				local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;7093]")
						say("[LC;7066]")
						return
					end
				say_title("[LC;7093]")
				say("[LC;7068]")

				clear_letter()
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7093]")
			say("[LC;7069]")

			set_state(ask_to)

		end
	end

	state ask_to begin
		when info or button begin
			say_title("[LC;7070]")
                        			say_reward("[LC;7071]")
					end

		when letter begin
			send_letter("[LC;7070]")
		end



		when __TARGET__.target.click or	20011.chat."[LC;7072]" begin
			target.delete("__TARGET__")

			say_title("[LC;4223]")
			say("[LC;7073]")
			wait()

           say_title("[LC;4223]")
			say("[LC;7074]")

			set_state(return_to)
		end
	end

	state return_to begin
		when letter begin
			send_letter("[LC;7075]")
		end


		when info or button begin
			say_title("[LC;7076]")
			say_reward("[LC;7077]")
		end

		when __TARGET__.target.click or	20023.chat."[LC;7072]" begin
			target.delete("__TARGET__")
			say_title("[LC;7093]")
			say("[LC;7079]")

			local s = select(
				"[LC;7080]",
				"[LC;7081]",
				"[LC;7082]",
				"[LC;7083]"
			)

			if s == 2 then
				say_title("[LC;7093]")
				say("[LC;7084]")

				pc.give_exp2(6000)
				set_quest_state("levelup","run")
				pc.change_money(2000)

                say_title("[LC;192]")
				say_reward("[LC;7085]")
				
				clear_letter()

				set_state(__COMPLETE__)

			elseif s==4 then
				say_title("[LC;7093]")
				say("[LC;7086]")
				local s= select("[LC;7087]", "[LC;7088]")
				if 2==s then
					say("[LC;7050]")
					local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;7093]")
						say(nil)
						return
					end
					say_title("[LC;7093]")
					say("[LC;7068]")
					set_state(__GIVEUP__)
				end
				say_title("[LC;7093]")
				say("[LC;7091]")
				set_state(ask_to)

			else
				say_title("[LC;7093]")
				say("[LC;7092]")
				local s= select("[LC;7094]", "[LC;7095]")
				if 2==s then
					say("[LC;7050]")
					local a= select("[LC;2059]", "[LC;2035]")
						if  2==a then
							say_title("[LC;7093]")
							say("[LC;7066]")
							return
						end
					say_title("[LC;7093]")
					say("[LC;7068]")
					set_state(__GIVEUP__)
				end
				say_title("[LC;7093]")
				say("[LC;7098]")
				set_state(ask_to)
			end
		end
	end

	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
	end
end
