quest horse_exchange_ticket begin
	state start begin
		when 20349.chat."[LC;1557]" with pc.countitem("50005")>=1 begin
			say_title("[LC;1558]")
			say("[LC;1559]")
			local b= select("[LC;1560]", "[LC;13]")
			if 1==b then
				if pc.countitem("50005")>=1 then
					pc.removeitem("50005", 1)
					pc.give_item2("50050", 1)
					say("[LC;1561]")
				end
			elseif 2==b then
			else
				say(string.format("[LC;53;%s]", b))
			end
		end
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end

