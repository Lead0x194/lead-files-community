quest oxevent_manager begin
    state start begin
        
        function cleanup_event()
            oxevent.end_event()
            game.set_event_flag("ox_map_login_counter",0)
        end
        
        function check_limit()
            if game.get_event_flag("ox_map_login_counter") == game.get_event_flag("ox_map_player_max") then
                return 0
            else
                return 1
            end
        end

        function enter_level (vnum1,vnum2)
            lv_range={}
            lv_range[1] ={15,39}
            lv_range[2] ={40,64}
            lv_range[3] ={65,84}
            lv_range[4] ={85,99}
            lv_range[5] ={100,105}
            return lv_range [vnum1][vnum2]
        end
        
        when login or enter begin
            if pc.get_map_index() == 113 then
                local counter = game.get_event_flag("ox_map_login_counter")
                game.set_event_flag("ox_map_login_counter", counter+1)
            end
        end

				when logout begin
					if pc.get_map_index() == 113 then
						 if is_test_server() then
                pc.setqf("ox_end_cooldown_time", get_time() + 20*3)
            else
                pc.setqf("ox_end_cooldown_time", get_time()+60*15) -----------------------------------15 Minuten nun
            end
					end
				end
    
        when 20011.chat."[LC;6448]" begin

            say_title("[LC;4223]")
            say("[LC;6461]")
            wait()

            if game.get_event_flag("oxevent_status") == 0 then
                say_title("[LC;4223]")
                say("[LC;6474]")

            elseif game.get_event_flag("oxevent_status") == 1 then
                say_title("[LC;4223]")
                say("[LC;6482]")

                local s =  select("[LC;34]", "[LC;1891]")

                if s == 1 then
                    say_title("[LC;4223]")
                    say("[LC;6483]")
                    wait()
                    
                    -- read the limits that the admin set hopefully
                    local min = game.get_event_flag("ox_map_level_min")
                    local max = game.get_event_flag("ox_map_level_max")
                    
                    if pc.level < min or pc.level > max then
                        say_title("[LC;4223]")
                        say_reward(string.format("[LC;828;%s;%s]", min, max))
                        return
                    end
										
                    if get_time() < pc.getqf("ox_end_cooldown_time") then
                        say_title("[LC;4223]")
                        say("[LC;2129]")
												return
                    end
                    
                    
                    -- check again the limit before we warp the player, maybe someone have trigger the limit 
                    if  oxevent_manager.check_limit() == 0 then
                        say_title("[LC;4223]")
                        say("[LC;830]")
                        return
                    end
                    
                    -- removed the random warp, cause the current binary checks the coordinates.
                    --pc.warp(math.random(892973,899719), math.random(23256, 26044) )
                     pc.warp(896500, 24600)
                elseif s == 2 then
                    return
                end

            elseif game.get_event_flag("oxevent_status") == 2 then
                say_title("[LC;4223]")
                say("[LC;6484]")

            end
        end

        when 20358.chat."[LC;6485]" with pc.get_gm_level()== 5  begin

            local stat = oxevent.get_status()

            if stat == 0 then
            
                say("[LC;839]")
                local choice = select ("1> min "..oxevent_manager.enter_level(1,1).." max "..oxevent_manager.enter_level(1,2),"2> min "..oxevent_manager.enter_level(2,1).." max "..oxevent_manager.enter_level(2,2), "3> min "..oxevent_manager.enter_level(3,1).." max "..oxevent_manager.enter_level(3,2), "4> min "..oxevent_manager.enter_level(4,1).." max "..oxevent_manager.enter_level(4,2),  "5> min "..oxevent_manager.enter_level(5,1).." max "..oxevent_manager.enter_level(5,2), "[LC;1891]")
                if choice == 6 then
                    return
                end
                
                say("[LC;840]")
                local amount_choice = input_number("[LC;848]")

                 if amount_choice > 200 or amount_choice <= 0 then
                    say("[LC;849]")
                    return
                end

                say("[LC;6486]")
                say("[LC;842]")
                say("[LC;843]" .. " " .. oxevent_manager.enter_level(choice,1).. " - " ..oxevent_manager.enter_level(choice,2))
                say("[LC;844]" .. " " .. amount_choice)

                local s =  select("[LC;6487]", "[LC;1891]")

                if s == 1 then
                    local v = oxevent.open()

                    if v == 0 then
                        say("[LC;6447]")
                        say_reward("[LC;6449]")
                        
                    elseif v == 1 then
                        say("[LC;6450]")
                        notice_multiline("[LC;6451]",notice_all)
                        notice_multiline("[LC;6452]",notice_all)
                        -- set the limits we set previous asked
                        game.set_event_flag("ox_map_level_min",oxevent_manager.enter_level(choice,1))
                        game.set_event_flag("ox_map_level_max",oxevent_manager.enter_level(choice,2))
                        game.set_event_flag("ox_map_player_max",amount_choice)
                    else
                        say("[LC;6447]")
                    end
                end
            elseif stat == 1 then
                    say(string.format("[LC;6453;%s]", oxevent.get_attender()))

                    local s =  select("[LC;6454]", "[LC;1891]")

                    if s == 1 then
                        oxevent.close()
                        say("[LC;6455]")
                    end
            elseif stat == 2 then
                    say("[LC;6456]")

                    local s =  select(
                        "[LC;6457]", 
                        "[LC;6458]",  
                        "[LC;6459]",
                        "[LC;1891]"
                        )

                    if s == 1 then
                        local v = oxevent.quiz(1, 30)

                        if v == 0 then
                            say("[LC;6460]")
                        elseif v == 1 then
                            say("[LC;6462]")
                        else
                            say("[LC;6463]")
                        end
                    elseif s == 2 then
                        oxevent_manager.cleanup_event()
                        say("[LC;6464]")
                        notice_multiline("[LC;6465]",notice_all)
                        notice_multiline("[LC;6466]",notice_all)
                    elseif s == 3 then
                        oxevent_manager.cleanup_event()
                        say("[LC;6467]")
                        notice_multiline("[LC;6468]",notice_all)
                        notice_multiline("[LC;6469]",notice_all)
                    end
            elseif stat == 3 then
                    say("[LC;6470]")
                    say_reward("[LC;6471]")
            else
                    say("[LC;6472]")
                end
            end

        when 20358.chat."[LC;6473]" with pc.get_gm_level()== 5  begin
            say("[LC;6475]")

            local s =  select("[LC;6476]", "[LC;1891]")

            if s == 1 then
                oxevent.end_event_force()
                game.set_event_flag("ox_map_login_counter",0)
                say("[LC;6477]")
            end
        end

        when 20358.chat."[LC;6478]" with pc.get_gm_level()== 5  begin
            say("[LC;6479]")
            local item_vnum = input()
            say("[LC;6480]")
            local item_count = input()
            
            oxevent.give_item(item_vnum, item_count)

            say(string.format("[LC;6481;%s]", oxevent.get_attender()))
        end
    end
end
