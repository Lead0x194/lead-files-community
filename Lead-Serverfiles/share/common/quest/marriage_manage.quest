quest marriage_manage begin
    state start begin
	when oldwoman.chat."[LC;5485]" with not pc.is_engaged_or_married() begin
	    if not npc.lock() then
		say_title("[LC;1118]")
		say("[LC;5496]")
		return
	    end
	    if pc.level < 25 then
			say_title("[LC;617]")
			say("[LC;5507]")
			say_title("[LC;5519]")
			say_reward("[LC;5530]")
				npc.unlock()
		return
	    end

	    local m_ring_num = pc.countitem(70301)
	    local m_has_ring = m_ring_num > 0
	    if not m_has_ring then
		say_title("[LC;617]")
		say("[LC;5541]")
		say_item("[LC;5552]", 70301, "")
		say("[LC;5563]")
		npc.unlock()

		return
	    end

	    local m_sex = pc.get_sex()
		local m_nationality= pc.get_empire()
	    if not marriage_manage.is_equip_wedding_dress() then
		say_title("[LC;617]")
		say("[LC;5575]")

		if m_sex==0 then
		    say_item("[LC;5480]", marriage_manage.get_wedding_dress(m_sex), "")
		    say_reward("[LC;5486]")
		else
		    say_item("[LC;5487]", marriage_manage.get_wedding_dress(m_sex), "")
		    say_reward("[LC;5488]")
		end
				npc.unlock()
		return
	    end

	    local NEED_MONEY = 1000000
	    if pc.get_money() < NEED_MONEY then
		say_title("[LC;617]")
		say("[LC;5489]")
		say_reward("[LC;5490]")
		npc.unlock()
		return
	    end

	    say_title("[LC;617]")
	    say("[LC;5491]")
	    say_reward("[LC;5492]")

	    local sname = input()
	    if sname == "" then
		say_title("[LC;617]")
		say("[LC;5493]")
		npc.unlock()
		return
	    end

	    local u_vid = find_pc_by_name(sname)
	    local m_vid = pc.get_vid()
	    if u_vid == 0 then
		say_title("[LC;617]")
		say("[LC;5494]")
		say_reward(string.format("[LC;5495;%s]", sname))
				npc.unlock()
		return
	    end

	    if not npc.is_near_vid(u_vid, 10) then
		say_title("[LC;617]")
		say("[LC;5497]")
		say_reward(string.format("[LC;5498;%s]", sname))
				npc.unlock()
		return
	    end

	    local old = pc.select(u_vid)
	    local u_level = pc.get_level()
	    local u_job = pc.get_job()
	    local u_sex = pc.get_sex()
		local u_nationality= pc.get_empire()
	    local u_name = pc.name
	    local u_gold = pc.get_money()
	    local u_married = pc.is_married()
	    local u_has_ring = pc.countitem(70301) > 0
	    local u_wear = marriage_manage.is_equip_wedding_dress()
	    pc.select(old)
	    local m_level = pc.get_level()

	    if u_vid == m_vid then
		say_title("[LC;617]")
		say("[LC;5499]")
		say_reward("[LC;5500]")
				npc.unlock()
		return
	    end

	    if u_sex == m_sex then
		say_title("[LC;617]")
		say("[LC;5501]")
		npc.unlock()
		return
	    end

	    if u_nationality != m_nationality then
		say_title("[LC;617]")
		say("[LC;5502]")
		npc.unlock()
		return
	    end
	    if u_married then
		say_title("[LC;617]")
		say("[LC;5503]")
say_reward(string.format("[LC;5504;%s]", sname))
				npc.unlock()
		return
	    end

	    if u_level < 25 then
		say_title("[LC;617]")
		say("[LC;5505]")
		npc.unlock()
		return
	    end

	    if m_level - u_level > 15 or u_level - m_level > 15 then
		say_title("[LC;617]")
		say("[LC;5506]")
		npc.unlock()
		return
	    end

	    if not u_has_ring then
		if m_ring_num >= 2 then
		    say_title("[LC;617]")
		    say("[LC;5508]")
		else
		    say("[LC;5509]")
		end

		say_item("[LC;5552]", 70301, "")
		say_title("[LC;617]")
		say("[LC;5510]")
		npc.unlock()
		return
	    end

	    if not u_wear then
		say_title("[LC;617]")
		say("[LC;5511]")
		if u_sex==0 then
		    say_title("[LC;617]")
			say_item("[LC;5480]", marriage_manage.get_wedding_dress(u_sex), "")
		    say("[LC;5512]")
		else
		    say_title("[LC;617]")
		    say_item("[LC;5487]", marriage_manage.get_wedding_dress(u_sex), "")
		    say("[LC;5513]")
		end
			npc.unlock()
		return
	    end

	    local ok_sign = confirm(u_vid, string.format("[LC;5514;%s]",pc.name), 30) 

	    if ok_sign == CONFIRM_OK then
		local m_name = pc.name
		if pc.get_gold()>=NEED_MONEY then
		    pc.change_gold(-NEED_MONEY)

		    pc.removeitem(70301, 1)
		    pc.give_item2(70302, 1)
		    local old = pc.select(u_vid)
		    pc.removeitem(70301, 1)
		    pc.give_item2(70302, 1)
		    pc.select(old)

		    say_title("[LC;617]")
		    say("[LC;5515]")
		    wait()
		    setskin(NOWINDOW)
		    marriage.engage_to(u_vid)
		end
	    else
		say_title("[LC;617]")
		say("[LC;5516]")
	    end
	    	    npc.unlock()
	end
	
	when oldwoman.chat."[LC;5517]" with pc.is_engaged() begin
	    say_title("[LC;617]")
	    say("[LC;5518]")
	    wait()
	    setskin(NOWINDOW)
	    marriage.warp_to_my_marriage_map()
	end


	when 9011.chat."[LC;5520]" with pc.is_engaged() and marriage.in_my_wedding() begin
	    if not npc.lock() then
		say_title("[LC;5521]")
		say("[LC;5522]")
		return
	    end
	    say_title("[LC;5521]")
	    say("[LC;5523]")

	    local sname = input()
	    local u_vid = find_pc_by_name(sname)
	    local m_vid = pc.get_vid()

	    if u_vid == 0 then
			say_title("[LC;5521]")
			say("[LC;5524]")
			say_reward(string.format("[LC;5495;%s]", sname))
			npc.unlock()
		return
	    end

	    if not npc.is_near_vid(u_vid, 10) then
			say_title("[LC;5521]")
			say("[LC;5525]")
			say_reward(string.format("[LC;5526;%s]", sname))
			npc.unlock()
		return
	    end

	    if u_vid == m_vid then
		say_title("[LC;5521]")
		say("[LC;5527]")
		npc.unlock()
		return
	    end

	    if u_vid != marriage.find_married_vid() then
		say_title("[LC;5528]")
		say("[LC;5529]")
		npc.unlock()
		return
	    end

	    local ok_sign = confirm(u_vid, string.format("[LC;5514;%s]",pc.name), 30)
	    if ok_sign != CONFIRM_OK then
			say_title("[LC;5528]")
			say("[LC;5531]")
			npc.unlock()
			return
	    end
		say_title("[LC;5521]")
		say("[LC;5532]")
		marriage.set_to_marriage()
	    say("[LC;5533]")
	    npc.unlock()
	end

	function give_wedding_gift()
	    local male_item = {71072, 71073, 71074}
	    local female_item = {71069, 71070, 71071} 
	    if pc.get_sex() == MALE then
		pc.give_item2(male_item[number(1, 3)], 1)
	    else
		pc.give_item2(female_item[number(1, 3)], 1)
	    end
	end

	when 9011.chat."[LC;5534]" with 
	    	(pc.is_engaged() or pc.is_married()) and 
		marriage.in_my_wedding() and
		not marriage.wedding_is_playing_music() begin
	    marriage.wedding_music(true, "wedding.mp3")
	    setskin(NOWINDOW)
	end
	when 9011.chat."[LC;5535]" with 
	    	(pc.is_engaged() or pc.is_married()) and 
		marriage.in_my_wedding() and
		marriage.wedding_is_playing_music() begin
	    marriage.wedding_music(false, "default")
	    setskin(NOWINDOW)
	end
	when 9011.chat."[LC;5536]" with 
	    pc.is_married() and 
	    marriage.in_my_wedding() begin
	    marriage.wedding_dark(true)
	    setskin(NOWINDOW)
	end

	when 9011.chat."[LC;5537]" with pc.is_married() and marriage.in_my_wedding() begin
	    marriage.wedding_snow(true)
	    setskin(NOWINDOW)
	end

	when 9011.chat."[LC;5538]" with pc.is_married() and marriage.in_my_wedding() begin
	    if not npc.lock() then
		say_title("[LC;5528]")
		say("[LC;5539]")
		return
	    end

	    say_title("[LC;5521]")
	    say("[LC;5540]")
	    local s =  select("[LC;5542]", "[LC;5543]")
	    if s == 2 then
				local u_vid = marriage.find_married_vid()
				if u_vid == 0 then
			    say_title("[LC;5521]")
		  	  say("[LC;5544]")
			    npc.unlock()
		    return
		end
		say_title("[LC;5521]")
		say("[LC;5545]")
		local ok_sign = confirm(u_vid, "[LC;5546]", 30)
		if ok_sign == CONFIRM_OK then
		    marriage.end_wedding()
		else
		    say_title("[LC;5528]")
		    say("[LC;5547]")
		end

	    end
		npc.unlock()
	end

	
	when 	11000.chat."[LC;5548]" or
	    	11002.chat."[LC;5549]" or
		11004.chat."[LC;5549]" with pc.is_married() begin

	    if not marriage_manage.check_divorce_time() then
		return
	    end

	    local u_vid = marriage.find_married_vid()
	    if u_vid == 0 or not npc.is_near_vid(u_vid, 10) then
		say_title("[LC;1016]")
		say("[LC;5550]")
		return
	    end

	    say_title("[LC;1016]")
	    say("[LC;5551]")

	    local MONEY_NEED_FOR_ONE = 500000
	    local s =  select("[LC;1732]", "[LC;5553]")

	    if s == 1 then
		local m_enough_money = pc.gold > MONEY_NEED_FOR_ONE
		local m_have_ring = pc.countitem(70302) > 0

		local old = pc.select(u_vid)
		local u_enough_money = pc.gold > MONEY_NEED_FOR_ONE
		local u_have_ring = pc.countitem(70302) > 0
		pc.select(old)

		if not m_have_ring then
		    say("[LC;5554]")
		    return;
		end
		if not u_have_ring then
		    say("[LC;5555]")
		    return;
		end

		if not m_enough_money then
		    say_title("[LC;1016]")
		    say("[LC;5556]")
			say_reward(string.format("[LC;5557;%s]", MONEY_NEED_FOR_ONE/10000))
		    return;
		end
		if not u_enough_money then
		    say_title("[LC;1016]")
		    say("[LC;5556]")
		    say_reward("[LC;5558]")
		    		    return;
		end
		say_title("[LC;1016]")
		say("[LC;5559]")

		local c= select("[LC;1732]", "[LC;5560]")
		if 2 == c then
		    say_pc_name()
		    say("[LC;5561]")
		    wait()
		    say_title("[LC;1016]")
		    say("[LC;5562]")
		    say_reward("[LC;5564]")
		    		    return
		end

		local ok_sign = confirm(u_vid, pc.name.."[LC;5565]", 30)
		if ok_sign == CONFIRM_OK then

		    local m_enough_money = pc.gold > MONEY_NEED_FOR_ONE
		    local m_have_ring = pc.countitem(70302) > 0

		    local old = pc.select(u_vid)
		    local u_enough_money = pc.gold > MONEY_NEED_FOR_ONE
		    local u_have_ring = pc.countitem(70302) > 0
		    pc.select(old)

		    if m_have_ring and m_enough_money and u_have_ring and u_enough_money then
			pc.removeitem(70302, 1)
			pc.change_money(-MONEY_NEED_FOR_ONE)

			local old = pc.select(u_vid)
			pc.removeitem(70302, 1)
			pc.change_money(-MONEY_NEED_FOR_ONE)
			pc.select(old)

			say_title("[LC;1016]")
			say("[LC;5566]")
			say_reward("[LC;5564]")
						marriage.remove()
		    else
			say_title("[LC;1016]")
			say("[LC;5567]")
			say_reward("[LC;5568]")
					    end
		else
		    say_title("[LC;1016]")
		    say("[LC;5569]")
		    say_reward("[LC;5568]")
		    		end
	    end
	end

	when 	11000.chat."[LC;5570]" or
	    	11002.chat."[LC;5571]" or
		11004.chat."[LC;5571]" with 
			not pc.is_married() 	and 
			pc.count_item(70302)>0
			begin
		say_title("[LC;1016]")
		say("[LC;5572]")
		say_reward("[LC;5573]")
		pc.remove_item(70302)
	end

	when 	11000.chat."[LC;5574]" or
	    	11002.chat."[LC;5574]" or
		11004.chat."[LC;5574]" with pc.is_married() begin

	    if not marriage_manage.check_divorce_time() then
		return
	    end

	    say_title("[LC;5576]")
	    say("[LC;5577]")

	    local s =  select("[LC;1732]", "[LC;5578]")

	    local NEED_MONEY = 1000000
	    if s == 2 then
		return
	    end

	    if pc.money < NEED_MONEY then
		say_title("[LC;1016]")
		say("[LC;5579]")
		return
	    end

	    say_title("[LC;1016]")
	    say("[LC;5580]")

	    local c =  select("[LC;5581]", "[LC;5582]")

	    if c == 2 then
		say_title("[LC;1016]")
		say("[LC;5583]")
		return
	    end

	    pc.removeitem(70302, 1)
	    pc.change_gold(-NEED_MONEY)

	    marriage.remove()

	    say_title("[LC;1016]")
	    say("[LC;5584]")
	end

	when oldwoman.chat."[LC;5479]" with not pc.is_engaged() begin
	    local t = marriage.get_wedding_list()
	    if table.getn(t) == 0 then
		say_title("[LC;617]")
		say("[LC;5481]")
	    else
		local wedding_names = {}
		table.foreachi(t, function(n, p) wedding_names[n] = string.format("[LC;5482;%s;%s]",p[3],p[4]) end)
		wedding_names[table.getn(t)+1] = locale.confirm
		local s = select_table(wedding_names)

		if s != table.getn(wedding_names) then
		    marriage.join_wedding(t[s][1], t[s][2])
		end
	    end
	end
	when 9011.click with not pc.is_engaged() and not pc.is_married() begin
	    say_title("[LC;5521]")
	    say("[LC;5483]")
	end

	function check_divorce_time()

	    local DIVORCE_LIMIT_TIME = 86400

	    if is_test_server() then
		DIVORCE_LIMIT_TIME = 60
	    end

	    if marriage.get_married_time() < DIVORCE_LIMIT_TIME then 
		say_title("[LC;1016]")
		say("[LC;5484]")
		return false
	    end

	    return true
	end

	function is_equip_wedding_dress()
	    local a = pc.get_armor()
	    return a >= 11901 and a <= 11904
	end
	function get_wedding_dress(pc_sex)
		if 0==pc_sex then
		    return 11901
		else
		    return 11903
		end
	end
    end
end

