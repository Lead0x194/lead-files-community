quest find_squareguard begin
	state start begin
	end

	state run begin
		when login with pc.level<=5 begin
			set_state(find)
		end
	end
	state find begin
		when letter begin
			local find_npc_vnum = 0
			if pc.get_empire()==1 then
				find_npc_vnum = 11000
			elseif pc.get_empire()==2 then
				find_npc_vnum = 11002
			elseif pc.get_empire()==3 then
				find_npc_vnum = 11004
			end

			local v=find_npc_by_vnum(find_npc_vnum)
			if 0==v then
			else
				target.vid("__TARGET__1", v, "[LC;1001]")
			end
		end
		when letter begin
			send_letter("[LC;1001]")
		end
		when button or info begin
			say_title("[LC;44]")
			say("[LC;1013]")
		end
		when __TARGET__1.target.click begin
			target.delete("__TARGET__1")
			say_title("[LC;1016]")
			say("[LC;1017]")
			local b= select("[LC;1018]")
			if 1==b then
				say_title("[LC;44]")
				say_reward("[LC;1019]")
				pc.changemoney(200)
				set_state(buy)
			elseif 2==b then
			else
				say(string.format("[LC;1020;%s]", b))
			end
		end
	end
	state buy begin
		when letter begin
			send_letter("[LC;1021]")
	
			local v=find_npc_by_vnum(9003)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;1005]" )
			end

		end
		when button or info begin
			say_title("[LC;44]")
			say("[LC;1022]")
		end
		when 11000.chat."[LC;1000]" or 11002.chat."[LC;1000]" or 11004.chat."[LC;1000]" begin
			say_title("[LC;1002]")
			say("[LC;1003]")
		end
		when __TARGET__.target.click  begin 
			target.delete("__TARGET__")
			say_title("[LC;1004]")
      		say("[LC;1006]")
	  		wait()
	  		say_title("[LC;1004]")
	  		say("[LC;1007]")
	  		wait()
	  		say_title("[LC;44]")
	  		say_reward("[LC;1008]")
	  		----------"12345678901234567890123456789012345678901234567890"|
	  		say_reward("[LC;1009]")
			pc.give_item2(27001,5)
			setstate(deliver)
		end
	end
	state deliver begin
		when letter begin
			local find_npc_vnum = 0
			if pc.get_empire()==1 then
				find_npc_vnum = 11000
			elseif pc.get_empire()==2 then
				find_npc_vnum = 11002
			elseif pc.get_empire()==3 then
				find_npc_vnum = 11004
			end

			local v=find_npc_by_vnum(find_npc_vnum)
			if 0==v then
			else
				target.vid("__TARGET__1", v, "[LC;1001]")
			end
		end
		when letter begin
			send_letter("[LC;1010]")
		end
		when button or info begin
			say_title("[LC;44]")
			say("[LC;1011]")
		end
		
		when __TARGET__1.target.click with pc.countitem("27001")<1 begin
			target.delete("__TARGET__1")
			say_title("[LC;1016]")
			say("[LC;1012]")
			-- genereate a error, we have another quest for the skills. Here are the orignal korean linked
			-- set_quest_state("find_skillteacher", "find")
			clear_letter()
			set_state(__COMPLETE__)
		end
		when __TARGET__1.target.click with pc.countitem("27001")>=1 begin
			target.delete("__TARGET__1")
			
			say_title("[LC;1016]")
			say("[LC;1014]")
			wait()
			say_title("[LC;1016]")
			say("[LC;1015]")
			if pc.countitem("27001")>=1 then
				pc.removeitem("27001", 1)
				local r=number(1, 3)
				if r==1 then
					pc.give_item2("14000", 1)
				elseif r==2 then
					pc.give_item2("16000", 1)
				elseif r==3 then
					pc.give_item2("17000", 1)
				end
			end
			clear_letter()
			set_state(__COMPLETE__)
			-- genereate a error, we have another quest for the skills. Here are the orignal korean linked
			-- set_quest_state("find_skillteacher", "find")
		end
	end
	state __COMPLETE__ begin
	end
end
