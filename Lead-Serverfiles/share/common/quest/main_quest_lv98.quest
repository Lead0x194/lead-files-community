	state state4_3 begin
		when letter begin
			send_letter("[LC;5395]")
			
			local v = find_npc_by_vnum(YACKHWAN)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(YACKHWAN))
			end
		end
		when button or info begin
			say_title("[LC;5395]")
			say("[LC;5420]")
			say("")
			say_reward({})
			say("")
		end
		
		when YACKHWAN.chat."[LC;5395]" begin
			target.delete("__TARGET__")
			
