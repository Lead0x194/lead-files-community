			say_title(locale.reward)
			say_reward(string.format ("[LC;4537;%d]", REWARD4_EXP))
			say_reward(string.format ("[LC;4538;%d]", REWARD4_GOLD))
			say_reward(string.format ("[LC;4540;%s]", item_name(REWARD4_ITEM1),REWARD4_ITEM1_COUNT,locale.count_postfix))
			say_reward(string.format ("[LC;4540;%s]", item_name(REWARD4_ITEM2),REWARD4_ITEM2_COUNT,locale.count_postfix))
			say("")
			
			pc.give_exp2(REWARD4_EXP)
			pc.change_money(REWARD4_GOLD)
			pc.give_item2(REWARD4_ITEM1, REWARD4_ITEM1_COUNT)
			pc.give_item2_select(REWARD4_ITEM2)
			item.set_socket(2, 60)
				
			set_state (state5_1)
		end
	end
	state state5_1 begin
		when letter begin
			send_letter("[LC;5408]")
			
			local v = find_npc_by_vnum(GUARD)
