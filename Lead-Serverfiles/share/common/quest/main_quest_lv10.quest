quest main_quest_lv10 begin
	state start begin
	end
	state run begin
		when login or levelup or enter with pc.get_level() >= 10 begin
				set_state ( gotoboss )
		end

	end
	state gotoboss begin
		when letter begin
			send_letter("[LC;4070]")
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4070]")
			end
		end
		when button or info begin
			say_title("[LC;4070]")
                        			say_reward("[LC;4081]")
                        		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
                        say_title("[LC;4082]")
			say("[LC;4083]")
			wait()

                        say_title("[LC;4082]")
                        			 ---							1
			say("[LC;4084]")
                        wait()

                        say_title("[LC;4082]")
			say("[LC;4085]")
			wait()

                        say_title("[LC;4082]")
			say("[LC;4086]")
                        wait()

			say_title("[LC;4082]")
			say("[LC;4087]")
                        wait()

                        say_title("[LC;4082]")
			say("[LC;4088]")
                        say_title("[LC;192]")
                        			say_reward("[LC;4069]")
                        			set_state (gotomusition)
		end
	end

	state gotomusition begin
		when letter begin
			local v=find_npc_by_vnum(20017)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;3738]")
			end
		end
		when letter begin
			send_letter("[LC;3738]")
		end
		when button or info begin
			say_title("[LC;4071]")
            say("[LC;4072]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;4073]")
			say("[LC;4074]")
			wait()

                        say_title("[LC;4073]")
			say("[LC;4075]")
			wait()

			say_title("[LC;4076]")
                        say("[LC;4077]")
			set_state (gotoboss2)
		end
	end
	state gotoboss2 begin
		when letter begin
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4078]")
			end
		end
		when letter begin
			send_letter("[LC;4078]")
		end
		when button or info begin
			say_title("[LC;4071]")
			say("[LC;4079]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;4082]")
			say("[LC;4080]")
			say_title("[LC;192]")
                        			say_reward("[LC;4069]")
                        			pc.give_exp2( 5000 )
			pc.change_money( 2000 )
						clear_letter()
			set_state ( __COMPLETE__ )
			set_quest_state("main_quest_lv12", "run")
		end
	end
	state __COMPLETE__ begin
	end
end
