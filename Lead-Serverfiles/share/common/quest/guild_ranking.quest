quest guild_ranking begin
	state start begin
		when guild_man1.chat."[LC;3560]" or guild_man2.chat."[LC;3560]" or guild_man3.chat."[LC;3560]" with pc.hasguild() begin
			say_title("[LC;1016]")
			say(string.format("[LC;1369;%s]", guild.around_ranking_string()))
		end
		when guild_man1.chat."[LC;3561]" or guild_man2.chat."[LC;3561]" or guild_man3.chat."[LC;3561]" with pc.hasguild() begin
			say_title("[LC;1016]")
			say(string.format("[LC;1370;%s]", guild.high_ranking_string()))
		end
		when guild_man1.chat."[LC;3559]" or guild_man2.chat."[LC;3559]" or guild_man3.chat."[LC;3559]" with pc.hasguild() begin
			say_title("[LC;1016]")
			say(string.format("[LC;1371;%s]", guild.get_rank()))
			say(string.format("[LC;1372;%s]", guild.get_ladder_point()))
		end
	end
end


