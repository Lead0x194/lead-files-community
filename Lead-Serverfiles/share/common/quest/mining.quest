quest mining begin
	state start begin
		when 20015.chat."[LC;1024]" begin
			setskin(NOWINDOW)
			npc.open_shop()
		end

		when 20015.take with item.vnum >= 29101 and item.vnum < 29110 and item.get_socket(0) != item.get_value(2) begin
			
			say_title("[LC;5585]")
			say("[LC;5586]")
		end
		when 20015.take with item.vnum >= 29101 and item.vnum < 29110 and item.get_socket(0) == item.get_value(2) begin
			say_title("[LC;5585]")

			say(string.format("[LC;5587;%s]",  item.get_level()))
			if item.get_value(3) == 100 then
			say_title("[LC;5585]")
				say("[LC;5588]")
			else
			say_title("[LC;5585]")
				say(string.format("[LC;5589;%s]",  100-item.get_value(3)))
			end

			local s =  select("[LC;2059]", "[LC;2035]")
			if s == 2 then
			say_title("[LC;5585]")
				say("[LC;5590]")
				return
			end
			
			local f = __refine_pick(item.get_cell())
			if f == 2 then 
			say_title("[LC;5585]")

				say("[LC;5591]")
			elseif f == 1 then 
			say_title("[LC;5585]")
				say("[LC;5592]")
			else 
			say_title("[LC;5585]")
				say("[LC;5593]")
			end
		end

		when 20047.click or	20048.click or	20049.click or	20050.click or	20051.click or	20052.click or	20053.click or	20054.click or	20055.click or	20056.click or	20057.click or	20058.click or	20059.click
			or 30301.click or 30302.click or 30303.click or 30304.click or 30305.click 
		begin
			if pc.is_mount() != true then
				pc.mining()
			end
		end
	end
end


