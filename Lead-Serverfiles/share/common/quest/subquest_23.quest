quest subquest_23 begin
    state start begin
		when login or levelup with pc.level >= 36  and pc.level <= 38 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v= find_npc_by_vnum(20006)
			if v!= 0 then
				target.vid("__TARGET__",v, "[LC;7582]")
			end
		end

		when __TARGET__.target.click or	20006.chat."[LC;7593]"  begin
	    	target.delete("__TARGET__")
			say_title("[LC;944]")
			say("[LC;7604]")
			wait()
						say_title("[LC;944]")
			say("[LC;7615]")
			local s= select("[LC;971]", "[LC;7616]")
			if 2==s then
				say("[LC;7617]")
				local a= select("[LC;2059]", "[LC;2035]")
					if 2==a then
						say_title("[LC;944]")
						say("[LC;7618]")
						return
					end
					say_pc_name()
					say("[LC;7619]")
					set_state(__GIVEUP__)
					return
				end
				say_pc_name()
				say("[LC;7620]")
				set_state(to_youhwan)

		end
	end
    state to_youhwan begin
		when letter begin

			send_letter("[LC;7581]")
			local v= find_npc_by_vnum(20017)
			if v!= 0 then
				target.vid("__TARGET__",v, "[LC;7583]")
			end

		end
		when button or info begin
			say_title("[LC;7583]")
			say("[LC;7584]")
		end


		when __TARGET__.target.click or	20017.chat."[LC;7585]" begin
			target.delete("__TARGET__")
			say_title("[LC;14]")
			say("[LC;7586]")
			set_state(to_hunter)
		end
	end


	state to_hunter begin
		when letter begin

			send_letter("[LC;7587]")
			local v= find_npc_by_vnum(20019)
			if v!= 0 then
				target.vid("__TARGET__",v, "[LC;7588]")
			end

		end
		when button or info begin
			say_title("[LC;7588]")
			say("[LC;7589]")
		end


		when __TARGET__.target.click or	20019.chat."[LC;7590]" begin
			target.delete("__TARGET__")
			say_title("[LC;4275]")
			say("[LC;7591]")
			wait()
			say_title("[LC;4275]")
			say("[LC;7592]")
			local s= select("[LC;7594]", "[LC;939]")
			if 2==s then
				say("[LC;7595]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2== a then
					say_pc_name()
					say("[LC;7596]")
					return
				end
				say_pc_name()
				say("[LC;7597]")
				set_state(__GIVEUP__)
				return
			end
			say_pc_name()
			say("[LC;7598]")
			set_state(to_danger_place)
		end
	end

	 state to_danger_place begin
		when letter begin

			send_letter("[LC;7599]")
			local v= find_npc_by_vnum(20356)
			if v!= 0 then
				target.vid("__TARGET__",v, "[LC;7600]")
			end

		end
		when button or info begin
			say_title("[LC;7601]")
			say("[LC;7602]")
		end


		when __TARGET__.target.click or	20356.chat."[LC;7603]" begin
			target.delete("__TARGET__")
			say_pc_name()
			say("[LC;7605]")
			pc.give_item2(16082)
			pc.give_item2(30155)
			set_state(to_mirinae)
		end
	end



	 state to_mirinae  begin
		when letter begin

			send_letter("[LC;7606]")
			local v= find_npc_by_vnum(20006)
			if v!= 0 then
				target.vid("__TARGET__",v, "[LC;7606]")
			end

		end
		when button or info begin
			say_title("[LC;7607]")
			say("[LC;7608]")
		end


		when __TARGET__.target.click or	20006.chat."[LC;7609]" with pc.count_item(16082)>0 and pc.count_item(30155)>0 begin
			target.delete("__TARGET__")
			say_title("[LC;944]")
			say("[LC;7610]")
			wait()
			say_title("[LC;944]")
			say("[LC;7611]")
			wait()
			say_title("[LC;944]")
			say("[LC;7612]")
			wait()
			say_title("[LC;944]")
			say("[LC;7613]")
			pc.remove_item(30155,1)

			say_reward("[LC;7614]")
			pc.give_exp2(600000)
			pc.change_money(35000)

			clear_letter()
			set_state(__COMPLETE__)
		end
	end

	state __GIVEUP__ begin
	end
	state __COMPLETE__  begin
		when enter begin
			q.done()
		end
	end
end

