quest main_quest_flame_lv102 begin
	state start begin
	end
	state state0 begin
		when login or levelup or enter with pc.level >= 102 begin
			set_state (state1_1)
		end
	end
	
	state state1_1 begin 
		when letter begin 
			send_letter("[LC;3838]") 
			local v = find_npc_by_vnum(20377) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20377))
			end
		end

		when button or info begin 
			say_title("[LC;3838]") 
			say("[LC;3839]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20377.chat."[LC;3838]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(20377)) 
			say("[LC;3840]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;3841]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3842]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;3843]") 
			set_state (state1_2)
		end

		when leave begin 
			--q.done()
		end
	end
	
    state state1_2 begin
		when enter begin 
			notice_multiline("[LC;3844]",notice)
		end

		when letter begin 
			send_letter("[LC;3838]") 
			q.set_counter_name("[LC;5362]")
			main_quest_flame_lv102.kill_count() 
 		end
        
		when button or info begin 
			say_title("[LC;3845]") 
			say("[LC;3846]") 
			local remain1 = 30 - pc.getqf("mob1")
			if remain1 < 0 then
				remain1 = 0
			end
			local remain2 = 30 - pc.getqf("mob2")
			if remain2 < 0 then
				remain2 = 0
			end
			local remain3 = 30 - pc.getqf("mob3")
			if remain3 < 0 then
				remain3 = 0
			end
			local remain4 = 30 - pc.getqf("mob4")
			if remain4 < 0 then
				remain4 = 0
			end
			say("[LC;5362]")
			say(string.format("[LC;3847;%s;%d;%s;%d]",mob_name(6005), remain1,mob_name(6006), remain2))
			say(string.format("[LC;3848;%s;%d;%s;%d]",mob_name(6007), remain3,mob_name(6008), remain4))
		end

		when 20377.chat."[LC;3838]" begin 
			say_title(mob_name(20377)) 
			say("[LC;3849]") 
		end

		when 6005.kill begin
			if number(1,1) == 1 then
				local kill_count = pc.getqf("mob1")
				pc.setqf("mob1", kill_count + 1)
				main_quest_flame_lv102.kill_count() 
			end
		end

		when 6006.kill begin
			if number(1,1) == 1 then
				local kill_count = pc.getqf("mob2")
				pc.setqf("mob2", kill_count + 1)
				main_quest_flame_lv102.kill_count() 
			end
		end

		when 6007.kill begin
			if number(1,1) == 1 then
				local kill_count = pc.getqf("mob3")
				pc.setqf("mob3", kill_count + 1)
				main_quest_flame_lv102.kill_count() 
			end
		end

		when 6008.kill begin
			if number(1,1) == 1 then
				local kill_count = pc.getqf("mob4")
				pc.setqf("mob4", kill_count + 1)
				main_quest_flame_lv102.kill_count() 
			end
		end
		
		function kill_count()
			local total_remain = 0
			local remain1 = 30 - pc.getqf("mob1")
			if remain1 < 0 then
				remain1 = 0
			end
			local remain2 = 30 - pc.getqf("mob2")
			if remain2 < 0 then
				remain2 = 0
			end
			local remain3 = 30 - pc.getqf("mob3")
			if remain3 < 0 then
				remain3 = 0
			end
			local remain4 = 30 - pc.getqf("mob4")
			if remain4 < 0 then
				remain4 = 0
			end
			total_remain = remain1 + remain2 + remain3 + remain4
			q.set_counter_value(total_remain)
            if total_remain == 0 then
				set_state ("state1_3")
			end
		end

		when leave begin 
			--q.done()
		end
	end
