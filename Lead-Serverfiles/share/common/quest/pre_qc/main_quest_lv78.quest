quest main_quest_lv78 begin
	state start begin
	end
	state state_0 begin
		when login or levelup or enter with pc.level >= 78 begin
			set_state (state_1)
		end
	end
	state state_1 begin
		when letter begin
			local v = find_npc_by_vnum (20369)
			if v != 0 then
				target.vid ("__TARGET__",v,"")
			end
			send_letter("[LC;4685]")
		end
		when button or info begin
			say_title("[LC;4685]")
			say ("[LC;4696]")
		end
		when 20369.chat."[LC;4685]" begin
			target.delete("__TARGET__")
			say_title ("[LC;4590]")
			say("[LC;4707]")
			wait()
			say_title ("[LC;4590]")
			say("[LC;4708]")
			set_state (make_red_bead)
		end
	end
	state make_red_bead begin
		when enter begin
			pc.setqf ("first_make_time", 0)
		end
		when 2205.kill or 2204.kill or 2203.kill begin
			if number(1, 500) == 1 then
				pc.give_item2 (31007, 1)
			end
		end
		when 20369.chat."[LC;4685]" begin
			if pc.count_item (31006) >= 20 then
				say_title (mob_name(20369))
				say(string.format("[LC;4709;%d]", 20))
				wait()
				
				say_title (locale.reward)
				say_reward(string.format("[LC;4537;%d]", 36000000))
				say_reward(string.format("[LC;4540;%s]", item_name(72725)))
				say_reward(string.format("[LC;4540;%s]", item_name(70024)))
				say_reward(string.format("[LC;4540;%s]", item_name(70004)))

				pc.give_exp2(36000000)
				
				pc.give_item2(72725)
				pc.give_item2(70024)
				pc.give_item2(70004)
				pc.remove_item (31006, pc.count_item (31006))
				set_state (state_2)
				return
			end
			local t = get_global_time()
			local today = t - math.mod (t, 86400)
			if pc.getqf ("first_make_time") != today then
				pc.setqf ("first_make_time", today)
				pc.setqf ("make_count", 0)
			end
			if pc.count_item (90010) < 1 or pc.count_item (30019) < 1 or 
					pc.count_item (31007) < 1 then
				say_title ("[LC;4590]")
				say ("[LC;4710]")
				return
			end
			local n = pc.getqf ("make_count")
			if n >= 7 then
				say_title ("[LC;4590]")
				say("[LC;4711]")
				return
			else
				pc.remove_item(90010, 1)
				pc.remove_item(30019, 1)
				pc.remove_item(31007, 1)
				say_title("[LC;4590]")
				say("[LC;4712]")
				wait()
				pc.setqf ("make_count", n + 1)
				local n = number (1,100)
				if n > 60 then 
				say_title ("[LC;4590]")
					say("[LC;4713]")
					wait()
				elseif pc.count_item (31006) < 20 then
					pc.give_item2 (31006, 1)
				say_title ("[LC;4590]")
					say("[LC;4684]")
					say_item_vnum(31006)
					wait ()
				else 
					say_title (mob_name(20369))
					say(string.format("[LC;4709;%d]", 20))
					wait()
					
					say_title (locale.reward)
					say_reward(string.format ("[LC;4537;%d]", 36000000))
					say_reward(string.format ("[LC;4540;%s]", item_name(72725)))
					say_reward(string.format ("[LC;4540;%s]", item_name(70024)))
					say_reward(string.format ("[LC;4540;%s]", item_name(70004)))

					pc.give_exp2(36000000)
					
					pc.give_item2(72725)
					pc.give_item2(70024)
					pc.give_item2(70004)
					pc.remove_item (31006, pc.count_item (31006))
					set_state (state_2)
				end
			end
		end
	end
	state state_2 begin
		when letter begin
			local v = find_npc_by_vnum (20369)
			if v != 0 then
				target.vid ("__TARGET__",v,"")
			end
			send_letter ("[LC;4686]")
		end
		when button or info begin
			say_title ("[LC;4686]")
			say("[LC;4687]")
		end
		when 20369.chat."[LC;4686]" with pc.count_item (31004) < 100 begin
			target.delete("__TARGET__")
			say_title ("[LC;4590]")
			say("[LC;4688]")
			wait()
			say_title ("[LC;4590]")
			say("[LC;4689]")
		end
		when 2315.kill or 2314.kill begin
			if number (1, 300) == 1 then
				pc.give_item2 (31004, 1)
				local n = pc.count_item (31004)
				if n < 100 then
					notice (string.format("[LC;4690;%d]", 100 - n))
				else
					notice_multiline("[LC;4691]", notice)
				end
			end
		end
		when 20369.chat."[LC;4686]" with pc.count_item (31004) >= 100 begin
			say_title ("[LC;4590]")
			say("[LC;4692]")
			wait()
			say_title (	pc.getname())
			say("[LC;4693]")
			wait()
			say_title ("[LC;4590]")
			say("[LC;4694]")
			wait()
			say_title ("[LC;4590]")
			say("[LC;4695]")
			wait()
			say_title (locale.reward)
			say_reward(string.format("[LC;4537;%d]", 48000000))
			say_reward(string.format("[LC;4538;%d]", 230000))
			say_reward(string.format("[LC;4540;%s]", item_name(72729)))
			say_reward(string.format("[LC;4540;%s]", item_name(70035)))
			say_reward(string.format("[LC;4540;%s]", item_name(70003)))

			pc.give_exp2(48000000)
			pc.change_money(230000)
			
			pc.give_item2(72729)
			pc.give_item2(70035)
			pc.give_item2(70003)
			pc.remove_item (31004, pc.count_item (31004))
			set_state (state_3)
		end
	end
	state state_3 begin
		when letter begin
			local v = find_npc_by_vnum (20018)
			if v != 0 then
				target.vid ("__TARGET__",v,"")
			end
			send_letter ("[LC;4697]")
		end
		when button or info begin
			say_title ("[LC;4697]")
			say("[LC;4698]")
		end
		when 20018.chat."[LC;4697]" begin
			target.delete("__TARGET__")
			say_title ( mob_name(20018))
			say("[LC;4699]")
			wait()
			say_title ( pc.get_name ())
			say("[LC;4700]")
			wait()
			say_title ( mob_name(20018))
			say("[LC;4701]")
			wait()
			say_title ( pc.get_name ())
			say("[LC;4702]")
			wait()
			say_title ( mob_name(20018))
			say("[LC;4703]")
			wait()
			say_title ( pc.get_name ())
			say("[LC;4704]")
			wait()
			say_title ( mob_name(20018))
			say("[LC;4705]")
			wait()
			say_title(locale.reward)
			say_reward(string.format("[LC;4540;%s]", item_name(30319).." ".."2"..locale.count_postfix))
			pc.give_item2(30319,2) 
			wait()
			say("[LC;4706]")
			set_state (__COMPLETE__)
			q.done()
			set_quest_state("main_quest_lv84", "state_0")

		end
	end
	state __COMPLETE__ begin
	end
end
