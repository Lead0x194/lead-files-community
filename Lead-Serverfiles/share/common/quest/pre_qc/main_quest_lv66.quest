			say("[LC;4605]")
		end
		when 20369.chat."[LC;4600]" begin
			target.delete("__TARGET__")
			pc.remove_item (31003, 1)
			if (pc.getqf ("state_8_start") + 30 * 60 - get_global_time()) >= 0 then
				q.done()
				say_title ("[LC;4590]")
				say("[LC;4606]")
				wait()
				say_title ("[LC;4590]")
				say("[LC;4607]")
				wait()
				say_title (locale.reward)
