				say_reward(string.format("[LC;4540;%s]", item_name(30033)))
				say_reward(string.format("[LC;4540;%s]", item_name(50727).." ".."10"..locale.count_postfix))
				say_reward(string.format("[LC;4540;%s]", item_name(50728).." ".."10"..locale.count_postfix))

				pc.give_exp2(2900000)
				pc.change_money(200000)
				
				pc.give_item2(30033)
				pc.give_item2(50727, 10)
				pc.give_item2(50728, 10)

			else
			
				say_title("[LC;4590]")
				say("[LC;4608]")						
				wait()
				say_title("[LC;4590]")
				say("[LC;4609]")
