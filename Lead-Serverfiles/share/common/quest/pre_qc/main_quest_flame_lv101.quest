			say("[LC;3830]") 
			wait()

			say_title(mob_name(20380)) 
			say("[LC;3831]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3820]") 
			wait()

			set_state (state3_2)
		end

		when leave begin 
