			target.delete("__TARGET__") 
			say_title(mob_name(20377)) 
			say("[LC;3835]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;3836]") 
			wait()
			say_title("[LC;4182]")
			say_reward(string.format("[LC;4537;%d]", 48584000))
			pc.give_exp2( 48584000)
			say_reward(string.format("[LC;4538;%d]", 156000))
			pc.change_money( 156000)
			say_reward(string.format("[LC;4540;%s]", item_name(71095),1))
			pc.give_item2(71095, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(72016),1))  -- 제3의 손
			pc.give_item2_select(72016)
			item.set_socket(2, 60)
			say()
			say_title(string.format("[LC;4060]", 102))
			set_state (__COMPLETE__)
			set_quest_state ("main_quest_flame_lv102", "state0")
		end

		when leave begin 
			--q.done()
		end
	end
	
	state __COMPLETE__ begin
		when enter begin
			--q.done()
		end
	end
	
end