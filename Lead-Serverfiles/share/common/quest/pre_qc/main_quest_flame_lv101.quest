quest main_quest_flame_lv101 begin
	state start begin
	end
	state state0 begin
		when login or levelup or enter with pc.level >= 101 begin
			set_state (state1_1)
		end
	end
	
	state state1_1 begin 
		when letter begin 
			send_letter("[LC;3791]") 
			local v = find_npc_by_vnum(20377) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20377))
			end
		end

		when button or info begin 
			say_title("[LC;3791]") 
			say("[LC;3792]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20377.chat."[LC;3791]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(20377)) 
			say("[LC;3793]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;3794]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;3795]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3796]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;3797]")  
			set_state (state1_2)
		end

		when leave begin 
			--q.done()
		end
	end
	state state1_2 begin
		when enter begin 
			notice_multiline("[LC;3798]",notice)
		end

		when letter begin 
			send_letter("[LC;3791]") 
			q.set_counter_name("[LC;5362]")
			q.set_counter_value(2)
 		end

		when button or info begin 
			say_title("[LC;3799]") 
			say("[LC;3800]") 
			
			say("[LC;5362]")
			say(string.format("[LC;4769;%s;%d]", item_name(31074), 1))
			say(string.format("[LC;4769;%s;%d]", item_name(31079), 1))
			say()
			say_reward("[LC;3801]")
		end

		when 20377.chat."[LC;3791]" begin 
			say_title(mob_name(20377)) 
			say("[LC;3802]") 
		end
		
		when 20393.click begin
			say("[LC;3803]")
			set_state (state1_3)
		end
		
		when kill with pc.get_map_index() >= 351 * 10000 and pc.get_map_index() < (351 + 1) *10000 begin
			if number(1,100) == 1 then
				pc.give_item2(31074, 1)
				set_state (state1_4)
			end
		end

		when leave begin 
			--q.done()
		end
	end
	state state1_3 begin
		when enter begin 
			notice_multiline("[LC;3804]",notice)
		end

		when letter begin 
			send_letter("[LC;3791]") 
			q.set_counter_name("[LC;5362]")
			q.set_counter_value(1)
 		end

		when button or info begin 
			say_title("[LC;3799]") 
			say("[LC;3800]") 
			
			say("[LC;5362]")
			say(string.format("[LC;4769;%s;%d]", item_name(31074), 1))
			say(string.format("[LC;4769;%s;%d]", item_name(31079), 0))
			say()
			say_reward("[LC;3801]")
		end

		when 20377.chat."[LC;3791]" begin 
			say_title(mob_name(20377)) 
			say("[LC;3805]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;3806]") 
		end
		
		when kill with pc.get_map_index() >= 351 * 10000 and pc.get_map_index() < (351 + 1) *10000 begin
			if number(1,100) == 1 then
				pc.give_item2(31074, 1)
				set_state ("state1_5")
			end
		end

		when leave begin 
			--q.done()
		end
	end
	state state1_4 begin
		when enter begin 
			notice_multiline("[LC;3807]",notice)
		end

		when letter begin 
			send_letter("[LC;3791]") 
			q.set_counter_name("[LC;5362]")
			q.set_counter_value(1)
 		end

		when button or info begin 
			say_title("[LC;3799]") 
			say("[LC;3800]") 
			
			say("[LC;5362]")
			say(string.format("[LC;4769;%s;%d]", item_name(31074), 0))
			say(string.format("[LC;4769;%s;%d]", item_name(31079), 1))
			say()
			say_reward("[LC;3801]")
		end

		when 20377.chat."[LC;3791]" begin 
			say_title(mob_name(20377)) 
			say("[LC;3808]") 
		end
		
		when 20393.click begin
			say("[LC;3803]")
			set_state (state1_5)
		end

		when leave begin 
			--q.done()
		end
	end
	state state1_5 begin 
		when enter begin 
			notice_multiline("[LC;3809]",notice)
		end

		when letter begin 
			send_letter("[LC;3791]") 
			local v = find_npc_by_vnum(20377) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20377))
			end
		end

		when button or info begin 
			say_title("[LC;3791]") 
			say("[LC;3810]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20377.chat."[LC;3791]" begin 
			target.delete("__TARGET__") 
			pc.remove_item(31074, pc.count_item(31074)) 
			say_title(mob_name(20377)) 
			say("[LC;3811]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3812]") 
			wait()

			say_title("[LC;3813]") 
			say("[LC;3814]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;3815]") 
			wait()--reward

			say_reward(string.format("[LC;4537;%d]", 37003000))
			pc.give_exp2(37003000)
			say_reward(string.format("[LC;4538;%d]", 153000))
			pc.change_money(153000)
			say_reward(string.format("[LC;4540;%s]", item_name(30047),2))
			pc.give_item2(30047, 2)
			say_reward(string.format("[LC;4540;%s]", item_name(27992),2))
			pc.give_item2(27992, 1)
			pc.give_item2(27992, 1)
			say()
			set_state (state2_1)
		end

		when leave begin 
			--q.done()
		end
	end
	
	state state2_1 begin 
		when letter begin 
			send_letter("[LC;3816]") 
