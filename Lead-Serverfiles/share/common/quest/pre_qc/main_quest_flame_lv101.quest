			target.delete("__TARGET__") 
			say_title(mob_name(20380)) 
			say("[LC;3818]") 
			wait()

			say_title(mob_name(20380)) 
			say("[LC;3819]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3820]") 
			wait()

			say_title(mob_name(20380)) 
			say("[LC;3821]") 
			set_state (state2_2)
		end

		when leave begin 
			--q.done()
		end
	end
	state state2_2 begin 
		when enter begin 
			notice_multiline("[LC;3822]",notice)
		end

		when letter begin 
			send_letter("[LC;3816]") 
			q.set_counter_name("[LC;5362]")
			main_quest_flame_lv101.item_count() 
		end
		
		when button or info begin 
			say_title("[LC;3799]") 
			say("[LC;3837]") 
			say("[LC;5362]")
			say(string.format("[LC;4769;%s;%d]",item_name(31080), 1 - pc.count_item(31080)))
		end

		when 20380.chat."[LC;3816]" begin 
			say_title(mob_name(20380)) 
			say("[LC;3823]") 
		end

		when 2206.kill begin 
			if number(1,100) == 1 then
				pc.give_item2(31080, 1)
				main_quest_flame_lv101.item_count() 
			end
		end

		function item_count()
			if pc.count_item(31080) >= 1 then
				set_state ("state2_3")
			end
			q.set_counter_value(1 - pc.count_item(31080))
		end

		when leave begin 
			--q.done()
		end
	end
	state state2_3 begin 
		when enter begin 
			notice_multiline("[LC;3824]",notice)
		end

		when letter begin 
			send_letter("[LC;3816]") 
			local v = find_npc_by_vnum(20380) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20380))
			end
		end

		when button or info begin 
			say_title("[LC;3816]") 
			say("[LC;3825]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20380.chat."[LC;3816]" begin 
			target.delete("__TARGET__") 
			pc.remove_item(31080, pc.count_item(31080)) 
			say_title(mob_name(20380)) 
			say("[LC;3826]") 
			wait()--reward

			say_reward(string.format("[LC;4537;%d]", 48584000))
			pc.give_exp2( 48584000)
			say_reward(string.format("[LC;4538;%d]", 154000))
			pc.change_money(154000)
			say_reward(string.format("[LC;4540;%s]", item_name(72024),1))
			pc.give_item2_select(72024)
			item.set_socket(2, 180)
			say_reward(string.format("[LC;4540;%s]", item_name(71094),1))
			pc.give_item2(71094, 1)
			say()
			set_state (state2_4)
		end

		when leave begin 
			--q.done()
		end
	end
	state state2_4 begin 
		when enter begin 
			pc.setqf("limit_time", get_time() + 60*60*24)
		end

		when login begin 
			local remain_time = pc.getqf("limit_time") - get_time()
			timer("time_over", remain_time)
		end
		
		when letter begin 
			send_letter("[LC;3816]") 
			local v = find_npc_by_vnum(20380) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20380))
			end
		end

		when button or info begin 
			say_title("[LC;3816]") 
			say("[LC;3825]") 
			local remain_time = pc.getqf("limit_time") - get_time()
			local left_hour = math.mod(remain_time / (60 * 60), 24);
			local left_minute = math.mod(remain_time / 60, 60);
			say(string.format("[LC;3827;%d;%d]", left_hour, left_minute))
			--say_reward(locale.target_npc_info) 
		end

		when 20380.chat."[LC;3816]" begin 
			say_title(mob_name(20380)) 
			say("[LC;3828]") 
		end

		when time_over.timer begin 
			set_state ("state3_1")
		end

		when leave begin 
			pc.setqf("limit_time", 0);
			--q.done()
		end
	end

	state state3_1 begin 
		when letter begin 
			send_letter("[LC;3829]") 
			local v = find_npc_by_vnum(20380) 
			if 0 != v then
