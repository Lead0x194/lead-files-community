			say_reward(string.format ("[LC;4538;%d]", 379000))
			say_reward(string.format ("[LC;4540;%s]", item_name(30015),2,locale.count_postfix))
			say_reward(string.format ("[LC;4540;%s]", item_name(70043),1,locale.count_postfix))
			say("")
			
			pc.give_exp2(32033398)
			pc.change_money(379000)
			pc.give_item2(30015, 2)
			pc.give_item2_select(70043)
			item.set_socket(2, 60)
				
			set_state (state5_1)
		end
	end
	state state5_1 begin
		when letter begin
			send_letter("[LC;5408]")
			
			local v = find_npc_by_vnum(20378)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20378))
			end
		end
		when button or info begin
			say_title("[LC;5408]")
			say("[LC;5409]")
			say("")
			say_reward({})
			say("")
		end
		
		when 20378.chat."[LC;5408]" begin
			target.delete("__TARGET__")
			
			say_title(mob_name(20378))
			say("[LC;5410]")
			say("")
			wait()
			
			say_title(mob_name(20378))
			say("[LC;5411]")
			say("")
			wait()
			
			say_title(locale.reward)
			say_reward(string.format ("[LC;4537;%d]", 38739560))
			say_reward(string.format ("[LC;4538;%d]", 390000))
			say_reward(string.format ("[LC;4540;%s]", item_name(30006),1,locale.count_postfix))
			say("")
			
			pc.give_exp2(38739560)
			pc.change_money(390000)
			pc.give_item2(30006, 1)
			
			clear_letter()
			set_state (__COMPLETE__)
		end
	end
	
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
