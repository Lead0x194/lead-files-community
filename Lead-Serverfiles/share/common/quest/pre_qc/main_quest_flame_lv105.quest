quest main_quest_flame_lv105 begin
	state start begin
	end
	state state0 begin
		when login or levelup or enter with pc.level >= 105 begin
			set_state (state1_1)
		end
	end
	
	state state1_1 begin 
		when letter begin 
			send_letter("[LC;3984]") 
			local v = find_npc_by_vnum(20377) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20377))
			end
		end

		when button or info begin 
			say_title("[LC;3984]") 
			say("[LC;3985]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20377.chat."[LC;3984]" begin 
			target.delete("__TARGET__") 
			pc.remove_item(31083, 3)
			say_title(mob_name(20377)) 
			say("[LC;3986]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3987]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;3988]") 
			wait()

			say_title(mob_name(20377)) 
			say({}) 
			wait()

			say_title(pc.getname()) 
			say("[LC;3989]") 
			set_state (state1_2)
		end

		when leave begin 
			--q.done()
		end
	end
	state state1_2 begin 
		when enter begin 
			pc.setqf("kill_count_1", 0)
			pc.setqf("kill_count_2", 0)
			pc.setqf("kill_count_3", 0)
			pc.setqf("kill_count_4", 0)
			pc.setqf("kill_count_5", 0)
			notice_multiline("[LC;3990]",notice)
		end

		when letter begin 
			send_letter("[LC;3984]") 
			q.set_counter_name("[LC;5425]")
			main_quest_flame_lv105.kill_count_state1_2() 
		end

		when button or info begin 
			say_title("[LC;3991]") 
			say("[LC;3992]") 
			say("[LC;5425]")
			local remain1 = 10 - pc.getqf("kill_count_1")
			if remain1 < 0 then
				remain1 = 0
			end
			local remain2 = 10 - pc.getqf("kill_count_2")
			if remain2 < 0 then
				remain2 = 0
			end
			local remain3 = 10 - pc.getqf("kill_count_3")
			if remain3 < 0 then
				remain3 = 0
			end
			local remain4 = 10 - pc.getqf("kill_count_4")
			if remain4 < 0 then
				remain4 = 0
			end
			local remain5 = 10 - pc.getqf("kill_count_5")
			if remain5 < 0 then
				remain5 = 0
			end
			say(string.format("[LC;5426;%s;%d;%s;%d]" ,mob_name(6005), remain1,mob_name(6006), remain2))
			say(string.format("[LC;5426;%s;%d;%s;%d]" ,mob_name(6007), remain3,mob_name(6008), remain4))
			say(string.format("[LC;5424;%s;%d]",mob_name(6009), remain5))
			say_reward("[LC;3993]")
		end

		when 20377.chat."[LC;3984]" begin 
			say_title(mob_name(20377)) 
			say("[LC;3994]") 
		end

		when 6005.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv105.kill_count_state1_2() 
		end

		when 6006.kill begin
			local kill_count = pc.getqf("kill_count_2")
			pc.setqf("kill_count_2", kill_count+1)
			main_quest_flame_lv105.kill_count_state1_2() 
		end

		when 6007.kill begin
			local kill_count = pc.getqf("kill_count_3")
			pc.setqf("kill_count_3", kill_count+1)
			main_quest_flame_lv105.kill_count_state1_2() 
		end

		when 6008.kill begin
			local kill_count = pc.getqf("kill_count_4")
			pc.setqf("kill_count_4", kill_count+1)
			main_quest_flame_lv105.kill_count_state1_2() 
		end

		when 6009.kill begin
			local kill_count = pc.getqf("kill_count_5")
			pc.setqf("kill_count_5", kill_count+1)
			main_quest_flame_lv105.kill_count_state1_2() 
		end

		function kill_count_state1_2()
			local total_remain = 0
			local remain1 = 10 - pc.getqf("kill_count_1")
			if remain1 < 0 then
				remain1 = 0
			end
			total_remain = total_remain + remain1
			local remain2 = 10 - pc.getqf("kill_count_2")
			if remain2 < 0 then
				remain2 = 0
			end
			total_remain = total_remain + remain2
			local remain3 = 10 - pc.getqf("kill_count_3")
			if remain3 < 0 then
				remain3 = 0
			end
			total_remain = total_remain + remain3
			local remain4 = 10 - pc.getqf("kill_count_4")
			if remain4 < 0 then
				remain4 = 0
			end
			total_remain = total_remain + remain4
			local remain5 = 10 - pc.getqf("kill_count_5")
			if remain5 < 0 then
				remain5 = 0
			end
			total_remain = total_remain + remain5
			q.set_counter_value(total_remain)
			if total_remain == 0 then
				set_state ("state1_3")
			end
		end

		when leave begin 
			pc.setqf("kill_count_1", 0)
			pc.setqf("kill_count_2", 0)
			pc.setqf("kill_count_3", 0)
			pc.setqf("kill_count_4", 0)
			pc.setqf("kill_count_5", 0)
			--q.done()
		end
	end
	state state1_3 begin 
		when enter begin 
			notice_multiline("[LC;3995]",notice)
		end

		when letter begin 
			send_letter("[LC;3984]") 
			local v = find_npc_by_vnum(20377) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20377))
			end
		end

		when button or info begin 
			say_title("[LC;3984]") 
			say("[LC;3996]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20377.chat."[LC;3984]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(20377)) 
			say("[LC;3997]") 
			wait()--reward

			say_reward(string.format("[LC;4537;%d]", 48584000))
			pc.give_exp2(48584000)
			say_reward(string.format("[LC;4538;%d]", 174000))
			pc.change_money(174000)
			say_reward(string.format("[LC;4540;%s]", item_name(71095),1))
			pc.give_item2(71095, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(30033),3))
			pc.give_item2(30033, 3)
			say()
			set_state (state2_1)
		end

		when leave begin 
			--q.done()
		end
	end
	
	state state2_1 begin 
		when letter begin 
			send_letter("[LC;3998]") 
			local v = find_npc_by_vnum(20377) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20377))
			end
		end

		when button or info begin 
			say_title("[LC;3998]") 
			say("[LC;3985]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20377.chat."[LC;3998]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(20377)) 
			say("[LC;3999]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;4000]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3989]") 
			set_state (state2_2)
		end

		when leave begin 
			--q.done()
		end
	end
	state state2_2 begin 
		when enter begin 
			pc.setqf("kill_count_1", 0)
			notice_multiline("[LC;4001]",notice)
		end

		when letter begin 
			send_letter("[LC;3998]") 
			q.set_counter_name("[LC;5425]")
			
			if party.is_party() then
				local map_index = pc.get_map_index()
				if map_index >= 351 * 10000 and  map_index < (351 + 1) *10000 then
					pc.setqf("in_dungeon", 1)
				else
					if pc.getqf("in_dungeon") == 1 then
						if party.getf("flame_dungeon_boss_kill_count") == 1 then
							set_state (state2_3)
						end
						pc.setqf("in_dungeon", 0)
					end
				end
			end
			
			main_quest_flame_lv105.kill_count_state2_2() 
		end
		
		when logout begin 
			if party.is_party() then
				if party.getf("flame_dungeon_boss_kill_count") == 0 then
					pc.setqf("in_dungeon", 0)
				end
			end
		end

		when button or info begin 
			say_title("[LC;4002]") 
			say("[LC;4003]") 
			say("[LC;5425]")
			say(string.format("[LC;5424;%s;%d]",mob_name(6091), 1 - pc.getqf("kill_count_1")))
			say_reward("[LC;3993]")
		end

		when 20377.chat."[LC;3998]" begin 
			say_title(mob_name(20377)) 
			say("[LC;4004]") 
		end

		when 6091.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv105.kill_count_state2_2() 
		end

		function kill_count_state2_2() 
			local total_remain = 0
			local remain1 = 1 - pc.getqf("kill_count_1")
			if remain1 < 0 then
				remain1 = 0
			end
			total_remain = total_remain + remain1
			q.set_counter_value(total_remain)
			if total_remain == 0 then
				set_state ("state2_3")
			end
		end

		when leave begin 
			pc.setqf("kill_count_1", 0)
			pc.setqf("in_dungeon", 0)
			--q.done()
		end
	end
	state state2_3 begin 
		when enter begin 
			notice_multiline("[LC;4005]",notice)
		end

		when letter begin 
			send_letter("[LC;3998]") 
			local v = find_npc_by_vnum(20377) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20377))
			end
		end

		when button or info begin 
			say_title("[LC;3998]") 
			say("[LC;3996]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20377.chat."[LC;3998]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(20377)) 
			say("[LC;4006]") 
			wait()--reward

			say_reward(string.format("[LC;4537;%d]", 60583000))
			pc.give_exp2(60583000)
			say_reward(string.format("[LC;4538;%d]", 175000))
			pc.change_money(175000)
			say_reward(string.format("[LC;4540;%s]", item_name(71095),1))
			pc.give_item2(71095, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(71026),1))
			pc.give_item2(71026, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(71025),2))
			pc.give_item2(71025, 1)
			pc.give_item2(71025, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(72001),1))
			pc.give_item2_select(72001)
			item.set_socket(2, 60)
			say()
			set_state (state3_1)
		end

		when leave begin 
			--q.done()
		end
	end
	
	state state3_1 begin 
		when letter begin 
			send_letter("[LC;4007]") 
			local v = find_npc_by_vnum(20377) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20377))
			end
		end

		when button or info begin 
			say_title("[LC;4007]") 
			say("[LC;3985]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20377.chat."[LC;4007]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(20377)) 
			say("[LC;4008]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;4009]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3989]") 
			say_reward(string.format("[LC;4540;%s]", item_name(31083),1))
			pc.give_item2(31083, 1)
			set_state (state3_2)
		end

		when leave begin 
			--q.done()
		end
	end
	state state3_2 begin 
		when enter begin 
			notice_multiline("[LC;4010]",notice)
		end

		when letter begin 
			send_letter("[LC;4007]") 
			q.set_counter_name("[LC;4011]")
		end

		when button or info begin 
			say_title("[LC;4012]") 
			say("[LC;4013]") 
			
			say_title("[LC;4011]")
			say("[LC;4014]")
			say()
			say_reward("[LC;3993]")
		end

		when 20390.take with item.vnum == 31083 begin 
			item.remove()
			say_title("[LC;4015]") 
			say("[LC;4016]") 
			set_state (state3_3)
		end

		when leave begin 
			--q.done()
		end
	end
	state state3_3 begin 
		when enter begin 
			notice_multiline("[LC;4017]",notice)
		end

		when letter begin 
			send_letter("[LC;4007]") 
			local v = find_npc_by_vnum(20377) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20377))
			end
		end

		when button or info begin 
			say_title("[LC;4007]") 
			say("[LC;3996]") 
			--say_reward(locale.target_npc_info) 
		end

		when 20377.chat."[LC;4007]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(20377)) 
			say("[LC;4018]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;4019]") 
			wait()

			say_title(mob_name(20377)) 
			say("[LC;4020]") 
			wait()--reward

			say_reward(string.format("[LC;4537;%d]", 48584000))
			pc.give_exp2(177000)
			say_reward(string.format("[LC;4538;%d]", 177000))
			pc.change_money(177000)
			say_reward(string.format("[LC;4540;%s]", item_name(72024),1))
			pc.give_item2_select(72024)
			item.set_socket(2, 180)
			say_reward(string.format("[LC;4540;%s]", item_name(71094),1))
			pc.give_item2(71094, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(71001),5))
			pc.give_item2(71001, 5)
			say()
			set_state (__COMPLETE__)
		end

		when leave begin 
			--q.done()
		end
	end
	
	
	state __COMPLETE__ begin
		when enter begin
			--q.done()
		end
	end	
	
	
	
end