				set_state ( state0 )
			end
		end
	end
	state state0 begin
		when login or levelup or enter with pc.level >= 99 begin
			set_state (state1_1)
		end
	end

	state state1_1 begin 

		when letter begin 
			send_letter("[LC;4021]") 
