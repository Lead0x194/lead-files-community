            say_title("[LC;4941]")
            say("[LC;4942]")
            say_item_vnum(31010)
            say("[LC;4767]")
            
            local remain_item = 4 - pc.count_item(31010)
            if remain_item <= 0 then
                remain_item = 0
            end
            q.set_counter_value(remain_item)
            say_reward(string.format("%s: %d %s",item_name(31010),remain_item,locale.count_postfix))
            
            -- say()
            -- say_reward(locale.main_quest_lv92.pos_info)
            -- select("[LC;4853]")
            -- setskin(NOWINDOW)
            -- clearmapsignal()
            
        end
        
        when 20378.chat."[LC;4931]" begin
            
            if pc.count_item(31010) >= 4 then
                pc.remove_item ( 31010, pc.count_item(31010))	
                say_title(mob_name(20378))
                say("[LC;4947]")
                wait()
                
                say_title(locale.reward)
                say_reward(string.format ("[LC;4537;%d]", 33874000))
                say_reward(string.format ("[LC;4538;%d]", 200000))
                say_reward(string.format ("[LC;4540;%s]", item_name(50817),10,locale.count_postfix))
                say("")
                
                pc.give_exp2(33874000)
                pc.change_money(200000)
                pc.give_item2(50817, 10)
                
                set_state (state2_1)
            else
                say_title(mob_name(20378))
                say("[LC;4943]")
                
                set_state (state1_2)
            end
        end
        
        when 3504.kill or 3505.kill begin
            if number(1,500) == 1 then
                if pc.count_item(31010) < 4 then
                    pc.give_item2(31010, 1)
                    
                    local remain_item = 4 - pc.count_item(31010)
                    if remain_item <= 0 then
                        remain_item = 0
                    end
                    q.set_counter_value(remain_item)
                    
                    if pc.count_item(31010) >= 4 then
                        notice_multiline("[LC;4944]",notice)
                        notice_multiline("[LC;4945]",notice)
                        set_state (state1_3)
                    end
                end
            end
        end
    end
