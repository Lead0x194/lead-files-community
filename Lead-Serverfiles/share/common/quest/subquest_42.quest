quest subquest_42 begin
	state start begin
		when login or levelup with pc.level >= 46 and pc.level <= 48 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			
			local vnum=0

			if pc.get_empire() == 1 then
				vnum= 20306
			elseif pc.get_empire() == 2 then
				vnum= 20326
			elseif pc.get_empire() == 3 then
				vnum=20346
			end


			local v=find_npc_by_vnum(vnum)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;8159]")
			end
		end

		when __TARGET__.target.click or 20306.chat."[LC;8159]"  begin
			target.delete("__TARGET__")
			say_title("[LC;8170]")
			say("[LC;8174]")
			wait()
			say_title("[LC;8170]")
			say("[LC;8175]")
			wait()
			say_title("[LC;8170]")
			say("[LC;8176]")
		
			local s= select("[LC;8177]", "[LC;8178]")
			if 2==s then
				say("[LC;8179]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;8170]")
					say("[LC;8180]")
					return
				end
				say_title("[LC;8170]")
				say("[LC;8158]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;8170]")
			say("[LC;8160]")
			set_state(for_the_die)

			end

		when __TARGET__.target.click or 20326.chat."[LC;8159]"  begin
			target.delete("__TARGET__")
			say_title("[LC;8170]")
			say("[LC;8161]")
			wait()
			say_title("[LC;8170]")
			say("[LC;8175]")
			wait()
			say_title("[LC;8170]")
			say("[LC;8162]")
		
			local s= select("[LC;8177]", "[LC;8178]")
			if 2==s then
				say("[LC;8179]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;8170]")
					say("[LC;8180]")
					return
				end
				say_title("[LC;8170]")
				say("[LC;8158]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;8170]")
			say("[LC;8160]")
			set_state(for_the_die)

			end



		when __TARGET__.target.click or 20346.chat."[LC;8159]"  begin
			target.delete("__TARGET__")
			say_title("[LC;8170]")
			say("[LC;8161]")
			wait()
			say_title("[LC;8170]")
			say("[LC;8175]")
			wait()
			say_title("[LC;8170]")
			say("[LC;8162]")
		
			local s= select("[LC;8177]", "[LC;8178]")
			if 2==s then
				say("[LC;8179]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;8170]")
					say("[LC;8180]")
					return
				end
				say_title("[LC;8170]")
				say("[LC;8158]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;8170]")
			say("[LC;8160]")
			set_state(for_the_die)

			end

		end


	state for_the_die begin

		when letter begin

			setskin(NOWINDOW)
			makequestbutton("[LC;8159]")
			q.set_title("[LC;8159]")
			q.start()
			
			if  pc.count_item("30147") >=1 and  pc.count_item("30148") >=1 then
					local vnum=0

					if pc.get_empire() == 1 then
						vnum= 20306
					elseif pc.get_empire() == 2 then
						vnum= 20326
					elseif pc.get_empire() == 3 then
						vnum= 20346
					end

					local v=find_npc_by_vnum(vnum)
					if 0!= v then
						target.vid("__TARGET__",v, "")
					end 
				end	

		end		
			
	
		when info or  button begin
			if  pc.count_item("30147") >=1 and  pc.count_item("30148") >=1 then
				say_title("[LC;8163]")
				say("[LC;8164]")
				return
			end
			
			say_title("[LC;8165]")

			say("[LC;8166]")
		end


					
		when 734.kill or 735.kill or 736.kill  begin
			local s = number(1, 100)
			
			if s <= 5 and pc.count_item(30147)==0 then
				pc.give_item2(30147, 1)
			end	
	
			local a = number(1, 100)
			if a <= 5 and pc.count_item(30148)==0 then
				pc.give_item2(30148, 1)
			end
			
						
		end
			
				
		when __TARGET__.target.click or	20306.chat."[LC;8167]" with pc.count_item("30147") >=1 and  pc.count_item("30148") >=1 begin
		
			target.delete("__TARGET__")
			say_title("[LC;8170]")
			say("[LC;8168]")
			pc.remove_item("30147",1)
			pc.remove_item("30148",1)
			
			say_reward("[LC;8169]")
			pc.give_exp2(1700000)
			set_quest_state("levelup","run")


			say_reward("[LC;8171]")
			pc.give_item2(50621)
			pc.give_item2(50621)
			pc.give_item2(50621)
	
			say_reward("[LC;8172]")
			pc.change_money(30000)
			
			clear_letter()
			set_state(COMPLETE)

		end
	
		when __TARGET__.target.click or	20326.chat."[LC;8167]" with pc.count_item("30147") >=1 and  pc.count_item("30148") >=1 begin
		
			target.delete("__TARGET__")
			say_title("[LC;8170]")
			say("[LC;8173]")
			pc.remove_item("30147",1)
			pc.remove_item("30148",1)
			
			say_reward("[LC;8169]")
			pc.give_exp2(1700000)
			set_quest_state("levelup","run")


			say_reward("[LC;8171]")
			pc.give_item2(50621)
			pc.give_item2(50621)
			pc.give_item2(50621)
	
			say_reward("[LC;8172]")
			pc.change_money(30000)
			
			clear_letter()
			set_state(COMPLETE)

		end
	
		when __TARGET__.target.click or	20346.chat."[LC;8167]" with pc.count_item("30147") >=1 and  pc.count_item("30148") >=1 begin
		
			target.delete("__TARGET__")
			say_title("[LC;8170]")
			say("[LC;8173]")
			pc.remove_item("30147",1)
			pc.remove_item("30148",1)
			
			say_reward("[LC;8169]")
			pc.give_exp2(1700000)
			set_quest_state("levelup","run")


			say_reward("[LC;8171]")
			pc.give_item2(50621)
			pc.give_item2(50621)
			pc.give_item2(50621)
	
			say_reward("[LC;8172]")
			pc.change_money(30000)
			
			clear_letter()
			set_state(COMPLETE)

		end

end

	state __GIVEUP__ begin
	end

	state COMPLETE begin
		when enter begin
			q.done()
		end
	end


end
