quest subquest_27 begin
	state start begin
		when login or levelup with pc.level >= 38  and pc.level <= 40  begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20023)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7743]")
			end
		end

		when __TARGET__.target.click or 20023.chat."[LC;7754]" begin
			target.delete("__TARGET__")
			say_title("[LC;7093]")
			say("[LC;7765]")
			wait()
		
			say_title("[LC;7093]")
			say("[LC;7776]")
			
			set_state(to_wife)

		end
	end
	state to_wife begin
		when letter begin
			local v=find_npc_by_vnum(20002)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7453]")
			end
			
			setskin(NOWINDOW)
			makequestbutton("[LC;7782]")
			q.set_title("[LC;7782]")
			q.start()

		end

		when info or button begin
		
			say_title("[LC;7783]")
			say("[LC;7784]")


		end

		when __TARGET__.target.click or	20002.chat."[LC;7785]" begin
			target.delete("__TARGET__")
			say_title("[LC;6402]")
			say("[LC;7786]")
			wait()
			say_title("[LC;6402]")
			say("[LC;7742]")
			set_state(to_neighbor)
		end
	end	
	
	state to_neighbor  begin
		when letter begin
			local v=find_npc_by_vnum(9003)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7744]")
			end
			
			setskin(NOWINDOW)
			makequestbutton("[LC;7745]")
			q.set_title("[LC;7745]")
			q.start()

		end

		when info or button begin
		
			say_title("[LC;7745]")
			say("[LC;7746]")


		end


		when __TARGET__target.click or	9003.chat."[LC;7747]"  begin
			target.delete("__TARGET__")
			say_title("[LC;1004]")
			say("[LC;7748]")
			wait()
			say_title("[LC;7749]")
			say("[LC;7750]")
			set_state(back_to_soonyougil)
		end	
			
	end

	state back_to_soonyougil begin

		when letter begin

			setskin(NOWINDOW)
			makequestbutton("[LC;7751]")
			q.set_title("[LC;7752]")
			q.start()
			
			local v = find_npc_by_vnum(20023)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7753]")
			end

		end

		when info or button begin
		
			say("[LC;7755]")


		end

		when __TARGET__.target.click or	20023.chat."[LC;7756]" begin
			target.delete("__TARGET__")
			say_title("[LC;7093]")
			say("[LC;7757]")
			wait("")
			say_title("[LC;7093]")
			say("[LC;7758]")

			local s= select("[LC;7759]", "[LC;7760]")
			if 2==s then
				say("[LC;7761]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7093]")
					say("[LC;7762]")
					return
				end
				say_title("[LC;7093]")
				say("[LC;7763]")
				set_state(__GIVEUP__)
				return
			end
					
			say_title("[LC;7093]")
			say("[LC;7764]")
			set_state(find_book)
			
		end

	end
			

	state find_book begin

		when letter begin
					
			if pc.count_item("30156")>=1 then
				setskin(NOWINDOW)
				makequestbutton("[LC;7766]")
				q.set_title("[LC;7767]")
				q.start()

				local v=find_npc_by_vnum(20023)
				if 0!= v then
					target.vid("__TARGET__",v, "[LC;7768]")
				end 
				return
			end
			
			setskin(NOWINDOW)
			makequestbutton("[LC;7769]")
			q.set_title("[LC;7769]")
			q.start()

		end

		when info or  button begin
			if pc.count_item("30156")>=1 then
				say_title("[LC;7770]")
				say("[LC;7771]")
				return
			end
			
			say_title("[LC;7769]")
			say("[LC;7772]")
		end

		when 701.kill  begin
			
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30156")==0  then
				pc.give_item2(30156, 1)

			end
		end

			
		when __TARGET__.target.click or	20023.chat."[LC;7773]"   begin
			target.delete("__TARGET__")
			if pc.count_item("30156")>=1	then
				say_title("[LC;7093]")
				say("[LC;7774]")
				pc.remove_item("30156",1)	
				say_reward("[LC;7775]")
				pc.change_money(20000)
				
				say_reward("[LC;7777]")
				pc.give_exp2(850000)


				clear_letter()
				set_state(__COMPLETE__)


				
				
				return
			else		
				say_title("[LC;7093]")
				say("[LC;7778]")


				local s= select("[LC;7727]", "[LC;939]")
				if 2==s then
					say("[LC;7740]")
					local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;7093]")
						say("[LC;7779]")
						return
					end
					say_title("[LC;7093]")
					say("[LC;7780]")

					set_state(__GIVEUP__)
					return
				end
						
				say_title("[LC;7093]")
				say("[LC;7781]")

				end


			end

		end



	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end	
	end	
end
	


