quest subquest_7 begin
	state start begin
		when login or levelup with pc.level >= 12 and pc.level <= 17 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin

			local v = find_npc_by_vnum(20008)

			if v!= 0 then
				target.vid("__TARGET__", v, "[LC;7177]")
			end
		end

		when 20008.chat."[LC;7184]" with pc.level >= 12 begin
			target.delete("__TARGET__")

			say_title("[LC;7137]")
			say("[LC;7185]")

			set_state(ask_to_sunyugil)
		end
	end

	state ask_to_sunyugil begin
		when letter begin
			send_letter("[LC;7177]")
		end

		when letter begin
			local v=find_npc_by_vnum(20023)
			if 0== v then
			else
				target.vid("__TARGET__",v, "[LC;7186]")
			end

		end

		when info or button begin
			say_title("[LC;7184]")
						say("[LC;7187]")
					end

		when 20023.chat."[LC;7188]" begin
			target.delete("__TARGET__")
			say_title("[LC;7093]")
			say("[LC;7189]")

			set_state(back_to)
		end
	end

	state back_to begin
		when letter begin
			send_letter("[LC;7177]")
		end

		when letter begin
			local v=find_npc_by_vnum(20008)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7190]")
			end
		end

		when info or button begin
			say_title("[LC;7184]")
			say("[LC;7190]")
		end

		when 20008.chat."[LC;7191]" begin
			target.delete("__TARGET__")
			say_title("[LC;7137]")
			say("[LC;7176]")
			wait()

            say_title("[LC;7137]")
			say("[LC;7178]")

			set_state(hunt_for_oku)
		end
	end

	state hunt_for_oku begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7177]")
			q.set_title("[LC;7177]")
			q.start()
		end

		when info or button begin
			say_title("[LC;7177]")
			say("[LC;7179]")
			say_item_vnum("30026")
		end

		when 106.kill begin
			local s = number(1, 100)
			if s <= 5 then
				pc.give_item2("30026", 1)

			end
		end

		when 20008.chat."[LC;7180]" begin
			target.delete("__TARGET__")
			if pc.count_item("30026") >= 1 then
				say_title("[LC;7137]")
				say("[LC;7181]")
				pc.remove_item("30026")
				pc.give_exp2(12000)
				set_quest_state("levelup","run")
				pc.change_money(5000 )
				pc.give_item2("30028", 1)

                                say_title("[LC;192]")
                                				say_reward("[LC;7182]")
				
				set_state(__COMPLETE__)
			else
				say_title("[LC;7137]")
				say("[LC;7183]")
			end
		end
	end

	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end

