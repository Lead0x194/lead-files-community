quest goldbar_shop begin
	state start begin
		when 20020.chat."[LC;1221]" begin
			if pc.get_level() < 30 then
				say_title("[LC;1232]")
				say("[LC;1243]")
				wait()
				say_title("[LC;44]")
								say_reward("[LC;1251]")
								return
			end
			if game.get_event_flag("gold_trade_enable") == 0 then
				say_title("[LC;1232]")
				say("[LC;1252]")
				wait()
				say_title("[LC;44]")
								say_reward("[LC;1253]")
								return
			end
			say_title("[LC;1232]")
			say("[LC;1254]")

			local s =  select("[LC;1255]", "[LC;1256]")

			if s == 1 then
				say_title("[LC;1232]")
				say("[LC;1218]")

				wait()

				local interval = game.get_event_flag("gold_trade_cycle")
				local unit = ""
				if interval <= 0 then interval = 360 end

				if interval >= 60 then
					interval = interval / 60
					unit = "[LC;1219]"
					math.ceil(interval)
				else
					unit = "[LC;1220]"
				end

				if interval < 1 then interval = 1 end
				say_title("[LC;1232]")
				say(string.format("[LC;1222;%s;%s]", interval, unit))
				say("[LC;1223]")
			else
				say_title("[LC;1232]")
				say("[LC;1224]")
			end

			setstate(trade_goldbar)
		end
	end

	state trade_goldbar begin
		when 20020.chat."[LC;1225]" begin
			if pc.get_level() < 30 then
				say_title("[LC;1232]")
				say("[LC;1226]")
				setstate(start)
				return
			end
			if game.get_event_flag("gold_trade_enable") == 0 then
				say_title("[LC;1232]")
				say("[LC;1227]")
				say_reward("[LC;1228]")
				return
			end

			local nexttime = pc.getqf("gold_buy_next_time")
			
			local interval = game.get_event_flag("gold_trade_cycle")
			local unit = ""

			if interval <= 0 then interval = 360 end

			if get_time() < nexttime then
				nexttime = (nexttime / 60) - (get_time()/60)

				if nexttime >= 60 then
					unit = "[LC;1219]"
					nexttime = nexttime / 60
					math.ceil(nexttime)
				else
					unit = "[LC;1220]"
				end

				if nexttime < 1 then nexttime = 1 end
				say_title("[LC;1232]")
				say("[LC;1229]")
say(string.format("[LC;1230;%s;%s]", nexttime, unit))
								else
				say_title("[LC;1232]")
				say("[LC;1231]")

					local s =  select("[LC;49]", "[LC;50]")
					if s == 1 then
						if pc.money >= 2200000 then
							local goldbar_count = pc.count_item(80007)
							char_log(0, "GOLDBARREN", "KAUFEN ("..goldbar_count..")")
							pc.changemoney(-2200000)
							say_title("[LC;1232]")
							say("[LC;1233]")
							pc.give_item2("80007", 1)
							pc.setqf("gold_buy_next_time", get_time() + time_min_to_sec(interval))
						else
							say_title("[LC;1232]")
							say("[LC;1234]")
						end
					elseif s == 2 then
						say_title("[LC;1232]")
						say("[LC;1235]")
					else
				end
							end
		end

		when 20020.chat."[LC;1236]" with pc.is_gm() begin
			say("[LC;1237]")
			pc.setqf("gold_buy_next_time", 0)
			pc.setqf("gold_sell_next_time", 0)
		end
		when 20020.chat."[LC;1238]" begin
			if pc.get_level() < 30 then
				say_title("[LC;1232]")
				say("[LC;1239]")
				setstate(start)
				return
			end
			if game.get_event_flag("gold_trade_enable") == 0 then
				say_title("[LC;1232]")
				say("[LC;1240]")
				say_reward("[LC;1241]")
								return
			end

			local nexttime = pc.getqf("gold_sell_next_time")

			local interval = game.get_event_flag("gold_trade_cycle")
			local unit = ""

			if interval <= 0 then interval = 360 end

			if get_time() < nexttime then
				nexttime = (nexttime / 60) - (get_time()/60)

				if nexttime >= 60 then
					unit = "[LC;1219]"
					nexttime = nexttime / 60
					math.ceil(nexttime)
				else
					unit = "[LC;1220]"
				end

				if nexttime < 1 then nexttime = 1 end
				say_title("[LC;1232]")
				say("[LC;1242]")
say(string.format("[LC;1244;%s;%s]", nexttime, unit))
							else
				if pc.count_item(80007) <= 0 then
				say_title("[LC;1232]")
				say("[LC;1245]")
				else
				say_title("[LC;1232]")
				say("[LC;1246]")

					local s =  select("[LC;1247]", "[LC;1248]")

					if s == 1 then
						say_title("[LC;1232]")
						say("[LC;1249]")

						local goldbar_count = pc.count_item(80007)
						if goldbar_count >= 1 then
							char_log(0, "GOLDBARREN", "VERKAUFEN("..goldbar_count..")")
							pc.changemoney(2000000)
							pc.remove_item(80007)
						else
							char_log(0, "GOLDBARREN", "SELL_HACK")
						end
						pc.setqf("gold_sell_next_time", get_time() + time_min_to_sec(interval))

					elseif s == 2 then
						say_title("[LC;1232]")
						say("[LC;1250]")
					end
				end
			end
		end
	end

end


