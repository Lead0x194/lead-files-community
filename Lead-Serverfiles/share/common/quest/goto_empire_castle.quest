quest goto_empire_castle begin
	state start begin
		when 20097.chat."[LC;1258]" begin

			local empire = pc.get_empire()
			if empire==1 then
				a= select("[LC;1261]", "[LC;1262]", "[LC;1263]", "[LC;1891]")
				if 1==a then
					
					say("[LC;1264]")
					wait()
					pc.warp(975200, 133000)
				elseif 2==a then
					say("[LC;1265]")
					wait()
					pc.warp(978000, 199500)
				elseif 3==a then
					say("[LC;1266]")
					wait()
					pc.warp(967900, 199400)
				else
					return
				end
			else  
				say("[LC;1267]")
			end
		end

		when 20098.chat."[LC;1268]" begin

			local empire = pc.get_empire()
			if empire==2 then
				a= select("[LC;1261]", "[LC;1262]", "[LC;1263]", "[LC;1891]")
				if 1==a then
					say("[LC;1269]")
					wait()
					pc.warp(977400, 150100)
				elseif 2==a then
					say("[LC;1257]")
					wait()
					pc.warp(977200, 185000)
				elseif 3==a then
					say("[LC;1266]")
					wait()
					pc.warp(925600, 201200)
				else
					return
				end	
			else  
				say("[LC;1259]")
			end
		end
		when 20099.chat."[LC;1258]" begin

			local empire = pc.get_empire()
			if empire==3 then
				a= select("[LC;1261]", "[LC;1262]", "[LC;1263]", "[LC;1891]")
				if 1==a then
					say("[LC;1269]")
					wait()
					pc.warp(1018900, 148400)
				elseif 2==a then
					say("[LC;1257]")
					wait()
					pc.warp(1019000, 200200)
				elseif 3==a then
					say("[LC;1266]")
					wait()
					pc.warp(923900, 183600)
				else
					return
				end	
			else  
				say("[LC;1260]")
			end
		end
	end
end
