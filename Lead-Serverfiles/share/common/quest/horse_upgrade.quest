quest horse_upgrade begin
	state start begin
		when 20349.chat."[LC;1724]" with horse.get_grade()==1 and horse.get_level()==10 begin
			if horse.is_dead() then
				say_title("[LC;1558]")
				say("[LC;1690]")
			elseif pc.level<=34 then
				say_title("[LC;1558]")
				say("[LC;1701]")
			elseif horse.get_level()<=9 then
				say_title("[LC;1558]")
				say("[LC;1712]")
			elseif pc.countitem("50050")<1 then
				say_title("[LC;1558]")
				say("[LC;1765]")
				setstate(need_item50050)
			elseif pc.countitem("50051")<1 then
				say_title("[LC;1558]")
				say("[LC;1714]")
			elseif horse.get_level()==10 and not horse.is_dead() and pc.countitem("50050")>=1 and pc.level>=35 then
				say_title("[LC;1558]")
				say("[LC;1715]")
				local b= select("[LC;971]", "[LC;931]")
				if 1==b then
					if pc.countitem("50050")>=1 then
						pc.removeitem("50050", 1)
						setstate(test)
					end
				elseif 2==b then
					say("[LC;1716]")
				else
					say(string.format("[LC;1717;%s]", b))
				end
			else
				say_title("[LC;1558]")
				say("[LC;1718]")
			end
		end
	end
	state need_item50050 begin
		when login or levelup or enter with pc.countitem("50050") >= 1 begin
			set_state(start)
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1723]")
			q.set_title("[LC;1723]")
			q.start()
		end
		when button begin
			say_title("[LC;1723]")
						say_reward("[LC;1719]")
						setstate(start)
			q.done()
		end
		when info begin
			say_title("[LC;1723]")
						say_reward("[LC;1719]")
						setstate(start)
			q.done()
		end
		when 20349.chat."[LC;1724]" with horse.get_grade()==1 and horse.get_level()==10 begin
			if horse.is_dead() then
				say_title("[LC;1558]")
				say("[LC;1690]")
			elseif pc.level<=34 then
				say_title("[LC;1558]")
				say("[LC;1701]")
			elseif horse.get_level()<=9 then
				say_title("[LC;1558]")
				say("[LC;1712]")
			elseif pc.countitem("50050")<1 then
				say_title("[LC;1558]")
				say("[LC;1765]")
			elseif pc.countitem("50051")<1 then
				say_title("[LC;1558]")
				say("[LC;1714]")
			elseif horse.get_level()==10 and not horse.is_dead() and pc.countitem("50050")>=1 and pc.level>=35 then
				say_title("[LC;1558]")
				say("[LC;1715]")
				local b= select("[LC;971]", "[LC;931]")
				if 1==b then
					if pc.countitem("50050")>=1 then
						pc.removeitem("50050", 1)
						setstate(test)
					end
				elseif 2==b then
					say("[LC;1716]")
				else
					say(string.format("[LC;1717;%s]", b))
				end
			else
				say_title("[LC;1558]")
				say("[LC;1718]")
			end
		end
	end
	state test begin
		when letter begin
			q.set_counter("[LC;1720]", 100-pc.getqf("kill_count"))
		end
		when 2105.party_kill begin
			pc.setqf("kill_count", pc.getqf("kill_count")+1)
			q.set_counter("[LC;1720]", 100-pc.getqf("kill_count"))
			if get_time()>=pc.getqf("limit_time") then
				setstate(failure)
			end
		end
		when 2107.party_kill begin
			pc.setqf("kill_count", pc.getqf("kill_count")+1)
			q.set_counter("[LC;1721]", 100-pc.getqf("kill_count"))
			if get_time()>=pc.getqf("limit_time") then
				setstate(failure)
				q.done()
			end
		end
		when letter begin
			q.set_clock("[LC;1722]", pc.getqf("limit_time")-get_time())
		end
		when enter begin
			pc.setqf("limit_time", get_time()+30*60)
			pc.setqf("kill_count", 0)
		end
		when leave begin
			q.done()
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1689]")
			q.set_title("[LC;1689]")
			q.start()
		end
		when button begin
			say_title("[LC;1689]")
						say_reward("[LC;1691]")
						say_reward("[LC;1728]")
					end
		when info begin
			say_title("[LC;1689]")
						say_reward("[LC;1691]")
						say_reward("[LC;1728]")
					end
		when 2105.party_kill with pc.getqf("kill_count") >= 100 and pc.getqf("kill_count") >= 100 and pc.getqf("limit_time")>=get_time() begin
			setstate(report)
		end
		when 2107.party_kill with pc.getqf("kill_count") >= 100 and pc.getqf("kill_count") >= 100 and pc.getqf("limit_time")>=get_time() begin
			setstate(report)
		end
		when 20349.chat."[LC;1692]" begin
			say_title("[LC;1558]")
			say("[LC;1693]")
			local b= select("[LC;2105]", "[LC;1891]")
			if 1==b then
			elseif 2==b then
				say_title("[LC;1558]")
				say("[LC;1731]")
				local b= select("[LC;1732]", "[LC;1733]")
				if 1==b then
					say_title("[LC;1586]")
					say("[LC;1734]")
					setstate(start)
					q.done()
				elseif 2==b then
					say_title("[LC;1558]")
					say("[LC;1694]")
				else
					say(string.format("[LC;1737;%s]", b))
				end
			else
				say(string.format("[LC;1737;%s]", b))
			end
		end
	end
	state report begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1738]")
			q.set_title("[LC;1738]")
			q.start()
		end
		when button begin
			say_title("[LC;1738]")
						say_reward("[LC;1739]")
					end
		when info begin
			say_title("[LC;1738]")
						say_reward("[LC;1739]")
					end
		when 20349.chat."[LC;1695]" with horse.get_grade()!=1 begin
			setstate(start)
			q.done()
		end
		when 20349.chat."[LC;1696]" with horse.get_grade()==1 begin
			say_title("[LC;1558]")
			say("[LC;1697]")
			if is_test_server() then
				pc.setqf("make_time", get_time()+10)
			else
				pc.setqf("make_time", get_time()+number(8, 16)*60*60)
			end
			setstate(wait)
		end
	end
	state wait begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1698]")
			q.set_title("[LC;1698]")
			q.start()
		end
		when button begin
			say_title("[LC;1698]")
						say_reward("[LC;1699]")
					end
		when info begin
			say_title("[LC;1698]")
						say_reward("[LC;1699]")
					end
		when login with get_time()>=pc.getqf("make_time") begin
			setstate(buy)
		end
		when 20349.chat."[LC;1745]" with horse.get_grade()!=1 begin
			setstate(start)
			q.done()
		end
		when 20349.chat."[LC;1700]" with horse.get_grade()==1 begin
			say_title("[LC;1558]")
			say("[LC;1702]")
		end
	end
	state buy begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1749]")
			q.set_title("[LC;1749]")
			q.start()
		end
		when button begin
			say_title("[LC;1749]")
						say_reward("[LC;1703]")
					end
		when info begin
			say_title("[LC;1749]")
						say_reward("[LC;1704]")
					end
		when 20349.chat."[LC;1745]" with horse.get_grade()!=1 begin
			setstate(start)
			q.done()
		end
		when 20349.chat."[LC;1745]" with horse.get_grade()==1 and horse.get_level()!=10 begin
			setstate(start)
			q.done()
		end
		when 20349.chat."[LC;1705]" with horse.get_grade()==1 and horse.get_level()==10 begin
			say_title("[LC;1558]")
			say("[LC;1706]")
			local b= select("[LC;1753]", "[LC;1754]", "[LC;1755]")
			if 1==b then
				if pc.money>=500000 then
					if pc.countitem("50051")>=1 then
						char_log(0, "HORSE_UPGRADE", "BEGIN")
						pc.changemoney(-500000)
						char_log(0, "HORSE_UPGRADE", "DEC money 500000")
						pc.removeitem("50051", 1)
						char_log(0, "HORSE_UPGRADE", "DEC 50051 1")
						horse.unride()
						horse.advance()
						horse.ride()
						char_log(0, "HORSE_UPGRADE", "INC horse_advance 1")
						pc.give_item2("50052", 1)
						char_log(0, "HORSE_UPGRADE", "INC 50052 1")
						char_log(0, "HORSE_UPGRADE", "END")
						say_title("[LC;1558]")
						say("[LC;1707]")
						setstate(start)
						q.done()
					else
						say_title("[LC;1558]")
						say("[LC;1708]")
					end
				else
					say_title("[LC;1558]")
					say("[LC;1709]")
				end
			elseif 2==b then
				say_title("[LC;1558]")
				say("[LC;1710]")
			elseif 3==b then
				say_title("[LC;1558]")
				say("[LC;1711]")
				local b= select("[LC;2059]", "[LC;2035]")
				if 1==b then
					setstate(start)
					q.done()
				elseif 2==b then
				else
					say(string.format("[LC;1737;%s]", b))
				end
			else
				say(string.format("[LC;1737;%s]", b))
			end
		end
	end
	state failure begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1762]")
			q.set_title("[LC;1762]")
			q.start()
		end
		when button begin
			say_title("[LC;1762]")
						say_reward("[LC;1713]")
						say_reward("[LC;1764]")
						setstate(start)
			q.done()
		end
		when info begin
			say_title("[LC;1762]")
						say_reward("[LC;1713]")
						say_reward("[LC;1764]")
						setstate(start)
			q.done()
		end
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
