quest subquest_22 begin
	state start begin
		when login or levelup with pc.level >= 35  and pc.level <= 37 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20015)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7562]")
			end
		end


		when __TARGET__.target.click or	20015.chat."[LC;7573]" begin
			target.delete("__TARGET__")
			say_title("[LC;7574]")
			say("[LC;7575]")
			wait()
			say_title("[LC;7574]")
			say("[LC;7576]")
			local s= select("[LC;6997]", "[LC;7577]")
			if 2==s then
				say("[LC;7578]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7574]")
					say("[LC;7579]")
					return
				end
				say_title("[LC;7574]")
				say("[LC;7580]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7574]")
			say("[LC;7561]")

		set_state(hunt_for_goldaxe)
		end
	end




	state hunt_for_goldaxe begin
		when letter begin
			send_letter("[LC;7562]")

			if pc.count_item(30102)>0 then
				local v=find_npc_by_vnum(20015)
				if 0==v then
				else
					target.vid("__TARGET__",v, "[LC;7563]")
				end
			end

		end
		when info or  button begin
			if pc.count_item(30102)>0 then
				say_title("[LC;7564]")
				say("[LC;7565]")
				return
			end
			say_title("[LC;7566]")
			say("[LC;7567]")
		end



		when 504.kill  begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30102")==0  then
				pc.give_item2("30102", 1)

				local v=find_npc_by_vnum(20015)
				if 0==v then
				else
					target.vid("__TARGET__",v, "[LC;7563]")
				end
			end
		end



		when 20015.chat."[LC;7568]" with pc.count_item("30102")>=1 begin
			target.delete("__TARGET__")
			say_title("[LC;7569]")
			say("[LC;7570]")
			pc.remove_item("30102",1)

			say_reward("[LC;7571]")
			pc.give_exp2(400000)

			say_reward("[LC;7572]")
			pc.change_money(30000)

			set_state(__COMPLETE__)
			clear_letter()
		end
	end


        state __GIVEUP__ begin
        end

        state __COMPLETE__ begin
                when enter begin
                        q.done()
                end
        end


end

