quest subquest_10 begin
	state start begin
		when login or levelup with pc.level >= 18 and pc.level <= 23 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(9003)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7246]")
			end
		end


		when __TARGET__.target.click or	9003.chat."[LC;7246]" with pc.level >= 18 begin
			target.delete("__TARGET__")

			say_title("[LC;1004]")
			say("[LC;7257]")
			say_item_vnum("30017")
						wait()
                        say_title("[LC;1004]")
			say("[LC;7265]")
		  	local s= select("[LC;7266]", "[LC;7103]")
			if 2==s then
				say("[LC;7267]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;1004]")
					say("[LC;7268]")
					return
				end
				say_title("[LC;1004]")
				say("[LC;7269]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;1004]")
			say("[LC;7270]")
			set_state(go_to_blacksmith)

		end
	end

	state go_to_blacksmith begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7246]")
			q.set_title("[LC;7246]")
			q.start()

			local v = find_npc_by_vnum(20016)

			if v == 0 then
			else
				target.vid("__TARGET__", v, "[LC;7271]")
			end
		end

		when info or button begin
			say_title("[LC;7271]")
                        			say_reward("[LC;7245]")
			say_item_vnum("30017")
					end

		when __TARGET__.target.click or	20016.chat."[LC;7247]" begin
			target.delete("__TARGET__")
			say_title("[LC;27]")
			say("[LC;7248]")

			set_state(ask_to_weaponshop)
		end
	end

	state ask_to_weaponshop begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7249]")
			q.set_title("[LC;7249]")
			q.start()

			local v= find_npc_by_vnum(9001)
			if v == 0 then
			else
				target.vid("__TARGET__", v, "[LC;7230]")
			end
		end

		when info or button begin
			say_title("[LC;7230]")
            say("[LC;7250]")
			say_item_vnum("30017")
		end

		when __TARGET__.target.click or	9001.chat."[LC;7249]" begin
			target.delete("__TARGET__")
			say_title("[LC;7195]")
			say("[LC;7251]")

			set_state(hunt_for_shoes)
		end
	end

	state hunt_for_shoes begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7249]")
			q.set_title("[LC;7249]")
			q.start()
		end

		when info or button begin
			say_title("[LC;7249]")
			say("[LC;7252]")
			say_item_vnum("30017")
		end

		when 302.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30017")==0  then
				pc.give_item2("30017", 1)
				send_letter("[LC;7253]")
				local v=find_npc_by_vnum(9003)
				if 0== v then
				else
					target.vid("__TARGET__",v, "[LC;7254]")
				end
			end

		end

		when __TARGET__target.click or	9003.chat."[LC;7255]" begin
			target.delete("__TARGET__")
			if pc.count_item("30017") >= 1 then
				say_title("[LC;1004]")
				say("[LC;7256]")
				wait()
                                say_title("[LC;192]")
                                				say_reward("[LC;7258]")
								pc.remove_item("30017", 1)
				pc.give_exp2(60000)
				pc.change_money(10000)
				pc.give_item2("50083", 1)
				clear_letter()
				set_state(__COMPLETE__)
			else
				say_title("[LC;1004]")
				say("[LC;7259]")
				say_item_vnum("30017")
								local s= select("[LC;2105]", "[LC;7260]")
				if 2==s then
					say("[LC;7261]")
					local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;1004]")
						say("[LC;7262]")
						set_state(information)
						return
					end
					say_title("[LC;1004]")
					say("[LC;7263]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;1004]")
				say("[LC;7264]")
			end
		end
	end
	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
