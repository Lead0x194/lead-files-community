

quest main_quest_lv47 begin
	state start begin
	end
	state run begin
		when login or levelup with pc.get_level() >= 47 begin
			set_state ( information )
		end
	end

	state information begin
		when letter begin
			send_letter("[LC;4231]")

			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4253]")
			end
		end
		when button or info begin
			say_title("[LC;4354]")
			say("[LC;4365]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4376]" begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4387]")
			wait()
			say_title("[LC;4398]")
						say_reward("[LC;4408]")
						wait()
			say_title("[LC;4409]")
   			say("[LC;4410]")
			wait()
			say_title("[LC;192]")
						say_reward("[LC;4325]")
			pc.give_exp2(2000000)
			say_reward("[LC;4266]")
			pc.change_money(50000)
			say_reward("[LC;4326]")
			pc.give_item2(71019)
			pc.remove_item(30150)
			set_state ( survey )

		end
	end

	state survey begin
		when letter begin
			send_letter("[LC;4411]")

			local v=find_npc_by_vnum(20362) 

			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4253]")
			end
		end
		when button or info begin
			say_title("[LC;4353]")
			say("[LC;4355]")
		end
		when __TARGET__.target.click or	20362.chat."[LC;4356]" begin
			target.delete("__TARGET__")
			say_pc_name()
			say("[LC;4357]")
			pc.give_item2(30150)
			set_state ( gototeacher2 )
		end
	end

	state gototeacher2 begin
		when letter begin
			send_letter("[LC;4411]")

			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4253]")
			end
		end
		when button or info begin
			say_title("[LC;4358]")
			say("[LC;4359]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4360]" begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
   			say("[LC;4361]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4362]")
   			wait()
			say_title("[LC;4223]")
			say("[LC;4363]")
			wait()
			say_title("[LC;192]")
						say_reward("[LC;4364]")
			pc.give_exp2(3000000)

			say_reward("[LC;4366]")
			pc.change_money(75000)

			say_reward("[LC;4367]")
			pc.give_item2(71020)

			pc.remove_item(30150)

			set_state (gotomusician)

		end
	end

	state gotomusician begin
		when letter begin
			send_letter("[LC;4368]")
			local v=find_npc_by_vnum(20017)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4369]")
			end
		end

		when button or info begin
			say_title("[LC;4370]")
			say("[LC;4371]")
		end

		when __TARGET__.target.click or	20017.chat."[LC;4372]" begin
			target.delete("__TARGET__")
			say_title("[LC;14]")
			say("[LC;4373]")
   			wait()
			say_title("[LC;14]")
   			say("[LC;4374]")
			wait()
			say_title("[LC;14]")
			say("[LC;4375]")
			set_state (his_advice)
		end
	end

	state his_advice begin
		when letter begin
			send_letter("[LC;4377]")
		end

		when button or info begin
			say_title("[LC;4378]")
			say("[LC;4379]")
		end
		
		when 2108.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30150")==0 then
				pc.give_item2(30150, 1)
				set_state (gotomusician1)
			end
		end
	end		
			
			
	state gotomusician1 begin
		when letter begin
			send_letter("[LC;4380]")
			local v=find_npc_by_vnum(20017)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4381]")
			end
		end

		when button or info begin
			say_title("[LC;4380]")
		   	
			say("[LC;4382]")
		end

		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;14]")
			say("[LC;4383]")
			q.done()

			set_state (gototeacher)
		end
	end

	state gototeacher begin
		when letter begin
			send_letter("[LC;4384]")

			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4385]")
			end
		end
		when button or info begin
			say_title("[LC;4386]")
			say("[LC;4388]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4389]")
   			wait()
			say_title("[LC;4223]")
			say("[LC;4390]")
   			wait()
			say_title("[LC;4223]")
			say("[LC;4391]")
			wait()
			say_title("[LC;4392]")
						say_reward("[LC;4393]")
						say_reward("[LC;4394]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4395]")
			wait()
			say_title("[LC;192]")
						say_reward("[LC;4364]")
			pc.give_exp2(3000000)

			say_reward("[LC;4366]")
			pc.change_money(75000)
			pc.remove_item(30150)
			set_state ( survey2)

		end
	end

	state survey2 begin
		when letter begin
			send_letter("[LC;4396]")

		end
		when button or info begin
			say_title("[LC;4397]")
			say("[LC;4399]")
		end

		when 2106.kill or 2107.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30150")==0 then
				pc.give_item2(30150, 1)
				set_state ( gototeacher3 )
			end
		 end
	end

	
	state gototeacher3 begin
		when letter begin
			send_letter("[LC;4400]")

			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4401]")
			end
		end
		when button or info begin
			say_title("[LC;4400]")
			say("[LC;4402]")
		end	
		when __TARGET__.target.click or 20011.chat."[LC;4400]" begin
			target.delete("__TARGET__")
			
			say_title("[LC;4223]")
			say("[LC;4403]")
			wait()
			say_title("[LC;4404]")
					   	say_reward("[LC;4405]")
						wait()
			say_title("[LC;4223]")
			say("[LC;4406]")
			wait()
			say_title("[LC;192]")
						say_reward("[LC;4407]")
			
			pc.give_exp2(3000000)
			pc.change_money(70000)
			pc.give_item2(70038)
			pc.remove_item(30150)

			clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv50", "run")
		end
	end
	state __COMPLETE__ begin
	end
end		
