quest guild_create begin
    state start begin
    end
    state run begin
        when letter begin
			send_letter("[LC;1336]")
		end
		when button or info begin
                 	----"12345678901234567890123456789012345678901234567890"|
            		say_title("[LC;1336]")
            		            		say_reward("[LC;1337]")
            		say_item_vnum(70101)
            		say_reward("[LC;1338]")
			        end
		when 691.party_kill begin
			set_state(reward)
		end
    end
	state reward begin
		when letter begin
			send_letter("[LC;1339]")
		end
		when button or info begin
			say_title("[LC;1340]")
                                                say_reward("[LC;1341]")
            		say_item_vnum(70101)
                        say_reward("[LC;1342]")
						set_state(start)
			pc.give_item2(70101)
		end
	end
end

