quest subquest_4 begin
	state start begin
		when login or levelup with pc.level >= 9 and pc.level <= 14 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20016)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7038]")
			end
		end
		when __TARGET__.target.click or	20016.chat."[LC;7038]" with pc.level >= 9 begin
			target.delete("__TARGET__")

			say_title("[LC;27]")
			say("[LC;7049]")
			wait()

			say_title("[LC;27]")
			say("[LC;7059]")
			say_item_vnum(30131)
			wait()

			say_title("[LC;27]")
			say("[LC;7060]")

			local s= select("[LC;7061]", "[LC;7062]")
			if 2==s then
				say("[LC;7063]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;27]")
					say("[LC;7064]")
					return
				end
				say_title("[LC;27]")
				say("[LC;7065]")

				clear_letter()
				set_state(__GIVEUP__)
				return
			end

			say_title("[LC;27]")
			say("[LC;7037]")
			pc.give_item2("30131", 1)
			say_item_vnum(30131)
			set_state(deliver_letter)

		end
	end

	state deliver_letter begin
		when info or button begin
			say_title("[LC;44]")
						say_reward("[LC;7039]")
					end

		when letter begin
			send_letter("[LC;7040]")
			
			local v=find_npc_by_vnum(20015)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7041]")
			end
		end

		when __TARGET__.target.click or	20015.chat."[LC;7042]" begin
			if pc.count_item(30131) >= 1 then
				target.delete("__TARGET__")

				say_title("[LC;7043]")
				say("[LC;7044]")
				wait()

				say_title("[LC;7043]")
				say("[LC;7045]")
				pc.remove_item("30131", 1)

				set_state(return_to)

			else
				say_title("[LC;7043]")
				say("[LC;7046]")
				local s= select("[LC;7047]", "[LC;7048]")
				if 2==s then
					say("[LC;7050]")

					local a= select("[LC;2059]", "[LC;2035]")
					if 2==a then
						say_title("[LC;5585]")
						say("[LC;7051]")
						return
					end
					say_title("[LC;5585]")
					say("[LC;7052]")
					clear_letter()
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;5585]")
				say("[LC;7053]")
				set_state(information)

			end
		end
	end

	state return_to begin
		when info or button begin
			say_title("[LC;29]")
						say_reward("[LC;7054]")
					end

		when letter begin
			local v=find_npc_by_vnum(20016)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7055]")
			end
		
			send_letter("[LC;7055]")
		end

		when 20016.chat."[LC;7056]" begin
			target.delete("__TARGET__")
			say_title("[LC;27]")
			say("[LC;7057]")

			pc.give_exp2(4000)
			set_quest_state("levelup","run")
			pc.change_money(3000)

			say_title("[LC;192]")
						say_reward("[LC;7058]")
			
			clear_letter()
			set_state(__COMPLETE__)
		end
	end

	state __GIVEUP__ begin

	end

	state __COMPLETE__ begin
	end
end
