quest guild_building begin
	state start begin
		when guild_man1.chat."[LC;1344]" or guild_man2.chat."[LC;1344]" or guild_man3.chat."[LC;1344]" with pc.is_gm() begin

			say_title("[LC;1001]")
			say("[LC;1355]")
			local u_name = input()
			local u_vid=find_pc_by_name(u_name)

			if u_vid==0 then 
				say_title("[LC;1359]")
				say(u_name)
				return
			end

			local old_vid = pc. select(u_vid , u_vid )
			u_withdrawTime=pc.getqf("new_withdraw_time")
			u_withdrawTime=pc.getqf("new_withdraw_time")
			pc. select(old_vid , old_vid )

			withdrawDelay=game.get_event_flag("guild_withdraw_delay")
			disbandDelay=game.get_event_flag("guild_disband_delay")

			say_title("[LC;1001]")
			say("[LC;1360]")

			if u_withdrawTime>0 then
				say(string.format("[LC;1361;%s]", time_to_str(u_withdrawTime).."[LC;1362]".. withdrawDelay))
			end

			if u_disbandTime>0 then
				say(string.format("[LC;1363;%s]", time_to_str(u_disbandTime).."[LC;1364]".. disbandDelay))
			end

			local retryTime1 = u_withdrawTime + withdrawDelay*86400
			local retryTime2 = u_withdrawTime + disbandDelay*86400

			local retryTime = 0
			if retryTime1 > retryTime2 then 
				retryTime = retryTime1
			else 
				retryTime = retryTime2 
			end

			local curTime = get_time()
			if curTime < retryTime then
				say(string.format("[LC;1365;%s]", time_to_str(retryTime).."[LC;1366]"..((retryTime-curTime)/3600)))

				if is_test_server() then
					local s= select("[LC;1367]", "[LC;13]")
					if s==1 then
						local old_vid = pc. select(u_vid , u_vid )
						local curTime=get_time()
						pc.setqf("new_withdraw_time", curTime-withdrawDelay*86400)
						pc.setqf("new_withdraw_time", curTime-disbandDelay*86400)
						pc. select(old_vid , old_vid )
					end
				end
			else
				say("[LC;1368]")
			end
		end
		when guild_man1.chat."[LC;1343]" or guild_man2.chat."[LC;1343]" or guild_man3.chat."[LC;1343]" with pc.is_gm() begin

			test_chat(string.format("[LC;1345;%s]", bool_to_str(pc.has_guild()).." [ENTER]pc.is_guildmaster: "..bool_to_str(pc.isguildmaster()).." [ENTER]pc.empire: "..pc.empire.." [ENTER]npc.empire: "..npc.empire))
		end
		when guild_man1.chat."[LC;2056]" or guild_man2.chat."[LC;2056]" or guild_man3.chat."[LC;2056]" with pc.hasguild() and not pc.isguildmaster() and (pc.is_gm() or npc.empire == pc.empire) begin

			say_title("[LC;1001]")
			say("[LC;1346]")
			local s =  select("[LC;2059]", "[LC;2035]")
			if s==1 then
				say_title("[LC;1001]")
				say("[LC;1347]")
				pc.remove_from_guild()
				pc.setqf("new_withdraw_time",get_global_time())
			end
		end

		when guild_man1.chat."[LC;2030]" or guild_man2.chat."[LC;2030]" or guild_man3.chat."[LC;2030]" with pc.hasguild() and pc.isguildmaster() and (pc.is_gm() or npc.empire == pc.empire) begin
			say_title("[LC;1001]")
			say("[LC;1348]")
			local s =  select("[LC;2059]", "[LC;2035]")
			if s==1 then
			say_title("[LC;1001]")
			say("[LC;1349]")
			pc.destroy_guild()
			pc.setqf("new_disband_time", get_global_time())
			pc.setqf("new_withdraw_time", get_global_time())
			end
		end

		when guild_man1.chat."[LC;1350]" or guild_man2.chat."[LC;1351]" or guild_man3.chat."[LC;1351]" begin
			local level_limit;
			local guild_create_item

			level_limit = 40
			guild_create_item = false
																	 
			if pc.hasguild() then
				return
			end
			if game.get_event_flag("guild_withdraw_delay")*86400 > 
				get_global_time() - pc.getqf("new_withdraw_time") then
			say_title("[LC;1001]")
			say("[LC;1352]")
-- say(string.format("[LC;1353]", game.get_event_flag("guild_withdraw_delay")))
			return
			end

			if game.get_event_flag("guild_disband_delay")*86400 > 
				get_global_time() - pc.getqf("new_withdraw_time") then
			say_title("[LC;1001]")
			say("[LC;1354]")
-- say(string.format("[LC;1353]", game.get_event_flag("guild_disband_delay")))
			return
			end
			say_title("[LC;1001]")
			say("[LC;1356]")
			local s =  select("[LC;2059]", "[LC;2035]")
			if s == 2 then
				return
			end

			if pc.level >= 40 then
			if pc.gold >= 200000 then

				if not guild_create_item or pc.countitem(guild_create_item)>0 then
					game.request_make_guild()
				end

				else
				say_title("[LC;1001]")
				say("[LC;1357]")
				return
				end
			else
			say_title("[LC;1001]")
			say("[LC;1358]")
			end
		end
	end
end


