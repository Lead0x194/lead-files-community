quest new_quest_lv17 begin
    state start begin
	-- When level 17 target Wonda Rim for new Quest-------------------------------------------------------------
		when login or levelup with pc.get_level() >= 17 begin
			local v=find_npc_by_vnum(20087)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;5630]")
			end
		end
		when 20087.chat."[LC;5632]" begin
			target.delete("__TARGET__")
			say_title("[LC;5631]") -- yellow text headline
			say("[LC;5633]") -- white font text
			wait() -- next button 
			say_title("[LC;5631]");
           	say("[LC;5634]") -- yellow text headline
			say("[LC;5635]") -- white font text
			local doquest = select("[LC;7148]", "[LC;7304]", "[LC;6200]")
			if doquest == 1 then
				set_state(ask_uriel)
			elseif doquest == 3 then
				say("[LC;7170]")
				local abortquest = select("[LC;7173]", "[LC;7174]")
				if abortquest == 1 then
					set_state(__GIVEUP__)
				else
					say_title("[LC;5631]") -- yellow text headline
					say("[LC;7288]")
					return
				end
			else
				say_title("[LC;5631]") -- yellow text headline
				say("[LC;7288]")
				return
			end
		end
	end
	---- ask uriel what to do --------------------------------------------------------------------------------
	state ask_uriel begin
		--BEGIN EDIT by Arne 18Sept09 according to mantis0026065, Reason: letter, quest
		when enter or login begin
			send_letter("[LC;5632]")
			q.start()
			q.set_title("[LC;5632]")
			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET2__", v, "[LC;5638]")
			end
		end
		
		when button or info begin
		say_title("[LC;5637]")
		say("[LC;5639]")
		say("")
		say(string.format("[LC;5640;%s]", get_map_name_by_number(1)))
		end
		--END EDIT
		
		when 20011.chat."[LC;5632]" begin
			target.delete("__TARGET2__")
			say_title("[LC;5636]") -- yellow text headline
			say("[LC;5642]")
			say_item_vnum(30173) -- icon of item by vnum
			say("[LC;5643]")
			local s = select("[LC;5644]")
			if s == 1 then
				clear_letter()
				q.done() -- EDIT added by Arne 18Sept09, see above for Reason
				set_state(back_to_wondarim)
			end
		end
	end
	--- tell wonda rim what to do---------------------------------------------------------------------------------------------------
	state back_to_wondarim begin

		--BEGIN EDIT by Arne 18Sept09 according to mantis0026065, Reason: letter, quest
		when enter or login begin
			send_letter("[LC;5632]")
			q.start()
			q.set_title("[LC;5632]")
			local v=find_npc_by_vnum(20087)
			if 0!=v then
				target.vid("__TARGET__", v, "[LC;5630]")
			end
		end
		
		when button or info begin
		say_title("[LC;5645]")
		say("[LC;5646]")
		say("")
		say(string.format("[LC;5647;%s]", get_map_name_by_number(1)))
		end
		--END EDIT
		
		when 20087.chat."[LC;5632]" begin
			pc.setqf("collect_count",5) --Current number of items
			target.delete("__TARGET__")
			say_title("[LC;5631]")  -- yellow text headline
			say("[LC;5648]") -- red font text
			wait() -- next button 
			say("[LC;5649]") -- white font text
			say_item_vnum(30173) -- icon of item by vnum
			say("[LC;5650]") 
			say("[LC;5651]")
			q.done() -- EDIT added by Arne 18Sept09, see above for Reason
			set_state(findmurang)
		end
	end
	----- kill mu rang to gather wolfskin -------------------------------------------------------------------------------------------------
	state findmurang begin
	
		--BEGIN EDIT by Arne 18Sept09 according to mantis0026065, Reason: letter, quest
		when enter or login begin
			send_letter("[LC;5632]")
			q.start()
			q.set_title("[LC;5632]")
			-- ticket id: 0076498
			if pc.getqf("collect_count") == 0 then
				pc.setqf("collect_count", 5)
			end
		end
		--END EDIT 
		
		-- kill a mu rang wolf
		when 152.kill begin
			if pc.getqf("collect_count") >= 1 and math.random(1,5) < 4 then -- probability if s.th. drops
				local index =pc.getqf("collect_count") - 1
				pc.setqf("collect_count",index) --you got one, so you have one less to kill
				pc.give_item2(30173) -- spawn item by vnum in inventory
				notice_multiline("[LC;5652]", notice)
				--BEGIN EDIT by Arne 18Sept09 according to mantis0026065, Reason: , new state for quest	
				if pc.getqf("collect_count") <= 0 then
					q.done()
					set_state(skins_to_wonda)
				end
				--END EDIT
			else
				return
			end
		end
		
		when button or info begin
			-------------- info if a wolfskin dropped
			-- hier fehlt questjournal eintrag und es wird keine info angezeigt wo man hin muss
			say_title("[LC;5632]") -- yellow text headline
			say("[LC;5653]")
			say_reward(string.format("[LC;5654;%s]", 5 - pc.getqf("collect_count")))
		end
	end
		-------------- try to give wonda rim the wolfskins		
		--BEGIN EDIT by Arne 18Sept09 according to mantis0026065, Reason: new state for quest	
	state skins_to_wonda begin
		when enter or login begin
			send_letter("[LC;5632]")
			q.start()
			q.set_title("[LC;5632]")
			local v=find_npc_by_vnum(20087)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;5630]")
			end
		end
		
		when button or info begin
		say_title("[LC;5655]")
		say("[LC;5656]")
		say("")
		say(string.format("[LC;5647;%s]", get_map_name_by_number(1)))
		end
		--END EDIT
	
		when 20087.chat."[LC;5632]" begin  
		target.delete("__TARGET__")
			say_title("[LC;5631]")
			if pc.getqf("collect_count") > 0 then
				say_reward(string.format("[LC;5657;%s]", 5 - pc.getqf("collect_count")))
			else
				say("[LC;5658]")
				q.done() -- EDIT added by Arne 18Sept09, see above for Reason
				set_state(gotochaegirab)
			end
		end
	end
	------  talk with uncle chaegirab about the wolfskins and wonda rim ------------------------------------------------------------------------------------------------------
	state gotochaegirab begin
		
		--BEGIN EDIT by Arne 18Sept09 according to mantis0026065, Reason: letter, quest
		when enter or login begin
			send_letter("[LC;5632]")
			q.start()
			q.set_title("[LC;5632]")
			local v=find_npc_by_vnum(20084)
			if 0==v then
			else
				target.vid("__TARGET3__", v, "[LC;5659]")
			end
		end
		
		when button or info begin
		say_title("[LC;5632]")
		say("[LC;5660]")
		say("")
		say(string.format("[LC;5661;%s]", get_map_name_by_number(1)))
		end
		--END EDIT
	
		when 20084.chat."[LC;5632]" begin  
			target.delete("__TARGET3__")
			say_title("[LC;5632]")
			say("[LC;5662]")
			say("[LC;5663]")
			say("[LC;5664]")
			-- Questjournal eintrag fehlt
			q.done() -- EDIT added by Arne 18Sept09, see above for Reason
			set_state(back_to_wondarim_final)
		end
	end
	------  tell wonda rim what uncle chaegirab told ------------------------------------------------------------------------------------------------------
	state back_to_wondarim_final begin
	
		--BEGIN EDIT by Arne 18Sept09 according to mantis0026065, Reason: letter, quest
		when enter or login begin
		send_letter("[LC;5632]")
		q.start()
		q.set_title("[LC;5632]")
					local v=find_npc_by_vnum(20087)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;5630]")
			end
		end
		
		when button or info begin
		say_title("[LC;5632]")
		say("[LC;5665]")
		say("")
		say(string.format("[LC;5647;%s]", get_map_name_by_number(1)))		
		end
		--END EDIT
		
		when 20087.chat."[LC;5632]" begin  
			target.delete("__TARGET__")
			say_title("[LC;5632]")
			say("[LC;5666]")
			local s = select("[LC;5667]", "[LC;5668]")
			-- when player chooses option 1 (lying) -> 
			if s == 1 then
				say("[LC;5669]")
				say_reward("[LC;5670]")
				pc.remove_item(30173, pc.count_item(30173))
				pc.give_item2(80008) -- gold
				pc.change_money(20000)
				pc.give_exp2(20000)
				q.done() -- EDIT added by Arne 18Sept09, see above for Reason
				set_state(__COMPLETE__)
				return
			end
			-- when player chooses option 2 (telling the truth) -> 
			if s == 2 then
                say_title("[LC;5631]")
				say("[LC;5672]")
				say("[LC;5673]")
				q.done() -- EDIT added by Arne 18Sept09, see above for Reason
				set_state(goto_yangshin)
			end
		end
	end
	------  sell wolfskin to yangshin (optional) ------------------------------------------------------------------------------------------------------
	state goto_yangshin begin
		--BEGIN EDIT by Arne 18Sept09 according to mantis0026065, Reason: letter, quest
		when login or enter begin
				local empire = pc.get_empire()
				if is_destination_village(2)  then
				local v=find_npc_by_vnum(20019)
				if 0!=v then
					target.vid("__TARGET4__", v, "[LC;5679]")
				end
			end
			if empire == 1 then -- = Shinsoo
				send_letter("[LC;5632]")
			end
			if empire == 2 then -- = Chunjo
				send_letter("[LC;5632]")
			end
			if empire == 3 then -- = Jinno
				send_letter("[LC;5632]")
			end
			q.start()
			q.set_title("[LC;5632]")		
		end
		
		when button or info begin
			say_title("[LC;5632]")
			local empire = pc.get_empire()
			if empire == 1 then -- = Shinsoo
				say("[LC;5674]")
			end
			if empire == 2 then -- = Chunjo
				say("[LC;5675]")
			end
			if empire == 3 then -- = Jinno
				say("[LC;5676]")
			end	
		end
		--END EDIT
		when 20019.chat."[LC;5632]" begin  
			target.delete("__TARGET4__")
			say_title("[LC;5680]")
			say("[LC;5677]" )
            say_title("[LC;29]")
			say_reward("[LC;5678]")
			pc.remove_item(30173, pc.count_item(30173))
			pc.give_item_from_special_item_group(50300)
			pc.change_money(10000)
			pc.give_exp2(40000)
			q.done() -- EDIT added by Arne 18Sept09, see above for Reason
			set_state(__COMPLETE__)
			return
		end
	end
	------  give up ------------------------------------------------------------------------------------------------------
	state __GIVEUP__ begin
	end
	------  complete ------------------------------------------------------------------------------------------------------
	state __COMPLETE__ begin
	end
end


