			pc.change_money(157000)
			say_reward(string.format("[LC;4540;%s]", item_name(71095),1))
			pc.give_item2(71095, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(72723),1))
			pc.give_item2(72723, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(70050),1))
			pc.give_item2(70050, 1)
			say()
			set_state (state2_1)
		end

		when leave begin 
			--q.done()
		end
	end
	
	
	state state2_1 begin 
