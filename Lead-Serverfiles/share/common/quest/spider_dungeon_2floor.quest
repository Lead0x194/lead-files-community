quest spider_dungeon_2floor begin
	state start begin
		when login or levelup with pc.level >0 begin
			set_state(to_spider_2floor)
		end
	end
		
	state to_spider_2floor begin
		when 20089.chat."[LC;6918]" begin
			say_title("[LC;6919]")
			say("[LC;6920]")
			
			local a= select("[LC;2059]", "[LC;2035]")
			if 1==a then
			
				say_title("[LC;6919]")
				say("[LC;6921]")
				wait()

				pc.warp(91700, 525300)
				return
			end

			say_title("[LC;6919]")
			say("[LC;6922]")
		end
	end
end