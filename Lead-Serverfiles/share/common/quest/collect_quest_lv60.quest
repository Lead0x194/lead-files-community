quest collect_quest_lv60  begin
	state start begin
	end
	state run begin
		when login or levelup with pc.level >= 60 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20084)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;272]")
			end
			send_letter("[LC;331]")
		end

		when button or info begin
			say_title("[LC;344]")
			say("[LC;356]")
		end

		when __TARGET__.target.click or	20084.chat."[LC;364]" begin
			target.delete("__TARGET__")
			say_title("[LC;365]")
			say("[LC;366]")
			wait()
			say_title("[LC;365]")
			say("[LC;367]")
			wait()
			say_title("[LC;365]")
			say("[LC;368]")
			set_state(go_to_disciple)
			pc.setqf("duration",0)  -- Versuchszeit
			pc.setqf("collect_count",0)--gesammte Zahl der Artikel
			pc.setqf("drink_drug",0) --Wenn das Verwirrungswasser trinkt, plus 1
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter("[LC;369]")

		end
		when button or info begin
			say_title("[LC;330]")
			say("[LC;332]")
			say_item_vnum(30050)
			say_reward(string.format("[LC;333;%s]", pc.getqf("collect_count")))
		end

		when 71035.use begin --DasVerwirrungswasser
			if get_time() < pc.getqf("duration") then
				say("[LC;334]")
				return
			end
			if pc.getqf("drink_drug")==1 then
				say("[LC;335]")
				return
			end
			if pc.count_item(30050)==0 then
				say_title("[LC;336]")
				say("[LC;337]")
				return
			end

			pc.remove_item(71035, 1)
			pc.setqf("drink_drug",1)
		end




		when 20084.chat."[LC;338]" with pc.count_item(30050) >0   begin
			if get_time() > pc.getqf("duration") then
				if  pc.count_item(30050) >0 then
					say_title("[LC;365]")
					say("[LC;339]")
					pc.remove_item(30050, 1)
					pc.setqf("duration",get_time()+60*60*22)------------------22Stunden
					wait()

					local pass_percent
					if pc.getqf("drink_drug")==0 then
						pass_percent=60
					else
						pass_percent=90
					end

					local s= number(1,100)
					if s<= pass_percent  then
						if pc.getqf("collect_count")< 19 then     --nicht mehr als 20
							local index =pc.getqf("collect_count")+1
							pc.setqf("collect_count",index)     --Da du noch einen besorgst, macht man plus eins
							say_title("[LC;336]")
							say(string.format("[LC;340;%s]", 20-pc.getqf("collect_count")))
							pc.setqf("drink_drug",0)	 --Anfang mit dem Verwirrungswasser
							return
						end
						say_title("[LC;365]")
						say("[LC;341]")
						pc.setqf("collect_count",0)
						pc.setqf("drink_drug",0)
						pc.setqf("duration",0)
						set_state(key_item)
						return
					else
						say_title("[LC;365]")
						say("[LC;342]")
						pc.setqf("drink_drug",0)	 --Anfang mit dem Verwirrungswasser
						return
					end

				else
					say_title("[LC;365]")
					--say(string.format("[LC;269]", item_name(30050)))
					say("[LC;343]")
					return
				end
			else
				say_title("[LC;365]")
				say("[LC;345]")
				return
			end

		end
	end


	state key_item begin
		when letter begin
			send_letter("[LC;346]")

			if pc.count_item(30223)>0 then
				local v = find_npc_by_vnum(20084)
				if v != 0 then
					target.vid("__TARGET__", v, "[LC;272]")
				end
			end

		end
		when button or info begin
			if pc.count_item(30223) >0 then
				say_title("[LC;347]")
				say("[LC;348]")
				return
			end

			say_title("[LC;349]")
			say("[LC;350]")
			say_item_vnum(30223)
			say("[LC;351]")
		end



		when 1101.kill or	 1102.kill or	 1103.kill or	 1104.kill or	 1105.kill or	 1106.kill or	 1107.kill  begin
			local s = number(1, 500)
			if s == 1 and pc.count_item(30223)==0 then
				pc.give_item2(30223, 1)
				send_letter("[LC;352]")
			end
		end



		when __TARGET__.target.click  or	20084.chat."[LC;353]" with pc.count_item(30223) > 0  begin
			target.delete("__TARGET__")
			if pc.count_item(30223) > 0 then 
				say_title("[LC;365]")
				say("[LC;354]")
				pc.remove_item(30223,1)
				set_state(__reward)

			else
				say_title("[LC;138]")
				--say(string.format("[LC;242]", item_name(30223)))
				say("[LC;355]")
				return
			end
		end

	end

	state __reward begin
		when letter begin
			send_letter("[LC;357]")

			local v = find_npc_by_vnum(20018)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;245]")
			end

		end
		when button or info begin
			say_title("[LC;282]")
			say("[LC;358]")

		end

		when __TARGET__.target.click  or	20018.chat."[LC;359]"  begin
		    target.delete("__TARGET__")
			say_title("[LC;248]")
			say("[LC;360]")
			wait()
			say_pc_name()
			say("[LC;361]")
			wait()
			say_title("[LC;248]")
			say("[LC;362]")
			say_reward("[LC;363]")

			affect.add_collect(apply.ATT_GRADE_BONUS,50,60*60*24*365*60)--60Jahre
			pc.give_item2(50112)
			clear_letter()
			set_quest_state("collect_quest_lv70", "run")
			set_state(__complete)
		end

	end


	state __giveup__ begin
	end
	state __complete begin
	end
end



