quest main_quest_lv6 begin
	state start begin
	end
	state run begin
		when login or levelup or enter with pc.get_level() >= 6 begin
			set_state ( gototeacher )		
		end
	end
	state gototeacher begin
		when letter begin
			local v=find_npc_by_vnum(20354)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4501]")
			end
		end
		when letter begin
			send_letter("[LC;4501]")
		end
		when button or info begin
			say_title("[LC;4501]")
			say("[LC;4512]")
			say_item_vnum(30070)
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;4066]")
			say("[LC;4520]")
			wait()
			say_title("[LC;4066]")
			say("[LC;4521]")
			wait()
			say_title("[LC;44]")
			say_reward("[LC;4522]")
			say_reward(string.format("[LC;4523;%s]", 1300))
			say_reward(string.format("[LC;4524;%s]", 1500))
			say_reward(string.format("[LC;4184;%s]", item_name(30070)))
			say_item_vnum(30070)

			set_state ( gotosmith )
		end
	end


	state gotosmith begin
		when letter begin
			local v=find_npc_by_vnum(20016)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4525]")
			end
		end
		when letter begin
			send_letter("[LC;4526]")
		end
		when button or info begin
			say_title("[LC;4526]")
			say("[LC;4500]")
		end

		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;27]")
			say("[LC;4502]")
			wait()
			say_title("[LC;27]")
			say("[LC;4503]")
			say_item_vnum(30003)
						set_state ( gotowarehousekeeper )

		end
	end
	state gotowarehousekeeper begin
		when letter begin
			local v=find_npc_by_vnum(9005)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4504]")
			end
		end
		when letter begin
			send_letter("[LC;4505]")
		end
		when button or info begin
			say_title("[LC;4505]")
			say("[LC;4506]")
			say_item_vnum(30003)
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;4507]")
			say("[LC;4508]")
			wait()
			say_title("[LC;4507]")
			say("[LC;4509]")
			say_item_vnum(30003)
			say("[LC;4510]")
			set_state ( gotosmith2 )
		end
	end
	state gotosmith2 begin
		when letter begin
			local v=find_npc_by_vnum(20016)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4525]")
			end
		end
		when letter begin
			send_letter("[LC;4511]")
		end
		when button or info begin
			say_title("[LC;4511]")
			say("[LC;4513]")
			say_item_vnum(30003)
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;27]")
			say("[LC;4514]")
			wait()
			say_title("[LC;27]")
			say("[LC;4515]")
			wait()
			say_title("[LC;27]")
			say("[LC;4516]")
			wait()
			say_title("[LC;3558]")
			say_reward(string.format("[LC;4523;%s]", 1300))
			say_reward(string.format("[LC;4524;%s]", 1500))
			say_reward(string.format("[LC;4184;%s]", item_name(30070)))
			say_item_vnum(30070)
			pc.give_exp2(5000)
			pc.change_money(1500)
			pc.give_item2(30070 , 1) 

			clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv7", "run")

		end
	end
	state __COMPLETE__ begin
	end

end
