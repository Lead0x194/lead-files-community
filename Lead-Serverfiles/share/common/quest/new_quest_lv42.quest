quest new_quest_lv42 begin
	state start begin
		when login or levelup with pc.get_level() >= 42 begin
			set_state(information)
		end
	end
	-- player wants to eat s.th. at octavio's but he has no fish -----------------------------------------
	state information begin
		when login or enter begin
			send_letter("[LC;5871]")
			q.start()
			q.set_title("[LC;5871]")
			local v=find_npc_by_vnum(20008) -- Octavio
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;5872]")
			end
		end
		when button or info begin
			say_title("[LC;5871]")
			say("[LC;5873]")
			say("")
			say(string.format("[LC;5877;%s]", get_map_name_by_number(1)))
		end
		when 20008.chat."[LC;5871]" begin -- EDIT added by Arne 22Sept09, Reason: make all quests to choices
			target.delete("__TARGET__")
			say_title("[LC;5874]") -- yellow text headline
			say("[LC;5875]" ) -- white font text
			say("[LC;5876]")
			local doquest = select("[LC;5878]", "[LC;7304]", "[LC;6200]")
			if doquest ==1 then 
				q.done()
				set_state(ask_fisher)
			elseif doquest == 3 then
				say("[LC;7170]")
				local abortquest = select("[LC;7173]", "[LC;7174]")
				if abortquest == 1 then
					set_state(__GIVEUP__)
				else
					say_title("[LC;5874]") -- yellow text headline
					say("[LC;7288]")
					return
				end
			else
				say_title("[LC;5874]") -- yellow text headline
				say("[LC;7288]")
				return
			end
		end
	end
	-- player shall ask the fisher, why there is no fresh fish from the sea-----------------------------
	state ask_fisher begin
		when enter or login begin
			send_letter("[LC;5871]")
			q.start()
			q.set_title("[LC;5871]")
			local v=find_npc_by_vnum(9009) -- Fisher
			local v2=find_npc_by_vnum(20013) -- Fisher without store
			if 0==v2 then -- EDIT modified by Arne 22Sept09, Reason: rtying to get both Fisher instances marked, preferably that one without a shop
				if 0!=v then
					target.vid("__TARGET2__", v, "[LC;5879]")
				end
			else
				target.vid("__TARGET2__", v2, "[LC;5879]")
			end
		end
	
        -- BEGIN EDIT by Arne 22Sept09, Reason: trying to get dialoges working for both Fishers
		when button or info begin
    		say_title("[LC;5871]")
	    	say("[LC;5884]")
		    say("")
    		say(string.format("[LC;5885;%s]", get_map_name_by_number(1)))
		end
	
        function npc_chat()
			target.delete("__TARGET2__")
			say_title("[LC;5883]")
			say("[LC;5880]")
    			wait()
			say("[LC;5881]")
	    		wait()
			say("[LC;5882]")
			q.done()
        end

		when 9009.chat."[LC;5871]" begin
            		new_quest_lv42.npc_chat()
			set_state(ask_yonah)
		end
		
		when 20013.chat."[LC;5871]" begin
			new_quest_lv42.npc_chat()
			set_state(ask_yonah)			
		end
		-- END EDIT
	end
	
	-- player shall ask yonah, what to to against the agressive whales, because he hunted whales in his youth -------------------------------------
	state ask_yonah begin
		when enter or login begin
			send_letter("[LC;5886]")
			q.start() -- EDIT Added by Arne 22Sept09, Reason: no quest, no letter
			q.set_title("[LC;5886]")
			local v=find_npc_by_vnum(20005) -- Yonah
			if 0==v then
			else
				target.vid("__TARGET3__", v, "[LC;5889]")
			end
		end
		-- BEGIN EDIT by Arne 22Sept09, Reason: missing quest
		when button or info begin
			say_title("[LC;5886]")
			say("[LC;5887]")
			say("")
			say(string.format("[LC;5888;%s]", get_map_name_by_number(1)))
		end
		--END EDIT
		when 20005.chat."[LC;5886]" begin -- EDIT added by Arne 22Sept09, Reason: make all quests to choices
			target.delete("__TARGET3__")
			say_title("[LC;5893]")
			say("[LC;5890]")			
		wait()
			say("[LC;5891]")
			say_reward("[LC;5892]")
			q.done() --EDIT added by Arne 22Sept09, Reason: see above
			set_state(goto_smith)
		end
	end
	-- player shall ask the smith to produce special weapons for hunting whales with strong iron -----------------------------------------
	state goto_smith begin
		when enter or login begin
			
			-- turkey special hack
			if pc.getqf("reward_given") == 1 then
				char_log(pc.get_player_id(), 'QUEST_HACK', 'new_quest_lv42 goto_smith hack')
				q.done()
				set_state(__COMPLETE__)
				return
			end
			
			new_quest_lv42_neededAmountDrop1 = 20
			new_quest_lv42_mob1 = 20047 -- diamantader
			new_quest_lv42_drop1 = 50601 -- diamant stein
			send_letter("[LC;5886]")
			q.start() -- EDIT Added by Arne 22Sept09, Reason: no quest, no letter
			q.set_title("[LC;5886]")
			local v=find_npc_by_vnum(20016) -- Schmied
			if 0==v then
			else
				target.vid("__TARGET4__", v, "[LC;5895]")
			end
		end
				-- BEGIN EDIT by Arne 22Sept09, Reason: missing quest
		when button or info begin
			say_title("[LC;5886]")
			say("[LC;5894]")
			say("")
			say(string.format("[LC;5907;%s]", get_map_name_by_number(1)))
		end
		--END EDIT
		
		when 20016.chat."[LC;5886]" begin
			target.delete("__TARGET4__")
			say_title("[LC;5899]")
			say("[LC;5896]")			
			wait()
			say_title("[LC;5899]")
			say("[LC;5897]")
			say_reward(string.format("%s x", new_quest_lv42_neededAmountDrop1))
			say_item_vnum(new_quest_lv42_drop1) -- icon of item
			say_reward("[LC;5898]")
			say(mob_name(new_quest_lv42_mob1))
			q.done() --EDIT added by Arne 22Sept09, Reason: see above
			set_state(find_diamonds)
		end
	end
	-- smith need special diamondstones, to produce strong iron weapons -----------------------------------------
	-- player has to go mining to get the diamond stones -----------------------------------------
	state find_diamonds begin
		when enter or login begin
			new_quest_lv42_neededAmountDrop1 = 20
			new_quest_lv42_mob1 = 20047 -- diamantader
			new_quest_lv42_drop1 = 50601 -- diamant stein
			send_letter("[LC;5886]")
			--BEGIN EDIT by Arne 22Sept09, Reason: trying to come up with a messaging for the harvestable items but abandoned it
			q.start()
			q.set_title("[LC;5886]")
			
			notice_multiline("[LC;5901]", notice)
			if new_quest_lv42_neededAmountDrop1 <= pc.count_item(new_quest_lv42_drop1) then
				send_letter("[LC;5886]")
				local v=find_npc_by_vnum(20016) -- Schmied
				if 0==v then
				else
					target.vid("__TARGET4__", v, "[LC;5895]")
				end
			else
			end
			--END EDIT
		end
		when info or button begin
			say_title("[LC;5886]") --EDIT Arne 22Sept09, Reason: more info in quest message
			say("[LC;5906]")
			say("")
			if new_quest_lv42_neededAmountDrop1 <= pc.count_item(new_quest_lv42_drop1) then
				say("[LC;5903]")
				say(string.format("[LC;5907;%s]", get_map_name_by_number(1)))
			else
				say(string.format("[LC;5902;%s]" , new_quest_lv42_neededAmountDrop1-pc.count_item(new_quest_lv42_drop1), mob_name(new_quest_lv42_mob1)))
			end
		end
		
		when kill begin
			if new_quest_lv42_neededAmountDrop1 <= pc.count_item(new_quest_lv42_drop1) then
				send_letter("[LC;5886]")
				local v=find_npc_by_vnum(20016) -- Schmied
				if 0==v then
				else
					target.vid("__TARGET4__", v, "[LC;5895]")
				end
			end
		end
		
		when 20047.click begin
			if pc.is_mount() != true then
					pc.mining()
				end
			if new_quest_lv42_neededAmountDrop1 <= pc.count_item(new_quest_lv42_drop1) then
				send_letter("[LC;5886]")
				local v=find_npc_by_vnum(20016) -- Schmied
				if 0==v then
				else
					target.vid("__TARGET4__", v, "[LC;5895]")
				end
			end
		end


		
		when 20016.chat."[LC;5886]" begin
			say_title("[LC;5899]")
			if new_quest_lv42_neededAmountDrop1 <= pc.count_item(new_quest_lv42_drop1) then
				say("[LC;5904]")
				target.delete("__TARGET4__")
				pc.setqf("diamond_duration", get_time())
				new_quest_lv42_timeToWait = 86400
				pc.remove_item(new_quest_lv42_drop1, new_quest_lv42_neededAmountDrop1)
				q.done() --EDIT ... yawn, see above
				set_state(wait_for_smith)
			else
				say(string.format("[LC;5908;%s]", new_quest_lv42_neededAmountDrop1-pc.count_item(new_quest_lv42_drop1)))
				say("[LC;5905]")
			end
		end
	end
	-- player has to wait as long as the smith needs to produce the weapons -----------------------------------------
	state wait_for_smith begin
		when enter or login begin
			new_quest_lv42_neededAmountDrop1 = 20
			new_quest_lv42_mob1 = 20047 -- diamantader
			new_quest_lv42_drop1 = 50601 -- diamant stein
			new_quest_lv42_timeToWait = 86400
			send_letter("[LC;5886]")
			q.start()
			q.set_title("[LC;5886]")
			local timeLeft = new_quest_lv42_timeToWait - (get_time() - pc.getqf("diamond_duration"))
			q.set_clock("[LC;5910]", timeLeft)
			if get_time() - pc.getqf("diamond_duration") >= new_quest_lv42_timeToWait then
				send_letter("[LC;5886]")
				local v=find_npc_by_vnum(20016) -- Schmied
				if 0==v then
				else
					target.vid("__TARGET4__", v, "[LC;5895]")
				end
			end
		end
		
		when button or info begin
			say_title("[LC;5886]")
			if get_time() - pc.getqf("diamond_duration") >= new_quest_lv42_timeToWait then
				say(nil)
				say("")
				say(string.format("[LC;5907;%s]", get_map_name_by_number(1)))
			else
				say("[LC;5912]")
			end
		end
		--BEGIN EDIT added by Arne 23Sept09, Reason: trying to get a letter started on time up
		when kill begin
			if get_time() - pc.getqf("diamond_duration") >= new_quest_lv42_timeToWait then
				send_letter("[LC;5886]")
				local v=find_npc_by_vnum(20016) -- Schmied
				if 0==v then
				else
					target.vid("__TARGET4__", v, "[LC;5895]")
				end
			end
		end
		--END EDIT
				
		when 20016.chat."[LC;5886]" begin
    		say_title("[LC;5899]")
			if get_time() - pc.getqf("diamond_duration") >= new_quest_lv42_timeToWait then
				say("[LC;5913]")
				target.delete("__TARGET4__")
				q.done()
				pc.give_item2(30175)
				pc.give_item2(30175)
				set_state(back_to_fisher)
			else
				say("[LC;5914]")
			end
		end
	end
	-- player brings back the weapons to the fisher -> now they can defend themselves against the agressive whales -------
	state back_to_fisher begin
		when enter or login begin
			new_quest_lv42_neededAmountDrop1 = 20
			new_quest_lv42_mob1 = 20047 -- diamantader
			new_quest_lv42_drop1 = 50601 -- diamant stein
			new_quest_lv42_timeToWait = 86400
			send_letter("[LC;5886]")
			q.start()
			q.set_title("[LC;5886]")
			local v=find_npc_by_vnum(9009) -- Fisher
			local v2=find_npc_by_vnum(20013) -- Fisher without store
			if 0==v2 then -- EDIT modified by Arne 22Sept09, Reason: rtying to get both Fisher instances marked, preferably that one without a shop
				if 0!=v then
					target.vid("__TARGET5__", v, "[LC;5879]")
				end
			else
				target.vid("__TARGET5__", v2, "[LC;5879]")
			end
		end
		
		when button or info begin
			say_title("[LC;5886]")
			say("[LC;5915]")
			say("")
			say(string.format("[LC;5885;%s]", get_map_name_by_number(1)))
			
		end
		
		when 20013.chat."[LC;5886]" or 9009.chat."[LC;5886]" begin
			target.delete("__TARGET5__")
			say_title("[LC;5883]")
			if pc.count_item(30175) >= 2 then
				pc.remove_item(30175, 2)
				say("[LC;5916]")
				say_reward(string.format("[LC;5917]", 500000))
				say_item_vnum(27868) -- icon of item Gegrillter Graskarpfen
				say_reward("[LC;5918]")
				pc.setqf("reward_given", 1)
				pc.change_money(500000)
				pc.give_exp2(750000)
				pc.give_item2(27868, 3)
				q.done()
				set_state(__COMPLETE__)
				return
			else
				say("[LC;5919]")
				say_reward("[LC;5920]")
				q.done()
				set_state(goto_smith)
			end
		end
	end
	------  give up ------------------------------------------------------------------------------------------------------
	state __GIVEUP__ begin
	end
	------  complete ------------------------------------------------------------------------------------------------------
	state __COMPLETE__ begin
	end
end 
