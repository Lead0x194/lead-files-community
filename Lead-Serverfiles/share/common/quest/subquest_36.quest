
quest subquest_36 begin
	state start begin
		when login or levelup with pc.level >= 47 and pc.level <= 49 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20005)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7968]")
			end
		end


        when __TARGET__.target.click or 20005.chat."[LC;7979]" begin
			target.delete("__TARGET__")
			say_title("[LC;6969]")
			say("[LC;7990]")
			wait()
			say_title("[LC;6969]")
			say("[LC;7991]")
			local s= select("[LC;7992]", "[LC;7993]")
			if 2==s then
				say("[LC;7714]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;6969]")
					say("[LC;7994]")
					return
				end
				say_title("[LC;6969]")
				say("[LC;7995]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;6969]")
			say("[LC;7996]")
			set_state(for_horse)
		end
	end


state for_horse begin
	when letter begin
	    send_letter("[LC;7979]")
		if 	pc.count_item(50054)>=10 then
			local v=find_npc_by_vnum(20349)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;6566]")
			end
		end

	end
	when button or info begin
		if 	pc.count_item(50054)>=10 then
	    		say_title("[LC;7967]")
			say("[LC;7969]")
			return
		end

		say_title("[LC;7970]")
		say("[LC;7971]")
	end



	when 20349.chat."[LC;7972]" with pc.count_item(50054) ==0 or pc.count_item(50054) < 10 begin
		say_title("[LC;1558]")
		say("[LC;7973]")
	    local s= select("[LC;7977]", "[LC;7825]")
	    if 1==s then
			say_pc_name()
			say("[LC;7974]")
			return

	    else
			say_pc_name()
			say("[LC;7975]")
			wait()
			say_title("[LC;1558]")
			say("[LC;7976]")

			local s= select("[LC;7977]", "[LC;7825]")
			if 1==s then
				say_pc_name()
				say("[LC;7978]")
				return

			elseif 2==s then
				say_pc_name()
				say("[LC;7980]")
				set_state(__GIVEUP__)
			end
	    end
	end



	when __TARGET__.target.click or	20349.chat."[LC;7981]" with pc.count_item(50054)>=10 begin
		target.delete("__TARGET__")
		say_title("[LC;1586]")
		say("[LC;7982]")
		say_reward("[LC;7983]")
		pc.give_exp2(1800000)

		pc.remove_item(50054,10)
		set_state(OLD_MAN_DONE)
	end
  end

  state OLD_MAN_DONE begin
	when letter begin
			send_letter("[LC;7984]")
			local v=find_npc_by_vnum(20005)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7968]")
			end

		end
	when button or info begin
		say_title("[LC;7985]")
		say("[LC;7986]")
	end
	when __TARGET__.target.click or	20005.chat."[LC;7987]" begin
		target.delete("__TARGET__")
		say_title("[LC;7968]")
		say("[LC;7988]")
		say_reward("[LC;7989]")

		local s=number(1,3)
		if 1>=s then
			pc.give_item2(50320)
		elseif 2>=s then
			pc.give_item2(50320)
		elseif 3>=s then
			pc.give_item2(50320)
		end

		set_state(__COMPLETE__)
		clear_letter()

	end
end
    state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
	state __GIVEUP__ begin
    end
end

