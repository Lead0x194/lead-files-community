
quest subquest_3 begin
	state start begin
		when login or levelup with pc.level >= 8 and pc.level <= 13 begin
			set_state(information)
		end	
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20018)

			if v!= 0 then
				target.vid("__TARGET__", v, "[LC;7023]")
			end
		end

		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;248]")
			say("[LC;7029]")
			wait()

			say_title("[LC;248]")
			say("[LC;7030]")
			say_item_vnum(30029)
			say("[LC;7031]")

			set_state(hunt_for_wolf)
		end
	end

	state hunt_for_wolf begin
		when letter begin
			send_letter("[LC;7023]")
		end
		when button or info begin
			say_title("[LC;7023]")
						say_reward("[LC;7032]")
			say_item_vnum(30029)
					end

    	when 20018.chat."[LC;7033]" with pc.count_item(30029) == 0 begin
			say_title("[LC;248]")
			say("[LC;7034]")
			say_item_vnum(30029)
			say("[LC;7035]")
		end

		
		when 104.kill begin
			local s = number(1, 100)
			if s <= 5 then
				pc.give_item2("30029", 1)
				set_state(go_back_to_doctor)
			end
		end
	
	end

    state go_back_to_doctor begin
		when letter begin
			send_letter("[LC;7036]")
			local v = find_npc_by_vnum(20018)

			if v!= 0 then
				target.vid("__TARGET__", v, "[LC;7036]")
			end
		end
		when button or info begin
			say_title("[LC;7022]")
						say_reward("[LC;7024]")
					end
				
		when __TARGET__.target.click begin      
			target.delete("__TARGET__")
			if pc.count_item(30029) >= 1 then 
			say_title("[LC;248]")
			say("[LC;7025]")
			say_item_vnum(30029)
			say("[LC;7026]")
			wait()
			say_title("[LC;248]")
			say("[LC;7027]")
			say_item_vnum(30027)
			
			say_title("[LC;3558]")
						say_reward("[LC;7028]")
			
			pc.remove_item(30029)
			pc.give_exp2(3000)
			set_quest_state("levelup","run")
			
			pc.change_money(5000)
			pc.give_item2("30027", 1)

			clear_letter()
			set_state(__COMPLETE__)
			end
		end
	end

	state __COMPLETE__ begin
	end
end

