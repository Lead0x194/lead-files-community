quest item_change_sex begin
	state start begin
		when 71048.use begin 
			if pc.get_level() < 50 then 
				say_title("[LC;78]")
				say("[LC;1785]")
				return
			end
			
			if pc.is_engaged() then
				say_title("[LC;78]")
				say("[LC;1793]")
				return
			end

			if pc.is_married() then
				say_title("[LC;78]")
				say("[LC;1793]")
				return
			end

			if pc.is_polymorphed() then
				say_title("[LC;78]")
				say("[LC;1796]")
				return
			end

			if get_time() < pc.getqf("next_time") then
				say_title("[LC;78]")
				say("[LC;1798]")
				say("[LC;1799]")

				if pc.is_gm() then
					say(string.format("[LC;1784;%s]", time_to_str(pc.getqf("next_time"))))
					say("[LC;1786]")
					local s =  select("[LC;2059]", "[LC;2035]")
					if s == 1 then
						say("[LC;81]")
						pc.setqf("next_time", 0)
					end
				end
				return

			end

			say_title("[LC;1787]")
			say("[LC;1788]")
			wait()
			say_title("[LC;1787]")
			say("[LC;1789]")
			local s= select("[LC;2059]", "[LC;2035]")

			if 1==s then
				say_title("[LC;1787]")
				say("[LC;1790]")
				say_reward("[LC;71]")
				
				pc.remove_item("71048",1)
				pc.setqf("next_time", get_time() + 86400 * 3)

				pc.change_sex()

				local m_sex = pc.get_sex()

				if m_sex == 0 then
				    char_log(0, "CHANGE_SEX", "F -> M")
				else
				    char_log(0, "CHANGE_SEX", "M -> F")
				end

			elseif 2==s then
				say("[LC;1791]")
			end
		end
	end
end		


