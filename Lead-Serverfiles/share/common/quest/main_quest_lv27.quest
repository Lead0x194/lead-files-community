quest main_quest_lv27 begin
	state start begin
	end
	state run begin
		when login or levelup or enter begin
			if pc.get_level() >= 27 then 				
				setstate( gotoboss )		
			end
		end
	end
	state gotoboss begin
		when letter begin
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4078]")
			end
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;4180]")
			q.set_title("[LC;4180]")
			q.start()
		end
		when button begin
			say_title("[LC;4180]")
			say("[LC;4185]")

		end
		when info begin
			say_title("[LC;4180]")
			say("[LC;4186]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;4082]")
			say("[LC;4187]")
			wait()
			say_title("[LC;4082]")
			say("[LC;4188]")
			wait()
			say_title("[LC;4189]")
			say("[LC;4190]")
			setstate( killmetinstone )
			q.done()
		end
	end

	state killmetinstone begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;4180]")
			q.set_title("[LC;4180]")
			q.start()
		end
		when button begin
			say_title("[LC;4180]")
			say("[LC;4191]")
		end
		when info begin
			say_title("[LC;4180]")
			say("[LC;4191]")
		end
		when 8005.kill begin
			say_title("[LC;4180]")
			say("[LC;4192]")
			setstate(gotoboss2)
			q.done()
		end	
	end
	state gotoboss2 begin
		when letter begin
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4078]")
			end
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;4178]")
			q.set_title("[LC;4110]")
			q.start()
		end
		when button begin
			say_title("[LC;4178]")
			say("[LC;4110]")
		end
		when info begin
			say_title("[LC;4178]")
			say("[LC;4110]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;4082]")
			say("[LC;4181]")
			wait()
			say_title("[LC;4182]")
						say_reward("[LC;4183]")
say_reward(string.format("[LC;4184;%s]", item_name(30018)))
say_reward(string.format("[LC;4184;%s]", item_name(30031)))
			pc.give_exp2( 300000 )
			pc.change_money( 15000 )
			pc.give_item2( 30018,1 ) 
			pc.give_item2( 30031,1 ) 
			q.done()
			clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv30","run")
		end
	end
	state __COMPLETE__ begin
	end
end


