define acient_rubbing 31001
define acient_doc 31002
----------------------------------
----------------------------------
quest main_quest_lv60 begin
	state start begin
		when login or levelup or enter with pc.get_level() >= 60 begin
			if pc.getf("main_quest_lv55", "__status")==main_quest_lv55.__COMPLETE__ then
				set_state ( quest1_begin )
			end
		end
	end
	
	state run begin
		when login or levelup or enter with pc.get_level() >= 60 begin
			set_state ( quest1_begin )
		end
	end

	state quest1_begin begin
		when letter begin
			send_letter("[LC;4528]")
			
			local vid_20011 = find_npc_by_vnum(20011)
			if 0 != vid_20011 then
				target.vid("__TARGET__", vid_20011, mob_name(20011))
			end
		end

		when button or info begin
			say_title("[LC;4528]")
			
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4539]")
			say("")
			
		end
		
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4550]")
			say("")
			wait()
			
			say_title(pc.getname())
			say("[LC;4561]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			say("[LC;4563]")
			say("")

			set_state ( quest2_begin )
		end
	end

	state quest2_begin begin
		when letter begin
			send_letter("[LC;4564]")

			local v = find_npc_by_vnum(20011)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20011))
			end
		end

		when button or info begin
			say_title("[LC;4564]")
			say("[LC;4565]")
			say("")
		end

		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4566]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			say("[LC;4567]")
			say("")
			wait()
			
			say_title(pc.getname())
			say("[LC;4527]")
			say("")
			wait()
			
			say_title(mob_name(20011))  
			say("[LC;4529]")
			
			set_state (quest2_ongoing)
		end
	end
	
	state quest2_ongoing begin
		when letter begin
			send_letter("[LC;4564]")

			local v = find_npc_by_vnum(20371)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20371))
			end
		end

		when button or info begin
			say_title("[LC;4564]")
			say("[LC;4530]")
			say("")
		end
		
		when 20011."[LC;4564]" begin
			say_title(mob_name(20011))
			say("[LC;4531]")
			say("")
		end
		
		when 20371.click begin
			target.delete("__TARGET__")
			say_reward("[LC;4532]")
			pc.give_item2 ( acient_rubbing )
			say("")
			
			set_state (quest2_end)
		end
	end
		
	state quest2_end begin
		when letter begin
			send_letter("[LC;4564]")

			local v = find_npc_by_vnum(20011)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20011))
			end
		end

		when button or info begin
			say_title("[LC;4564]")
			say("[LC;4533]")
			say("")
		end
		
		when __TARGET__.target.click begin
			pc.remove_item ( acient_rubbing, 1 )
			target.delete("__TARGET__")
			
			say_title(mob_name(20011))
			say("[LC;4534]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			say("[LC;4535]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			say("[LC;4536]")
			say("")
			wait()
			
			say_title(locale.reward)
			say_reward(string.format("[LC;4537;%d]", 980000))
			say_reward(string.format("[LC;4538;%d]", 175000))
			say_reward(string.format("[LC;4540;%s]", item_name(71001).." ".."10"..locale.count_postfix))
			say_reward(string.format("[LC;4540;%s]", item_name(50721).." ".."10"..locale.count_postfix))
			say_reward(string.format("[LC;4540;%s]", item_name(50725).." ".."10"..locale.count_postfix))
			say("")
			
			pc.give_exp2(980000)
			pc.change_money(175000)
			
			pc.give_item2(71001, 10)
			pc.give_item2(50721, 10)
			pc.give_item2(50725, 10)
			
			
			
			set_state (quest3_begin)
		end
	
	end
	
	state quest3_begin begin
		when letter begin
			send_letter("[LC;4541]")

			local v = find_npc_by_vnum(20011)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20011))
			end
		end

		when button or info begin
			say_title("[LC;4541]")
			say("[LC;4542]")
			say("")
		end
		
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4543]")
			say("")
			
			set_state (quest3_ongoing1)
		end	
	end
	
	state quest3_ongoing1 begin
		when letter begin
			send_letter("[LC;4541]")

			--------------------------------
			--------------------------------
		end

		when button or info begin
			say_title("[LC;4541]")
			say("[LC;4542]")
			say("")
		end

		when 20011.chat."[LC;4541]" begin
			say_title(mob_name(20011))
			say("[LC;4545]")
			say("")
		end
		
		when 2305.kill begin
			if	number (1,100) == 1 then	
				pc.give_item2 (acient_doc, 1 )	
				say_reward("[LC;4546]")
				say("")
				
				set_state (quest3_end1)
			end
		end
	end
	
	state quest3_end1 begin
		when letter begin
			send_letter("[LC;4541]")

			local v = find_npc_by_vnum(20011)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20011))
			end
		end

		when button or info begin
			say_title("[LC;4541]")
			say("[LC;4542]")
			say("")
		end
		
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4547]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			pc.remove_item (acient_doc, 1 )	
			say("[LC;4548]")
			say("")
			
			set_state (quest3_ongoing2)
		end	
		
	end
	
	state quest3_ongoing2 begin
		when enter begin
			pc.setqf("remain_item",9)
		end
		
		--*************************--
		when letter begin
			send_letter("[LC;4541]")

			--------------------------------
			--------------------------------
		end
		when button or info begin
			say_title("[LC;4541]")
			say("[LC;4542]")
			say("")
			q.set_counter("[LC;4544]", pc.getqf("remain_item"))
		end
		-----------------------------
		--*************************--
		

		
		when 2305.kill begin
			if	number (1,100) == 1 then
				local remain_item_prev =  pc.getqf("remain_item")
				pc.setqf("remain_item",remain_item_prev-1)
			
				pc.give_item2 (acient_doc, 1 )	
				notice(string.format("[LC;4549;%d]",pc.getqf("remain_item")))
				
				if pc.getqf("remain_item")==0 then
					-------------------------------------
					-------------------------------------
					set_state (quest3_end2)
				end
			end
		end
	end
	
	state quest3_end2 begin
		--*************************--
		when letter begin
			send_letter("[LC;4541]")

			local v = find_npc_by_vnum(20011)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20011))
			end
		end
		when button or info begin
			say_title("[LC;4541]")
			say("[LC;4542]")
			say("")
			q.set_counter("[LC;4544]", pc.getqf("remain_item"))
		end
		-----------------------------
		--*************************--
	
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			pc.remove_item (acient_doc, pc.count_item (acient_doc) )	
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4551]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4552]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4553]")
			say("")
			wait()
			
			say_title(locale.reward)
			----"12345678901234567890123456789012345678901234567890"|
			say_reward(string.format("[LC;4537;%d]", 3300000))
			say_reward(string.format("[LC;4540;%s]", item_name(71094).." ".."3"..locale.count_postfix))
			say_reward(string.format("[LC;4540;%s]", item_name(30056)))
			say_reward(string.format("[LC;4540;%s]", item_name(30025)))
			say("")
			
			
			pc.give_exp2(3300000)
			
			pc.give_item2(71094, 3)
			pc.give_item2(30056)
			pc.give_item2(30025)
			
			set_state (quest4_begin)
		end	
	end
	
	state quest4_begin begin
		--*************************--
		when letter begin
			send_letter("[LC;4554]")

			local v = find_npc_by_vnum(20011)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(20011))
			end
		end
		when button or info begin
			say_title("[LC;4554]")
			say("[LC;4555]")
			say("")
		end
		-----------------------------
		--*************************--
	
	
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4556]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4557]")
			say("")
			wait()
			
			say_title(pc.getname())
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4558]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4559]")
			say("")
			wait()
			
			say_title(mob_name(20011))
			----"12345678901234567890123456789012345678901234567890"|
			say("[LC;4560]")
			say("")
			wait()
			
			----"12345678901234567890123456789012345678901234567890"|
			say_reward("[LC;4562]")
			say("")
			
			clear_letter()
			set_quest_state ("main_quest_lv66", "state_0")
			set_state (__COMPLETE__)
		end	
	end
	
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
