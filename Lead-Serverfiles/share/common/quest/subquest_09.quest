quest subquest_9 begin
	state start begin
		when login or levelup with pc.level >= 16 and pc.level <= 21 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20016)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7232]")
			end
		end


		when __TARGET__.target.click or	20016.chat."[LC;7237]" with pc.level >= 16 begin
			target.delete("__TARGET__")

			say_title("[LC;27]")
			say("[LC;7238]")

			local s= select("[LC;971]", "[LC;931]")
			if 2==s then
				say_title("[LC;27]")
				say("[LC;7239]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7240]")
					say("[LC;7241]")
					return
				end
				say_title("[LC;27]")
				say("[LC;7242]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;27]")
			say("[LC;7243]")
			set_state(hunt_for_goldenaxe)

		end
	end

	state hunt_for_goldenaxe begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7244]")
			q.set_title("[LC;7244]")
			q.start()
		end

		when info or button begin
			say_title("[LC;7244]")
			say("[LC;7231]")
		end

		when 301.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30102")==0  then
				pc.give_item2("30102", 1)
				send_letter("[LC;7233]")

				local v=find_npc_by_vnum(20016)
				if 0==v then
				else
					target.vid("__TARGET__",v, "[LC;7157]")
				end
			end
		end

		when 20016.chat."[LC;7234]" begin
			target.delete("__TARGET__")
			if pc.count_item("30102") >= 1 then
				say_title("[LC;27]")
				say("[LC;7235]")

				pc.remove_item("30102", 1)

				pc.give_exp2(36000)
				set_quest_state("levelup","run")
				pc.change_money(10000)
				pc.give_item2("30031", 1)

				say_title("[LC;192]")
								say_reward("[LC;7236]")
				
				clear_letter()
				set_state(__COMPLETE__)
				return
			end 
		end  
	end  --state
	state __GIVEUP__ begin
	end

	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
