

quest main_quest_lv50 begin
	state start begin
	end
	state run begin
		when login or levelup or enter with pc.get_level()>= 50 begin
			set_state ( information )
		end
	end
	state information begin
		when letter begin
			send_letter("[LC;4231]")

		end
		when button or info begin
			say_title("[LC;4413]")
			say("[LC;4424]")
		end

		when 2036.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30150")==0 then
				pc.give_item2(30150, 1)
				set_state ( gototeacher5)
			end
		end
	end

	state gototeacher5 begin
		when letter begin
			send_letter("[LC;4436]")

			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4450]")
			end
		end
		when button or info begin
			say_title("[LC;4452]")
			say("[LC;4453]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4436]" begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4454]")
			wait()
			say_title("[LC;4455]")
			say_reward("[LC;4456]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4457]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4412]")
			say_reward("[LC;4414]")
			pc.give_exp2(5000000)

			say_reward("[LC;4415]")
			pc.change_money(125000)

			say_reward("[LC;4416]")
			pc.give_item2(70050)

			pc.remove_item(30150)

			set_state ( survey6)

		end
	end
	state survey6 begin
		when letter begin
			send_letter("[LC;4417]")
			local v=find_npc_by_vnum(20359)
			if 0==v then
			else
				target.vid("__TARGET1__", v, "[LC;4418]")
			end

		end
		when button or info begin
			say_title("[LC;4419]")
			say("[LC;4420]")
		end

		when __TARGET1__.target.click or 20359.chat."[LC;4421]" begin
			say_pc_name()
			say("[LC;4422]")
			pc.give_item2(30150)
			set_state ( gototeacher6)
		end
	end

	state gototeacher6 begin
		when letter begin
			send_letter("[LC;4423]")

			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4401]")
			end
		end
		when button or info begin
			say_title("[LC;4425]")
			say("[LC;4426]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4423]" begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4427]")
			wait()
			say_title("[LC;4428]")
			say_reward("[LC;4429]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4430]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4431]")
			say_reward("[LC;4432]")
			pc.give_exp2(5500000)

			say_reward("[LC;4433]")
			pc.change_money(137500)

			say_reward("[LC;4434]")
			pc.give_item2(70051)

			pc.remove_item(30150)

			set_state (survey7)

		end
	end

	state survey7 begin
		when letter begin
			send_letter("[LC;4231]")

		end
		when button or info begin
			say_title("[LC;4435]")
			say("[LC;4437]")
		end

		when 2034.kill begin
			pc.give_item2(30150)
			set_state ( gototeacher7)
		end
	end

	state gototeacher7 begin
		when letter begin
			send_letter("[LC;4438]")

			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4439]")
			end
		end
		when button or info begin
			say_title("[LC;4440]")
			say("[LC;4441]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4438]" begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4442]")
			wait()
			say_title("[LC;4443]")
			say_reward("[LC;4444]")
			wait()
			say_title("[LC;4445]")
			say_reward("[LC;4446]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4447]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4448]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4449]")
			say_reward("[LC;4451]")
						
			pc.give_exp2(6000000)
			pc.give_item2(71004)
			pc.remove_item(30150)
			pc.change_money(150000)

			clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv55", "run")
		end
	end
	state __COMPLETE__ begin
	end
end	

