quest collect_quest_lv50  begin
	state start begin
	end
	state run begin
		when login or levelup with pc.level >= 50 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20084)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;128]")
			end
			send_letter("[LC;296]")
		end

		when button or info begin
			say_title("[LC;308]")
			say("[LC;320]")
		end

		when __TARGET__.target.click or
			20084.chat."[LC;324]" begin
			target.delete("__TARGET__")
			say_title("[LC;138]")
			say("[LC;325]")
			wait()
			say_title("[LC;138]")
			say("[LC;326]")
			wait()
			say_title("[LC;138]")
			say("[LC;327]")
			set_state(go_to_disciple)
			pc.setqf("duration",0)  -- Versuchszeit
			pc.setqf("collect_count",0)--die zahl der gesammelten artikel
			pc.setqf("drink_drug",0) --Wenn man Das Verwirrungswasser trinkt 1
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter("[LC;328]")

		end
		when button or info begin
			say_title("[LC;329]")
			say("[LC;295]")
			say_item_vnum(30015)
			say_reward(string.format("[LC;297;%s]", pc.getqf("collect_count")))
					end

		when 71035.use begin --Das Verwirrungswasser
			if get_time() < pc.getqf("duration") then
				say("[LC;298]")
				return
			end
			if pc.getqf("drink_drug")==1 then
				say("[LC;299]")
				return
			end
			if pc.count_item(30015)==0 then
				say_title("[LC;138]")
				say("[LC;300]")
				return
			end

			pc.remove_item(71035, 1)
			pc.setqf("drink_drug",1)
		end



		when 20084.chat."[LC;301]" with pc.count_item(30015) >0   begin
			if get_time() > pc.getqf("duration") then
				if  pc.count_item(30015) >0 then
					say_title("[LC;138]")
					say("[LC;302]")
					pc.remove_item(30015, 1)
					pc.setqf("duration",get_time()+60*60*22) ----------------22Stunden
					wait()

					local pass_percent
					if pc.getqf("drink_drug")==0 then
						pass_percent=60
					else
						pass_percent=90
					end

					local s= number(1,100)
					if s<= pass_percent  then
						if pc.getqf("collect_count")< 14 then     --nicht mehr als 15
							local index =pc.getqf("collect_count")+1
							pc.setqf("collect_count",index)     --da du eins besorgst hast, mache ich +1
							say_title("[LC;138]")
							say(string.format("[LC;303;%s]", 15-pc.getqf("collect_count")))
							pc.setqf("drink_drug",0)	 --Anfang mit dem Verwirrungswasser
							return
						end
						say_title("[LC;138]")
						say("[LC;304]")
						pc.setqf("collect_count",0)
						pc.setqf("drink_drug",0)
						pc.setqf("duration",0)
						set_state(key_item)
						return
					else
						say_title("[LC;138]")
						say("[LC;305]")
						pc.setqf("drink_drug",0)	 --Anfang mit dem Verwirrungswasser
						return
					end

				else
					say_title("[LC;138]")
					--say(string.format("[LC;231]", item_name(30015)))
					say("[LC;306]")
					return
				end
			else
				say_title("[LC;138]")
				say("[LC;307]")
				return
			end

		end
	end


	state key_item begin
		when letter begin
			send_letter("[LC;309]")

			if pc.count_item(30222)>0 then
				local v = find_npc_by_vnum(20084)
				if v != 0 then
					target.vid("__TARGET__", v, "[LC;128]")
				end
			end

		end
		when button or info begin
			if pc.count_item(30222) >0 then
				say_title("[LC;310]")
				say("[LC;311]")
				return
			end

			say_title("[LC;138]")
			say("[LC;312]")
			say_item_vnum(30222)----------Das Geisstein der Schlangegeist
			say("[LC;313]")
		end


		when 1001.kill or
			 1002.kill or
			 1003.kill or
			 1004.kill  begin
			local s = number(1, 500)
			if s == 1 and pc.count_item(30222)==0 then
				pc.give_item2(30222, 1)
				send_letter("[LC;314]")
			end
		end




		when __TARGET__.target.click  or
			20084.chat."[LC;315]" with pc.count_item(30222) > 0  begin
			target.delete("__TARGET__")
			say_title("[LC;138]")
			if pc.count_item(30222) > 0 then 
				say("[LC;316]")
				pc.remove_item(30222,1)
				set_state(__reward)

			else
				say_title("[LC;138]")
				--say(string.format("[LC;242]", item_name(30222)))
				say("[LC;318]")
				return
			end
		end

	end

	state __reward begin
		when letter begin
			send_letter("[LC;317]")

			local v = find_npc_by_vnum(20018)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;245]")
			end

		end
		when button or info begin
			say_title("[LC;319]")
			say("[LC;321]")
		end

		when __TARGET__.target.click  or
			20018.chat."[LC;247]"  begin
		    target.delete("__TARGET__")
			say_title("[LC;248]")
			say("[LC;322]")
			say_reward("[LC;323]")
						affect.add_collect(apply.DEF_GRADE_BONUS,60,60*60*24*365*60) --60Jahre

			pc.give_item2(50111)
			clear_letter()
			set_quest_state("collect_quest_lv60", "run")
			set_state(__complete)
		end

	end


	state __complete begin
	end
end



