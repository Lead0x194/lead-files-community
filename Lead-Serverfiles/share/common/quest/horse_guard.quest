quest horse_guard begin
	state start begin
		when 20349.chat."[LC;1562]" begin
			say_title("[LC;1586]")
			local s=number(1, 7)
			if 1>=s then -- 14.29% (1/7)
				say("[LC;1563]")
			elseif 2>=s then -- 14.29% (1/7)
				say("[LC;1564]")
			elseif 3>=s then -- 14.29% (1/7)
				say("[LC;1565]")
			elseif 4>=s then -- 14.29% (1/7)
				say("[LC;1566]")
			elseif 5>=s then -- 14.29% (1/7)
				say("[LC;1567]")
			elseif 6>=s then -- 14.29% (1/7)
				say("[LC;1568]")
			elseif 7>=s then -- 14.29% (1/7)
				say("[LC;1569]")
			end
		end
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
