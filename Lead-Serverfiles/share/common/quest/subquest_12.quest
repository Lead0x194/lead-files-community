quest subquest_12 begin
	state start begin
		when login or levelup with pc.level >= 20  and pc.level <= 25 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
			
			local vnum=0

			if pc.get_empire() == 1 then
				vnum=11000
			elseif pc.get_empire() == 2 then
				vnum=11002
			elseif pc.get_empire() == 3 then
				vnum=11004
			end

			local v = find_npc_by_vnum(vnum)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7291]")
			end
		end

		
		when __TARGET__.target.click or	11000.chat."[LC;7291]" with pc.level >= 20 begin
			target.delete("__TARGET__")

			say_title("[LC;1016]")

			say("[LC;7301]")
			wait()

			say_title("[LC;1016]")

			say("[LC;7302]")
			local s= select("[LC;7303]", "[LC;7304]")
			if 2==s then
				say_title("[LC;1016]")
				say("[LC;7305]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;1016]")
					say("[LC;7306]")
					return
				end
				say_title("[LC;1016]")
				say("[LC;7307]")
				set_state(__GIVEUP__)
				return
			end
			set_state(hunt_mijung)
		
		end
		when __TARGET__.target.click or	11002.chat."[LC;7291]" with pc.level >= 20 begin
			target.delete("__TARGET__")

			say_title("[LC;1016]")

			say("[LC;7301]")
			wait()

			say_title("[LC;1016]")

			say("[LC;7302]")
			local s= select("[LC;7303]", "[LC;7304]")
			if 2==s then
				say_title("[LC;1016]")
				say("[LC;7305]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;1016]")
					say("[LC;7306]")
					return
				end
				say_title("[LC;1016]")
				say("[LC;7307]")
				set_state(__GIVEUP__)
				return
			end
						set_state(hunt_mijung)
		
		end
		when __TARGET__.target.click or	11004.chat."[LC;7291]" with pc.level >= 20 begin
			target.delete("__TARGET__")

			say_title("[LC;1016]")

			say("[LC;7301]")
			wait()

			say_title("[LC;1016]")

			say("[LC;7302]")
			local s= select("[LC;7303]", "[LC;7304]")
			if 2==s then
				say_title("[LC;1016]")
				say("[LC;7308]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;1016]")
					say("[LC;7306]")
					return
				end
				say_title("[LC;1016]")
				say("[LC;7307]")
				set_state(__GIVEUP__)
				return
			end
			set_state(hunt_mijung)
		
		end

	end

	state hunt_mijung begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7291]")
			q.set_title("[LC;7290]")
			say_reward("[LC;7292]")
			q.start()
		end

		when info or button begin
			say_title("[LC;7293]")
			say("[LC;7294]")
		end
		
		when 391.kill begin
			set_state(hunt_reward)
		end
	end

	state hunt_reward begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7291]")
			q.set_title("[LC;7291]")
			q.start()
		
			local vnum=0

			if pc.get_empire() == 1 then
				vnum=11000
			elseif pc.get_empire() == 2 then
				vnum=11002
			elseif pc.get_empire() == 3 then
				vnum=11004
			end

			local v=find_npc_by_vnum(vnum)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7295]")
			end
		end
		
		when info or button begin
			say_title("[LC;7296]")
			say("[LC;7297]")
		end
		
		when __TARGET__.target.click or	11000.chat."[LC;7298]" or	11002.chat."[LC;7298]" or	11004.chat."[LC;7298]" begin 
			target.delete("__TARGET__")
			say_title("[LC;1016]")

			say("[LC;7299]")
			pc.give_exp2(122000)
			pc.change_money(20000)
			pc.give_item2("14040", 1)

			say_title("[LC;192]")
						say_reward("[LC;7300]")

						clear_letter()
			set_state(__COMPLETE__)
		
		end


	end
	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end


