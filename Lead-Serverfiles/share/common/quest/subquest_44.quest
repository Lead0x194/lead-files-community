
quest subquest_44 begin
	state start begin
		when login or  levelup with pc.level >= 37 and pc.level <= 39 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20012)
			if v!= 0 then
				target.vid("__TARGET__", v, "[LC;8182]")
			end
		end


		when __TARGET__.target.click or	20012.chat."[LC;8193]" with pc.level >= 37 begin
			target.delete("__TARGET__")
			say_title("[LC;7208]")
			say("[LC;8204]")
			wait()
			say_title("[LC;7208]")
			say("[LC;8215]")
			local s= select("[LC;8226]", "[LC;931]")
			if 2==s then
				say("[LC;8229]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;7208]")
					say("[LC;8230]")
					return
				end
				say_title("[LC;7208]")
				say("[LC;8231]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7208]")
			say("[LC;8232]")
			set_state(go_to_desert)
			pc.setqf("kill_count", 0)
		end
    end

    state go_to_desert begin
		when letter begin
		    send_letter("[LC;8181]")
		end
		when button or info begin
			say_title("[LC;8193]")
			say("[LC;8183]")
		end

		when 20012.click begin
			say("[LC;8184]")
		end



		when 2001.kill or 2002.kill or 2003.kill or 2004.kill or  2005.kill with pc.getqf("spider_eye")==0  begin
			local cur_kill_count=pc.getqf("kill_count")+1
			pc.setqf("kill_count", cur_kill_count)

			if cur_kill_count>=number(10, 50) then
				set_state(fail_find_bell)
			end
		end
	end
	state fail_find_bell begin
		when letter begin
			send_letter("[LC;8185]")
		end

		when info or  button begin
			say_title("[LC;8186]")
			say("[LC;8187]")
			set_state(go_to_boy)
		end
	end

    state go_to_boy begin
		when letter begin
		  send_letter("[LC;8188]")

		  local v = find_npc_by_vnum(20014)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;8189]")
			end

		end
		when button or info begin
			say_title("[LC;8188]")
			say("[LC;8190]")
		end

		when __TARGET__.target.click or	20014.chat."[LC;8191]" begin
			target.delete("__TARGET__")
			say_title("[LC;6407]")
			say("[LC;8192]")
			wait()
			say_title("[LC;6407]")
			say("[LC;8194]")
			wait()
			say_title("[LC;6407]")
			say("[LC;8195]")
			local s= select("[LC;8226]", "[LC;931]")
			if 2==s then
				say("[LC;8196]")
				local a=  select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;6407]")
					say("[LC;8197]")
					return
				end
				say_title("[LC;6407]")
				say("[LC;8198]")
				set_state(report_YuRang)
				return
			end
			say_title("[LC;6407]")
			say("[LC;8199]")
			set_state(attach_bell)
		end
    end

    state report_YuRang begin

		when letter begin
		   send_letter("[LC;8200]")

		   local v=find_npc_by_vnum(20012)
			if v!=0 then
				target.vid("__TARGET__", v, "[LC;8200]")
			end

		end
		when button or info begin
			say_title("[LC;8200]")
			say("[LC;8201]")
		end

		when 20014.chat."[LC;8202]" begin
			say_title("[LC;6407]")
			say("[LC;8203]")
		end
		when __TARGET__.target.click or	20012.chat."[LC;8205]" begin
			target.delete("__TARGET__")
			say_title("[LC;7208]")
			say("[LC;8206]")
			say_reward("[LC;8207]")
						say_reward("[LC;8208]")
			pc.change_money(30000)
			say_reward("[LC;8209]")
			pc.give_exp2(350000)


			clear_letter()
			set_state(__COMPLETE__)
		end
	end

    state attach_bell begin
		when letter begin
		    send_letter("[LC;8210]")
		end

		when button or info begin
			say_title("[LC;8210]")
			say("[LC;8211]")
		end
		when 20014.chat."[LC;8212]" begin
			say_title("[LC;6407]")
			say("[LC;8213]")
		end

		when 2001.kill or 2002.kill or 2003.kill or 2004.kill or  2005.kill  begin
			local cur_kill_count=pc.getqf("kill_count")+1
			pc.setqf("kill_count", cur_kill_count)

			if cur_kill_count>=number(10, 50) then
				send_letter("[LC;8214]")
				set_state(report_girl_lie)
			end
		end

	end
    state report_girl_lie begin
		when letter begin
			send_letter("[LC;8200]")

			local v=find_npc_by_vnum(20012)
			if v!=0 then
				target.vid("__TARGET__", v, "[LC;7205]")
			end

		end

		when button or info begin
			say_title("[LC;8200]")
			say("[LC;8216]")
		end

		when 20014.chat."[LC;8217]" begin
			say_title("[LC;6407]")
			say("[LC;8218]")
		end
		when __TARGET__.target.click or	20012.chat."[LC;8219]" begin
			target.delete("__TARGET__")
			say_title("[LC;7208]")
			say("[LC;8220]")

			set_state(report_boy_lie)
		end
	end
    state report_boy_lie begin
		when letter begin
			send_letter("[LC;8221]")
			local v=find_npc_by_vnum(20014)
			if v!=0 then
				target.vid("__TARGET__", v, "[LC;8222]")
			end
		end

		when button or info begin
			say_title("[LC;8221]")
			say("[LC;8223]")
		end

		when __TARGET__.target.click or	20014.chat."[LC;8224]" begin
			target.delete("__TARGET__")
			say_title("[LC;6407]")
			say("[LC;8225]")
			say_reward("[LC;8227]")
			pc.change_money(30000)

			say_reward("[LC;8228]")
			pc.give_exp2(700000)


			pc.setqf("kill_count", 0)
			clear_letter()
			set_state(__COMPLETE__)
		end
    end
    state __COMPLETE__ begin
	end
    state __GIVEUP__ begin
    end
end
