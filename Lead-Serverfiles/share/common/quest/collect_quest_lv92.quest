----------------------------------------------------
--COLLECT QUEST_lv92
----------------------------------------------------
quest collect_quest_lv92 begin
	state start begin
	end

	state run begin
		when login or levelup with pc.level >= 92 begin
			set_state(information)
		end	
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20091)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;543]")
			end
			send_letter("[LC;544]")
		end

		when button or info begin
			say_title("[LC;544]")
			say("[LC;545]")
		end
		
		when __TARGET__.target.click or 20091.chat."[LC;546]" begin
			target.delete("__TARGET__")
			---                                                   l
			say_title("[LC;547]")
			say("[LC;548]")
			wait()
			say_title("[LC;547]")
			say("[LC;549]")
			set_state(go_to_disciple)
			pc.setqf("duration", 0)  
			pc.setqf("collect_count", 0) 
			pc.setqf("drink_drug", 0) 
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter("[LC;544]")
		end

		when button or info begin
			say_title("[LC;550]")
			---                                                   l
			say("[LC;551]")
			say_item_vnum(30251) 
			say_reward(string.format("[LC;552;%s]", pc.getqf("collect_count")))
		end
		
		when 71035.use begin
			if get_time() < pc.getqf("duration") then
				say("[LC;553]")
				return
			end

			if pc.getqf("drink_drug") == 1 then
				say("[LC;554]")
				return
			end

			if pc.count_item(30251) == 0 then
				say("[LC;555]")
				return
			end

			pc.remove_item(71035, 1)
			pc.setqf("drink_drug",1)
		end

		when 1135.kill or 1137.kill begin
			local s = number(1, 200)
			if s <= 1 then
				pc.give_item2(30251, 1)
				send_letter("[LC;556]")
			end	
		end
		
    	when 20091.chat."[LC;557]" with pc.count_item(30251) > 0 begin
			if get_time() < pc.getqf("duration") then
		  		say_title("[LC;547]")
				say("[LC;558]")
				return
			end

			if pc.count_item(30251) <= 0 then
				say_title("[LC;547]")
				say("[LC;559]")
				return
			end

			say_title("[LC;547]")
			say("[LC;560]")
			pc.remove_item(30251, 1)

			if is_test_server() then 
				pc.setqf("duration", get_time()+10)
			else
				pc.setqf("duration", get_time()+60*60*6)
			end

			wait()

			local pass_percent

			if pc.getqf("drink_drug") == 0 then
				pass_percent = 10
			else		
				pass_percent = 60
			end

			local s = number(1, 100)

			if s <= pass_percent then
				local collect_count = pc.getqf("collect_count")
				pc.setqf("collect_count", collect_count + 1)
				pc.setqf("drink_drug", 0)

				if collect_count < 9 then
					say_title("[LC;547]")
					say("[LC;561]")
					say(string.format("[LC;562;%s]", 10-pc.getqf("collect_count")))
					say("[LC;563]")
				else
					pc.setqf("duration", 0) 

					say_title("[LC;547]")
					say("[LC;564]")

					local s = select("[LC;565]", "[LC;566]", "[LC;567]")

					if 1 == s then
						affect.add_collect(1,1000,60*60*24*365*60) -- hp index == 1, hp +1000
						pc.setqf("reward", 1)
					elseif 2 == s then
						affect.add_collect(apply.DEF_GRADE_BONUS, 120, 60*60*24*365*60)
						pc.setqf("reward", 2)
					elseif 3 == s then 
						affect.add_collect(apply.ATT_GRADE_BONUS, 51, 60*60*24*365*60)
						pc.setqf("reward", 3)
					end

					clear_letter()
					set_quest_state("collect_quest_lv94", "run")
					set_state(__complete)
				end

				return
			else								
				pc.setqf("drink_drug", 0)
				say_title("[LC;547]")
				say("[LC;568]")
				return
			end
	   	end
    end -- end of state 'go_to_disciple'
	
	state __complete begin
	end
end
