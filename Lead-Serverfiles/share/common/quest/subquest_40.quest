
quest subquest_40 begin
	state start begin
		when login or levelup with pc.level >= 56  and pc.level <= 58 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
			
			local v = find_npc_by_vnum(20355)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;8111]")
			end
		end
		
		when __TARGET__.target.click or 20355.chat."[LC;8111]" with pc.level >= 56 and pc.getqf("aborted") != 1 begin
			target.delete("__TARGET__")
                        say_title("[LC;4082]")
                        say("[LC;8122]")
                        wait()
                        say_title("[LC;4082]")
                        say("[LC;8129]")
                        wait()
                        say_title("[LC;4082]")
                        say("[LC;8130]")
                        local b= select("[LC;8131]", "[LC;8132]")
                        if 2==b then
                                say("[LC;8133]")
                                local a= select("[LC;2059]", "[LC;2035]")
                                if 2==a then
                                        say_title("[LC;4082]")
                                        say("[LC;8134]")
                                        pc.setqf("aborted", 1)
                                        return
                                end
                                say_title("[LC;4082]")
                                say("[LC;8135]")
                                pc.setqf("aborted",0)
                                set_state(__GIVEUP__)
                                return
                        end
                        say_title("[LC;4082]")
                        say("[LC;8110]")
                        pc.setqf("aborted",0)
                        set_state(for_five_thousand_bow)
                        return
		end

		when __TARGET__.target.click or
                        20355.chat."[LC;8115]" with pc.level >= 56 and pc.getqf("aborted") == 1 begin
			target.delete("__TARGET__")
			say_title("[LC;4082]")
			say("[LC;8122]")
			wait()
			say_title("[LC;4082]")
			say("[LC;8129]")
			wait()
			say_title("[LC;4082]")
			say("[LC;8130]")
			local b= select("[LC;8131]", "[LC;8132]")
			if 2==b then
				say("[LC;8133]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;4082]")
					say("[LC;8134]")
					pc.setqf("aborted", 1)
					return 
				end
				say_title("[LC;4082]")
				say("[LC;8135]")
				pc.setqf("aborted",0)
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;4082]")
			say("[LC;8110]")
			pc.setqf("aborted",0)
			set_state(for_five_thousand_bow)
			return
		end
	end
	state for_five_thousand_bow begin
		when letter begin
			send_letter("[LC;8111]")
			
			if 	pc.count_item("30157")>=5000 then	
				local v=find_npc_by_vnum(20355)
				if 0 == v then
				else
					target.vid("__TARGET__",v, "[LC;8112]")
				end 
			end

		end
		when button or info begin
			if 	pc.count_item("30157")>=5000 then	
				say_title("[LC;8111]")
				say("[LC;8113]")
				return
			end
			say_title("[LC;8111]")
			say("[LC;8114]")
			say_item_vnum(30157)
		end

		when 20355.chat."[LC;8115]" with pc.count_item(30157) <5000 begin
			say_title("[LC;4082]")
			say("[LC;8116]")
			local s= select("[LC;8117]", "[LC;7632]")
			if 2==s then
				say("[LC;8118]")
				local a=  select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;7386]")
					say("[LC;8119]")
					return
				end
				say("[LC;8120]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;4082]")
			say("[LC;8121]")
		end
		
		when 906.kill   begin
			local s = number(1, 100)
			if s <= 10 and pc.count_item("30157")<5000 then
				pc.give_item2(30157, 10)
			end

			
		end

		when __TARGET__.target.click  or 
			20355.chat."[LC;8123]" with pc.count_item(30157)>=5000 begin
			target.delete("__TARGET__")

			say_title("[LC;4082]")
			say("[LC;8124]")
			wait()
			say_title("[LC;4082]")
			say("[LC;8125]")

			pc.remove_item(30157 , 5000)			
		
			say_reward("[LC;8126]")
			pc.give_item2(71044,3)
			pc.give_item2(71045,3)
			
			say_reward("[LC;8127]")
			pc.give_exp2(4500000)

			say_reward("[LC;8128]")
			pc.change_money(50000)
						
			clear_letter()	
			set_state(COMPLETE)
		end
	end
	state COMPLETE begin
		when enter begin
			q.done()
		end
	end
	state __GIVEUP__ begin
	end
end
