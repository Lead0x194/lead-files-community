quest make_herb_lv25  begin
	state start begin
		when login or levelup with pc.get_level() ==25  begin
			set_state(information)
		end	
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20084)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;123]")
			end
			send_letter("[LC;134]")
		end

		when button or info begin
			say_title("[LC;134]")
			say("[LC;172]")
		end
		
		when __TARGET__.target.click or	20084.chat."[LC;137]" begin
			target.delete("__TARGET__")
			say_title("[LC;138]")
			say("[LC;180]")
			wait()
			say_title("[LC;138]")
			say("[LC;181]")
			set_state(go_to_disciple)
			pc.setqf("collect_count",0)--Current number of items
			pc.setqf("drink_drug",0) --when take the Potion of Daze
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter("[LC;141]")
			
		end
		when button or info begin
			say_title("[LC;182]")
			say("[LC;183]")
			say_item_vnum(50706) 
			say_reward(string.format("[LC;184;%s]", pc.getqf("collect_count")))
					end
		
		when 71035.use begin --Potion of Daze

			if pc.getqf("drink_drug")==1 then
				say("[LC;125]")

				return
			end
			if pc.count_item(50706)==0 then
				say("[LC;185]")
				return
			end
			pc.remove_item(71035, 1)
			pc.setqf("drink_drug",1)
		end


		when 183.kill begin
			if  pc.count_item(50706)<10 - pc.getqf("collect_count") then
				pc.give_item2(50706, 1)
			end
		end
		
    	when 20084.chat."[LC;186]" with pc.count_item(50706) >0   begin
				say_title("[LC;138]")
				say("[LC;187]")
				pc.remove_item(50706, 1)
				wait()
				
				local pass_percent
				if pc.getqf("drink_drug")==0 then
					pass_percent=70
				else		
					pass_percent=100
				end
				
				local s= number(1,100)
				if s<= pass_percent  then
				   if pc.getqf("collect_count")< 9 then     --Less than 10 
						local index =pc.getqf("collect_count")+1 
						pc.setqf("collect_count",index)     --you got one, so you would get +1
						say_title("[LC;138]")
						say(string.format("[LC;171;%s]", 10-pc.getqf("collect_count")))
						pc.setqf("drink_drug",0)	 --Initialize the potion
						return
					end
					say_title("[LC;138]")
					say("[LC;173]")
					say_reward("[LC;174]")
					
					if pc.job==0 then
						pc.give_item2(12222)
						say_reward("[LC;175]")
					end
					if pc.job==1 then
						pc.give_item2(12362)
						say_reward("[LC;176]")
					end
					if pc.job==2 then
						pc.give_item2(12502)
						say_reward("[LC;177]")
					end
					if pc.job==3 then		
						pc.give_item2(12642)
						say_reward("[LC;178]")
					end	

					pc.setqf("collect_count",0)
					pc.setqf("drink_drug",0)	
					
					clear_letter()
					set_state(__complete)
					
					pc.change_money(20000)
					pc.give_exp2(200000)
					set_quest_state("levelup","run")
					
					return
				else								
				say_title("[LC;138]")
				say("[LC;179]")
				pc.setqf("drink_drug",0)	 --Initialize Potion
				return
				end

	end
end


		
	state __complete begin
	end
end
