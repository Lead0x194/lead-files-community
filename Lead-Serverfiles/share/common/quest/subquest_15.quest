quest subquest_15 begin
	state start begin
		when login or levelup or enter with pc.get_level() >= 23  and pc.get_level() <= 28 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin

			local vnum=0

			if pc.get_empire() == 1 then
				vnum=11000
			elseif pc.get_empire() == 2 then
				vnum=11002
			elseif pc.get_empire() == 3 then
				vnum=11004
			end

			local v = find_npc_by_vnum(vnum)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7346]")
			end
		end


		when __TARGET__.target.click or	11000.chat."[LC;7346]" or	11002.chat."[LC;7346]" or	11004.chat."[LC;7346]" with pc.level >= 23 begin
			target.delete("__TARGET__")

			say_title("[LC;1016]")
			say("[LC;7351]")
			wait()

			say_title("[LC;1016]")
			say("[LC;7352]")
			wait()

			say_title("[LC;1016]")
			say("[LC;7353]")
			local s= select("[LC;7111]", "[LC;1409]")
			if 2==s then
				say("[LC;7286]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7354]")
					say("[LC;7355]")
					return
				end
				say_title("[LC;1016]")
				say("[LC;7356]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;1016]")
			say("[LC;7357]")
			set_state(hunt_eunjung)
		end
	end

	state hunt_eunjung begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7346]")
			q.set_title("[LC;7346]")
			q.start()
		end

		when button or info begin
			say_title("[LC;7346]")
			say("[LC;7358]")
		end

		when 392.kill begin
			set_state(hunt_reward)
		end
	end

	state hunt_reward begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7346]")
			q.set_title("[LC;7346]")
			q.start()
		end

		when letter begin
			local vnum=0

			if pc.get_empire() == 1 then
				vnum=11000
			elseif pc.get_empire() == 2 then
				vnum=11002
			elseif pc.get_empire() == 3 then
				vnum=11004
			end

			local v = find_npc_by_vnum(vnum)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7345]")
			end
		end

		when info or button begin
			say_title("[LC;7346]")
			say("[LC;7347]")
		end

		when __TARGET__.target.click or	11000.chat."[LC;7345]" or	11002.chat."[LC;7345]" or	11004.chat."[LC;7345]" begin
			target.delete("__TARGET__")
			say_title("[LC;1016]")
			say("[LC;7348]")
			wait()
			say_title("[LC;1016]")
			say("[LC;7349]")
			wait()
			pc.give_exp2(150000)
			pc.change_money(25000)
			pc.give_item2("16064", 1)
			say_title("[LC;192]")
						say_reward("[LC;7350]")
			
			clear_letter()
			set_state(__COMPLETE__)
		end


	end

	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end


