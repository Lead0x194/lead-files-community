quest subquest_1 begin
	state start begin
		when login or levelup with pc.level >= 6 and pc.level <= 11 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(9003)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;6965]")
			end
		end

		when __TARGET__.target.click or	9003.chat."[LC;6976]" begin
			target.delete("__TARGET__")

			say_title("[LC;1004]")
			say("[LC;6987]")
			say_item_vnum(30130)
			say("[LC;6996]")
			local s= select("[LC;6997]", "[LC;6998]")
			if 2==s then
				say("[LC;6999]")

				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;1004]")
					say("[LC;7000]")
					return
				end

				say_title("[LC;1004]")
				say("[LC;7001]")
				set_state(__GIVEUP__)
				return
			end	
			say_title("[LC;6964]")
			say("[LC;6966]")
			set_state(to_yeonnahwan)
		end
	end

	state to_yeonnahwan begin
		when letter begin
			local v = find_npc_by_vnum(20005)
			if v!= 0 then
				target.vid("__TARGET__", v, "[LC;6967]")
			end
			send_letter("[LC;6967]")
		
		end

		when button or info begin
			say_title("[LC;6967]")
						say_reward("[LC;6968]")
						say_item_vnum(30130)
					end

		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;6969]")
			say("[LC;6970]")
			say_item_vnum(30130)
			wait()
			say_title("[LC;6969]")
			say("[LC;6971]")
			say_item_vnum(30020)
			wait()
			set_state(hunt_for_peach)
		end
	end

	state hunt_for_peach begin
		when letter begin
			send_letter("[LC;6972]")
		end

		when button or info begin
			say_title("[LC;6972]")
						say_reward("[LC;6973]")
			say_item_vnum(30020)
					end

	when 20005.chat."[LC;6974]" with pc.count_item(30020) == 0 begin
			say_title("[LC;6969]")
			say("[LC;6975]")

		end


		when 108.kill begin
			local s = number(1, 100)
			if s <= 5 then
				pc.give_item2(30020, 1)
				set_state(go_back_to_yonah)
			end 
		end
	end
    state go_back_to_yonah begin
		when letter begin
			send_letter("[LC;6977]")
			local v = find_npc_by_vnum(20005)

			if v!= 0 then
				target.vid("__TARGET__", v, "[LC;6977]")
			end
		end
		when button or info begin
			say_title("[LC;6978]")
						say_reward("[LC;6979]")
					end
		
		when __TARGET__.target.click begin 
			target.delete("__TARGET__") 
			if pc.count_item(30020) >= 1 then
			
			say_title("[LC;6969]")
			say("[LC;6980]")
			say_item_vnum(30020)
			say("[LC;6981]")
			wait()
			say_title("[LC;6969]")
			say("[LC;6982]")
			say_item_vnum(30130)
			
			pc.remove_item(30020, 1)
			pc.give_item2(30130, 1)

			set_state(going_to_reward)
			end
		end
    end

	state going_to_reward begin
		when letter begin
			send_letter("[LC;6983]")

			local v=find_npc_by_vnum(9003)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;6983]")
			end

		end
		when info or button begin
			say_title("[LC;6983]")
						say_reward("[LC;6984]")
			say_item_vnum(30130)
					end

		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			if pc.count_item(30130) >= 1 then
				say_title("[LC;6985]")
				say("[LC;6986]")
				wait()
				say_title("[LC;192]")
								say_reward("[LC;6988]")
								pc.remove_item(30130)
				pc.give_exp2(1500)
				set_quest_state("levelup","run")
				pc.change_money(1000)
				clear_letter()
				set_state(__COMPLETE__)
			else
				say_title("[LC;6985]")
				say("[LC;6989]")

								say_item_vnum(30130)
				
				wait()
				say_title("[LC;1004]")
				say("[LC;6990]")
				local s= select("[LC;6991]", "[LC;6992]")
				if s==2 then
					say("[LC;6993]")
				
				local a= select("[LC;2059]", "[LC;2035]")	
				if 2==a then
					say_title("[LC;1004]")
					say("[LC;6994]")
					return
					end

				say_pc_name()
				say("[LC;6995]")
				clear_letter()
				set_state(__GIVEUP__)
				return
				end
				
			set_state(hunt_for_peach)
			end
		end
	end

	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
	end
end
