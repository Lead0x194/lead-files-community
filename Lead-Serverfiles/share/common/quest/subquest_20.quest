quest subquest_20  begin
   	state start begin
		when login or levelup with pc.level >= 30  and pc.level <= 32  begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20003)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7506]")
			end
		end


		when __TARGET__.target.click or	20003.chat."[LC;7517]"  begin
			target.delete("__TARGET__")
			say_title("[LC;6396]")
			say("[LC;7528]")
			wait()
			say_pc_name()
			say("[LC;7536]")
			wait()
			say_title("[LC;6396]")
			say("[LC;7537]")
			wait()
			say_title("[LC;6396]")
			say("[LC;7538]")
			say_item_vnum(30161)
			say("[LC;7539]")
			local b= select("[LC;7540]", "[LC;7541]")
			if 2==b then
				say("[LC;7505]")
				local q= select("[LC;2059]", "[LC;2035]")
				if 2==q  then
					say_title("[LC;6396]")
					say("[LC;7507]")
					return
				end
				say_title("[LC;6396]")
				say("[LC;7508]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;6396]")
			say("[LC;7509]")
			set_state(for_husband_product)
		end
    end
    state for_husband_product begin
		when letter begin
			send_letter("[LC;7510]")
			if pc.count_item(30161) >= 3 then
				local v=find_npc_by_vnum(20003)
				if 0==v then
				else
					target.vid("__TARGET__",v, "[LC;7511]")
				end
			end
		end

		when button or info begin
			if pc.count_item(30161) >= 3 then
				say_title("[LC;7512]")
				say("[LC;7513]")
				return
			end
			say_title("[LC;7514]")
			say("[LC;7515]")
			say_reward(string.format("[LC;7516;%s]", pc.count_item(30161)))
			
		end

		when 501.kill or 502.kill or  503.kill or 504.kill  begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30161")<3  then
				pc.give_item2("30161", 1)
				local v=find_npc_by_vnum(20003)
				if 0==v then
				else
					target.vid("__TARGET__",v, "[LC;7511]")
				end
			end
		end

		when 20003.chat."[LC;7518]" with pc.count_item(30161)==0 begin
			say_title("[LC;6396]")
			say("[LC;7519]")
			local s= select("[LC;7520]", "[LC;939]")
			if 2==s then
				say_title("[LC;6396]")
				say("[LC;7521]")
				local r= select("[LC;7522]", "[LC;2035]")
				if 2==r then
					say("[LC;7523]")
					return
				end
				say("[LC;7524]")
				set_state(__GIVEUP__)
				return
			end
			say("[LC;7525]")
		end
		when __TARGET__.target.click or	20003.chat."[LC;7526]" with pc.count_item(30161)>0 begin
			target.delete("__TARGET__")
			if pc.count_item(30161)<3 then
				say_title("[LC;7527]")
				say("[LC;7529]")
				local z= select("[LC;7530]", "[LC;7531]")
				if 2==z then
					say("[LC;7532]")
					set_state(__GIVEUP__)
					return
				end
				say("[LC;7533]")

			else
				say_title("[LC;7527]")
				say("[LC;7534]")
				say_reward("[LC;7535]")
				pc.change_money(20000)
				pc.give_exp2(300000)

				pc.remove_item(30161, 3)
				clear_letter()
				set_state(__COMPLETE__)
			end
		end
    end
    state __GIVEUP__ begin
    end
	state __COMPLETE__ begin
		when enter begin
		q.done()
		end
    end
end

