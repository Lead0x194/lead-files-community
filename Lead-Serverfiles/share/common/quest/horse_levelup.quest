			setstate(report)
		end
		when unmount begin
			setstate(failure)
		end
	end
	state start begin
		when 20349.chat."[LC;1585]" with horse.get_grade()==2 begin
			if horse.get_level()==20 then
				say_title("[LC;1586]")
				say("[LC;1587]")
			elseif pc.countitem("50050")<1 then
				say_title("[LC;1586]")
				say("[LC;1588]")
				setstate(need_item50050)
			elseif get_time()<pc.getqf("next_time") then
				say_title("[LC;1586]")
				say("[LC;1589]")
			elseif horse.get_stamina_pct()<=10 then
				say_title("[LC;1586]")
				say("[LC;1590]")
			elseif horse.get_health_pct()<=10 then
				say_title("[LC;1586]")
				say("[LC;1591]")
			elseif horse.is_riding()==0 then
				say_title("[LC;1586]")
				say("[LC;1592]")
			elseif (horse.get_level()>=11 and horse.get_level()<=19) then
				say_title("[LC;1586]")
				say("[LC;1594]")
				if is_test_server() then
					pc.setqf("next_time", get_time()+10)
				else
					pc.setqf("next_time", get_time()+number(16, 32)*60*60)
				end
				if horse.get_level()==11 then
					setstate(training1)
				elseif horse.get_level()==12 then
					setstate(training2)
				elseif horse.get_level()==13 then
					setstate(training3)
				elseif horse.get_level()==14 then
					setstate(training4)
				elseif horse.get_level()==15 then
					setstate(training5)
				elseif horse.get_level()==16 then
					setstate(training6)
				elseif horse.get_level()==17 then
					setstate(training7)
				elseif horse.get_level()==18 then
					setstate(training8)
				elseif horse.get_level()==19 then
					setstate(training9)
				end
			end
		end
	end
	state need_item50050 begin
		when login or levelup or enter with pc.countitem("50050") >= 1 begin
			set_state(start)
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1595]")
			q.set_title("[LC;1595]")
			q.start()
		end
		when button begin
			say_title("[LC;1595]")
			say("[LC;1596]")
			setstate(start)
			q.done()
		end
		when info begin
			say_title("[LC;1595]")
			say("[LC;1596]")
			setstate(start)
			q.done()
		end
	end
	state failure begin
		when login or levelup or enter or letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1597]")
			q.set_title("[LC;1597]")
			q.start()
		end
		when button begin
			say_title("[LC;1597]")
			say("[LC;1598]")
			setstate(start)
			q.done()
		end
		when info begin
			say_title("[LC;1597]")
			say("[LC;1598]")
			setstate(start)
			q.done()
		end
	end
	state report begin
		when letter begin
			local v=find_npc_by_vnum(20349)
			if 0==v then
			else
				target.vid("__TARGET__", v, "")
			end
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1599]")
			q.set_title("[LC;1599]")
			q.start()
		end
		when button begin
			say_title("[LC;1599]")
			say("[LC;1600]")
		end
		when info begin
			say_title("[LC;1599]")
			say("[LC;1600]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;1586]")
			say("[LC;1601]")
			setstate(reward)
			q.done()
		end
	end
	state reward begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1602]")
			q.set_title("[LC;1603]")
			q.start()
		end
		when button begin
			say_title("[LC;1603]")
			if horse.get_level()<=10 then
				say("[LC;1605]")
			elseif horse.get_level()>=20 then
				say("[LC;1606]")
			elseif (horse.get_level()>=11 and horse.get_level()<=19) then
				local s=number(1, 2)
				if 1>=s then -- 50.00% (1/2)
					say("[LC;1607]")
					pc.setqf("next_time", 0)
				elseif 2>=s then -- 50.00% (1/2)
					say("[LC;1608]")
					if pc.countitem("50050")>=1 then
						char_log(0, "HORSE_ADVANCE", "BEGIN")
						pc.removeitem("50050", 1)
						char_log(0, "HORSE_ADVANCE", "DEC 50050 1")
						horse.unride()
						horse.advance()
						horse.ride()
						char_log(0, "HORSE_ADVANCE", "INC horse_advance 1")
						char_log(0, "HORSE_ADVANCE", "END")
						say(string.format("[LC;1609;%s]", (horse.get_level())))
						if horse.get_level()==20 then
							say("[LC;1610]")
							pc.setqf("next_time", 0)
						else
							say("[LC;1611]")
						end
					else
						say("[LC;1612]")
					end
				end
			end
			setstate(start)
			q.done()
		end
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
