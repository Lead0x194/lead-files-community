			end
		end
		when button begin
			say_title("[LC;1576]")
			say("[LC;1577]")
			if	not pc.is_mount() then
				setstate(failure)
			end
		end
		when info begin
			say_title("[LC;1576]")
			say("[LC;1577]")
			if	not pc.is_mount() then
				setstate(failure)
			end
		end
		when 2108.kill with pc.getqf("kill_count") >= 20 begin
			setstate(report)
		end
		when unmount begin
