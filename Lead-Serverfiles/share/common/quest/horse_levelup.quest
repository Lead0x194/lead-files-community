			q.set_counter("[LC;1626]", 20-pc.getqf("kill_count"))
		end
		when 2203.kill begin
			pc.setqf("kill_count", pc.getqf("kill_count")+1)
			q.set_counter("[LC;1626]", 20-pc.getqf("kill_count"))
		end
		when enter begin
			pc.setqf("kill_count", 0)
		end
		when leave begin
