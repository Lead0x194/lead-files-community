quest horse_levelup begin
	state training1 begin
		when letter begin
			q.set_counter("[LC;1618]", 5-pc.getqf("kill_count"))
		end
		when 492.kill begin
			pc.setqf("kill_count", pc.getqf("kill_count")+1)
			q.set_counter("[LC;1618]", 5-pc.getqf("kill_count"))
		end
		when enter begin
			pc.setqf("kill_count", 0)
		end
		when leave begin
			q.done()
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;1571]")
			q.set_title("[LC;1571]")
			q.start()
			if	not pc.is_mount() then
				setstate(failure)
			end

		end
		when button begin
			say_title("[LC;1571]")
			say("[LC;1582]")
			if	not pc.is_mount() then
				setstate(failure)
			end

		end
		when info begin
			say_title("[LC;1571]")
			say("[LC;1582]")
			if	not pc.is_mount() then
				setstate(failure)
			end

		end
		when 492.kill with pc.getqf("kill_count") >= 5 begin
			setstate(report)
		end
		when unmount begin
			setstate(failure)
		end
	end
