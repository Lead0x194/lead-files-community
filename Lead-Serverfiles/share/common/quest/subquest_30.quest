
quest subquest_30 begin
	state start begin
		when login or levelup or enter with pc.get_level() >=33  and pc.get_level() <= 35 begin
			set_state( information )
		end
	end

	state information begin
		when letter begin
					
			local v = find_npc_by_vnum(20016)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7271]")
			end
		end

				
		when __TARGET__.target.click or	20016.chat."[LC;7788]" with pc.level >= 33 begin
			target.delete("__TARGET__")
			say_title("[LC;7240]")
			say("[LC;7799]")
			wait()
			say_title("[LC;7240]")
			say("[LC;7809]")
			wait()
			say_title("[LC;7240]")
			say("[LC;7810]")
			local s= select("[LC;6997]", "[LC;7811]")
			if 2==s then
				say_title("[LC;7240]")
				say("[LC;7812]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7240]")
					say("[LC;7813]")
					return
				end
				say_title("[LC;7240]")
				say("[LC;7814]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7240]")
			say("[LC;7815]")
			set_state(to_gain_material)
		end	
	end

	state to_gain_material begin

		when letter begin

			send_letter("[LC;7787]")
			local gold=pc.count_item(50606)
			local silver=pc.count_item(50605)
			local ebony=pc.count_item(50608)

			if	gold>=100  and silver>=100 and ebony>=100 then
				local v = find_npc_by_vnum(20016)

				if v != 0 then
					target.vid("__TARGET__", v, "[LC;7789]")
				end
				return
			end
			
		end

		when info or button begin
			local gold=pc.count_item(50606)
			local silver=pc.count_item(50605)
			local ebony=pc.count_item(50608)

			if	gold>=100  and silver>=100 and ebony>=100 then

				say_title("[LC;7790]")
				say("[LC;7791]")
				return
			end

			say_title("[LC;7792]")

			say("[LC;7793]")
		end

		when __TARGET__.target.click or	20016.chat."[LC;7794]" begin
			target.delete("__TARGET__")
			
			local gold = pc.count_item(50606)
			local silver = pc.count_item(50605)
			local ebony = pc.count_item(50608)

			
			if	gold<100 or silver<100 or ebony<100 then

				say_title("[LC;27]")

				say("[LC;7795]")
				local s= select("[LC;7796]", "[LC;7797]")
				if 2==s then
  				say_title("[LC;27]")
				say("[LC;7798]")
					local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;7240]")

						say("[LC;7800]")
						return
					end
				say_title("[LC;27]")
  				say("[LC;7801]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;7240]")
				say("[LC;7802]")
				return
		end	
			
		if	gold>=100  and silver>=100 and ebony>=100 then

			say_title("[LC;27]")
			say("[LC;7803]")
			wait()
			say_title("[LC;27]")
			say("[LC;7804]")
			pc.remove_item(50606,100)
			pc.remove_item(50605,100)
			pc.remove_item(50608,100)
		
			say_reward("[LC;7805]")
			pc.give_exp2(200000)
	
			say_reward("[LC;7806]")
			pc.change_money(20000)
				
				if pc.job == 0 then
					pc.give_item2(00063,1)
					say_reward("[LC;7807]")
				elseif pc.job == 1 then
					pc.give_item2(00063,1)
					say_reward("[LC;7807]")
				elseif pc.job == 2 then
					pc.give_item2(00063,1)
					say_reward("[LC;7807]")
				elseif pc.job == 3 then
					pc.give_item2(07053, 1)
					say_reward("[LC;7808]")
				end	
			clear_letter()
			set_state(__COMPLETE__)	
		end
			
		end	
	end
state __GIVEUP__ begin
end
state __COMPLETE__ begin
	when enter begin
	end
end
end
