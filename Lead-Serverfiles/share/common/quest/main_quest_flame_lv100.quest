	end
	state state3_3 begin 
		when enter begin 
			notice_multiline("[LC;3789]",notice)
		end

		when letter begin 
			send_letter("[LC;3777]") 
			local v = find_npc_by_vnum(ALCHEMIST) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(ALCHEMIST))
			end
		end

		when button or info begin 
			say_title("[LC;3777]") 
			say("[LC;3776]") 
			--say_reward(locale.target_npc_info) 
		end

		when ALCHEMIST.chat."[LC;3777]" begin 
			target.delete("__TARGET__") 
			pc.remove_item(ITEM3_1, pc.count_item(ITEM3_1)) 
			say_title(mob_name(ALCHEMIST)) 
			say("[LC;3790]") 
			wait()--reward

			say_reward(string.format ("[LC;4537;%d]", 35843000))
			pc.give_exp2(35843000)
			say_reward(string.format ("[LC;4538;%d]", 152000))
			pc.change_money(152000)
			say_reward(string.format("[LC;4540;%s]", item_name(71095),1))
			pc.give_item2(71095, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(50708),10))
			pc.give_item2(50708, 10)

			say()
			say_reward(string.format("[LC;4060]", 101))
			
			set_state (__COMPLETE__)
			set_quest_state ("main_quest_flame_lv101", "state0")
		end

		when leave begin 
			--q.done()
		end
	end
	
	state __COMPLETE__ begin
		when enter begin
			--q.done()
		end
