
define YACKHWAN 20377
define SCHOLAR 20380
define ALCHEMIST 20001
define BLACKSMITH 20016

define ITEM2_1 90010
define ITEM2_1_NEEDED 10
define ITEM2_2 30010
define ITEM2_2_NEEDED 50
define ITEM2_3 30025
define ITEM2_3_NEEDED 10
define ITEM2_4 51001
define ITEM2_4_NEEDED 200


define ITEM3_1 31077

quest main_quest_flame_lv100 begin
	state start begin
	end
	state state0 begin
		when login or levelup or enter with pc.level >= 100 begin
			set_state (state1_1)
		end
	end
	state state1_1 begin 
		when letter begin 
			send_letter("[LC;3748]") 
			local v = find_npc_by_vnum(YACKHWAN) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(YACKHWAN))
			end
		end

		when button or info begin 
			say_title("[LC;3748]") 
			say("[LC;3749]") 
			--say_reward(locale.target_npc_info) 
		end

		when YACKHWAN.chat."[LC;3748]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(YACKHWAN)) 
			say("[LC;3750]") 
			wait()

			say_title(mob_name(YACKHWAN)) 
			say("[LC;3751]") 
			wait()

			say_title(mob_name(YACKHWAN)) 
			say("[LC;3752]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3753]") 
			wait()

			say_title(mob_name(YACKHWAN)) 
			say("[LC;3754]") 
			set_state (state1_2)
		end

		when leave begin 
			--q.done()
		end
	end	
	state state1_2 begin 
		when enter begin 
			pc.setqf("kill_count_1", 0)
			notice_multiline("[LC;3755]",notice)
		end

		when letter begin 
			send_letter("[LC;3748]") 
			q.set_counter_name("[LC;5425]")
			main_quest_flame_lv100.kill_count() 
		end

		when button or info begin 
			say_title("[LC;3756]") 
			say("[LC;3757]") 
			say("[LC;5425]")
			say(string.format("[LC;5424;%s;%d]", 300 - pc.getqf("kill_count_1")))
		end

		when YACKHWAN.chat."[LC;3748]" begin 
			say_title(mob_name(YACKHWAN)) 
			say("[LC;3758]") 
		end

		when 2202.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv100.kill_count() 
		end

		when 2203.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv100.kill_count() 
		end

		when 2204.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv100.kill_count() 
		end

		when 2205.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv100.kill_count() 
		end

		when 7020.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv100.kill_count() 
		end

		when 7021.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv100.kill_count() 
		end

		when 7022.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv100.kill_count() 
		end

		when 7023.kill begin
			local kill_count = pc.getqf("kill_count_1")
			pc.setqf("kill_count_1", kill_count+1)
			main_quest_flame_lv100.kill_count() 
		end

		function kill_count()
			local total_remain = 0
			local remain1 = 300 - pc.getqf("kill_count_1")
			if remain1 < 0 then
				remain1 = 0
			end
			total_remain = total_remain + remain1
			q.set_counter_value(total_remain)
			if total_remain == 0 then
				set_state ("state1_3")
			end
		end

		when leave begin 
			pc.setqf("kill_count_1", 0)
			--q.done()
		end
	end	
	state state1_3 begin 
		when enter begin 
			notice_multiline("[LC;3759]",notice)
		end

		when letter begin 
			send_letter("[LC;3748]") 
			local v = find_npc_by_vnum(YACKHWAN) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(YACKHWAN))
			end
		end

		when button or info begin 
			say_title("[LC;3748]") 
			say("[LC;3760]") 
			--say_reward(locale.target_npc_info) 
		end

		when YACKHWAN.chat."[LC;3748]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(YACKHWAN)) 
			say("[LC;3761]") 
			wait()--reward

			say_reward(string.format("[LC;4537;%d]", 38143000))
			pc.give_exp2(38143000)
			say_reward(string.format("[LC;4538;%d]", 149000))
			pc.change_money(149000)
			say_reward(string.format("[LC;4540;%s]", item_name(30051),1))
			pc.give_item2(30051, 1)
			say_reward(string.format("[LC;4540;%s]", item_name(50814),10))
			pc.give_item2(50814, 10)
			say()

			set_state (state2_1)
		end

		when leave begin 
			--q.done()
		end
	end
	

	state state2_1 begin 

		when letter begin 
			send_letter("[LC;3762]") 
			local v = find_npc_by_vnum(ALCHEMIST) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(ALCHEMIST))
			end
		end

		when button or info begin 
			say_title("[LC;3762]") 
			say("[LC;3763]") 
			--say_reward(locale.target_npc_info) 
		end

		when ALCHEMIST.chat."[LC;3762]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(ALCHEMIST)) 
			say("[LC;3764]") 
			wait()

			say_title(mob_name(ALCHEMIST)) 
			say("[LC;3765]") 
			wait()

			say_title(pc.getname()) 
			say({}) 
			wait()

			say_title(mob_name(ALCHEMIST)) 
			say("[LC;3766]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3767]") 
			wait()

			say_title(mob_name(ALCHEMIST)) 
			say("[LC;3768]") 
			set_state (state2_2)
		end

		when leave begin 
			--q.done()
		end
	end
	state state2_2 begin
		when enter begin 
			notice_multiline("[LC;3769]",notice)
		end
		when letter begin
			send_letter("[LC;3762]") 
			q.set_counter_name("[LC;3770]")
		end
		when button or info begin
			say_title("[LC;3771]")
			say("[LC;3772]")
			say("[LC;3770]")			
			
			local remain1 = ITEM2_1_NEEDED - pc.count_item(ITEM2_1)
			local remain2 = ITEM2_2_NEEDED - pc.count_item(ITEM2_2)
			local remain3 = ITEM2_3_NEEDED - pc.count_item(ITEM2_3)
			local remain4 = ITEM2_4_NEEDED - pc.count_item(ITEM2_4)
			if remain1 < 0 then
				remain1 = 0
			end
			if remain2 < 0 then
				remain2 = 0
			end
			if remain3 < 0 then
				remain3 = 0
			end
			if remain4 < 0 then
				remain4 = 0
			end
			
			say(string.format("[LC;5426;%s;%d;%s;%d]",item_name(ITEM2_1) ,remain1,item_name(ITEM2_2) ,remain2))
			say(string.format("[LC;5426;%s;%d;%s;%d]",item_name(ITEM2_3) , remain3,item_name(ITEM2_4) , remain4))
			say()
			q.set_counter_value(remain1 + remain2 + remain3 + remain4)
			
            local check = remain1 + remain2 + remain3 + remain4
            
			if check <= 0 then
				set_state (state2_3)
			end
			
		end
		
		when ALCHEMIST.chat."[LC;3762]" begin
			if pc.count_item(ITEM2_1) >= ITEM2_1_NEEDED and pc.count_item(ITEM2_2) >= ITEM2_2_NEEDED 
			and pc.count_item(ITEM2_3) >= ITEM2_3_NEEDED and  pc.count_item(ITEM2_4) >= ITEM2_4_NEEDED then
				
				pc.remove_item ( ITEM2_1,ITEM2_1_NEEDED)	
				pc.remove_item ( ITEM2_2,ITEM2_2_NEEDED)	
				pc.remove_item ( ITEM2_3,ITEM2_3_NEEDED)	
				pc.remove_item ( ITEM2_4,ITEM2_4_NEEDED)	
				
				say_title(mob_name(ALCHEMIST)) 
				say("[LC;3773]") 
				wait()
				

				say_reward(string.format("[LC;4537;%d]", 48584000))
				pc.give_exp2(48584000)
				say_reward(string.format("[LC;4538;%d]", 150000))
				pc.change_money(150000)
				say_reward(string.format("[LC;4540;%s]", item_name(30015),2))
				pc.give_item2(30015, 2)
				say_reward(string.format("[LC;4540;%s]", item_name(70043),1))
				pc.give_item2_select(70043)
				item.set_socket(2, 60)
				set_state (state3_1)
			else 
				say_title(mob_name(ALCHEMIST)) 
				say("[LC;3774]") 
			end
		end	

		when leave begin 
			--q.done()
		end
	end
	state state2_3 begin
		when enter begin 
			notice_multiline("[LC;3775]",notice)
		end

		when letter begin 
			send_letter("[LC;3762]") 
			local v = find_npc_by_vnum(ALCHEMIST) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(ALCHEMIST))
			end
