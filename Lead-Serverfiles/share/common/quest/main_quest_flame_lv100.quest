	state state3_2 begin 
		when enter begin 
			notice_multiline("[LC;3769]",notice)
		end

		when letter begin 
			send_letter("[LC;3777]") 
			local v = find_npc_by_vnum(BLACKSMITH) 
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(BLACKSMITH))
			end
			q.set_counter_name("[LC;3770]")
			q.set_counter_value(1)
		end

		when button or info begin 
			say_title("[LC;3781]") 
			say("[LC;3782]") 
			say("[LC;3770]")
			say("[LC;3783]")
			--say_reward(locale.target_npc_info) 
		end

		when BLACKSMITH.chat."[LC;3777]" begin 
			target.delete("__TARGET__") 
			say_title(mob_name(BLACKSMITH)) 
			say("[LC;3784]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3785]") 
			wait()

			say_title(mob_name(BLACKSMITH)) 
			say("[LC;3786]") 
			wait()

			say_title(pc.getname()) 
			say("[LC;3787]") 
			
			pc.give_item2(ITEM3_1, 1)
			set_state (state3_3)
		end

		when ALCHEMIST.chat."[LC;3777]" begin 
			say_title(mob_name(ALCHEMIST)) 
			say("[LC;3788]") 
		end

		when leave begin 
			--q.done()
