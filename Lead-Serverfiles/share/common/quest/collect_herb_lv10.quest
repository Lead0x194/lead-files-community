quest make_herb_lv10  begin
	state start begin
		when login or levelup with pc.get_level() ==10  begin
			set_state(information)
		end	
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20084)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;123]")
			end
			send_letter("[LC;134]")
		end

		when button or info begin
			say_title("[LC;134]")
			say("[LC;136]")
		end
		
		when __TARGET__.target.click or	20084.chat."[LC;137]" begin
			target.delete("__TARGET__")
			say_title("[LC;138]")
			say("[LC;139]")
			wait()
			say_title("[LC;138]")
			say("[LC;140]")
			set_state(go_to_disciple)
			pc.setqf("collect_count",0)--Current number of items
			pc.setqf("drink_drug",0) --when take the Potion of Daze
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter("[LC;141]")
			
		end
		when button or info begin
			say_title("[LC;142]")
			say("[LC;122]")
			wait()
			say_title("[LC;44]")
						say_item_vnum(50703) 
			say_reward(string.format("[LC;124;%s]", pc.getqf("collect_count")))
					end
		
		when 71035.use begin --Potion of Daze

			if pc.getqf("drink_drug")==1 then
				say_title("[LC;138]")
				say("[LC;125]")

				return
			end
			if pc.count_item(50703)==0 then
				say_title("[LC;138]")
				say("[LC;126]")
				return
			end
			pc.remove_item(71035, 1)	
			pc.setqf("drink_drug",1)
		end


		when 177.kill begin
			if  pc.count_item(50703)<5- pc.getqf("collect_count")then
				pc.give_item2(50703, 1)
			end
		end
		
    	when 20084.chat."[LC;127]" with pc.count_item(50703) >0   begin
				say_title("[LC;128]")
				say("[LC;129]")
				pc.remove_item(50703, 1)
				wait()
				
				local pass_percent
				if pc.getqf("drink_drug")==0 then
					pass_percent=90
				else		
					pass_percent=100
				end
				
				local s= number(1,100)
				if s<= pass_percent  then
				   if pc.getqf("collect_count")< 4 then     --Less than 5 
						local index =pc.getqf("collect_count")+1 
						pc.setqf("collect_count",index)     --you got one, so you would get +1
						say_title("[LC;138]")
						say(string.format("[LC;130;%s]", 5-pc.getqf("collect_count")))
						pc.setqf("drink_drug",0)	 --Initialize the potions
						return
					end
					say_title("[LC;138]")
				        say("[LC;131]")
					wait()
					say("[LC;132]")
					say_reward("[LC;133]")
					
					pc.setqf("collect_count",0)
					pc.setqf("drink_drug",0)	
					
					clear_letter()
					set_state(__complete)
					
					pc.give_item2(16023)
					pc.change_money(5000)
					pc.give_exp2(6500)
					set_quest_state("levelup","run")
					
					return
				else								
				say_title("[LC;138]")
				say("[LC;135]")
				pc.setqf("drink_drug",0)	 --Initialize Potions
				return
				end

	end
end


		
	state __complete begin
	end
end
