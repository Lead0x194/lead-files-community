quest subquest_25 begin
	state start begin
		when login or levelup with pc.level >= 31  and pc.level <= 33 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20022)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7658]")
			end
		end

		when __TARGET__.target.click or 20022.chat."[LC;7669]" begin
			target.delete("__TARGET__")
			say_title("[LC;636]")
			say("[LC;7680]")
			wait()
			say_title("[LC;636]")
			say("[LC;7691]")
			wait()
			say_title("[LC;636]")
			say("[LC;7696]")
			set_state(to_hear_about_her)
			
		end
	end
	
	state to_hear_about_her begin	
		when letter begin
			setskin(NOWINDOW)
			q.set_title("[LC;7697]")
			q.start()
			makequestbutton("[LC;7698]")
			
			local v=find_npc_by_vnum(20021)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7699]")
			end

		end
		
		when info or button begin
			say_title("[LC;7697]")
			say("[LC;7700]")
		end
		
		when  __TARGET__.target.click or	20021.chat."[LC;7657]" begin
			target.delete("__TARGET__")
			say_title("[LC;1406]")
			say("[LC;7659]")
			wait()
			say_title("[LC;1406]")
			say("[LC;7660]")
			
			set_state(order)

	
		end
	end
	state order begin
		when letter begin
			setskin(NOWINDOW)
			q.set_title("[LC;7661]")
			q.start()
			makequestbutton("[LC;7662]")
			
			local v=find_npc_by_vnum(20022)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7663]")
			end

		end
		when info or button begin
			say_title("[LC;7661]")
			say("[LC;7664]")
		end

		when __TARGET__.target.click or	20022.chat."[LC;7665]"  begin
			target.delete("__TARGET__")

			say_title("[LC;636]")
			say("[LC;7666]")
			wait()
			say_title("[LC;636]")
			say("[LC;7667]")
			local s= select("[LC;6997]", "[LC;7668]")
			if 2==s then
				say("[LC;7670]")
				local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;636]")
						say("[LC;7671]")
						return
					end
					say_title("[LC;636]")
					say("[LC;7672]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;636]")
				say("[LC;7673]")
				set_state(find_flower)
			end


	end

	state find_flower begin
		when letter begin
			setskin(NOWINDOW)
			q.set_title("[LC;7674]")
			q.start()
			makequestbutton("[LC;7674]")
		
			local v=find_npc_by_vnum(20358)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7675]")
			end


		end
		when info or  button begin
			say_title("[LC;7676]")

			say("[LC;7677]")
		end
		when 20022.chat."[LC;7678]" begin
			say_title("[LC;636]")
			say("[LC;7679]")
		
			local s= select("[LC;7681]", "[LC;7682]")
			if 2==s then
				say("[LC;7683]")
				local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;636]")
						say("[LC;7684]")
						return
					end
					say_title("[LC;636]")
					say("[LC;7685]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;636]")



				say("[LC;7686]")
		end	


		when __TARGET__.target.click or	20358.chat."[LC;7687]" with pc.getqf("flower_done")==0 begin    
				target.delete("__TARGET__")
				say("[LC;7688]")
				pc.give_item2(30153, 1)                                                    
				set_state(go_to_reward)
			end
			
	end

	state go_to_reward begin
		when letter begin
			setskin(NOWINDOW)
			q.set_title("[LC;7689]")
			q.start()
			makequestbutton("[LC;7689]")
			
			local v=find_npc_by_vnum(20022)
			if 0 == v then
				else
					target.vid("__TARGET__",v, "[LC;7661]")
			end 

		end
		when info or  button begin
			say_title("[LC;7689]")

			say("[LC;7690]")
		end

		when __TARGET__.target.click or 20022.chat."[LC;7692]" with pc.count_item(30153) > 0 begin      
			target.delete("__TARGET__")
			say_title("[LC;636]")
			say("[LC;7693]")
			pc.remove_item(30153,1)
			
			say_reward("[LC;7694]")
			pc.give_exp2(400000)
			say_reward("[LC;7695]")
			pc.change_money(12000)	
			
			clear_letter()
			set_state(__COMPLETE__)

		end
	end

	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
	end
end


