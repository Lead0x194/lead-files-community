quest subquest_47  begin

	state start begin
		when login or levelup with pc.level >= 50  and pc.level <= 52 begin
			set_state( information )
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;8276]")
			end
		end
		when __TARGET__.target.click or	20355.chat."[LC;8289]" with  pc.level >= 50 begin
			target.delete("__TARGET__")
			say_title("[LC;4082]")
			say("[LC;8305]")
			-- select: take quest / give up quest
			local r= select("[LC;971]", "[LC;6998]")
			-- give up quest
			if 2==r then
				say("[LC;8309]") -- give up yes/no
				local a= select("[LC;2059]", "[LC;2035]")
				-- dont give up
				if 2==a then
					say_title("[LC;4082]")
					say("[LC;8310]")
					return
				end
				-- give up
				say_title("[LC;4082]")
				say("[LC;8311]")
				set_state(__GIVEUP__)
				return
			end
			-- dont give up quest
			say_title("[LC;4082]")
			say("[LC;8312]")
			wait()
			say_title("[LC;4082]")
			say("[LC;8313]") -- displays the riddle text
			wait()
			say_title("[LC;4082]")
			say("[LC;8314]")
			-- select: answer question / i dont know / show again
			local s= select("[LC;8274]", "[LC;8277]", "[LC;8278]")
			-- i dont know
			if 2==s then
				say("[LC;8279]")
				-- select: give up yes / no
				local a= select("[LC;2059]", "[LC;2035]")
				-- show riddle again
				if  2==a then
					say_title("[LC;4082]")
					say("[LC;8280]")
					return
				end
				-- give up quest
				say_title("[LC;4082]")
				say("[LC;8281]")
				set_state(__GIVEUP__)
				return
			end
			-- show the riddle again
			if 3==s then
				say_title("[LC;4082]")
				say("[LC;8282]") -- displays the riddle text again
				wait()
			end
			say_title("[LC;4082]")
			say("[LC;8283]")
			-- input answer
			local answer = select( "[LC;8301]", "[LC;8303]", "[LC;8300]", "[LC;8302]", "[LC;8304]")
			-- input correct answer -> quest complete
			if 3 == answer  then
				say_title("[LC;4082]")
				say("[LC;8284]")
				say_reward("[LC;8285]")
				pc.give_exp2(2300000)
				clear_letter()
			    set_state(__COMPLETE__)
				return
			-- input no answer
			elseif 5 == answer then
				say_title("[LC;4082]")
				say("[LC;8286]")
				-- select: try again / i dont know
				local answer = select("[LC;8287]", "[LC;8290]")
				-- i dont know
				if 2==answer then
					say_title("[LC;4082]")
					say("[LC;8291]")
					return
				end
				-- try again
				say_title("[LC;4082]")
				say("[LC;8292]")
				local answer = select( "[LC;8303]", "[LC;8300]", "[LC;8302]", "[LC;8301]", "[LC;8304]")
				-- input correct answer -> quest complete
				if 2==answer then
					say_title("[LC;4082]")
					say("[LC;8293]")
					say_reward("[LC;8294]")
					pc.give_exp2(2300000)
					clear_letter()
					set_state(__COMPLETE__)
					return
				-- input wrong answer
				else
					say_title("[LC;4082]")
					say("[LC;8295]")
					return
				end
			-- wrong answer
			else
				say_title("[LC;4082]")
				say("[LC;8296]")
				-- select: try again / i dont know
				local a= select("[LC;8297]", "[LC;8298]")
				-- i dont know -> give up
				if 2==a then
					say_title("[LC;4082]")
					say("[LC;8291]")
					set_state(__GIVEUP__)
					return
				end
				-- try again
				say("[LC;8299]")
				local answer = select( "[LC;8300]", "[LC;8301]", "[LC;8302]", "[LC;8303]", "[LC;8304]")
				-- correct answer
				if 1==answer then
					say_title("[LC;4082]")
					say("[LC;8306]")
					say_reward("[LC;8285]")
					pc.give_exp2(2300000)
					say_reward("[LC;8307]")
					pc.change_money(20000)
					clear_letter()
					set_state(__COMPLETE__)
					return
				-- no or wrong answer -> retry by clicking captain (20355.chat) again
				else
					say_title("[LC;4082]")
					say("[LC;8308]")
					return
				end
			end
		end
	end

	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
	state __GIVEUP__ begin
	end
end

