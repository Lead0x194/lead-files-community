quest main_quest_lv3 begin
	state start begin

	end
	state run begin
		when login or levelup or enter with pc.get_level() >= 3 begin
			set_state ( gototeacher )
		end
		when 20354.chat."[LC;4194]" begin
			say_title("[LC;4066]")
			say("[LC;4205]")
		end
	end
	state gototeacher begin
		when letter begin
			send_letter("[LC;4206]")
			local v=find_npc_by_vnum(20354)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4171]")
			end
		end
		when button or info begin
			say_title("[LC;4206]")
			say("[LC;4207]")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;4066]")
			say("[LC;4208]")
			wait()
			say_title("[LC;4066]")
			say("[LC;4209]")
			wait()
			set_state ( gotogood )
		end
	end

	state gotogood begin
		when letter begin
			local v=find_npc_by_vnum(9003)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4210]")
			end
		end
		when letter begin
			send_letter("[LC;4211]")
		end
		when button or info begin
			say_title("[LC;4211]")
						say_reward("[LC;4212]")
					end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			say_title("[LC;1004]")
			say("[LC;4193]")
			wait()
			say_title("[LC;1004]")
			say("[LC;4195]")
			say_item("[LC;4196]", 69000, "")
			set_state ( gotodefend )
		end
	end

	state gotodefend begin
		when letter begin
			local v=find_npc_by_vnum(9002)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4197]")
			end
		end
		when letter begin
			send_letter("[LC;4198]")
		end
		when button or info begin
			say_title("[LC;4198]")
			say("[LC;4199]")
			say_item("[LC;4196]", 69000, "")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;4200]")
			say("[LC;4201]")
			say_item("[LC;4196]", 69000, "")
			say("[LC;4202]")
			wait()
			say_title("[LC;4200]")
			say("[LC;4203]")
			wait("")
			say_title("[LC;192]")
						say_reward("[LC;4204]")

						pc.give_exp2( 450 )
			pc.change_money( 5000 )
			pc.give_item2( 27004 ,20 )
						
			clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv6","run")
		end
	end
	state __COMPLETE__ begin
	end
end
