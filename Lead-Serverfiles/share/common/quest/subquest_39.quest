
quest subquest_39 begin
	state start begin
		when login or levelup or enter with pc.level >= 55 and pc.level <= 57 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20020)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;8056]")
			end
		end

		
		when __TARGET__.target.click or	20020.chat."[LC;8067]" with pc.level >= 55 begin
			target.delete("__TARGET__")

			say_title("[LC;1232]")
			say("[LC;8078]")
			wait()
			say_title("[LC;1232]")
			say("[LC;8089]")
			local s= select("[LC;971]", "[LC;6998]")
			if 2==s then
				say("[LC;8100]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;1232]")
					say("[LC;8106]")
					return
				end
				say_title("[LC;8107]")
				say("[LC;8108]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;8107]")
			say("[LC;8109]")
			set_state(ask_to_backgo)
		

		
		end
	end

	state ask_to_backgo begin
		when info or button begin
			say_title("[LC;8055]")
			say("[LC;8057]")
		end

		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8058]")
			q.set_title("[LC;8059]")
			q.start()
			
			local v=find_npc_by_vnum("20018")
			if 0== v then
			else
				target.vid("__TARGET__",v, "[LC;8060]")
			end
		end

		when __TARGET__.target.click or 20018.chat."[LC;8061]" begin
			target.delete("__TARGET__")	
			say_title("[LC;8062]")
			say("[LC;8063]")
			wait()
			say_title("[LC;248]")
			say("[LC;8064]")
			wait()
			say_title("[LC;248]")
			say("[LC;8065]")
			local b= select("[LC;8066]", "[LC;8068]")
			if 2==b then
				say("[LC;8069]")
				local a= select("[LC;8070]", "[LC;2035]")
				if  2==a then
					say_title("[LC;248]")
					say("[LC;8071]")
					return
				end	
				say_title("[LC;248]")
				say("[LC;8072]")
				set_state(__GIVEUP__)
				return
			end 

			say_title("[LC;248]")
			say("[LC;8073]")
			set_state(hunt_monkey_boss)

			end
		end
			
	state hunt_monkey_boss begin
		when letter begin
			if pc.count_item(50059)>0 then
				setskin(NOWINDOW)
				makequestbutton("[LC;8074]")
				q.set_title("[LC;8074]")
				q.start()
			
				local v=find_npc_by_vnum("20018")
				if 0== v then
				else
					target.vid("__TARGET__",v, "[LC;8075]")
				end

				return
			end
			setskin(NOWINDOW)
			makequestbutton("[LC;8074]")
			q.set_title("[LC;8074]")
			q.start()
		end
		when button or info begin
			if pc.count_item(50059)>0 then
				say_title("[LC;8076]")
				say("[LC;8077]")
				return
			end
			say_title("[LC;8079]")
			say("[LC;8080]")
			say_item_vnum(50059)
					end
		when __TARGET__.target.click or 20018.chat."[LC;8081]" with pc.count_item(50059) ==0 begin
			say_title("[LC;248]")
			say("[LC;8082]")
			local s= select("[LC;8083]", "[LC;8084]")
			if 2==s then
				say_title("[LC;248]")
				say("[LC;8085]")
				local s= select("[LC;8086]", "[LC;8087]")
				if 1==s then
					say_pc_name()
					say("[LC;8088]")
					wait()
					say_title("[LC;8062]")
					say("[LC;8090]")
					set_state(__GIVEUP__)
					return
				end
				say_pc_name()
				say("[LC;8091]")
				return
			end
			say_title("[LC;248]")
			say("[LC;8092]")
			return	
		end
		
		when 5161.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("50059")==0 then
				pc.give_item2(50059, 1)
				
			end
		end


		when __TARGET__.target.click or	20018.chat."[LC;8081]" with pc.count_item(50059)>=1 begin
			target.delete("__TARGET__")

			say_title("[LC;248]")
			say("[LC;8093]")
			wait()
			say_title("[LC;8094]")
			say("[LC;8095]")
			pc.remove_item("50059",1)
			pc.give_item2("30152",1)
			set_state(go_to_patient)
		end
	end

	state go_to_patient begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8096]")
			q.set_title("[LC;8096]")
			q.start()
			
			local v=find_npc_by_vnum(20020)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;8097]")
			end
		end

		when info or button begin
			say_title("[LC;8098]")
			say("[LC;8099]")
		end
		
		when __TARGET__.target.click or	20020.chat."[LC;8101]" with pc.count_item(30152)>=1  begin
			target.delete("__TARGET__")
			say_title("[LC;1232]")
			say("[LC;8102]")
			wait()
			say_title("[LC;1232]")
			say("[LC;8103]")
			pc.remove_item("30152",1)
			say_reward("[LC;8104]")
			pc.change_money(65000)

			say_reward("[LC;8105]")
			pc.give_exp2(4000000)
			set_quest_state("levelup","run")
			
				
			clear_letter()	
			set_state(COMPLETE)
			return
				
		end
	
	end
	state __GIVEUP__ begin
	end
	
	state COMPLETE begin
		when enter begin
			q.done()
		end
	end
end
