quest subquest_45 begin
	state start begin
		when login or levelup with pc.level >= 60  and pc.level <= 62  begin
			set_state(enter)
		end
	end

	state enter  begin
		when letter begin
			local v=find_npc_by_vnum(20023)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7743]")
			end
		end

		when __TARGET__.target.click or 20023.chat."[LC;8234]" begin
			target.delete("__TARGET__")
			say_title("[LC;7093]")
			say("[LC;8245]")
			wait()
			say_title("[LC;7093]")
			say("[LC;8248]")
			
			local s= select("[LC;8249]")
			if 2==s then
				say("[LC;8250]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7093]")
					say("[LC;8251]")
					return
				end
				say_title("[LC;7093]")
				say("[LC;8252]")
				set_state(__GIVEUP__)
				return
			end
					
			say_title("[LC;7093]")
			say("[LC;8253]")
			set_state(WHAT_IS_MILGYO)
			
		end

	end
			

	state WHAT_IS_MILGYO begin

		when letter begin

			setskin(NOWINDOW)
			makequestbutton("[LC;8254]")
			q.set_title("[LC;8254]")
			q.start()

			if pc.count_item("30147")>=1 and	 pc.count_item("30148")>=1  and  pc.count_item("30164")>=1 then
				local v=find_npc_by_vnum(20023)
				if 0!= v then
					target.vid("__TARGET__",v, "[LC;7751]")
				end 
			end

		end

		when info or  button begin

			if pc.count_item("30147")>=1 and pc.count_item("30148")>=1  and  pc.count_item("30164")>=1  then
				say_title("[LC;8233]")
				say("[LC;8235]")
				return
			end
				
			say_title("[LC;8233]")


			say("[LC;8236]")
		end

		when 737.kill  begin
		
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30147")==0  then
				pc.give_item2(30147, 1)    
				return
			end	
			
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30148")==0  then
				pc.give_item2(30148, 1) 
				return
			end
			
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30164")==0  then
				pc.give_item2(30164, 1) 
				return
			end
			
		end

			
		when __TARGET__.target.click or 20023.chat."[LC;8237]"   begin
			if pc.count_item("30147")>0 and pc.count_item("30148")>0  and  pc.count_item("30164")>0 then
				target.delete("__TARGET__")
				say_title("[LC;7093]")
				say("[LC;8238]")
				wait()
				say_title("[LC;7093]")
				say("[LC;8239]")
				pc.remove_item("30148",1)
				pc.remove_item("30147",1)
				pc.remove_item("30164",1)
				
				say_reward("[LC;8240]")
				pc.give_exp2(7000000)
					
				say_reward("[LC;8241]")
				pc.give_item2(70003)

				say_reward("[LC;8242]")
				pc.change_money(70000)
				clear_letter()
				set_state(COMPLETE)


				
				return
			else		
				say_title("[LC;7093]")


				say("[LC;8243]")
				local s= select("[LC;8244]", "[LC;939]")
				if 2==s then
					say_title("[LC;7093]")
					say("[LC;8246]")
					set_state(__GIVEUP__)
					return
				end
						
				say_title("[LC;7093]")

				say("[LC;8247]")
			end


		end

	end


	state __GIVEUP__ begin
	end
	state COMPLETE begin
		when enter begin
			q.done()
		end	
	end	
end
	

