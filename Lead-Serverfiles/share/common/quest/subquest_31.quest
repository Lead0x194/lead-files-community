quest subquest_31 begin
	state start begin
		when login or levelup or enter with pc.get_level() >=34  and pc.get_level() <= 36 begin
			set_state( information )
		end
	end

	state information begin
		when letter begin
					
			local v = find_npc_by_vnum(20016)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7817]")
			end
		end

				
		when __TARGET__.target.click or	20016.chat."[LC;7828]" with pc.level >= 34 begin
			target.delete("__TARGET__")
			say_title("[LC;7240]")
			say("[LC;7838]")
			wait()
			say_title("[LC;27]")
			say("[LC;7839]")
			local s= select("[LC;7840]", "[LC;7811]")
			if 2==s then
			say_title("[LC;27]")
			say("[LC;7841]")
			local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7240]")
					say("[LC;7842]")
					return
				end
				say_title("[LC;7240]")
				say("[LC;7843]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7240]")
			say("[LC;7844]")
			set_state(to_gain_material)
		end	
	end

	state to_gain_material begin

		when letter begin

			send_letter("[LC;7816]")
			local copper =pc.count_item(50604)
			local pearl=pc.count_item(50609)
			local ebony=pc.count_item(50608)
			
			if	copper>100  or  pearl>100 or  ebony>100 then
				
				local v = find_npc_by_vnum(20016)

				if v != 0 then
				target.vid("__TARGET__", v, "[LC;7789]")
				end
				return
			end
	
		end

		when info or button begin
			local copper=pc.count_item(50604)
			local pearl=pc.count_item(50609)
			local ebony=pc.count_item(50608)
			
			if	copper>=100  and   pearl>=100 and  ebony>=100 then
				say_title("[LC;7818]")
				say("[LC;7819]")
				return
			end
			
			say_title("[LC;7820]")
			say("[LC;7821]")
		end

		when 20016.chat."[LC;7822]"  begin
			target.delete("__TARGET__")
			
			local copper =pc.count_item(50604)
			local pearl=pc.count_item(50609)
			local ebony=pc.count_item(50608)
			

			
			if	copper<100  or  pearl<100 or  ebony<100 then

				say_title("[LC;27]")

				say("[LC;7823]")
				local s= select("[LC;7824]", "[LC;7825]")
				if 2==s then
  				say("[LC;7826]")
					local a= select("[LC;2059]", "[LC;2035]")
					if  2==a then
						say_title("[LC;27]")
						say("[LC;7827]")
						return
					end
					say_title("[LC;7240]")
					say("[LC;7829]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;27]")
				say("[LC;7830]")
		end	
		if copper>=100  and pearl>=100 and ebony>=100 then
			say("[LC;7831]")
			say_reward("[LC;7832]")
			pc.give_exp2(200000)

			
			pc.remove_item(50604,100)
			pc.remove_item(50609,100)
			pc.remove_item(50608,100)
			
			say_reward("[LC;7833]")
			pc.change_money(20000)

				if pc.job == 0 then
					pc.give_item2(11233, 1)
					say_reward("[LC;7834]")
				elseif pc.job == 1 then
					pc.give_item2(11433, 1)
					say_reward("[LC;7835]")
				elseif pc.job == 2 then
					pc.give_item2(11633, 1)
					say_reward("[LC;7836]")
				elseif pc.job == 3 then
					pc.give_item2(11833, 1)
					say_reward("[LC;7837]")
				end	
			
			
			clear_letter()
			set_state(__COMPLETE__)	
			end

			
		end	
	end
state __GIVEUP__ begin
end
state __COMPLETE__ begin
	when enter begin
		q.done()
	end
end
end
