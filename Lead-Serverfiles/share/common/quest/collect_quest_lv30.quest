quest collect_quest_lv30  begin
	state start begin
		when login or levelup with pc.level >= 30 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20084)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;128]")
			end
			send_letter("[LC;222]")
		end

		when button or info begin
			say_title("[LC;222]")
			say("[LC;233]")
		end

		when __TARGET__.target.click or	20084.chat."[LC;244]" begin
			target.delete("__TARGET__")
			say_title("[LC;138]")
			say("[LC;253]")
			wait()
			say_title("[LC;138]")
			say("[LC;254]")
			wait()
			say_title("[LC;128]")
			say("[LC;255]")
			set_state(go_to_disciple)
			pc.setqf("duration",0) 
			pc.setqf("collect_count",0)
			pc.setqf("drink_drug",0)
		end
	end


	state go_to_disciple begin
		when letter begin
			send_letter("[LC;256]")

		end
		when button or info begin
			say_title("[LC;257]")
			say("[LC;258]")
			say_item_vnum(30006)
			say_reward(string.format("[LC;221;%s]", pc.getqf("collect_count")))
					end

		when 71035.use begin
			if get_time() < pc.getqf("duration") then
				say("[LC;223]")
				return
			end
			if pc.getqf("drink_drug")==1 then
				say("[LC;224]")

				return
			end
			if pc.count_item(30006)==0 then
				say_title("[LC;138]")
				say("[LC;225]")
				return
			end
			pc.remove_item(71035, 1)
			pc.setqf("drink_drug",1)
		end

		when 601.kill begin
			local s = number(1, 100)
			if s <= 5 then
				pc.give_item2(30006, 1)
			end 
		end


    	when 20084.chat."[LC;226]" with pc.count_item(30006) >0   begin
			if get_time() > pc.getqf("duration") then
				if pc.count_item(30006) >0 then 
				say_title("[LC;128]")
				say("[LC;227]")
				pc.remove_item("30006", 1)
				pc.setqf("duration",get_time()+60*60*22) ---22Stunden
				wait()

				local pass_percent
				if pc.getqf("drink_drug")==0 then
					pass_percent=60
				else
					if true == pet.is_summon(34003) or true == pet.is_summon(34001) then
						pass_percent=92
					else
						pass_percent=90
					end
				end

				notice(pass_percent)

				local s= number(1,100)
				if s <= pass_percent  then
				   if pc.getqf("collect_count")< 9 then    
						local index =pc.getqf("collect_count")+1
						pc.setqf("collect_count",index)
						say_title("[LC;128]")
						say(string.format("[LC;228;%s]", 10-pc.getqf("collect_count")))
						pc.setqf("drink_drug",0)	
						return
					end
					say_title("[LC;138]")
					say("[LC;229]")
					pc.setqf("collect_count",0)
					pc.setqf("drink_drug",0)
					pc.setqf("duration",0)
					set_state(key_item)
					return
				else
				say_title("[LC;138]")
				say("[LC;230]")
				pc.setqf("drink_drug",0)	
				return
				end
			else
				say_title("[LC;138]")
				--say(string.format("[LC;231]", item_name(30006)))
				say("[LC;231]")
				return
			end
	    else
		  say_title("[LC;138]")
		  say("[LC;232]")
		  return
		end

	end
end


	state key_item begin
		when letter begin
			send_letter("[LC;234]")

			if pc.count_item(30220)>0 then
				local v = find_npc_by_vnum(20084)
				if v != 0 then
					target.vid("__TARGET__", v, "[LC;128]")
				end
			end

		end
		when button or info begin
			if pc.count_item(30220) >0 then
				say_title("[LC;235]")
								say_reward("[LC;236]")
								return
			end
			say_title("[LC;235]")
			say("[LC;237]")
			say_item_vnum(30220)
			say("[LC;238]")
		end



		when 631.kill or 632.kill or 633.kill or 634.kill or 635.kill or 636.kill or 637.kill  begin
			local s = number(1, 500)
			if s == 1 and pc.count_item(30220)==0 then
				pc.give_item2(30220, 1)
				send_letter("[LC;239]")
			end
		end

		when __TARGET__.target.click  or	20084.chat."[LC;240]" with pc.count_item(30220) > 0  begin
			target.delete("__TARGET__")
			if pc.count_item(30220) > 0 then 
				say_title("[LC;128]")
				say("[LC;241]")
				pc.remove_item(30220,1)
				set_state(__reward)
			else
				say_title("[LC;128]")
				--say(string.format("[LC;242]", item_name(30220)))
				say("[LC;242]")
				return
			end
		end

	end

	state __reward begin
		when letter begin
			send_letter("[LC;243]")

			local v = find_npc_by_vnum(20018)
			if v != 0 then
				target.vid("__TARGET__", v, "[LC;245]")
			end

		end
		when button or info begin
			say_title("[LC;243]")
			say("[LC;246]")
		end

		when __TARGET__.target.click  or	20018.chat."[LC;247]"  begin
			target.delete("__TARGET__")
			say_title("[LC;248]")
			say("[LC;249]")
			say_reward("[LC;250]")

			affect.add_collect(apply.MOV_SPEED, 10, 60*60*24*365*60) --60Jahre
			pc.give_item2(50109)
			clear_letter()
			set_quest_state("collect_quest_lv40", "run")
			set_state(__complete)
		end

	end


	state __giveup__ begin
		when 20084.chat."[LC;251]" begin
			say_title("[LC;138]")
			say("[LC;252]")
			set_state(start)
	     end
	 end
	state __complete begin
	end
end



