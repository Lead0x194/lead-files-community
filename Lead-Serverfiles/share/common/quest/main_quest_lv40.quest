
quest main_quest_lv40 begin
	state start begin
	end
	state run begin
		when login or levelup or enter with pc.get_level() >= 40 begin
			set_state ( information )
		end
	end
	state information begin
		when letter begin
			send_letter("[LC;4231]")
		end
		when button or info begin
		        ----"12345678901234567890123456789012345678901234567890"|
			say_title("[LC;4299]")
			say("[LC;4310]")
		end

		when 731.kill begin
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30150")==0 then
				pc.give_item2(30150, 1)
				set_state (gototeacher)
			end
		end
	end

	state gototeacher begin
		when letter begin

			send_letter("[LC;4292]")
			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4253]")
			end
		end
		when button or info begin
			
			say_title("[LC;4321]")
			say("[LC;4332]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4292]" begin
			target.delete("__TARGET__")

			say_title("[LC;4223]")
   			say("[LC;4343]")
			wait()
			say_title("[LC;4349]")
			   			say_reward("[LC;4350]")
						wait()
			say_title("[LC;4223]")
			say("[LC;4351]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4352]")
			say_reward("[LC;4298]")
			pc.give_exp2(2000000)

			say_reward("[LC;4300]")
			pc.change_money(50000)

			say_reward("[LC;4301]")
			pc.give_item2(71018)
			pc.remove_item(30150)
			set_state ( godoc4 )

		end
	end

	state godoc4 begin
		when letter begin

			send_letter("[LC;4302]")
			local v=find_npc_by_vnum(20360)
			if 0==v then
			else
				target.vid("__TARGET1__", v, "[LC;4303]")
			end

			local v=find_npc_by_vnum(20361)
			if 0==v then
			else
				target.vid("__TARGET2__", v, "[LC;4304]")
			end
		end

		when button or info begin
			
			say_title("[LC;4305]")
			say("[LC;4306]")
		end
		when __TARGET1__.target.click or	20360.chat."[LC;4304]" begin
			target.delete("__TARGET1__")
			say_pc_name()
			say("[LC;4307]")
			pc.setqf("click1",1)

			if pc.getqf("click2") == 1 then
				pc.setqf("click1",0)
				pc.setqf("click2",0)

				pc.give_item2(30150)
				set_state ( gototeacher2)
				return
			end


			say("[LC;4308]")
		end

		when __TARGET2__.target.click or	20361.chat."[LC;4309]" begin
			target.delete("__TARGET2__")
			say_pc_name()
			say("[LC;4311]")
			pc.setqf("click2",1);

			if pc.getqf("click1") == 1 then
				pc.setqf("click1",0)
				pc.setqf("click2",0)
				pc.give_item2(30150)
				set_state ( gototeacher2)
				return
			end
			say("[LC;4312]")
		end
	end

	state gototeacher2 begin
		when letter begin

			send_letter("[LC;4313]")
			local v=find_npc_by_vnum(20011)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4253]")
			end
		end
		when button or info begin
			say_title("[LC;4314]")
			say("[LC;4315]")
		end
		when __TARGET__.target.click or	20011.chat."[LC;4316]" begin
			target.delete("__TARGET__")
			say_title("[LC;4223]")
			say("[LC;4317]")
			wait()
			say_title("[LC;4318]")
						say_reward("[LC;4319]")
						wait()
			say_title("[LC;4320]")
						say_reward("[LC;4322]")
						wait()
			say_title("[LC;4223]")
			say("[LC;4323]")
			wait()
			say_title("[LC;4223]")
			say("[LC;4324]")
			say_reward("[LC;4325]")
			pc.give_exp2(2000000)

			say_reward("[LC;4266]")
			pc.change_money(50000)

			say_reward("[LC;4326]")
			pc.give_item2(71019)

			pc.remove_item(30150)

						set_state ( goboss )

		end
	end

	state goboss begin
		when letter begin

			send_letter("[LC;4327]")
			local v=find_npc_by_vnum(20355)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4328]")
			end
		end
		when button or info begin
			say_title("[LC;4329]")
			say("[LC;4330]")
		end
		when __TARGET__.target.click or	20355.chat."[LC;4331]" begin
			target.delete("__TARGET__")
			say_title("[LC;4082]")
			say("[LC;4333]")
			wait()
			say_title("[LC;4082]")
			say("[LC;4334]")
			set_state (survey)
		end
	end


	state survey begin
		when letter begin

			send_letter("[LC;4335]")
			local v=find_npc_by_vnum(20364)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4335]")
			end
		end
		when button or info begin
			say_title("[LC;4335]")
			                        ---"12345678901234567890123456789012345678901234567890"|
			say("[LC;4336]")
		end
		when __TARGET__.target.click or	20364.chat."[LC;4337]" begin
			target.delete("__TARGET__")
		
			say_title("[LC;4338]")
			say("[LC;4339]")
			wait()
			say_title("[LC;4338]")
			say("[LC;4340]")
			wait()
			say_title("[LC;4338]")
			say("[LC;4341]")
			set_state (survey2)
		end
	end

	state survey2 begin
		when letter begin
			send_letter("[LC;4342]")
		end

		when button or info begin
			say_title("[LC;4342]")
			say("[LC;4344]")
		end
		when 591.kill begin
			local s = number(1, 100)
			if s <= 10 and pc.count_item("30150")==0 then
				pc.give_item2(30150, 1)
				set_state (_end_)
			end
		end
	end

	state _end_ begin

		when letter begin
			send_letter("[LC;4345]")
		end

		when button or info begin
			say_title("[LC;4345]")
			say("[LC;4346]")
			wait()
			say_title("[LC;4347]")
						say_reward("[LC;4348]")
						clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv47", "run")
		end

	end
	state __COMPLETE__ begin
	end


end



