quest subquest_49 begin
	state start begin
		when login or levelup or enter with pc.level >= 59 and pc.level <= 61 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20014)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;8346]")
			end
		end

		when __TARGET__.target.click or	20014.chat."[LC;8357]" with pc.level >= 59 begin
			target.delete("__TARGET__")
			say_title("[LC;8370]")
			say("[LC;8381]")
			wait()
			say_title("[LC;8370]")
			say("[LC;8388]")
			local s= select("[LC;8269]", "[LC;8270]")
			if 2==s then
			say_title("[LC;8370]")
				say("[LC;8389]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;6407]")
					say("[LC;8390]")
					return
				end
				say_title("[LC;8370]")
				say("[LC;8391]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;8370]")
			say("[LC;8392]")
			set_state(ask_to_youhwarang)
		end
	end

	state ask_to_youhwarang begin
		when info or button begin
			say_title("[LC;8345]")
			say("[LC;8347]")
		end

		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8345]")
			q.set_title("[LC;8348]")
			q.start()

			local v=find_npc_by_vnum("20024")
			if 0== v then
			else
				target.vid("__TARGET__",v, "[LC;8349]")
			end
		end

		when __TARGET__.target.click or	20024.chat."[LC;8350]" begin
			target.delete("__TARGET__")
			say_title("[LC;6412]")
			say("[LC;8351]")
			set_state(ask_to_chef)
		end
	end

	state ask_to_chef begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8352]")
			q.set_title("[LC;8352]")
			q.start()

			local v=find_npc_by_vnum("20008")
			if 0== v then
			else
				target.vid("__TARGET1__",v, "[LC;8352]")
			end
		end

		when info or button begin
			say_title("[LC;8345]")
			say("[LC;8353]")
		end

		when __TARGET1__.target.click or 20008.chat."[LC;8354]" begin
			target.delete("__TARGET1__")
			say_title("[LC;7137]")
			say("[LC;8355]")
			wait()
			say_title("[LC;7137]")
			say("[LC;8356]")
			wait()
			say_title("[LC;7137]")
		    say("[LC;8358]")
			local s= select("[LC;2059]", "[LC;2035]")
			if 2==s then
				say("[LC;8359]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;7137]")
					say("[LC;8360]")
					return
				end
				say_title("[LC;7137]")
				say("[LC;8361]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7137]")
		    say("[LC;8362]")
			set_state(gain_ice)
		end
	end

	state gain_ice begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8346]")
			q.set_title("[LC;8346]")
			q.start()

			if pc.count_item("30146")>=50 then
				local v=find_npc_by_vnum(20008)
				if 0==v then
					else
					target.vid("__TARGET__",v, "[LC;8363]")
				end
			end

		end

		when info or button begin

			if pc.count_item("30146")>=50 then
				say(string.format("[LC;8364;%s]", locale.NOTICE_COLOR.."[LC;8365]"..locale.NORMAL_COLOR))
				return
			end
			say(string.format("[LC;8366;%s]", locale.NOTICE_COLOR.."[LC;8367]"..locale.NORMAL_COLOR))
		end

		when 1101.kill begin
			local s = number(1, 100)
			if s <= 7 and pc.count_item("30146")< 50  then
				pc.give_item2("30146", 2)
			end
		end

		when __TARGET__.target.click or	20008.chat."[LC;8368]" begin
			target.delete("__TARGET__")
			if pc.count_item("30146") >= 50 then
				say_title("[LC;7137]")
				say("[LC;8369]")
				say_item_vnum(30149)
				pc.give_item2(30149)
				set_state(back_to_boy)
				pc.remove_item(30146, 50)
				return
			else
				say("[LC;8371]")
				local s= select("[LC;8372]", "[LC;939]")
				if 2==s then
					say_title("[LC;7137]")
					say("[LC;8373]")
					set_state(__GIVEUP__)
					return
				end
				say_title("[LC;7137]")

				say("[LC;8374]")
			end
	end
end

state back_to_boy begin
	when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8221]")
			q.set_title("[LC;8221]")
			q.start()

			local v = find_npc_by_vnum(20014)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;8375]")
			end

		end

		when info or button begin
			say_title("[LC;8221]")
			say("[LC;8376]")
			say_item_vnum(30149)
		end


		when __TARGET__.target.click or	20014.chat."[LC;8377]" begin
			target.delete("__TARGET__")
			if pc.count_item("30149")>0 then
				say_title("[LC;6407]")
				say("[LC;8378]")
				pc.remove_item(30149,1)

				say_reward("[LC;8379]")
				pc.give_exp2(6000000)

				say_reward("[LC;8380]")
				pc.give_item2(71021)

				say_reward("[LC;8382]")
				pc.change_money(70000)
			   clear_letter()
			   set_state(__COMPLETE__)
		   else
			   say_title("[LC;6407]")
			   say("[LC;8383]")
			   say_item_vnum(30149)
			   			   wait()
			   say_pc_name()
				say("[LC;8384]")
				local s =  select("[LC;8385]", "[LC;8386]")
				if s == 2 then
					say_pc_name()
					say("[LC;8387]")
					clear_letter()
					set_state(__GIVEUP__)

				end
				set_state(gain_ice)
			end

		end
	end

	state __GIVEUP__ begin
	end

	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
