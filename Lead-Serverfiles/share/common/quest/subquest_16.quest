quest subquest_16 begin
	state start begin
		when login or levelup or enter with pc.level >= 25 and pc.level <= 30 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20355)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7360]")
			end
		end


		when __TARGET__.target.click or	20355.chat."[LC;7371]" with pc.level >= 25 begin
			target.delete("__TARGET__")

			say_title("[LC;4082]")
			say("[LC;7382]")
			wait()

			say_title("[LC;4082]")
			say("[LC;7391]")
			local s= select("[LC;7102]", "[LC;7200]")
			if 2==s then
				say("[LC;7286]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;4082]")
					say("[LC;7392]")
					return
				end
				say_title("[LC;4082]")
				say("[LC;7393]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;4082]")
			say("[LC;7394]")
			set_state(ask_to_youhwan)
		

		
		end
	end

	state ask_to_youhwan begin
		when info or button begin
			say_title("[LC;7395]")
			say("[LC;7396]")
		end

		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7395]")
			q.set_title("[LC;7359]")
			q.start()

			local v=find_npc_by_vnum("20017")
			if 0== v then
			else
				target.vid("__TARGET__",v, "[LC;7361]")
			end
		end

		when 20017.chat."[LC;7395]" begin
			target.delete("__TARGET__")	
			say_title("[LC;14]")
			say("[LC;7362]")
			wait()

			say_title("[LC;7363]")
			say("[LC;7364]")
			wait()

			say_title("[LC;7363]")
			say("[LC;7365]")
			set_state(ask_to_hengsang)
		end
	end

	state ask_to_hengsang begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7366]")
			q.set_title("[LC;7367]")
			q.start()

			local v=find_npc_by_vnum("20010")
			if 0== v then
			else
				target.vid("__TARGET1__",v, "[LC;7368]")
			end	
		end
		
		when info or button begin
			say_title("[LC;7395]")
			say("[LC;7369]")
		end
		
		
		when 20010.chat."[LC;7371]" begin
			target.delete("__TARGET1__")
			say_title("[LC;7370]")
			say("[LC;7372]")
			wait()
			say_title("[LC;7370]")
			say("[LC;7373]")
			wait()
			say_title("[LC;7370]")
			say("[LC;7374]")
			wait()

			say_title("[LC;7370]")
			say("[LC;7375]")
			set_state(ask_to_euldo)
		end
	end
	state ask_to_euldo begin
		when letter begin
			local v=find_npc_by_vnum("20011")
			if 0== v then
			else
				target.vid("__TARGET1__",v, "[LC;4409]")
			end
		
			setskin(NOWINDOW)
			makequestbutton("[LC;4385]")
			q.set_title("[LC;7367]")
			q.start()
		end

		when info or button begin
			say_title("[LC;7376]")
			say("[LC;7377]")
		end
		
		
		
		when 20011.chat."[LC;7395]" begin
			target.delete("__TARGET1__")
			say_title("[LC;7378]")
			say("[LC;7379]")
			wait()

			say_title("[LC;7378]")
			say("[LC;7380]")
			wait()
			say_title("[LC;7378]")
			say("[LC;7381]")
			set_state(ask_to_guard)
		end
	end

	state ask_to_guard begin
		when info or button begin
			say_title("[LC;44]")
			say("[LC;7383]")
		end
		
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7384]")
			q.set_title("[LC;7384]")
			q.start()

			local v=find_npc_by_vnum("20355")
			if 0== v then
			else
				target.vid("__TARGET__",v, "[LC;7395]")
			end
		end

		when 20355.chat."[LC;7385]" begin
			target.delete("__TARGET__")
			say_title("[LC;7386]")
			say("[LC;7387]")
			wait()
			
			say_title("[LC;7386]")
			say("[LC;7388]")
			wait()

			say_title("[LC;7386]")
			say("[LC;7389]")
			wait()
			say_title("[LC;192]")
						say_reward("[LC;7390]")
						pc.give_exp2(150000)
			pc.change_money(30000)
			pc.give_item2("17060", 1)			

			clear_letter()
			set_state(__COMPLETE__)
		end
	end
	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end

