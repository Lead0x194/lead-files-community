quest event_ramadan begin
	state start begin
		function is_running()
			return (game.get_event_flag("ramadan_drop") > 0)    --npc spawn
		end
		function reward_period()
			return (game.get_event_flag("ramadan_reward") > 0)    --reward menu appear
		end

			
		function setting()
			return {  
			["bread"]	= 30315,
			["candy"]	= 50183,
			["plate"]	= 30316,
			["iftar"]	= 30317,
			["fruit"]	= 30318,
			["box"]	    = 50182,
			["horse1"]	= 71131,
			["horse2"]	= 71132,
			["horse3"]	= 71133,
			["horse4"]	= 71134,
			["historian"]	= 33002,
			["beggar1"]	    = 33003, 
			["beggar2"]	    = 33004,
			["beggar3"]	    = 33005, 
			["beggar4"]	    = 33006, 
			["beggar5"]	    = 33007 
			}
		end
		
		when login or enter with event_ramadan.is_running() begin
			local setting = event_ramadan.setting()
			local mapIndex = pc.get_map_index()
			if mapIndex == 1 or mapIndex == 21 or mapIndex == 41 then
				if find_npc_by_vnum(setting.historian) == 0 then  
					if mapIndex == 1 then
						mob.spawn(setting.historian, 608, 617, 1, 1, 1)
					elseif mapIndex == 21 then
						mob.spawn(setting.historian, 596, 610, 1, 1, 1)
					elseif mapIndex == 41 then
						mob.spawn(setting.historian, 357, 743, 1, 1, 1)
					end
				end

				if find_npc_by_vnum(setting.beggar1) == 0 then 
				if mapIndex == 1 then
						mob.spawn(setting.beggar1, 619, 701, 1, 1, 1)
					elseif mapIndex == 21 then
						mob.spawn(setting.beggar1, 564, 613, 1, 1, 1)
					elseif mapIndex == 41 then
						mob.spawn(setting.beggar1, 344, 723, 1, 1, 1)
					end
				end
				if  find_npc_by_vnum(setting.beggar2) == 0 then 
					if mapIndex == 1 then
						mob.spawn(setting.beggar2, 697, 580, 1, 1, 1)
					elseif mapIndex == 21 then
						mob.spawn(setting.beggar2, 699, 658, 1, 1, 1)
					elseif mapIndex == 41 then
						mob.spawn(setting.beggar2, 443, 733, 1, 1, 1)
					end
				end	
				if   find_npc_by_vnum(setting.beggar3) == 0  then
					if mapIndex == 1 then
						mob.spawn(setting.beggar3, 646, 515, 1, 1, 1)
					elseif mapIndex == 21 then
						mob.spawn(setting.beggar3, 613, 715, 1, 1, 1)
					elseif mapIndex == 41 then
						mob.spawn(setting.beggar3, 428, 651, 1, 1, 1)
					end
				end
				if  find_npc_by_vnum(setting.beggar4) == 0 then
					if mapIndex == 1 then
						mob.spawn(setting.beggar4, 554, 550, 1, 1, 1)
					elseif mapIndex == 21 then
						mob.spawn(setting.beggar4, 635, 539, 1, 1, 1)
					elseif mapIndex == 41 then
						mob.spawn(setting.beggar4, 303, 587, 1, 1, 1)
					end
				end
				if  find_npc_by_vnum(setting.beggar5) == 0 then
					if mapIndex == 1 then
						mob.spawn(setting.beggar5, 702, 629, 1, 1, 1)
					elseif mapIndex == 21 then
						mob.spawn(setting.beggar5, 529, 547, 1, 1, 1)
					elseif mapIndex == 41 then
						mob.spawn(setting.beggar5, 456, 673, 1, 1, 1)
					end
				end
		end   --if
		end --when
		
		--"[LC;886]"	Historiker? 
		-- (Referenz 33002 Mob)
		when 33002.chat."[LC;886]" with pc.getf("event_ramadan","first_notice")==0  begin
			local setting = event_ramadan.setting()
			--"[LC;887]"	Historiker: (referenz auf mob: 33002)
			say_title("[LC;887]")
			-- "[LC;888]"	review the old and learn the new! why do you find me ?
			say("")
			say("[LC;888]")
			wait()

			say_pc_name()
			-- "[LC;889]"	Tut mir leid, kennen wir uns?
			say("[LC;889]")
			wait()

			say_title("[LC;887]")
			--"[LC;890]"	Entschuldige, ich vergaß mich vorzustellen. Ich bin der viel gereiste Historiker. 
			--									Wenn du Fragen zur Geschichte hast scheue dich nicht mich zu fragen.
			say("[LC;890]")
			wait()
			
			say_pc_name()
			-- "[LC;891]"	Es ehrt mich dich kennen zu lernen. Ich sollte dich öfter aufsuchen
			say("[LC;891]")
			

			pc.setqf("first_notice",1)
		end  
	
	-- Brot: Brotkringel
	-- Süßigkeit: Haloa, baklawa, irgendwas süßes (ihr wisst bescheid)
	-- "[LC;892]"	Was Süßes
	when 33002.chat."[LC;892]" with pc.getf("event_ramadan","first_notice")==1 begin
		
		local setting = event_ramadan.setting()
		if pc.count_item(setting.bread) == 0  then
			say_title("[LC;887]")
			-- "[LC;928]"	Kennst du dich mit Süßigkeiten aus? Es wird Baklava (bitte absprechen und referenz auf item: 50183) genannt.
			say("[LC;928]")
			-- "[LC;929]"	Ja, das kenne ich
			-- "[LC;930]"	Nein, tut mir leid
			local s=select("[LC;929]" ,"[LC;930]")
			if 2==s then
				--"[LC;887]"	Historiker:
				say_title("[LC;887]")
				--"[LC;893]"	Schade, bis zum nächsten mal.
				say("[LC;893]")
				return
			end
			say_title("[LC;887]")
			--"[LC;894]"	Dann weißt du ja was ich meine. Wenn ein solches erhalten willst bringe mir bitte ein Brot (bitte abspreche und referenz auf item: 30315).
			say("[LC;894]")
			wait()
			say_title("[LC;887]")
			-- "[LC;895]"	Ich würde dir gerne ein Baklava (item: 50183) für 10 Brote (item: 30315) geben. Bist du damit einverstanden?
			say("[LC;895]")
			-- "[LC;896]"	Gerne
			-- "[LC;897]"	Hab keine Zeit
			local s=select("[LC;896]","[LC;897]")
			if 2==s then
				say_title("[LC;887]")
				say("[LC;893]")
			return
			end
			say_title("[LC;887]")
			-- "[LC;898]"	Ich würde dir gerne ein Baklava (item: 50183) für 10 Brote (item: 30315) geben. Bist du damit einverstanden?
			say("[LC;898]")
		elseif	pc.count_item(setting.bread) > 0 and  pc.count_item(setting.bread) < 10  then
			say_title("[LC;887]")
			-- "[LC;899]"	Das sind zu wenig Brote, ich kann damit nicht viel anfangen.
			say("[LC;899]")
		elseif	pc.count_item(setting.bread) >= 10  then
			say_title("[LC;887]")
			-- "[LC;900]"	Das sind genug Brote, dafür kann ich dir gerne das Baklava geben.
			say("[LC;900]")
			wait()	
			say_title("[LC;887]")
			-- "[LC;901]"	Sammle mehr und ich kann dir mehr davon bereiten
			say("[LC;901]")
			pc.give_item2(setting.candy,1)
			pc.remove_item(setting.bread,10)
		end  --if
		if not event_ramadan.is_running() then
			npc.purge()
		end
	end	  --when
		-- "[LC;902]"	Leckeres Brot (item: 30315)
		when 33002.chat."[LC;902]" with pc.getqf("first_notice")== 1 begin
			local setting = event_ramadan.setting()
			say_title("[LC;887]")
			-- "[LC;903]"	Ich bin gesättigt mit dem leckeren Brot das du mir brachtest
			say("[LC;903]")
			-- "[LC;904]"	Hast du gewusst das es viele Bettler gibt die Hunger haben? Es wäre schön wenn du auch mit Ihnen das Fastenbrechen begehen würdest
			say("[LC;904]")
			-- "[LC;905]"	Bringe es Ihnen am besten auf einem Teller (bitte absprechen und refernz auf item:30316)
			say("[LC;905]")
			say_item_vnum(setting.plate)
			wait()
			say_title("[LC;887]")
			-- "[LC;906]"	Danke für dein Brot es ist gut. So eine weise Person sollte auch Barmherzig sein. Man wird es dir vergelten.
			say("[LC;906]")
		end	
		-- "[LC;907]"	Hunger ...
		when 33003.chat."[LC;907]" or 33004.chat."[LC;907]" or 33005.chat."[LC;907]" or 33006.chat."[LC;907]" or 33007.chat."[LC;907]" begin
			local setting = event_ramadan.setting()
			if pc.count_item(setting.iftar) == 0  then 
				-- "[LC;908]"	Bettler: (referenz auf Mob: 33003~33007)
				say_title("[LC;908]")
				say("")
				-- "[LC;909]"	Ich bin wirklich hungrig. Habe erbarmen und bringe mir ein Iftar (bitte mit Abdel absprechen und referenz auf item: 30317). Bitte bringe es mir, damit ich nicht verhungere.
				say("[LC;909]")

			elseif pc.count_item(setting.iftar) > 0  then 
				
				say_title("[LC;908]")
				say("")
				-- "[LC;910]"	Das ist doch ein Iftar (referenz: 30317)? Ein warmes leckeres Brot (referenz entsprechend). Willst du diese mir geben? Es wäre mir wertvoll!
				say("[LC;910]")
				-- "[LC;911]"	Nimm du Hungriger
				-- "[LC;912]"	Nein, ich behalte es
				local s = select("[LC;911]","[LC;912]")
				if 2==s then
					say_title("[LC;908]")
					say("")
					-- "[LC;913]"	Du Unbarmherziger sei nicht so geizig mit deinem Essen. Falls du deine Meinung änderst, weißt du wo du mich findest.
					say("[LC;913]")
					return
				end
				-- reward
				say_title("[LC;908]")
				say("")
				-- "[LC;914]"	Es sei dir gedankt. Du bist wahrlich eine weise Person. Möge deine gute Tat hiermit belohnt sein.
				say("[LC;914]")
				
				pc.give_item2(setting.box,1)
				pc.remove_item(setting.iftar,1)
				end --if

				if not event_ramadan.is_running() then
					npc.purge()
				end
			end	
		
		-- "[LC;915]"	Die Frucht des Segens
		when 33002.chat."[LC;915]" with  pc.getf("event_ramadan","fig_exchange")==0 begin
			local setting = event_ramadan.setting()
			if get_time() > pc.getqf("duration") then
				say_title("[LC;887]")
				say("")
				-- "[LC;916]"	Ich hab auf meinen Reisen die "Frucht des Segens" (bitte Item: 30318 referenzien und ändern) kennen gelernt. Diese Frucht belohnt den Fleißigen der regelmäßig zur selben Stunde wiederkehrt.
				say("[LC;916]")
				pc.give_item2(setting.fruit)
				pc.setqf("duration",get_time()+60*60*24) 			--24h
			else	
				say_title("[LC;887]")
				-- "[LC;917]"	Entschuldige, dich hab ich heute gesehen und du wurdest schon belohnt. Denk daran: Nur der wahrlich geduldige erreicht sein Ziel.
				say("[LC;917]")
			end
		end
		-- "[LC;918]"	Das Glück des Tüchtigen
		when 33002.chat."[LC;918]" with event_ramadan.reward_period() and  pc.getf("event_ramadan","fig_exchange")==0 begin
			local setting = event_ramadan.setting()
			say_title("[LC;887]")
			say("")
			-- "[LC;919]"	Ich habe dich schon erwartet. Meine Zeit hier geht zu Ende und ich ziehe in die Welt um neue Geschichten zu lernen.
			say("[LC;919]")
			wait()
			if  pc.count_item(setting.fruit)>= 5 then		--more than 5
				say_title("[LC;887]")
				say("")
				-- "[LC;920;%d]"	Du hast %d Früchte des Segens (Item: 30318) für mich verwahrt.
				say(string.format("[LC;920;%d]", pc.count_item(setting.fruit)))
				-- "[LC;921]"	Würdest du mir diese geben für meine Reise? Ich will es dir auch entlohnen.
				say("[LC;921]")
				-- "[LC;922]"	Hier nimm
				-- "[LC;923]"	Nein
				local s=select("[LC;922]", "[LC;923]")
				if 2==s then 
					say_title("[LC;887]")
					say("")
					-- "[LC;924]"	Überlege es dir und ich warte auch dich.
					say("[LC;924]")
					return
				end
				say_title("[LC;887]")
				say("")
				-- "[LC;925]"	Danke für deine Großzügigkeit und deinen Fleiß. Bitte nehme dieses:
				say("[LC;925]")
				-- Item: Siegel des Rappen
				-- "[LC;926]"	Siegel des Rappen (referenz auf items:71131~4)
				say_reward("[LC;926]")
				say("")
				if pc.count_item(setting.fruit)>= 5 and pc.count_item(setting.fruit)<= 10 then
					pc.give_item2(setting.horse1,1)
				elseif pc.count_item(setting.fruit)>= 11 and pc.count_item(setting.fruit)<= 19 then
					pc.give_item2(setting.horse2,1)
				elseif pc.count_item(setting.fruit)>= 20 and pc.count_item(setting.fruit)<= 27 then
					pc.give_item2(setting.horse3,1)
				elseif pc.count_item(setting.fruit)>= 28 then
					pc.give_item2(setting.horse4,1)
				end
				pc.remove_item(setting.fruit,pc.count_item(setting.fruit))
				pc.setqf("fig_exchange",1)
			else										--less  than  5
				say_title("[LC;887]")
				say("")
				-- "[LC;927]"	Du hast weniger als 5? Schade damit kann ich nicht viel anfangen. Vielleicht beim nächsten mal.
				say("[LC;927]")
			end
	end
	when 30316.use begin
		local setting = event_ramadan.setting()
		if pc.count_item(setting.bread) >= 10 then
			pc.remove_item(setting.bread, 10)
			pc.remove_item(setting.plate, 1)
			pc.give_item2(setting.iftar, 1)
		end
	end

	end --state
end		--quest