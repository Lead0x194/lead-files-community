
quest subquest_37 begin
	state start begin
		when login or levelup with pc.level >= 51 and pc.level <= 53 begin
			set_state(information)
		end

	end

	state information begin
		when letter begin
					
			local v = find_npc_by_vnum(20005)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7998]")
			end
		end

		
		when __TARGET__.target.click or	20005.chat."[LC;7998]" with pc.level >= 51 begin
			target.delete("__TARGET__")

			say_title("[LC;8009]")
			say("[LC;8020]")
			wait()
			say_title("[LC;6969]")
			say("[LC;8027]")
			local s= select("[LC;6997]", "[LC;7811]")
			if 2==s then
				say("[LC;8028]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;8009]")
					say("[LC;8029]")
					return
				end
				say_title("[LC;6969]")
				say("[LC;8030]")
				set_state(__GIVEUP__)
				return
			end

			say_title("[LC;6969]")
			say("[LC;8031]")
			set_state(ask_to_eulduji)


		end
	end

	state ask_to_eulduji begin
		when letter begin
			send_letter("[LC;7998]")
		end

		when letter begin
			local v=find_npc_by_vnum(20011)
			if 0== v then
			else
				target.vid("__TARGET__",v, "[LC;8032]")
			end

		end

		when info or button begin
			say_title("[LC;4385]")
			say("[LC;7997]")
		end

		when __TARGET__.target.click or 20011.chat."[LC;7999]" begin
			target.delete("__TARGET__")
			say_title("[LC;8000]")

			say("[LC;8001]")
			set_state(ask_to_sunyougil)
		end
	end

	state ask_to_sunyougil begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8002]")
			q.set_title("[LC;8002]")
			q.start()

			local v=find_npc_by_vnum(20023)
			if 0== v then
			else
				target.vid("__TARGET__",v, "[LC;8003]")
			end

		end

		when info or button begin
			say_title("[LC;7998]")
			say("[LC;8004]")
		end

		when __TARGET__.target.click or 20023.chat."[LC;7999]" begin
			target.delete("__TARGET__")
			say_title("[LC;8005]")
			say("[LC;8006]")
			wait()
			say_title("[LC;7093]")
			say("[LC;8007]")
			set_state(to_seller)
		end
	end
	
	state to_seller begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8008]")
			q.set_title("[LC;8008]")
			q.start()

			local v=find_npc_by_vnum(20010)
			if 0== v then
			else
				target.vid("__TARGET__",v, "[LC;8010]")
			end

		end

		when info or button begin
			say_title("[LC;7998]")
			say("[LC;8011]")
		end

		when __TARGET__.target.click or 20010.chat."[LC;8012]" begin
			target.delete("__TARGET__")
			say_title("[LC;4232]")
			say("[LC;8013]")
			set_state(back_to_bookbug)
		end
	end

	state back_to_bookbug begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;7075]")
			q.set_title("[LC;8014]")
			q.start()

			local v=find_npc_by_vnum(20023)
			if 0!= v then
				target.vid("__TARGET__",v, "[LC;8015]")
			end
		end

		when info or button begin
			say_title("[LC;8015]")
			say("[LC;8016]")
		end

		when __TARGET__.target.click or	20023.chat."[LC;8017]" begin
			target.delete("__TARGET__")
			say_title("[LC;7093]")
			say("[LC;8018]")
			
			pc.give_item2(30160)
			set_state(back_to)
		end
	end

	state back_to begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8019]")
			q.set_title("[LC;8019]")
			q.start()
			
			local v=find_npc_by_vnum(20005)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;8021]")
			end
		end

		when info or button begin
			say_title("[LC;7998]")
			say("[LC;8022]")
		end
		
		when __TARGET__.target.click or	20005.chat."[LC;7998]" begin
			target.delete("__TARGET__")
			say_title("[LC;6969]")
			say("[LC;8023]")
			pc.remove_item(30160,1)

			say_reward("[LC;8024]")
			pc.change_money(35000)
			
			say_reward("[LC;8025]")
			pc.give_exp2(2500000)
			
			say_reward("[LC;8026]")
			pc.give_item2(15143)
			clear_letter()	
			set_state(__COMPLETE__)
			return
				
		end
	
	end
	state __GIVEUP__ begin
	end
	
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
