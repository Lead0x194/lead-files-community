quest subquest_24 begin
    state start begin
		when login or levelup with pc.level >=39 and pc.level <=41 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20012)
			if 0==v then
			else
				target.vid("__TARGET__",v, "[LC;7622]")
			end
		end
		
		when __TARGET__.target.click or 20012.chat."[LC;7633]"  begin
			target.delete("__TARGET__") 
			say_pc_name()
			say("[LC;7644]")
			wait()
			say_title("[LC;7208]")
			say("[LC;7651]")
			wait()
			say_pc_name()
			say("[LC;7652]")
			wait()
			say_title("[LC;7208]")
			say("[LC;7653]")
			say_item_vnum(30158)
						local s= select("[LC;7654]", "[LC;7655]")

			if 2==s then
				say_title("[LC;7656]")
				say("[LC;7621]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;7208]")
					say("[LC;7623]")
					return
				end
				say_title("[LC;7208]")
				say("[LC;7624]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7208]")
			say("[LC;7625]")
			set_state(accept)
    	end
      end
    state accept begin
		when letter begin
			send_letter("[LC;7626]")
		end
		
		when button or info begin
			say_title("[LC;7626]")
			say("[LC;7627]")
			say_reward("[LC;7628]")
					end
		
		when 20012.chat."[LC;7629]" begin
			if get_time() < pc.getqf("limit_time") then 
				say_title("[LC;7208]")
				say("[LC;7630]")
				local s= select("[LC;7631]", "[LC;7632]") 
				if 2==s then
					say_title("[LC;7208]")
					say("[LC;7634]")
					local s= select("[LC;7635]", "[LC;7636]")
					if 2==s then
						say_title("[LC;7208]")
						say("[LC;7637]")
						set_state(__GIVEUP__)
						return 
					end
					say_title("[LC;7208]")
					say("[LC;7638]")
					return
				end
				say_title("[LC;7208]")
				say("[LC;7639]")
				return
			end
			say_title("[LC;7208]")
			say("[LC;7640]")
			set_state(__FAIL__)
		end

		when enter begin
		    pc.setqf("limit_time", get_time()+30*60)
		    pc.setqf("kill_count", 0)
		end
	
		when leave begin
		    pc.setqf("limit_time", 0)
		    pc.setqf("kill_count", 0)
		    q.done()
		end
		when letter begin
		    local rest_time=pc.getqf("limit_time")-get_time()
			 timer("time_over", rest_time) 
			 q.set_clock("Time left", rest_time)
		end
		when time_over.timer begin
		    say_title("[LC;44]")
		    say("[LC;7641]")
		    say_reward("[LC;7642]")
			set_state(__FAIL__)
		    q.done()
																																															end
																																															when 2001.kill begin
		    local cur_kill_count=pc.getqf("kill_count")+1
		    pc.setqf("kill_count", cur_kill_count)

		    if cur_kill_count>=number(30, 40) then
				pc.give_item2(30158)
				set_state(report)
		    end
		end


		
	end
	state report begin
		when letter begin
			send_letter("[LC;7643]")
			
			local v=find_npc_by_vnum(20012)
			if v!=0 then
				target.vid("__TARGET__", v, "[LC;7645]")
			end

		end
		when button or info begin
			say_title("[LC;7643]")
			say("[LC;7646]")
		end
		
		when __TARGET__.target.click or	20012.chat."[LC;7647]" with pc.count_item(30158) >0  begin
			target.delete("__TARGET__")
			say_title("[LC;7208]")
			say("[LC;7648]")
			say_title("[LC;192]")
						say_reward("[LC;7649]")
			pc.remove_item(30158)
			pc.change_money(25000)
			say_reward("[LC;7650]")
			pc.give_exp2(900000)
			
			clear_letter()
			set_state(__COMPLETE__)
		end
	end
	state __FAIL__ begin
	end
    state __GIVEUP__ begin
    end
    state __COMPLETE__ begin
		when enter begin
			q.done()
		end
    end
end

