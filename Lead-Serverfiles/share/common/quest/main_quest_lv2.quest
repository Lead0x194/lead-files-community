quest main_quest_lv2 begin
	state start begin
	end
	state run begin
		when login or levelup or enter with pc.get_level() >= 2 begin
			set_state ( gototeacher )
		end
		when 20354.chat."[LC;4153]" with pc.get_level() < 2 begin
			say_title("[LC;4066]")
			say("[LC;4166]")
		end
	end
	state gototeacher begin
		when letter begin

			send_letter("[LC;4170]")
			local v=find_npc_by_vnum(20354)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4171]")
			end
		end
		when button or info begin
			say_title("[LC;4170]")
						say_reward("[LC;4172]")
					end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;4066]")
			say("[LC;4173]")
			wait()

			say_title("[LC;4066]")
			say("[LC;4174]")
			wait()
			say_title("[LC;44]")
						say_reward("[LC;4175]")
say_reward(string.format("[LC;4176;%s;%s]",item_name(27001), 15))
			say_item(item_name(27001),27001,"")
						set_state ( killdog )	

			pc.setqf("state", 0)
			q.set_counter("[LC;4177]", 0)
		end

	end

	state killdog begin
		when letter begin
			send_letter("[LC;4152]")
		end
		when button or info begin
			say_title("[LC;4154]")
			say("[LC;4155]")
			say_reward(string.format("[LC;4156;%s]", pc.getqf("state")))
		end
		when 101.kill begin
			local count = pc.getqf("state") + 1

			if count <= 9 then
				pc.setqf("state", count)
				q.set_counter("[LC;4157]", 9 - count)

				if count == 9 then
					say_title("[LC;4158]")
					say("[LC;4159]")
					set_state (gototeacher2)
				end
			end
		end
		when 20354.chat."[LC;4160]" with pc.getqf("state") < 9 begin
			say_title("[LC;4066]")

			say("[LC;4161]")
			if pc.is_gm() then
				wait()
				say_title("[LC;4162]")
				say("[LC;4163]")
				local s =  select("[LC;2059]", "[LC;2035]")
				if s == 1 then
					set_state (gototeacher2)
				end
			end
		end
		when 20354.chat."[LC;4160]" with pc.getqf("state") >= 9 begin
			say_title("[LC;4066]")
			say("[LC;4164]")
			set_state (gototeacher2)
		end
	end
	state gototeacher2 begin
		when letter begin
			local v=find_npc_by_vnum(20354)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;4171]")
			end
		end
		when letter begin
			send_letter("[LC;4165]")
		end
		when button or info begin
			say_title("[LC;4165]")
						say_reward("[LC;4159]")
					end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")

			say_title("[LC;4066]")
			say("[LC;4167]")
			wait()
			say_title("[LC;192]")
						say_reward("[LC;4168]")
say_reward(string.format("[LC;4169;%s;%s]", item_name(27001), 15))
			say_item(item_name(27001),27001,"")


						pc.give_exp2( 250 )
			pc.change_money( 1000 )
			pc.give_item2( 27001 ,15 ) 
			pc.setqf("state", 0)
			
			clear_letter()
			set_state (__COMPLETE__)
			set_quest_state("main_quest_lv3","run")
			
		end
	end
	state __COMPLETE__ begin
	end
end


