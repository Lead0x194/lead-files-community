				pc.remove_item ( ITEM7_1, pc.count_item(ITEM7_1))	
				
				say_title(mob_name(GUARD))
				say("[LC;4757]")
				wait()
				
				say_title(locale.reward)
				say_reward(string.format ("[LC;4537;%d]", REWARD7_EXP))
				say_reward(string.format ("[LC;4538;%d]", REWARD7_GOLD))
				say_reward(string.format ("[LC;4540;%s]", item_name(REWARD7_ITEM1),REWARD7_ITEM1_COUNT,locale.count_postfix))
				say_reward(string.format ("[LC;4540;%s]", item_name(REWARD7_ITEM2),REWARD7_ITEM2_COUNT,locale.count_postfix))
				say("")
				say_title("[LC;4770]")
				
				pc.give_exp2(REWARD7_EXP)
				pc.change_money(REWARD7_GOLD)
				pc.give_item2(REWARD7_ITEM1, REWARD7_ITEM1_COUNT)
				pc.give_item2_select(REWARD7_ITEM2)
				item.set_socket(2, 120)
				
				clear_letter()
				set_quest_state ("main_quest_lv91", "state0")
				set_state (__COMPLETE__)
			else
				say_title(mob_name(GUARD))
				say("[LC;4751]")
			end
		end
		
		when MOB7_1.kill or MOB7_2.kill or MOB7_3.kill or MOB7_4.kill or MOB7_5.kill or MOB7_6.kill or MOB7_7.kill begin
			if number(1,ITEM7_1_PCT_GET) == 1 then
				if pc.count_item(ITEM7_1) < ITEM7_1_NEEDED then
					pc.give_item2(ITEM7_1, 1)
					
					local remain =  ITEM7_1_NEEDED - pc.count_item(ITEM7_1)
					if remain < 0 then
						remain = 0
					end
					q.set_counter_value(remain)
					
					if pc.count_item(ITEM7_1) >= ITEM7_1_NEEDED then
						notice_multiline("[LC;4754]",notice)
						notice_multiline("[LC;4755]",notice)
						set_state (state7_3)
					end
				end
			end
		end
	end
	state state7_3 begin
	
		when letter begin
			send_letter("[LC;4855]")
			
			local v = find_npc_by_vnum(GUARD)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(GUARD))
			end
			q.set_counter_name("")
		end
		
		when button or info begin
			say_title("[LC;4855]")
			say("[LC;4756]")
		end
		
		when MOB7_1.kill or MOB7_2.kill or MOB7_3.kill or MOB7_4.kill or MOB7_5.kill or MOB7_6.kill or MOB7_7.kill begin
			if number(1,ITEM7_1_PCT_GET) == 1 then
				if pc.count_item(ITEM7_1) < ITEM7_1_NEEDED then
					pc.give_item2(ITEM7_1, 1)
					
					local remain =  ITEM7_1_NEEDED - pc.count_item(ITEM7_1)
					if remain < 0 then
						remain = 0
					end
					
					if pc.count_item(ITEM7_1) >= ITEM7_1_NEEDED then
						notice_multiline("[LC;4754]",notice)
						notice_multiline("[LC;4755]",notice)
					end
				end
			end
		end
		
		when GUARD.chat."[LC;4740]" begin
			target.delete("__TARGET__")
			
			if pc.count_item(ITEM7_1) >= ITEM7_1_NEEDED then
				pc.remove_item ( ITEM7_1, pc.count_item(ITEM7_1))	
				
				say_title(mob_name(GUARD))
				say("[LC;4757]")
				wait()
				
				say_title(locale.reward)
				say_reward(string.format ("[LC;4537;%d]", REWARD7_EXP))
				say_reward(string.format ("[LC;4538;%d]", REWARD7_GOLD))
				say_reward(string.format ("[LC;4540;%s]", item_name(REWARD7_ITEM1),REWARD7_ITEM1_COUNT,locale.count_postfix))
				say_reward(string.format ("[LC;4540;%s]", item_name(REWARD7_ITEM2),REWARD7_ITEM2_COUNT,locale.count_postfix))
				say("")
				say_title("[LC;4770]")
				
				pc.give_exp2(REWARD7_EXP)
				pc.change_money(REWARD7_GOLD)
				pc.give_item2(REWARD7_ITEM1, REWARD7_ITEM1_COUNT)
				pc.give_item2_select(REWARD7_ITEM2)
				item.set_socket(2, 120)
				
				clear_letter()
				set_quest_state ("main_quest_lv91", "state0")
				set_state (__COMPLETE__)
			else
				say_title(mob_name(GUARD))
				say("[LC;4751]")
				
				set_state (state7_2)
			end
		end
	end
	
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
