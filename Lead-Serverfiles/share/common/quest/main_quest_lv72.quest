define mysterious_man 20369
define memorial_stone 20372
define ancient_doc 31002
define ancient_rubbing 30160
define ice_golem 1107
define ice_gaint 1106
define ice_man 1105
define blue_bead 31005
define blue_bead_drop_rate 100
define blue_bead_report_term 86400
define blue_bead_can_report_num 10
define blue_beads_num 50
define pass_pct 60
quest main_quest_lv72 begin
    state start begin
    end
    state state_0 begin
        when login or levelup or enter with pc.level >= 72 begin
            set_state (state_1)
        end
    end
    state state_1 begin
        when letter begin
            local v = find_npc_by_vnum (mysterious_man)
            if v != 0 then
                target.vid ("__TARGET__",v,"")
            end
            send_letter("[LC;4655]")
        end
        when button or info begin
            say_title("[LC;4655]")
            say ("[LC;4666]")
        end
        when mysterious_man.chat."[LC;4655]" begin
            target.delete("__TARGET__")
            say_title ("[LC;4590]")
            say("[LC;4677]")
            wait()
            say_title ("[LC;4590]")
            say("[LC;4678]")
            wait()
            say_title ("[LC;4590]")
            say("[LC;4679]")
            set_state (state_2)
        end
    end
    state state_2 begin
        when letter begin
            local v = find_npc_by_vnum (memorial_stone)
            if v != 0 then
                target.vid ("__TARGET__",v,"")
            end
            send_letter("[LC;4680]")
        end
        when button or info begin
            say_title("[LC;4680]")
            say ("[LC;4681]")
        end
        when memorial_stone.click begin
            target.delete("__TARGET__")
            say("[LC;4682]")
            wait()
            say_title(mob_name(memorial_stone))
            say("[LC;4683]")
            wait()
            say_title(mob_name(memorial_stone))
            say("[LC;4654]")	
            wait()
            say("[LC;4656]")
            pc.give_item2 (ancient_rubbing, 1)
            set_state (report_discovery)
        end
    end
    state report_discovery begin
        
        when button or info begin
            return
        end
        
        when mysterious_man.chat."[LC;4680]" begin
            pc.remove_item (ancient_rubbing)
            say_title ("[LC;4590]")
            say("[LC;4657]")
            wait()
            say_title ( pc.getname())
            say("[LC;4658]")
            wait()
            say_title ("[LC;4590]")
            say("[LC;4659]")
            wait()
            say_title ( pc.getname())
            say("[LC;4660]")
            wait()
            say_title ("[LC;4590]")
            say("[LC;4661]")
            wait()
            say_title ("[LC;4590]")
            say("[LC;4662]")
            wait()
            
            if number (1,2) == 1 then
                drug = 30009
            else
                drug = 30083
            end
            say_title (locale.reward)
            say_reward(string.format("[LC;4537;%d]", 3100000))
            say_reward(string.format("[LC;4540;%s]", item_name(70005)))
            say_reward(string.format("[LC;4540;%s]", item_name(drug)))
            say_reward(string.format("[LC;4540;%s]", item_name(30039)))

            pc.give_exp2(3100000)
            
            pc.give_item2(70005)
            pc.give_item2(drug)
            pc.give_item2(30039)
            
            set_state (state_4)
        end
    end
    state state_4 begin
        when letter begin
            local v = find_npc_by_vnum (mysterious_man)
            if v != 0 then
                target.vid ("__TARGET__",v,"")
            end
            send_letter("[LC;4663]")
        end
        when button or info begin
            say_title("[LC;4663]")
            say("[LC;4664]")
        end
        when mysterious_man.chat."[LC;4663]" begin
            target.delete("__TARGET__")
            say_title ("[LC;4590]")
            say("[LC;4665]")
            wait()
            say_title ("[LC;4590]")
            say("[LC;4667]")
            wait()
            say_title ("[LC;4590]")
            say("[LC;4668]")
            pc.setqf ("collect_beads", 0)

            set_state (state_5)
        end
    end
    state state_5 begin
        when letter begin
            send_letter("[LC;4663]")
        end
        when button or info begin
            say_title("[LC;4663]")
            say("[LC;4664]")
        end

        when ice_man.kill or ice_gaint.kill or ice_golem.kill begin
            if number(1, blue_bead_drop_rate) > 1 then 
                return
            end

            local n = pc.getqf ("pass_beads")
            local i = pc.count_item (blue_bead)
            if n < blue_beads_num and pc.count_item (blue_bead) < blue_beads_num - n then
                notice_multiline("[LC;4670]", notice)
                notice_multiline(string.format("[LC;4671;%d]", blue_beads_num - n - 1), notice)
                pc.give_item2 (blue_bead, 1)
            end
        end

        when mysterious_man.chat."[LC;4663]" with pc.count_item (blue_bead) > 0 begin
            local now = get_global_time()
            local today = now - math.mod (now, blue_bead_report_term)
            local can_report_num
            if pc.getqf ("last_access_date") != today then
                pc.setqf ("last_access_date", today)
                pc.setqf ("blue_bead_todays_report_num", 1)
            else
                local reported_num = pc.getqf("blue_bead_todays_report_num")
                
                if blue_bead_can_report_num - reported_num <= 0 then
                    say("[LC;4672]")
                    return
                else
                    if not pc.is_gm() then 
                        pc.setqf ("blue_bead_todays_report_num", reported_num + 1)
                    end
                end
            end

            pc.remove_item (blue_bead, 1)
            local n = pc.getqf("pass_beads")
            if number (1,100) > pass_pct then
                say_title (mob_name(mysterious_man))
                say("[LC;4673]")
                return
            elseif n < blue_beads_num -1 then
                pc.setqf ("pass_beads", n + 1)
                say_title ("[LC;4590]")
                say (string.format("[LC;4674;%d]", blue_beads_num - n - 1))
            else
                pc.setqf("pass_beads", 0)
                say_title("[LC;4590]")
                say("[LC;4675]")						
                wait()
                say_title (locale.reward)
                say_reward(string.format("[LC;4537;%d]", 20000000))
                say_reward(string.format("[LC;4538;%d]", 225000))
                say_reward(string.format("[LC;4540;%s]", item_name(71035).." ".."3"..locale.count_postfix))
                say_reward(string.format("[LC;4540;%s]", item_name(70043)))
                say_reward(string.format("[LC;4540;%s]", item_name(72024)))

                pc.give_exp2(20000000)
                pc.change_money(225000)
                
                pc.give_item2(71035) 
                pc.give_item2(71035) 
                pc.give_item2(71035) 
                pc.give_item2(70043) 
                pc.give_item2(72024)

                wait()
                say("[LC;4676]")
                set_state (__COMPLETE__)
                q.done()
                set_quest_state ("main_quest_lv78", "state_0")
            end
        end
    end

    state __COMPLETE__ begin
    end
end
