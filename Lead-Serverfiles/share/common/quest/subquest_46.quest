
quest subquest_46 begin
	state start begin
		when login  or levelup with pc.level >= 53 and pc.level <= 56 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin

			local v = find_npc_by_vnum(20005)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;8256]")
			end
		end



		when __TARGET__.target.click or	20005.chat."[LC;8256]" begin
			target.delete("__TARGET__")
			say_title("[LC;6969]")
			say("[LC;8266]")
			wait()
			say_title("[LC;6969]")
			say("[LC;8267]")
			wait()
			say_title("[LC;6969]")
			say("[LC;8268]")

			local s= select("[LC;8269]", "[LC;8270]")
			if 2==s then
				say("[LC;8271]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;6969]")
					say("[LC;8272]")
					return
				end
				say_title("[LC;6969]")
				say("[LC;8273]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;6969]")
			say("[LC;8255]")
			set_state(to_get_material)
		end

	end


	state to_get_material begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;8257]")
			q.set_title("[LC;8258]")
			q.start()

			if pc.count_item("50611")>0 and pc.count_item("30138")>0 and pc.count_item("30137")>0 then
				local v = find_npc_by_vnum(20005)

				if v != 0 then
					target.vid("__TARGET__", v, "[LC;8256]")
				end
			end


		end

		when button or info begin
			if pc.count_item("50611") >= 1  and  pc.count_item("30137") >= 1 and pc.count_item("30138") >= 1 then
				say_title("[LC;8256]")
				say("[LC;8259]")
				return
			end

			say_title("[LC;8256]")
			say("[LC;8260]")


		end



		when 2108.kill  begin	--der zugellose Mensch in der Wuste
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30138")==0  then
				pc.give_item2("30138", 1)

				if pc.count_item("50611")>0 and pc.count_item("30137")>0 then
					local v = find_npc_by_vnum(20005)
					if v != 0 then
						target.vid("__TARGET__", v, "[LC;8261]")
					end
				end
			end

		end


		when 5125.kill or 5126.kill  begin --Der Gewinn der Affeblut
			local s = number(1, 100)
			if s <= 5 and pc.count_item("30137")==0  then
				pc.give_item2("30137", 1)

				if pc.count_item("50611")>0 and pc.count_item("30138")>0 then
					local v = find_npc_by_vnum(20005)

					if v != 0 then
						target.vid("__TARGET__", v, "[LC;8256]")
					end
				end

			end
		end


		when __TARGET__.target.click or	20005.chat."[LC;8262]" with  pc.count_item("50611") >= 1  and  pc.count_item("30137") >= 1 and pc.count_item("30138") >= 1 begin
				target.delete("__TARGET__")
				say_title("[LC;6969]")
				say("[LC;8263]")

				pc.remove_item("50611",1)
				pc.remove_item("30137",1)
				pc.remove_item("30138",1)

				say_reward("[LC;8264]")
				pc.give_exp2(3000000)
				set_quest_state("levelup","run")

				say_reward("[LC;8265]")
				pc.change_money(30000)

				clear_letter()
				set_state(__THEEND__)



	end
end
	state __GIVEUP__ begin
	end
	state __THEEND__ begin
		when enter begin
		end
	end
end


