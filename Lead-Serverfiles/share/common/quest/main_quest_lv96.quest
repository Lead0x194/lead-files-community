			-- say_reward(locale.main_quest_lv96.pos_info)
			-- select("[LC;4853]")
			-- setskin(NOWINDOW)
			-- clearmapsignal()
		end
		
		when GUARD.chat."[LC;5280]" begin
			say_title(mob_name(GUARD ))
			say("[LC;5289]")
			say("")
		end
		
		when MOB4_1.kill begin
			pc.setqf("kill_tree1",1)
			if pc.getqf("kill_tree1") == 1 and pc.getqf("kill_tree2") == 1 and pc.getqf("kill_tree3") == 1 then
				notice_multiline("[LC;5290]",notice)
				notice_multiline("[LC;5291]",notice)
				set_state (state4_3)
			end
			
			local remain1 = MOB4_1_COUNT - pc.getqf("kill_tree1")
			if remain1 < 0 then
				remain1 = 0
			end
			local remain2 = MOB4_2_COUNT - pc.getqf("kill_tree2")
			if remain2 < 0 then
				remain2 = 0
			end
			local remain3 = MOB4_3_COUNT - pc.getqf("kill_tree3")
			if remain3 < 0 then
				remain3 = 0
			end
			q.set_counter_value(remain1 + remain2 + remain3)
			
		end
		
		when MOB4_2.kill begin
			pc.setqf("kill_tree2",1)
			if pc.getqf("kill_tree1") == 1 and pc.getqf("kill_tree2") == 1 and pc.getqf("kill_tree3") == 1 then
				notice_multiline("[LC;5290]",notice)
				notice_multiline("[LC;5291]",notice)
				set_state (state4_3)
			end
			local remain1 = MOB4_1_COUNT - pc.getqf("kill_tree1")
			if remain1 < 0 then
				remain1 = 0
			end
			local remain2 = MOB4_2_COUNT - pc.getqf("kill_tree2")
			if remain2 < 0 then
				remain2 = 0
			end
			local remain3 = MOB4_3_COUNT - pc.getqf("kill_tree3")
			if remain3 < 0 then
				remain3 = 0
			end
			q.set_counter_value(remain1 + remain2 + remain3)
		end
		
		when MOB4_3.kill begin
			pc.setqf("kill_tree3",1)
			if pc.getqf("kill_tree1") == 1 and pc.getqf("kill_tree2") == 1 and pc.getqf("kill_tree3") == 1 then
				notice_multiline("[LC;5290]",notice)
				notice_multiline("[LC;5291]",notice)
				set_state (state4_3)
			end
			local remain1 = MOB4_1_COUNT - pc.getqf("kill_tree1")
			if remain1 < 0 then
				remain1 = 0
			end
			local remain2 = MOB4_2_COUNT - pc.getqf("kill_tree2")
			if remain2 < 0 then
				remain2 = 0
			end
			local remain3 = MOB4_3_COUNT - pc.getqf("kill_tree3")
			if remain3 < 0 then
				remain3 = 0
			end
			q.set_counter_value(remain1 + remain2 + remain3)
		end
	end
	state state4_3 begin
		when letter begin
			send_letter("[LC;5280]")
			
			local v = find_npc_by_vnum(GUARD)
			if 0 != v then
				target.vid("__TARGET__", v, mob_name(GUARD))
			end
			q.set_counter_name("")
		end
		when button or info begin
			say_title("[LC;5280]")
			say("[LC;5292]")
			say("")
			
			say("")
		end
		
		when GUARD.chat."[LC;5280]" begin
			target.delete("__TARGET__")
			
			say_title(mob_name(GUARD ))
			say("[LC;5293]")
			say("")
			wait()
			say_title(mob_name(GUARD ))
			say("[LC;5294]")
			say("")
			wait()
			
			say_title(locale.reward)
			say_reward(string.format ("[LC;4537;%d]", REWARD4_EXP))
			say_reward(string.format ("[LC;4538;%d]", REWARD4_GOLD))
			say("")
			say_title("[LC;5295]")
			
			pc.give_exp2(REWARD4_EXP)
			pc.change_money(REWARD4_GOLD)
			
			clear_letter()
            if pc.count_item(ITEM3_2) > 1 then
                pc.remove_item(ITEM3_2,pc.count_item(ITEM3_2))
            end
			set_quest_state ("main_quest_lv97", "state0")
			set_state (__COMPLETE__)
		end
	end
	
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
