	state start begin
		when 20300.chat."[LC;6517]"
			or 20301.chat."[LC;6517]"
			with pc.get_empire()==1 and pc.job==0 and pc.level<=5 begin
			setstate(accept)
		end
		when 20302.chat."[LC;6517]"
			or 20303.chat."[LC;6517]"
			with pc.get_empire()==1 and pc.job==1 and pc.level<=5 begin
			setstate(accept)
		end
		when 20304.chat."[LC;6517]"
			or 20305.chat."[LC;6517]"
			with pc.get_empire()==1 and pc.job==2 and pc.level<=5 begin
			setstate(accept)
		end
		when 20306.chat."[LC;6517]"
			or 20307.chat."[LC;6517]"
			with pc.get_empire()==1 and pc.job==3 and pc.level<=5 begin
			setstate(accept)
		end
		when 20320.chat."[LC;6517]"
