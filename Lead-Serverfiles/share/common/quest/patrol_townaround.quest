			with pc.get_empire()==2 and pc.job==0 and pc.level<=5 begin
			setstate(accept)
		end
		when 20322.chat."[LC;6517]"
			or 20323.chat."[LC;6517]"
			with pc.get_empire()==2 and pc.job==1 and pc.level<=5 begin
			setstate(accept)
		end
		when 20324.chat."[LC;6517]"
			or 20325.chat."[LC;6517]"
			with pc.get_empire()==2 and pc.job==2 and pc.level<=5 begin
			setstate(accept)
		end
		when 20326.chat."[LC;6517]"
			or 20327.chat."[LC;6517]"
			with pc.get_empire()==2 and pc.job==3 and pc.level<=5 begin
			setstate(accept)
		end
		when 20340.chat."[LC;6517]"
			or 20341.chat."[LC;6517]"
			with pc.get_empire()==3 and pc.job==0 and pc.level<=5 begin
			setstate(accept)
		end
		when 20342.chat."[LC;6517]"
			or 20343.chat."[LC;6517]"
			with pc.get_empire()==3 and pc.job==1 and pc.level<=5 begin
			setstate(accept)
		end
		when 20344.chat."[LC;6517]"
			or 20345.chat."[LC;6517]"
			with pc.get_empire()==3 and pc.job==2 and pc.level<=5 begin
			setstate(accept)
		end
		when 20346.chat."[LC;6517]"
			or 20347.chat."[LC;6517]"
			with pc.get_empire()==3 and pc.job==3 and pc.level<=5 begin
			setstate(accept)
		end
	end
	state accept begin
		function get_title()
			if pc.get_empire() == 1 then
				return "[LC;6518]"
			elseif pc.get_empire() == 2 then
				return "[LC;6523]"
			elseif pc.get_empire() == 3 then
				return "[LC;6525]"
			end
		end
		when letter begin
			setskin(NOWINDOW)
			local title = patrol_townaround.get_title()
			makequestbutton(title)
			q.set_title(title)

			q.start()
		end
		when button or info begin
			if pc.get_empire() == 1 then
				say_title("[LC;6518]")
				if is_test_server() then
					local s= select("[LC;6519]", "[LC;6520]", "[LC;6521]", "[LC;6522]")
					if 1==s then
						setstate(patrol1_blue_step1)
					elseif 2==s then
						setstate(patrol1_yellow_step1)
					elseif 3==s then
						setstate(patrol1_gray_step1)
					elseif 4==s then
						setstate(patrol1_purple_step1)
					end
				else
					local s=number(1, 4)
					if 1>=s then -- 80.00% (1/4)
						setstate(patrol1_blue_step1)
					elseif 2>=s then --80,00% (1/4)
						setstate(patrol1_yellow_step1)
					elseif 3>=s then --80,00% (1/4)
						setstate(patrol1_gray_step1)
					elseif 4>=s then -- 80.00% (1/4)
						setstate(patrol1_purple_step1)
					end
				end
			elseif pc.get_empire() == 2 then
				say_title("[LC;6523]")
				if is_test_server() then
					local s= select("[LC;6519]", "[LC;6520]", "[LC;6521]", "[LC;6522]")
					if 1==s then
						setstate(patrol2_blue_step1)
					elseif 2==s then
						setstate(patrol2_yellow_step1)
					elseif 3==s then
						setstate(patrol2_gray_step1)
					elseif 4==s then
						setstate(patrol2_purple_step1)
					end
				else
					local s=number(1, 4)
					if 1>=s then -- 80.00% (1/4)
						setstate(patrol2_blue_step1)
					elseif 2>=s then --80,00% (1/4)
						setstate(patrol2_yellow_step1)
					elseif 3>=s then --80,00% (1/4)
						setstate(patrol2_gray_step1)
					elseif 4>=s then -- 80.00% (1/4)
						setstate(patrol2_purple_step1)
					end
				end
			elseif pc.get_empire() == 3 then
				say_title("[LC;6525]")
				if is_test_server() then
					local s= select("[LC;6519]", "[LC;6520]", "[LC;6521]", "[LC;6522]")
					if 1==s then
						setstate(patrol3_blue_step1)
					elseif 2==s then
						setstate(patrol3_yellow_step1)
					elseif 3==s then
						setstate(patrol3_gray_step1)
					elseif 4==s then
						setstate(patrol3_purple_step1)
					end
				else
					local s=number(1, 4)
					if 1>=s then -- 80.00% (1/4)
						setstate(patrol3_blue_step1)
					elseif 2>=s then --80,00% (1/4)
						setstate(patrol3_yellow_step1)
					elseif 3>=s then --80,00% (1/4)
						setstate(patrol3_gray_step1)
					elseif 4>=s then -- 80.00% (1/4)
						setstate(patrol3_purple_step1)
					end
				end
			end
		end
	end
	
	state reward begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton("[LC;6526]")
			q.set_title("[LC;6526]")
			q.start()
		end
		when button begin
			say_title("[LC;6526]")
			say_reward("[LC;6527]")
			pc.give_exp2(135)
			set_quest_state("levelup", "run")
			setstate(__COMPLETE__)
			q.done()
		end
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end

