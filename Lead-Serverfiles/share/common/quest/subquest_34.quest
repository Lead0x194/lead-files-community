
quest subquest_34 begin
	state start begin
		when login or levelup or enter with pc.get_level() >=40  and pc.get_level() <= 42 begin
			set_state( information )
		end
	end

	state information begin
		when letter begin
					
			local v = find_npc_by_vnum(20355)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7384]")
			end
		end

				
		when __TARGET__.target.click or	20355.chat."[LC;7946]" with pc.level >= 40  begin
			target.delete("__TARGET__")
			say_title("[LC;7958]")
			say("[LC;7960]")
			wait()
			say_title("[LC;7958]")
			say("[LC;7961]")
			local s= select("[LC;7840]", "[LC;1891]")
			if 2==s then
				say("[LC;7962]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;4082]")
					say("[LC;7963]")
					return
				end
				say_title("[LC;4082]")
				say("[LC;7964]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;4082]")
			say("[LC;7965]")
			set_state(bye_blackwind)
		end	
	end
	state bye_blackwind begin
		when letter begin
			send_letter("[LC;7966]")
		end

		when info or button begin
			say_title("[LC;7966]")
			say("[LC;7945]")
		end
		when 20355.chat."[LC;7966]" with pc.level >=32 begin
			say_title("[LC;7958]")
			say("[LC;7947]")
			local s= select("[LC;7948]", "[LC;7825]")
			if 2==s then
				say("[LC;7949]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;4082]")
					say("[LC;7950]")
					return
				end
				say_title("[LC;4082]")
				say("[LC;7951]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;4082]")
			say("[LC;7952]")
		end
		
	
		when 404.kill begin
			pc.setqf("kill_m1",1)
				
			if	pc.getqf("kill_m1")==1	and	pc.getqf("kill_m2")==1 and	pc.getqf("kill_m3")==1	then
				set_state(hunt_reward)
			end
			return
		end
		when 405.kill begin
				pc.setqf("kill_m2",1)
			
				if	pc.getqf("kill_m1")==1	and	pc.getqf("kill_m2")==1 and	pc.getqf("kill_m3")==1	then
					set_state(hunt_reward)
				end
				return

		end

		when 406.kill begin
			pc.setqf("kill_m3",1)
			
			if	pc.getqf("kill_m1")==1	and	pc.getqf("kill_m2")==1 and	pc.getqf("kill_m3")==1	then
				set_state(hunt_reward)
			end
			return
				
		end
	
			
	end
	
	state hunt_reward begin
		when letter begin
			send_letter("[LC;7953]")
		
			local v = find_npc_by_vnum(20355)

			if v != 0 then
				target.vid("__TARGET__", v, "[LC;7953]")
			end
		end

		when info or button begin
			say_title("[LC;7953]")
			say("[LC;7954]")
		end
		
		when __TARGET__.target.click or	20355.chat."[LC;7955]" begin
			target.delete("__TARGET__")
			say_title("[LC;7958]")
			say("[LC;7956]")
			say_reward("[LC;7957]")
			pc.give_item2(71007)
			
			say_reward("[LC;7959]")
			pc.give_exp2(1000000)
			
			set_state(__COMPLETE__)
			clear_letter()	

			pc.setqf("kill_m1",0)
			pc.setqf("kill_m2",0)
			pc.setqf("kill_m3",0)
		end

		end
	state __GIVEUP__ begin
	end
	state __COMPLETE__ begin
	end
end

