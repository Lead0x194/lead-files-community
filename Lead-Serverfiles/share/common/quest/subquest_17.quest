quest subquest_17 begin
	state start begin
		when login or levelup with pc.level >= 27  and pc.level <=30 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			local v=find_npc_by_vnum(20021)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7398]")
			end
		end

		when __TARGET__.target.click or	20021.chat."[LC;7398]"  begin
			target.delete("__TARGET__")
			say_title("[LC;1406]")
			say("[LC;7409]")
			wait()
			say_title("[LC;1406]")
			say("[LC;7420]")
			local s= select("[LC;7431]", "[LC;7434]")
			if 2==s then
				say("[LC;7435]")
				local a= select("[LC;2059]", "[LC;2035]")
				if  2==a then
					say_title("[LC;1406]")
					say("[LC;7436]")
					return
				end
				say_title("[LC;1406]")
				say("[LC;7437]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;1406]")
			say("[LC;7438]")
			set_state(to_itemmall_owner)
			
		end	
		
	end
		
	state to_itemmall_owner begin
		when letter begin
			local v=find_npc_by_vnum(9003)
			if 0==v then
			else
				target.vid("__TARGET__", v, "[LC;7397]")
			end
			
			send_letter("[LC;7397]")
		end
		when info or button begin
			say_title("[LC;7397]")
			say("[LC;7399]")
		end


		
		when __TARGET__.target.click or	9003.chat."[LC;7400]"  begin
			target.delete("__TARGET__")
			say_title("[LC;6964]")
			say("[LC;7401]")
			wait()
			say_title("[LC;6964]")
			say("[LC;7402]")
			set_state(find_ariyoung)
		end
	end
	state find_ariyoung begin
		when letter begin
			local v=find_npc_by_vnum(20021)
			if 0!=v then
				target.vid("__TARGET__",v, "[LC;7403]")
			end

			send_letter("[LC;7403]")
		end
		
		when info or  button begin
			say_title("[LC;7404]")
			say("[LC;7405]")
		end
		
		when __TARGET__.target.click or	20021.chat."[LC;7406]" begin
			target.delete("__TARGET__")
			say_title("[LC;7404]")
			say("[LC;7407]")
			wait()
			say_title("[LC;7404]")
			say("[LC;7408]")
			local s= select("[LC;7410]", "[LC;7159]")
			if 2==s then
				say("[LC;7435]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;7404]")
					say("[LC;7411]")
					return
				end
				say_title("[LC;7404]")
				say("[LC;7412]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7404]")
			say("[LC;7413]")
			set_state(hunt)
		end	
	end	
	
	state hunt begin
		when letter begin
			send_letter("[LC;7414]")
		end
		when info or  button begin
			say_title("[LC;7414]")
			say("[LC;7415]")
		end
		when 20021.chat."[LC;7416]" begin
			say_title("[LC;7404]")
			say("[LC;7417]")
		
			local s= select("[LC;7418]", "[LC;7434]")
			if 2==s then
				say_title("[LC;7404]")
				say("[LC;7435]")
				local a= select("[LC;2059]", "[LC;2035]")
				if 2==a then
					say_title("[LC;7404]")
					say("[LC;7419]")
					return
				end
				say_title("[LC;7404]")
				say("[LC;7421]")
				set_state(__GIVEUP__)
				return
			end
			say_title("[LC;7404]")
			say("[LC;7422]")
		end
		
		when 493.kill begin
			local s = number(1, 100)
			if s <= 10 and pc.count_item("30101")==0 then
				pc.give_item2("30101")        
				set_state(discover_ring)
			end
		end
		
	end
	state discover_ring begin
		when letter begin
			send_letter("[LC;7423]")
			
			local v=find_npc_by_vnum(20021)
			if 0!=v then
				target.vid("__TARGET__",v, "[LC;7424]")

			end
		end
		when info or button begin
			say_title("[LC;7425]")
			say("[LC;7426]")
		end
		
		when __TARGET__.target.click or	20021.chat."[LC;7427]" with pc.count_item("30101")>= 1  begin   
			target.delete("__TARGET__")
			say_title("[LC;7404]")
			say("[LC;7428]")
			set_state(reward)
			pc.remove_item("30101")
		end
	end
	state reward begin
		when letter begin
			send_letter("[LC;7429]")
		end
		when info or button begin
			say_title("[LC;7429]")
			say("[LC;7430]")
			say_reward("[LC;7432]")
			pc.give_exp2(300000)
			
			say_reward("[LC;7433]")
			pc.change_money(10000)
			
			clear_letter()
			
			set_state(__COMPLETE__)
		end
	end

	state __GIVEUP__ begin
	end
		
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end
